+#[test]
+fn shared_line_vertices_keep_support_offset_and_traversal() {
+    let policy = CurveContext::STRICT;
+    let root = Real::from(3).sqrt().unwrap();
+    let center = Point2::new(Real::from(2).sqrt().unwrap(), root.clone());
+    let source = LineSeg2::try_new(center.clone(), center.translated(Real::from(5), Real::from(-3))).unwrap();
+    let offset = source.offset_left(q(1, 2)).unwrap();
+    let other = source.offset_left(q(-1, 2)).unwrap();
+    for reversed in [false, true] {
+        let line = if reversed { offset.reversed() } else { offset.clone() };
+        let endpoint = Point2::new((line.start().x() + &root) - &root, line.start().y().clone());
+        assert_ne!(&endpoint, line.start());
+        assert_eq!(crate::CurvePoint2::from(endpoint.clone()).same_point(&line.start().clone().into(), &policy), Classification::Decided(true));
+        let corner = center.translated(Real::from(6), Real::from(2));
+        let fragment = |line| BezierSplitFragment2::Materialized {
+            start: Real::zero().into(),
+            end: Real::one().into(),
+            curve: BezierSubcurve2::Quadratic(QuadraticBezier2::from_line_segment(line)),
+        };
+        let mut fragments = [
+            fragment(LineSeg2::try_new(corner.clone(), endpoint.clone()).unwrap()),
+            fragment(line),
+            fragment(LineSeg2::try_new(if reversed { offset.start().clone() } else { offset.end().clone() }, corner).unwrap()),
+        ];
+        share_line_image_vertices(&mut fragments, &policy);
+        let BezierSplitFragment2::Materialized { curve: BezierSubcurve2::Quadratic(curve), .. } = &fragments[1] else {
+            panic!("a native affine line");
+        };
+        let image = curve.retained_exact_line_image().unwrap();
+        assert_eq!(image.start(), &endpoint);
+        assert_eq!(curve.control(), &QuadraticBezier2::from_line_segment(if reversed { offset.reversed() } else { offset.clone() }).control().clone());
+        assert!(image.shares_support_line(&offset));
+        assert_eq!(image.retained_offset_relation(&other, &policy), Some(crate::segment::RetainedLineRelation2::ParallelDistinct));
+        let repeated = image.offset_left(q(1, 8)).unwrap();
+        let expected = source.offset_left(if reversed { q(3, 8) } else { q(5, 8) }).unwrap();
+        assert_eq!(repeated.retained_offset_relation(&expected, &policy), Some(crate::segment::RetainedLineRelation2::Coincident));
+    }
+}
