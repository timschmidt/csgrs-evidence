+        model.terms(0).unwrap().get(&vec![(SymbolId(3), 1)]),
+        Some(&Real::zero())
+    );
+    assert_eq!(model.remainder(0), Some(&d(0, 1, 0)));
+    assert_eq!(model.remainder(1), Some(&d(-1, 0, 0)));
+    assert_eq!(model.range(), &[d(-2, -1, 0), d(1, 2, 0)]);
+}
