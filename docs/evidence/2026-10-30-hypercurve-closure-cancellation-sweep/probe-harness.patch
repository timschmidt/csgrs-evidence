+// TEMPORARY cancellation-latency probes (not for commit).
+fn cancel_probe(name: &str, workload: fn()) {
+    use std::time::{Duration, Instant};
+    let wait: u64 = std::env::var("CANCEL_AFTER_SECONDS").ok().and_then(|v| v.parse().ok()).unwrap_or(20);
+    let token = hypercurve::CancellationToken::new();
+    let (sender, receiver) = std::sync::mpsc::channel();
+    let started = Instant::now();
+    {
+        let token = token.clone();
+        std::thread::Builder::new().stack_size(512 << 20).spawn(move || {
+            let outcome = {
+                let outcome = hypercurve::evaluate_with_cancellable_budget(
+                    hypercurve::PredicatePolicy::STRICT,
+                    hypercurve::WorkBudget::UNLIMITED,
+                    &token,
+                    || std::panic::catch_unwind(workload),
+                );
+                match outcome.result {
+                    Err(exceeded) => format!("budget {:?} usage {:?}", exceeded.kind, outcome.usage),
+                    Ok(value) => match value.into_unverified() {
+                        Ok(()) => format!("completed usage {:?}", outcome.usage),
+                        Err(_) => format!("panicked usage {:?}", outcome.usage),
+                    },
+                }
+            };
+            let _ = sender.send((outcome, Instant::now()));
+        }).unwrap();
+    }
+    match receiver.recv_timeout(Duration::from_secs(wait)) {
+        Ok((outcome, finished)) => {
+            eprintln!("PROBE {name} finished-before-cancel after {:?}: {outcome}", finished - started);
+            return;
+        }
+        Err(_) => {}
+    }
+    let cancelled = Instant::now();
+    token.cancel();
+    let (outcome, finished) = receiver.recv().unwrap();
+    eprintln!("PROBE {name} latency {:?}: {outcome}", finished.saturating_duration_since(cancelled));
+}
