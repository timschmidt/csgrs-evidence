index 000000000..49b10e99b
--- /dev/null
+++ b/crates/hyperreal/src/computable/node/asinh_range_tests.rs
@@ -0,0 +1,123 @@
+#[cfg(test)]
+mod asinh_range_tests {
+    use super::*;
+    use rug::{Float, Integer, Rational as Q, float::Round};
+
+    fn raw(kind: Approximation) -> Computable {
+        Computable {
+            internal: Arc::new(Node::new(
+                kind,
+                BoundCache::Invalid,
+                ExactSignCache::Invalid,
+            )),
+            signal: None,
+        }
+    }
+
+    fn oracle(q: &Q) -> [Q; 2] {
+        let mut lo = Float::with_val_round(2048, q, Round::Down).0;
+        let mut hi = Float::with_val_round(2048, q, Round::Up).0;
+        lo.asinh_round(Round::Down);
+        hi.asinh_round(Round::Up);
+        [lo.to_rational().unwrap(), hi.to_rational().unwrap()]
+    }
+
+    fn encloses(value: &Computable, p: i32, bounds: &[Q; 2]) {
+        let a = Integer::from_str_radix(&value.approx(p).to_string(), 10).unwrap();
+        let unit = if p > 0 {
+            Q::from(Integer::from(1) << p)
+        } else {
+            Q::from((1, Integer::from(1) << -p))
+        };
+        let center = Q::from(a) * &unit;
+        assert!(
+            Q::from(&center - &unit) <= bounds[0] && Q::from(&center + &unit) >= bounds[1],
+            "p={p}, center={center}, unit={unit}"
+        );
+    }
+
+    #[test]
+    fn both_asinh_series_reduce_large_inputs_and_preserve_small_inputs() {
+        crate::mpfr_test::cleanup_on_thread_exit();
+        let mut inputs = vec![Q::from(0)];
+        for q in [
+            Q::from((1, 16)),
+            Q::from((1, 3)),
+            Q::from((127, 256)),
+            Q::from((1, 2)),
+            Q::from((129, 256)),
+            Q::from((3, 4)),
+            Q::from(1),
+            Q::from(4),
+            Q::from(1000),
+            Q::from(Integer::from(1) << 512),
+            Q::from((1, Integer::from(1) << 512)),
+        ] {
+            inputs.extend([q.clone(), -q]);
+        }
+        for q in inputs {
+            let bounds = oracle(&q);
+            let r: Rational = q.to_string().parse().unwrap();
+            for rational in [false, true] {
+                let build = || {
+                    raw(if rational {
+                        Approximation::AsinhRational(r.clone())
+                    } else {
+                        Approximation::PrescaledAsinh(Computable::rational(r.clone()))
+                    })
+                };
+                let warm = build();
+                for p in [1, 0, -1, -32, -128, -512, -8, 1] {
+                    encloses(&build(), p, &bounds);
+                    encloses(&warm, p, &bounds);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn asinh_range_proof_accounts_for_every_allowed_sample_rounding() {
+        crate::mpfr_test::cleanup_on_thread_exit();
+        let mut checks = 0;
+        // The original series' actual working precisions, including the
+        // coarse request whose argument is now sampled before returning zero.
+        for (p, s) in [
+            (1_i32, -12_i32),
+            (0, -12),
+            (-1, -13),
+            (-32, -46),
+            (-128, -144),
+        ] {
+            let threshold = Integer::from(1) << (-s - 1);
+            for delta in -8_i32..=8 {
+                for negative in [false, true] {
+                    let q = Q::from((threshold.clone() * 4 + delta, Integer::from(1) << (-s + 2)));
+                    let q = if negative { -q } else { q };
+                    let base = threshold.clone() + delta.div_euclid(4);
+                    let base = if negative { -base } else { base };
+                    let bounds = oracle(&q);
+                    for rounding in -1..=1 {
+                        let sample: Integer = base.clone() + rounding;
+                        let unit = Q::from((1, Integer::from(1) << -s));
+                        if (Q::from(sample.clone()) * &unit - &q).abs() > unit {
+                            continue;
+                        }
+                        let input = raw(Approximation::Add(
+                            Computable::rational(q.to_string().parse().unwrap()),
+                            Computable::zero(),
+                        ));
+                        input
+                            .internal
+                            .store_cache_value(s, sample.to_string().parse().unwrap());
+                        let value = raw(Approximation::PrescaledAsinh(input));
+                        for precision in [p, -256, p] {
+                            encloses(&value, precision, &bounds);
+                            checks += 1;
+                        }
+                    }
+                }
+            }
+        }
+        assert_eq!(checks, 1170);
+    }
+}
diff --git a/crates/hyperreal/tests/serde_asinh_ranges.rs b/crates/hyperreal/tests/serde_asinh_ranges.rs
new file mode 100644
index 000000000..7d8a9637a
--- /dev/null
+++ b/crates/hyperreal/tests/serde_asinh_ranges.rs
@@ -0,0 +1,144 @@
+#![cfg(feature = "serde")]
+
+use hyperreal::{Computable, Rational, Real, RealSign};
+use serde_json::{Value, json};
+
+fn q(n: i64, d: u64) -> Value {
+    serde_json::to_value(Rational::fraction(n, d).unwrap()).unwrap()
+}
+
+fn node(kind: &str, value: Value) -> Value {
+    json!({"internal": {kind: value}})
+}
+
+fn bytes(value: &Value) -> Vec<u8> {
+    let mut bytes = Vec::new();
+    ciborium::ser::into_writer(value, &mut bytes).unwrap();
+    bytes
+}
+
+#[test]
+fn imported_asinh_kernels_enclose_large_values_before_and_after_refinement() {
+    // e < 11/4 gives sinh(2) < 121/32 < 4. Also e > 8/3 gives
+    // sinh(3) > ((8/3)^3 - 1)/2 > 4. Thus 2 < asinh(4) < 3.
+    // These bounds are independent of the implementation being tested.
+    for sign in [-1, 1] {
+        let argument = node("Ratio", q(4 * sign, 1));
+        for graph in [
+            node("AsinhRational", q(4 * sign, 1)),
+            node("PrescaledAsinh", argument.clone()),
+            node(
+                "PrescaledAsinh",
+                node("Add", json!([argument, node("Ratio", q(0, 1))])),
+            ),
+        ] {
+            let a: Computable = serde_json::from_value(graph.clone()).unwrap();
+            let b: Computable = ciborium::de::from_reader(bytes(&graph).as_slice()).unwrap();
+            for value in [a, b] {
+                let wire = serde_json::to_value(&value).unwrap();
+                for p in [1, -64, 1] {
+                    let approximation = value.approx(p);
+                    assert!(if sign > 0 {
+                        approximation > 0.into()
+                    } else {
+                        approximation < 0.into()
+                    });
+                }
+                assert_eq!(serde_json::to_value(value).unwrap(), wire);
+            }
+            for scale in [0, 1, -3] {
+                let wire = json!({"rational":q(scale, 1),"class":"Irrational","computable":graph});
+                let cbor = ciborium::Value::serialized(&wire).unwrap();
+                let collection = json!([Real::one(), wire]);
+                let mut values = vec![
+                    Real::from_json(&wire.to_string()).unwrap(),
+                    Real::from_bytes(&bytes(&wire)).unwrap(),
+                    Real::try_from(&cbor).unwrap(),
+                    Real::try_from(cbor).unwrap(),
+                ];
+                let mut json_collection: Vec<Real> =
+                    serde_json::from_value(collection.clone()).unwrap();
+                let mut cbor_collection: Vec<Real> =
+                    ciborium::de::from_reader(bytes(&collection).as_slice()).unwrap();
+                values.push(json_collection.pop().unwrap());
+                values.push(cbor_collection.pop().unwrap());
+                let factor = sign * scale;
+                let expected_sign = match factor.cmp(&0) {
+                    std::cmp::Ordering::Less => RealSign::Negative,
+                    std::cmp::Ordering::Equal => RealSign::Zero,
+                    std::cmp::Ordering::Greater => RealSign::Positive,
+                };
+                let (lower, upper) = if factor >= 0 {
+                    (2 * factor, 3 * factor)
+                } else {
+                    (3 * factor, 2 * factor)
+                };
+                for value in values {
+                    let json = value.to_json();
+                    let cbor = value.to_bytes();
+                    for p in [1, -64, 1] {
+                        let [lo, hi] = value.certified_rational_interval(p).unwrap();
+                        if factor == 0 {
+                            assert!(lo <= Rational::zero() && hi >= Rational::zero());
+                        } else {
+                            assert!(lo < Rational::new(upper) && hi > Rational::new(lower));
+                            if p == -64 {
+                                assert!(lo > Rational::new(lower) && hi < Rational::new(upper));
+                            }
+                        }
+                        assert_eq!(value.certified_sign_until(p).sign(), Some(expected_sign));
+                    }
+                    let translated = &value + Real::one();
+                    let [lo, hi] = translated.certified_rational_interval(-32).unwrap();
+                    assert!(lo >= Rational::new(lower + 1) && hi <= Rational::new(upper + 1));
+                    assert_eq!(value.to_json(), json);
+                    assert_eq!(value.to_bytes(), cbor);
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn asinh_series_accept_symbolic_arguments_and_small_values() {
+    // sinh(1) < (e-1/e)/2 < (11/4-4/11)/2 < sqrt(2), while
+    // sinh(2) > ((8/3)^2-(3/8)^2)/2 > 22/7 > pi. Both values lie in (1,2).
+    for constant in ["Pi", "Sqrt2"] {
+        for sign in [-1, 1] {
+            let argument = node("Constant", json!(constant));
+            let argument = if sign < 0 {
+                node("Negate", argument)
+            } else {
+                argument
+            };
+            let graph = node("PrescaledAsinh", argument);
+            let wire = json!({"rational":q(1, 1),"class":"Irrational","computable":graph});
+            let value = Real::from_json(&wire.to_string()).unwrap();
+            let [lo, hi] = value.certified_rational_interval(-64).unwrap();
+            let (lower, upper) = if sign > 0 { (1, 2) } else { (-2, -1) };
+            assert!(lo > Rational::new(lower) && hi < Rational::new(upper));
+        }
+    }
+    for n in [-1, 0, 1] {
+        for kind in ["PrescaledAsinh", "AsinhRational"] {
+            let argument = if kind == "PrescaledAsinh" {
+                node("Ratio", q(n, 16))
+            } else {
+                q(n, 16)
+            };
+            let graph = node(kind, argument);
+            let wire = json!({"rational":q(1, 1),"class":"Irrational","computable":graph});
+            let value = Real::from_bytes(&bytes(&wire)).unwrap();
+            let [lo, hi] = value.certified_rational_interval(-64).unwrap();
+            // asinh is odd and strictly increasing, with |asinh(x)| < |x|
+            // for nonzero x. Include the exact-zero continuation separately.
+            if n == 0 {
+                assert!(lo <= Rational::zero() && hi >= Rational::zero());
+            } else if n > 0 {
+                assert!(lo > Rational::zero() && hi < Rational::fraction(1, 16).unwrap());
+            } else {
+                assert!(lo > Rational::fraction(-1, 16).unwrap() && hi < Rational::zero());
+            }
+        }
+    }
+}
