+    /// The exact set `nominal ± numerator/denominator` with nonnegative uncertainty.
+    ///
+    /// The input types establish nonnegativity and exclude division by zero.
+    /// The nominal may be any finite rational; no sign predicate is repeated
+    /// on the converted uncertainty.
+    pub fn from_nominal_unsigned_uncertainty(
+        nominal: &Rational,
+        numerator: u64,
+        denominator: core::num::NonZeroU64,
+    ) -> Self {
+        let uncertainty = Rational::unsigned_fraction(numerator, denominator);
+        Self::centered(nominal, &uncertainty)
+    }
+
+    // Both callers establish nonnegative uncertainty before endpoint arithmetic.
+    fn centered(nominal: &Rational, uncertainty: &Rational) -> Self {
+        Self::ordered(nominal - uncertainty, nominal + uncertainty)
     }
 
