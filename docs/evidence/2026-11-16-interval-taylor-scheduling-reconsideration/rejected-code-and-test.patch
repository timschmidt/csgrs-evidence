+
+// The fixture was captured on 924bef144 before removing scheduling clones.
+// Keep exact serialized output, both policy receipts, and every dispatch count.
+#[cfg(all(feature = "serde", feature = "dispatch-trace"))]
+#[test]
+fn named_coefficient_schedule_preserves_exact_outputs_receipts_and_dispatch() {
+    use hyperlimit::{PredicatePolicy, classify_real_sign};
+    use hyperreal::dispatch_trace;
+    use hyperreal::{Rational, Real};
+    use hypersolve::{
+        SymbolId, SymbolRef,
+        expression_program::{
+            BinaryOperation, CoefficientRequest, ExpressionBudget, ExpressionDefinition,
+            ExpressionNode, ExpressionProgram,
+        },
+    };
+    use serde_json::json;
+    fn graph() -> ExpressionBudget {
+        ExpressionBudget::new(100_000, 10_000_000)
+    }
+    fn source() -> (ExpressionProgram, Vec<CoefficientRequest>, Real) {
+        let x = SymbolId(7);
+        let k = Real::from(
+            "123456789012345678901234567890123456789012345678901234567890"
+                .parse::<Rational>()
+                .unwrap(),
+        );
+        let source = ExpressionProgram::from_definition(
+            ExpressionDefinition {
+                variables: vec![x],
+                nodes: vec![
+                    ExpressionNode::Variable(SymbolRef::new(
+                        x,
+                        Some("retained_named_coordinate".repeat(8)),
+                    )),
+                    ExpressionNode::Constant(k.clone()),
+                    ExpressionNode::Binary {
+                        operation: BinaryOperation::Mul,
+                        left: 0,
+                        right: 0,
+                    },
+                    ExpressionNode::Binary {
+                        operation: BinaryOperation::Mul,
+                        left: 1,
+                        right: 2,
+                    },
+                    ExpressionNode::Binary {
+                        operation: BinaryOperation::Add,
+                        left: 3,
+                        right: 0,
+                    },
+                ],
+                outputs: vec![4, 4, 1],
+            },
+            &mut graph(),
+        )
+        .unwrap();
+        let requests = (0..3)
+            .flat_map(|output| {
+                (1..=3).map(move |degree| CoefficientRequest {
+                    output,
+                    powers: vec![(x, degree)],
+                })
+            })
+            .collect();
+        (source, requests, k)
+    }
+
+    let mut records = Vec::new();
+    for policy in [PredicatePolicy::STRICT, PredicatePolicy::APPROXIMATE_512] {
+        let (s, r, k) = source();
+        let mut g = graph();
+        dispatch_trace::reset();
+        let (result, values, receipts) = dispatch_trace::with_recording(|| {
+            let result = s.coefficients(&r, &mut g).unwrap();
+            let values = result.program().eval_real(&[2.into()], &mut g).unwrap();
+            let receipts: Vec<_> = values
+                .iter()
+                .map(|v| classify_real_sign(v, policy))
+                .collect();
+            (result, values, receipts)
+        });
+        let trace = dispatch_trace::take_trace();
+        let value = k.clone() * Real::from(4) + Real::from(2);
+        let first = k.clone() * Real::from(4) + Real::one();
+        assert_eq!(
+            values,
+            vec![
+                value.clone(),
+                value,
+                k.clone(),
+                first.clone(),
+                k.clone(),
+                Real::zero(),
+                first,
+                k,
+                Real::zero(),
+                Real::zero(),
+                Real::zero(),
+                Real::zero()
+            ]
+        );
+        records.push(json!({"kind":"control","policy":format!("{policy:?}"),"graph_work":10_000_000-g.remaining_work(),"definition":result.program().definition(),"values":values,"receipts":format!("{receipts:?}"),"trace":format!("{trace:?}")}).to_string());
+    }
+    assert_eq!(
+        records.join("\n") + "\n",
+        include_str!("support/coefficient_schedule_trace.jsonl")
+    );
+}
