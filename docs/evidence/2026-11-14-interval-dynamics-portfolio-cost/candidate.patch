diff --git a/crates/hyperdynamics/tests/reachability.rs b/crates/hyperdynamics/tests/reachability.rs
index 4d50521ca..bfd04b319 100644
--- a/crates/hyperdynamics/tests/reachability.rs
+++ b/crates/hyperdynamics/tests/reachability.rs
@@ -616,3 +616,219 @@ fn source_request_and_policy_replay_in_fresh_processes() {
         serde_json::from_value(bad).unwrap();
     assert!(ExpressionField::<2>::from_definition(source, &mut b()).is_err());
