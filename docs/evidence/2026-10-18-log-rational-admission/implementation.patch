diff --git a/crates/hyperreal/src/computable/node/log_rational_range_tests.rs b/crates/hyperreal/src/computable/node/log_rational_range_tests.rs
new file mode 100644
index 000000000..ad5254e3d
--- /dev/null
+++ b/crates/hyperreal/src/computable/node/log_rational_range_tests.rs
@@ -0,0 +1,121 @@
+#[cfg(test)]
+mod log_rational_range_tests {
+    use super::*;
+    use rug::{Float, Integer, Rational as Q, float::Round};
+
+    fn raw(kind: Approximation) -> Computable {
+        Computable {
+            internal: Arc::new(Node::new(
+                kind,
+                BoundCache::Invalid,
+                ExactSignCache::Invalid,
+            )),
+            signal: None,
+        }
+    }
+
+    fn oracle(residual: &Q, shift: i32) -> [Q; 2] {
+        let argument = Q::from(residual + 1);
+        let mut lo = Float::with_val_round(2048, &argument, Round::Down).0;
+        let mut hi = Float::with_val_round(2048, &argument, Round::Up).0;
+        lo.ln_round(Round::Down);
+        hi.ln_round(Round::Up);
+        let mut ln2_lo = Float::with_val(2048, 2);
+        let mut ln2_hi = Float::with_val(2048, 2);
+        ln2_lo.ln_round(Round::Down);
+        ln2_hi.ln_round(Round::Up);
+        let mut scaled_lo = ln2_lo.to_rational().unwrap() * shift;
+        let mut scaled_hi = ln2_hi.to_rational().unwrap() * shift;
+        if shift < 0 {
+            std::mem::swap(&mut scaled_lo, &mut scaled_hi);
+        }
+        [
+            lo.to_rational().unwrap() + scaled_lo,
+            hi.to_rational().unwrap() + scaled_hi,
+        ]
+    }
+
+    fn encloses(value: &Computable, p: i32, bounds: &[Q; 2]) {
+        let approximation = Integer::from_str_radix(&value.approx(p).to_string(), 10).unwrap();
+        let unit = if p > 0 {
+            Q::from(Integer::from(1) << p)
+        } else {
+            Q::from((1, Integer::from(1) << -p))
+        };
+        let center = Q::from(approximation) * &unit;
+        assert!(
+            Q::from(&center - &unit) <= bounds[0] && Q::from(&center + &unit) >= bounds[1],
+            "p={p}, center={center}, unit={unit}"
+        );
+    }
+
+    fn exercise(residual: &Q, shift: Option<i32>) {
+        let bounds = oracle(residual, shift.unwrap_or(0));
+        let r: Rational = residual.to_string().parse().unwrap();
+        let build = || {
+            raw(match shift {
+                None => Approximation::PrescaledLnRational(r.clone()),
+                Some(shift) => Approximation::BinaryScaledLnRational {
+                    residual: r.clone(),
+                    shift,
+                },
+            })
+        };
+        let warm = build();
+        for p in [2, 1, 0, -1, -32, -128, -512, -8, 2, 0] {
+            encloses(&build(), p, &bounds);
+            encloses(&warm, p, &bounds);
+        }
+    }
+
+    #[test]
+    fn rational_log_series_enclose_small_large_and_near_minus_one_residuals() {
+        crate::mpfr_test::cleanup_on_thread_exit();
+        let mut inputs = vec![Q::from(0)];
+        for q in [
+            Q::from((1, 16)),
+            Q::from((1, 3)),
+            Q::from((127, 256)),
+            Q::from((1, 2)),
+            Q::from((129, 256)),
+            Q::from((3, 4)),
+            Q::from(((Integer::from(1) << 512) - 1, Integer::from(1) << 512)),
+            Q::from((1, Integer::from(1) << 512)),
+        ] {
+            inputs.extend([q.clone(), -q]);
+        }
+        inputs.extend([
+            Q::from(1),
+            Q::from(4),
+            Q::from(1000),
+            Q::from(65535),
+            Q::from((Integer::from(1) << 512) - 1),
+        ]);
+        for residual in inputs {
+            exercise(&residual, None);
+            exercise(&residual, Some(0));
+        }
+    }
+
+    #[test]
+    fn binary_scaled_logs_preserve_residuals_and_full_width_shifts() {
+        crate::mpfr_test::cleanup_on_thread_exit();
+        for residual in [
+            Q::from(0),
+            Q::from((1, 16)),
+            Q::from((-1, 16)),
+            Q::from((1, 2)),
+            Q::from((-1, 2)),
+            Q::from((-15, 16)),
+            Q::from(4),
+            Q::from(65535),
+            Q::from((-65535, 65536)),
+            Q::from((Integer::from(1) << 512) - 1),
+            Q::from((1 - (Integer::from(1) << 512), Integer::from(1) << 512)),
+        ] {
+            for shift in [i32::MIN, -4096, -17, -3, 0, 3, 17, 4096, i32::MAX] {
+                exercise(&residual, Some(shift));
+            }
+        }
+    }
+}
diff --git a/crates/hyperreal/tests/serde_log_rational_ranges.rs b/crates/hyperreal/tests/serde_log_rational_ranges.rs
new file mode 100644
index 000000000..76c5c7a45
--- /dev/null
+++ b/crates/hyperreal/tests/serde_log_rational_ranges.rs
@@ -0,0 +1,162 @@
+#![cfg(feature = "serde")]
+
+use hyperreal::{Computable, Problem, Rational, Real, RealSign};
+use serde_json::{Value, json};
+
+fn q(n: i64, d: u64) -> Value {
+    serde_json::to_value(Rational::fraction(n, d).unwrap()).unwrap()
+}
+
+fn node(kind: &str, argument: Value) -> Value {
+    json!({"internal": {kind: argument}})
+}
+
+fn bytes(value: &Value) -> Vec<u8> {
+    let mut bytes = Vec::new();
+    ciborium::ser::into_writer(value, &mut bytes).unwrap();
+    bytes
+}
+
+#[test]
+fn imported_rational_logs_preserve_enclosures_and_following_arithmetic() {
+    let mut cases = Vec::new();
+    // e < 11/4 and e > 8/3 prove 1 < ln(5) < 2 and
+    // -3 < ln(1/16) < -2 independently of another scalar evaluator.
+    for (n, d, lower, upper) in [(4, 1, 1, 2), (-15, 16, -3, -2)] {
+        for graph in [
+            node("PrescaledLnRational", q(n, d)),
+            node(
+                "BinaryScaledLnRational",
+                json!({"residual": q(n, d), "shift": 0}),
+            ),
+        ] {
+            cases.push((graph, 0, Rational::new(lower), Rational::new(upper)));
+        }
+    }
+    // e^2 < 8 and e > 2 give 2/3 < ln(2) < 1. These exact dyadic
+    // arguments give (16+shift)*ln(2) or (-16+shift)*ln(2).
+    for (n, d, exponent) in [(65535, 1, 16), (-65535, 65536, -16)] {
+        for shift in [-3, 3] {
+            let coefficient = exponent + shift;
+            let a = Rational::fraction(2 * coefficient, 3).unwrap();
+            let b = Rational::new(coefficient);
+            let (lo, hi) = if coefficient > 0 { (a, b) } else { (b, a) };
+            let graph = node(
+                "BinaryScaledLnRational",
+                json!({"residual": q(n, d), "shift": shift}),
+            );
+            cases.push((graph, 2, lo, hi));
+        }
+    }
+    for (graph, coarse, lower, upper) in cases {
+        let a: Computable = serde_json::from_value(graph.clone()).unwrap();
+        let b: Computable = ciborium::de::from_reader(bytes(&graph).as_slice()).unwrap();
+        for value in [a, b] {
+            let wire = serde_json::to_value(&value).unwrap();
+            for p in [coarse, -64, coarse] {
+                let a: Rational = value.approx(p).to_string().parse().unwrap();
+                let unit = if p >= 0 {
+                    Rational::new(1_i64 << p)
+                } else {
+                    format!("1/{}", 1_u128 << -p).parse().unwrap()
+                };
+                let center = a * &unit;
+                assert!(&center - &unit < upper && &center + &unit > lower);
+            }
+            assert_eq!(serde_json::to_value(value).unwrap(), wire);
+        }
+        for scale in [0, 1, -3] {
+            let wire = json!({"rational":q(scale, 1),"class":"Irrational","computable":graph});
+            let cbor = ciborium::Value::serialized(&wire).unwrap();
+            let collection = json!([Real::one(), wire]);
+            let mut values = vec![
+                Real::from_json(&wire.to_string()).unwrap(),
+                Real::from_bytes(&bytes(&wire)).unwrap(),
+                Real::try_from(&cbor).unwrap(),
+                Real::try_from(cbor).unwrap(),
+            ];
+            let mut a: Vec<Real> = serde_json::from_value(collection.clone()).unwrap();
+            let mut b: Vec<Real> =
+                ciborium::de::from_reader(bytes(&collection).as_slice()).unwrap();
+            values.push(a.pop().unwrap());
+            values.push(b.pop().unwrap());
+            let factor = Rational::new(scale);
+            let (lo_bound, hi_bound) = if scale >= 0 {
+                (&lower * &factor, &upper * &factor)
+            } else {
+                (&upper * &factor, &lower * &factor)
+            };
+            let sign = if scale == 0 {
+                RealSign::Zero
+            } else if lo_bound > Rational::zero() {
+                RealSign::Positive
+            } else {
+                RealSign::Negative
+            };
+            for value in values {
+                let json = value.to_json();
+                let cbor = value.to_bytes();
+                for p in [coarse, -64, coarse] {
+                    let [lo, hi] = value.certified_rational_interval(p).unwrap();
+                    if scale == 0 {
+                        assert!(lo <= Rational::zero() && hi >= Rational::zero());
+                    } else {
+                        assert!(lo < hi_bound && hi > lo_bound);
+                        if p == -64 {
+                            assert!(lo > lo_bound && hi < hi_bound);
+                        }
+                    }
+                    assert_eq!(value.certified_sign_until(p).sign(), Some(sign));
+                }
+                let [lo, hi] = (&value + Real::one())
+                    .certified_rational_interval(-32)
+                    .unwrap();
+                assert!(lo >= &lo_bound + Rational::one() && hi <= &hi_bound + Rational::one());
+                assert_eq!(value.to_json(), json);
+                assert_eq!(value.to_bytes(), cbor);
+            }
+        }
+    }
+}
+
+#[test]
+fn rational_log_import_keeps_invalid_residuals_as_typed_failures() {
+    for (n, d) in [(-1, 1), (-2, 1), (-3, 2)] {
+        for graph in [
+            node("PrescaledLnRational", q(n, d)),
+            node(
+                "BinaryScaledLnRational",
+                json!({"residual": q(n, d), "shift": 0}),
+            ),
+            node(
+                "BinaryScaledLnRational",
+                json!({"residual": q(n, d), "shift": 31}),
+            ),
+        ] {
+            for graph in [
+                graph.clone(),
+                node("Multiply", json!([node("Ratio", q(0, 1)), graph])),
+            ] {
+                assert!(serde_json::from_value::<Computable>(graph.clone()).is_err());
+                assert!(
+                    ciborium::de::from_reader::<Computable, _>(bytes(&graph).as_slice()).is_err()
+                );
+                for scale in [0, 1, -3] {
+                    let wire =
+                        json!({"rational":q(scale, 1),"class":"Irrational","computable":graph});
+                    let cbor = ciborium::Value::serialized(&wire).unwrap();
+                    assert_eq!(Real::from_json(&wire.to_string()), Err(Problem::ParseError));
+                    assert_eq!(Real::from_bytes(&bytes(&wire)), Err(Problem::ParseError));
+                    assert_eq!(Real::try_from(&cbor), Err(Problem::ParseError));
+                    assert_eq!(Real::try_from(cbor), Err(Problem::ParseError));
+                    let collection = json!([Real::one(), wire]);
+                    assert!(serde_json::from_value::<Vec<Real>>(collection.clone()).is_err());
+                    assert!(
+                        ciborium::de::from_reader::<Vec<Real>, _>(bytes(&collection).as_slice())
+                            .is_err()
+                    );
+                }
+            }
+        }
+    }
+}
