+    let CompilationResult::Success { views: expected_views, failed_parts, .. } = expected else {
+        panic!("the explicitly colored control must compile");
+    };
+    assert!(failed_parts.is_empty());
+    assert_eq!(views.len(), expected_views.len());
+    for (view, expected) in views.iter().zip(&expected_views) {
+        assert_eq!(view.label, expected.label);
+        assert_eq!(view.base64_png, expected.base64_png, "{} colors shifted after a failed part", view.label);
+    }
+}
