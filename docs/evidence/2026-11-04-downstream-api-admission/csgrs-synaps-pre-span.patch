+/// Failed parts have no mesh to label, so their badges are listed in the
+/// lower-left corner of the viewport, above the axis indicator.
+fn draw_failed_part_badges(ctx: &egui::Context, failed_parts: &FailedParts, left: f32) {
+    if failed_parts.parts.is_empty() {
+        return;
+    }
+    egui::Area::new(egui::Id::new("failed_part_badges"))
+        .anchor(egui::Align2::LEFT_BOTTOM, egui::vec2(left + 8.0, -80.0))
+        .interactable(true)
+        .order(egui::Order::Background)
+        .show(ctx, |ui| {
+            ui.spacing_mut().item_spacing = egui::vec2(0.0, 2.0);
+            for failed in &failed_parts.parts {
+                let location = failed
+                    .location
+                    .map_or_else(String::new, |location| format!(" \u{b7} {location}"));
+                let badge = format!(
+                    "@{} \u{2716} {}{location}",
+                    failed.part,
+                    failed.failure.kind()
+                );
+                egui::Frame::new()
+                    .fill(egui::Color32::from_rgb(170, 40, 40))
+                    .corner_radius(egui::CornerRadius::same(3))
+                    .inner_margin(egui::Margin::symmetric(4, 2))
+                    .show(ui, |ui| {
+                        ui.label(
+                            egui::RichText::new(badge)
+                                .color(egui::Color32::WHITE)
+                                .strong()
+                                .small(),
+                        )
+                        .on_hover_text(failed.summary());
+                    });
+            }
+        });
