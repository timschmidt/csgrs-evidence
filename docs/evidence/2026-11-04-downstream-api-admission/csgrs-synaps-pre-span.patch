+/// Folds `operands` into a balanced tree of `op`. A balanced tree keeps the
+/// recorded expression shallow; the set is the same for any association.
+fn balanced(operands: &[SolidExpr], op: BoolOp) -> SolidExpr {
+    match operands {
+        [] => unreachable!("a Boolean fold always has an operand"),
+        [single] => single.clone(),
+        _ => {
+            let (left, right) = operands.split_at(operands.len() / 2);
+            let (left, right) = (balanced(left, op), balanced(right, op));
+            match op {
+                BoolOp::Union => left.union(&right),
+                BoolOp::Intersection => left.intersection(&right),
+                BoolOp::Difference => unreachable!("difference is never folded associatively"),
+            }
+        }
     }
 }
 
