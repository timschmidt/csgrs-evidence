+#[test]
+fn successful_parts_report_certified_mesh_evidence() {
+    let (parts, failed_parts, _) = compile_failures("cube(1);\nsphere(1, $fn = 8);");
+
+    assert!(failed_parts.is_empty());
+    assert_eq!(parts.len(), 2);
+    assert_eq!(
+        parts[0].evidence,
+        crate::compiler::PartEvidence::default(),
+        "an authored cube has declared coordinates and no qualification"
+    );
+    assert_eq!(parts[0].evidence.summary(), "certified");
+    assert!(
+        parts[1].evidence.source_sampled,
+        "a sphere is sampled from its continuous source"
+    );
+    assert!(!parts[1].evidence.approximate_512_consumed);
+    assert!(
+        parts[1]
+            .evidence
+            .summary()
+            .starts_with("certified; mesh evidence: source_sampled")
+    );
+}
+
+/// Asserts that two meshes bound the same exact rational volume.
+fn assert_same_exact_volume(left: &TriangleMesh, right: &csgrs::Real) {
+    let volume = solid::exact_mass_properties(left, csgrs::Real::one())
+        .expect("exact mass properties")
+        .volume
+        .exact_rational_normal_form();
+    assert!(
+        volume.is_some(),
+        "the volume must have an exact rational form"
+    );
+    assert_eq!(volume, right.exact_rational_normal_form());
+}
+
+fn exact_volume(mesh: &TriangleMesh) -> csgrs::Real {
+    solid::exact_mass_properties(mesh, csgrs::Real::one())
+        .expect("exact mass properties")
+        .volume
+}
+
+fn exact_bounds(mesh: &TriangleMesh) -> [csgrs::Real; 6] {
+    let bounds = solid::bounding_box(mesh)
+        .expect("exact bounds")
+        .expect("nonempty mesh");
+    [
+        bounds.mins.x,
+        bounds.mins.y,
+        bounds.mins.z,
+        bounds.maxs.x,
+        bounds.maxs.y,
+        bounds.maxs.z,
+    ]
+}
+
+/// The pairwise fold that `eval_boolean_op` used before D02.
+fn pairwise_reference(children: &[&str], op: hypermesh::BooleanOp) -> TriangleMesh {
+    let meshes: Vec<TriangleMesh> = children
+        .iter()
+        .map(|child| compile_to_triangle_mesh(child))
+        .collect();
+    meshes[1..].iter().fold(meshes[0].clone(), |acc, mesh| {
+        solid::boolean(&acc, mesh, op).expect("pairwise reference Boolean")
+    })
+}
+
+const UNION_CHILDREN: [&str; 4] = [
+    "cube(2);",
+    "translate([1, 1, 0]) cube(2);",
+    "translate([3, 0, 0]) cube([1, 3, 1]);",
+    "translate([0, 0, 2]) cube([4, 1, 1]);",
+];
+
+const DIFFERENCE_CHILDREN: [&str; 4] = [
+    "cube(10);",
+    "translate([2, 2, -1]) cube([2, 2, 12]);",
+    "translate([6, 6, -1]) cube([2, 2, 12]);",
+    "translate([4, -1, 8]) cube([2, 12, 3]);",
+];
+
+#[test]
+fn multi_child_union_is_one_recorded_program_with_the_pairwise_set() {
+    let code = format!("union() {{ {} }}", UNION_CHILDREN.join(" "));
+    let source = openscad_rs::parse(&code).unwrap();
+    let mut evaluator = Evaluator::new();
+    let shapes = evaluator.eval_statement_list(&source.statements);
+    assert_eq!(shapes.len(), 1);
+    assert!(
+        matches!(shapes[0].0, Shape::Csg3D { .. }),
+        "a 3D union is recorded, not folded eagerly"
+    );
+
+    let program = compile_to_triangle_mesh(&code);
+    let reference = pairwise_reference(&UNION_CHILDREN, hypermesh::BooleanOp::Union);
+    assert_same_exact_volume(&program, &exact_volume(&reference));
+    assert_eq!(exact_bounds(&program), exact_bounds(&reference));
+    hypermesh::polygon_soup(&crate::compiler::MESH_CONTEXT, &[program.as_ref()])
+        .expect("the one-program union is a closed manifold");
+}
+
+#[test]
+fn multi_child_difference_subtracts_every_later_child_from_the_first() {
+    let code = format!("difference() {{ {} }}", DIFFERENCE_CHILDREN.join(" "));
+    let program = compile_to_triangle_mesh(&code);
+    let reference = pairwise_reference(&DIFFERENCE_CHILDREN, hypermesh::BooleanOp::Difference);
+
+    assert_same_exact_volume(&program, &exact_volume(&reference));
+    // Independent closed form: 1000 - 2 * (2 * 2 * 10) - (2 * 10 * 2). The
+    // slot only touches each hole along a face: 1000 - 80 - 40 = 880.
+    assert_same_exact_volume(&program, &csgrs::Real::from(880));
+    assert_eq!(exact_bounds(&program), exact_bounds(&reference));
+}
+
+#[test]
+fn nested_boolean_subtrees_lower_into_one_expression() {
+    let code = "union() {
+        difference() { cube(4); translate([1, 1, 1]) cube(2); }
+        translate([5, 0, 0]) intersection() { cube(2); translate([1, 0, 0]) cube(2); }
+    }";
+    let source = openscad_rs::parse(code).unwrap();
+    let mut evaluator = Evaluator::new();
+    let shapes = evaluator.eval_statement_list(&source.statements);
+    assert!(matches!(shapes[0].0, Shape::Csg3D { .. }));
+
+    let program = compile_to_triangle_mesh(code);
+    // 64 - 8 for the hollow cube, plus the 1 x 2 x 2 intersection.
+    assert_same_exact_volume(&program, &csgrs::Real::from(60));
+}
+
+#[cfg(feature = "dispatch-trace")]
+#[test]
+fn four_child_union_builds_one_arrangement() {
+    let code = format!("union() {{ {} }}", UNION_CHILDREN.join(" "));
+    let source = openscad_rs::parse(&code).unwrap();
+    hyperreal::dispatch_trace::reset();
+    hyperreal::dispatch_trace::with_recording(|| {
+        let mut evaluator = Evaluator::new();
+        let shapes = evaluator.eval_source_file(&source);
+        assert!(matches!(shapes[0].0, Shape::TriangleMesh3D(_)));
+    });
+    let arrangements =
+        hyperreal::dispatch_trace::take_trace().path_count("hypermesh", "boolean", "start");
+    assert_eq!(arrangements, 1, "pairwise folding built {arrangements}");
+}
