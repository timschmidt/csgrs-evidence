+fn compile_failures(code: &str) -> (Vec<MeshData>, Vec<crate::compiler::FailedPart>, Vec<String>) {
+    match compile_with_timeout(code, 0) {
+        CompilationResult::Success {
+            parts,
+            failed_parts,
+            warnings,
+            ..
+        } => (parts, failed_parts, warnings),
+        CompilationResult::Error(error) => panic!("Compilation failed: {error}"),
+        CompilationResult::Canceled => panic!("Compilation was unexpectedly canceled"),
+    }
+}
+
+fn span_text(code: &str, failed: &crate::compiler::FailedPart) -> String {
+    let span = failed
+        .failure
+        .span()
+        .expect("the failure must name its statement");
+    code[span.start..span.end].to_owned()
+}
+
+#[test]
+fn kernel_failure_keeps_its_csgrs_kind_source_and_statement_span() {
+    let code = "cube(1);\ncube(-1);\nsphere(1);";
+    let (parts, failed_parts, _) = compile_failures(code);
+
+    assert_eq!(
+        parts.iter().map(|part| part.part).collect::<Vec<_>>(),
+        [1, 3],
+        "successful parts keep their source-order numbers"
+    );
+    assert_eq!(failed_parts.len(), 1);
+    let failed = &failed_parts[0];
+    assert_eq!(failed.part, 2);
+    assert_eq!(
+        failed.failure.kind(),
+        crate::compiler::FailureKind::Kernel(csgrs::errors::ValidationErrorKind::InvalidInput)
+    );
+    assert!(matches!(
+        failed.failure.kernel_error(),
+        Some(csgrs::Error::NegativeParameter { .. })
+    ));
+    assert!(span_text(code, failed).starts_with("cube(-1)"));
+    assert_eq!(
+        failed.location,
+        Some(crate::compiler::SourceLocation { line: 2, column: 1 })
+    );
+    assert!(
+        failed
+            .summary()
+            .starts_with("failed (invalid_input) at line 2:1: cube() failed")
+    );
+}
+
+#[test]
+fn invalid_argument_failure_names_the_transform_statement() {
+    let code = "cube(1);\n  translate(\"up\") cube(2);";
+    let (parts, failed_parts, _) = compile_failures(code);
+
+    assert_eq!(parts.len(), 1);
+    assert_eq!(failed_parts.len(), 1);
+    let failed = &failed_parts[0];
+    assert_eq!(failed.part, 2);
+    assert_eq!(
+        failed.failure.kind(),
+        crate::compiler::FailureKind::InvalidArgument
+    );
+    assert!(failed.failure.kernel_error().is_none());
+    assert!(span_text(code, failed).starts_with("translate(\"up\")"));
+    assert_eq!(
+        failed.location,
+        Some(crate::compiler::SourceLocation { line: 2, column: 3 })
+    );
+}
