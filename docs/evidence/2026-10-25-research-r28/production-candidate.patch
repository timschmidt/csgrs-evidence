+/// The caller has established one nonzero sign for the Bernstein weights.
+/// This makes the active image finite and connected. Distinct points on a
+/// positive-radius circle make it nonconstant, so it cannot lie on one line.
+/// A support tag or a declined comparison alone does not establish that claim.
+fn certified_nonlinear_circle_image(
+    circle: Option<&std::sync::Arc<crate::rational_bezier::RationalQuadraticCircle2>>,
+    start: &Point2,
+    end: &Point2,
+    policy: &CurveContext,
+) -> bool {
+    let Some(circle) = circle else {
+        return false;
+    };
+    let strict = policy.strict_counterpart();
+    real_sign(&circle.radius_squared, &strict) == Some(RealSign::Positive)
+        && [(start.x(), end.x()), (start.y(), end.y())]
+            .into_iter()
+            .any(|(first, second)| {
+                matches!(
+                    crate::classify::compare_reals(first, second, &strict),
+                    Some(std::cmp::Ordering::Less | std::cmp::Ordering::Greater)
+                )
+            })
