+    ) -> Result<Self, FlowTaylorError> {
+        budget.graph.charge(0)?;
+        if additional == 0 {
+            budget.graph.charge(1)?;
+            let result = self.clone();
+            budget.graph.charge(0)?;
+            return Ok(result);
+        }
+        // The source-only prefix has no generated association to preserve.
+        // Its authored source is already shared through the field.
+        if self.order == 0 {
+            return self.field.flow_taylor(additional, budget);
+        }
+        let order = self
+            .order
+            .checked_add(additional)
+            .ok_or(FlowTaylorError::OrderOverflow)?;
+        let count = order.checked_add(1).ok_or(FlowTaylorError::OrderOverflow)?;
+        let columns = N.checked_add(1).ok_or(ExpressionError::SizeExhausted)?;
+        let requests_len = N
+            .checked_mul(columns)
+            .ok_or(ExpressionError::SizeExhausted)?;
+        let outputs = count.checked_mul(N).ok_or(ExpressionError::SizeExhausted)?;
+        budget
+            .graph
+            .check_entries(&[count, outputs, N, columns, requests_len, requests_len])?;
+        let copy_work = N.checked_add(8).ok_or(ExpressionError::SizeExhausted)?;
+        let mut stages = Vec::with_capacity(count);
+        for stage in self.stages.iter() {
+            budget.graph.charge(copy_work)?;
+            stages.push(stage.clone());
+        }
+        let first = self
+            .stages
+            .len()
+            .checked_add(1)
+            .ok_or(FlowTaylorError::OrderOverflow)?;
+        let field = &self.field;
+        append_flow_stages(
+            field,
+            &mut stages,
+            first,
+            count,
+            columns,
+            requests_len,
+            budget,
+        )?;
+        budget.graph.charge(count)?;
+        let result = Self {
+            field: self.field.clone(),
+            order,
+            stages: stages.into(),
+        };
+        budget.graph.charge(0)?;
+        Ok(result)
+    }
+}
