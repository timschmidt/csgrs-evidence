+        check(format!("TRACE{case}={:?}", dispatch_trace::take_trace()));
+        check(format!(
+            "WORK{case}={}:{}",
+            b.remaining_graph_work(),
+            b.remaining_scalar_work()
+        ));
+    }
+}
