[
  {
    "id": "workspace-check-0-3",
    "origin": {
      "workflow": ".github/workflows/workspace.yml",
      "job": "check",
      "matrix": {},
      "step": 3,
      "name": "Check every member and target"
    },
    "cwd": ".",
    "command": "cargo check --locked --workspace --all-targets",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "CARGO_TERM_COLOR": "always"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  },
  {
    "id": "workspace-test-6-3",
    "origin": {
      "workflow": ".github/workflows/workspace.yml",
      "job": "test",
      "matrix": {
        "crate": "hypercircuit"
      },
      "step": 3,
      "name": "Run tests"
    },
    "cwd": ".",
    "command": "cargo test --locked -p \"hypercircuit\" ",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "CARGO_TERM_COLOR": "always",
      "CRATE": "hypercircuit",
      "ARGS": ""
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  },
  {
    "id": "workspace-test-9-3",
    "origin": {
      "workflow": ".github/workflows/workspace.yml",
      "job": "test",
      "matrix": {
        "crate": "hyperdrc",
        "args": "--release",
        "timeout": 90
      },
      "step": 3,
      "name": "Run tests"
    },
    "cwd": ".",
    "command": "cargo test --locked -p \"hyperdrc\" --release",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "CARGO_TERM_COLOR": "always",
      "CRATE": "hyperdrc",
      "ARGS": "--release"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  }
]
