[
  {
    "id": "extra-clippy-074",
    "origin": {
      "workflow": ".github/workflows/workspace.yml",
      "job": "check",
      "matrix": {},
      "step": 3,
      "name": "Check every member and target"
    },
    "cwd": ".",
    "command": "cargo clippy --locked --workspace --all-targets -- -D warnings",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "CARGO_TERM_COLOR": "always"
    },
    "target_group": "1.99.1-normal",
    "kind": "strict-clippy",
    "timeout_seconds": 21600
  },
  {
