[
  {
    "id": "rust-release-0-4",
    "origin": {
      "workflow": ".github/workflows/rust.yml",
      "job": "release",
      "matrix": {
        "toolchain": "stable"
      },
      "step": 4,
      "name": "Package, verify and consume the released crates"
    },
    "cwd": ".",
    "command": "bash scripts/release-check.sh",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "CARGO_TERM_COLOR": "always"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  }
]
