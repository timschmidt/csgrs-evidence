    "cwd": ".",
    "command": "set -euo pipefail\nmkdir -p site\ncp -r crates/hypercurve/examples/hypercurve_ui/dist site/hypercurve\ncp -r crates/hypermesh/examples/hypermesh_ui/dist site/hypermesh\ncp -r crates/hypertri/examples/hypertri_ui/dist site/hypertri\ncat > site/index.html <<'HTML'\n<!doctype html>\n<meta charset=\"utf-8\">\n<title>csgrs demos</title>\n<h1>csgrs demos</h1>\n<ul>\n  <li><a href=\"hypercurve/\">hypercurve</a></li>\n  <li><a href=\"hypermesh/\">hypermesh</a></li>\n  <li><a href=\"hypertri/\">hypertri</a></li>\n</ul>\nHTML\ntouch site/.nojekyll\n",
