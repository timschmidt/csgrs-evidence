  {
    "id": "hypertri-feature-powerset-0-4",
    "origin": {
      "workflow": ".github/workflows/hypertri.yml",
      "job": "feature-powerset",
      "matrix": {
        "kind": "check",
        "command": "cargo hack check --feature-powerset --exclude-features all-algorithms --all-targets"
      },
      "step": 4,
      "name": "Run ${{ matrix.kind }} across feature powerset"
    },
    "cwd": "crates/hypertri",
    "command": "cargo hack check --feature-powerset --exclude-features all-algorithms --all-targets",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "CARGO_TERM_COLOR": "always",
      "COMMAND": "cargo hack check --feature-powerset --exclude-features all-algorithms --all-targets"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
