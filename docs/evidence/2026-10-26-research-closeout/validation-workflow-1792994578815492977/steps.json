[
  {
    "id": "pages-build-0-5",
    "origin": {
      "workflow": ".github/workflows/pages.yml",
      "job": "build",
      "matrix": {},
      "step": 5,
      "name": "Build hypercurve UI"
    },
    "cwd": "crates/hypercurve/examples/hypercurve_ui",
    "command": "trunk build index.html --release --dist dist --public-url \"/csgrs/hypercurve/\"",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "TRUNK_COLOR": "never",
      "BASE_PATH": "/csgrs"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  },
  {
    "id": "pages-build-0-6",
    "origin": {
      "workflow": ".github/workflows/pages.yml",
      "job": "build",
      "matrix": {},
      "step": 6,
      "name": "Build hypermesh UI"
    },
    "cwd": "crates/hypermesh/examples/hypermesh_ui",
    "command": "trunk build --release --locked --dist dist --public-url \"/csgrs/hypermesh/\"",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "TRUNK_COLOR": "never",
      "BASE_PATH": "/csgrs"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  },
  {
    "id": "pages-build-0-7",
    "origin": {
      "workflow": ".github/workflows/pages.yml",
      "job": "build",
      "matrix": {},
      "step": 7,
      "name": "Build hypertri UI"
    },
    "cwd": "crates/hypertri/examples/hypertri_ui",
    "command": "trunk build --release --dist dist --public-url \"/csgrs/hypertri/\"",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "TRUNK_COLOR": "never",
      "BASE_PATH": "/csgrs"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  },
  {
    "id": "pages-build-0-8",
    "origin": {
      "workflow": ".github/workflows/pages.yml",
      "job": "build",
      "matrix": {},
      "step": 8,
      "name": "Assemble site"
    },
    "cwd": ".",
    "command": "set -euo pipefail\nmkdir -p site\ncp -r crates/hypercurve/examples/hypercurve_ui/dist site/hypercurve\ncp -r crates/hypermesh/examples/hypermesh_ui/dist site/hypermesh\ncp -r crates/hypertri/examples/hypertri_ui/dist site/hypertri\ncat > site/index.html <<'HTML'\n<!doctype html>\n<meta charset=\"utf-8\">\n<title>csgrs demos</title>\n<h1>csgrs demos</h1>\n<ul>\n  <li><a href=\"hypercurve/\">hypercurve</a></li>\n  <li><a href=\"hypermesh/\">hypermesh</a></li>\n  <li><a href=\"hypertri/\">hypertri</a></li>\n</ul>\nHTML\ntouch site/.nojekyll\n",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "TRUNK_COLOR": "never"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  }
]
