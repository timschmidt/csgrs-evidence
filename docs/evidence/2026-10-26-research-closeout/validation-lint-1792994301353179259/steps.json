[
  {
    "id": "extra-clippy-067",
    "origin": {
      "workflow": ".github/workflows/hypertri.yml",
      "job": "aggregate-configs",
      "matrix": {},
      "step": 8,
      "name": "Check UI feature selection"
    },
    "cwd": "crates/hypertri",
    "command": "cargo clippy --manifest-path examples/hypertri_ui/Cargo.toml -- -D warnings",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "CARGO_TERM_COLOR": "always"
    },
    "target_group": "1.99.1-normal",
    "kind": "strict-clippy",
    "timeout_seconds": 21600
  },
  {
    "id": "extra-clippy-123",
    "origin": {
      "script_internal": true
    },
    "cwd": "crates/hypertri/examples/hypertri_ui",
    "command": "cargo clippy --release --target wasm32-unknown-unknown -- -D warnings",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1"
    },
    "target_group": "1.99.1-normal",
    "kind": "strict-clippy",
    "timeout_seconds": 21600
  }
]
