[
  {
    "id": "hypercurve-quality-0-6",
    "origin": {
      "workflow": ".github/workflows/hypercurve.yml",
      "job": "quality",
      "matrix": {},
      "step": 6,
      "name": "Test WASM demo crate"
    },
    "cwd": "crates/hypercurve/examples/hypercurve_ui",
    "command": "cargo test --locked --no-fail-fast",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  },
  {
    "id": "hypercurve-quality-0-7",
    "origin": {
      "workflow": ".github/workflows/hypercurve.yml",
      "job": "quality",
      "matrix": {},
      "step": 7,
      "name": "Run strict demo Clippy"
    },
    "cwd": "crates/hypercurve/examples/hypercurve_ui",
    "command": "cargo clippy --locked --all-targets -- -D warnings",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  },
  {
    "id": "hypercurve-quality-0-8",
    "origin": {
      "workflow": ".github/workflows/hypercurve.yml",
      "job": "quality",
      "matrix": {},
      "step": 8,
      "name": "Build release WASM demo"
    },
    "cwd": "crates/hypercurve/examples/hypercurve_ui",
    "command": "cargo build --locked --release --target wasm32-unknown-unknown",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  }
]
