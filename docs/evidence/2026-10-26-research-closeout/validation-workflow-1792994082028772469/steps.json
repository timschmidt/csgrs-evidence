[
  {
    "id": "hyperspatial-representations-0-2",
    "origin": {
      "workflow": ".github/workflows/hyperspatial.yml",
      "job": "representations",
      "matrix": {},
      "step": 2,
      "name": "Exercise scalar configurations"
    },
    "cwd": ".",
    "command": "bash crates/hyperspatial/scripts/representation-checks.sh",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "CARGO_TERM_COLOR": "always"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  },
  {
    "id": "hyperspatial-wasm-0-2",
    "origin": {
      "workflow": ".github/workflows/hyperspatial.yml",
      "job": "wasm",
      "matrix": {},
      "step": 2,
      "name": "Check native library on WASM"
    },
    "cwd": ".",
    "command": "cargo check --locked -p hyperspatial --lib --all-features --target wasm32-unknown-unknown",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "CARGO_TERM_COLOR": "always"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  },
  {
    "id": "hyperspatial-wasm-0-3",
    "origin": {
      "workflow": ".github/workflows/hyperspatial.yml",
      "job": "wasm",
      "matrix": {},
      "step": 3,
      "name": "Lint native library on WASM"
    },
    "cwd": ".",
    "command": "cargo clippy --locked -p hyperspatial --lib --all-features --target wasm32-unknown-unknown -- -D warnings",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "CARGO_TERM_COLOR": "always"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  }
]
