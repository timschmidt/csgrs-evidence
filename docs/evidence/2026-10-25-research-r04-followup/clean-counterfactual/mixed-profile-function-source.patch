+        .unwrap();
+        assert_eq!(outcome.certainty, CurveCertainty::Certified);
+        let rewritten = outcome.value;
+        assert_eq!(
+            rewritten.data.normalized_policy(),
+            Some(CurveContext::STRICT)
+        );
+        assert!(Arc::ptr_eq(
+            source.data.certified_loop_roles.as_ref().unwrap(),
+            rewritten.data.certified_loop_roles.as_ref().unwrap(),
+        ));
+        assert_eq!(rewritten.loop_role_counts().unwrap(), (2, 0));
+        assert_eq!(rewritten.filled_area().unwrap(), Some(Real::from(8)));
+        for (before, after) in source
+            .boundary_loops()
+            .iter()
+            .zip(rewritten.boundary_loops())
