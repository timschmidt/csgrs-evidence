+#[test]
+fn loop_image_rewrite_rejects_removed_or_reordered_correspondence() {
+    let source = loop_rewrite_fixture();
+    let boundaries = source.boundary_loops();
+    for replacement in [
+        vec![(0, boundaries[0].clone())],
+        vec![(1, boundaries[1].clone()), (0, boundaries[0].clone())],
+        vec![(0, boundaries[0].clone()), (0, boundaries[1].clone())],
+    ] {
+        assert!(matches!(
+            source.with_rewritten_loop_images(replacement.into_iter(), &CurveContext::STRICT),
+            Err(CurveError::Topology(_))
+        ));
+    }
