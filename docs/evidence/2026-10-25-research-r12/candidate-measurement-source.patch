+#[test]
+fn loop_image_rewrite_keeps_strict_proofs_under_both_policies() {
+    let source = loop_rewrite_fixture();
+    for policy in [
+        CurveContext::STRICT,
+        CurveContext::APPROXIMATE_512,
+        CurveContext::STRICT,
+    ] {
+        let outcome = resolve_certified_operation(&policy, |attempt| {
+            source.with_rewritten_loop_images(
+                source.boundary_loops().to_vec().into_iter().enumerate(),
+                attempt,
+            )
+        })
+        .unwrap();
+        assert_eq!(outcome.certainty, CurveCertainty::Certified);
+        let rewritten = outcome.value;
+        assert_eq!(
+            rewritten.data.normalized_policy(),
+            Some(CurveContext::STRICT)
+        );
+        assert!(Arc::ptr_eq(
+            source.data.certified_loop_roles.as_ref().unwrap(),
+            rewritten.data.certified_loop_roles.as_ref().unwrap(),
+        ));
+        assert_eq!(rewritten.loop_role_counts().unwrap(), (2, 0));
+        assert_eq!(rewritten.filled_area().unwrap(), Some(Real::from(8)));
+        for (before, after) in source
+            .boundary_loops()
+            .iter()
+            .zip(rewritten.boundary_loops())
+        {
+            assert_eq!(before.arrangement_sources(), after.arrangement_sources());
+            assert_eq!(before.fragments(), after.fragments());
+        }
+    }
