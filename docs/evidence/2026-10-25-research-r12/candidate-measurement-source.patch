+fn loop_rewrite_fixture() -> CurveRegion2 {
+    let policy = CurveContext::STRICT;
+    let boundaries = [0, 10]
+        .into_iter()
+        .enumerate()
+        .map(|(loop_index, x)| {
+            let points = [p(x, 0), p(x + 2, 0), p(x + 2, 2), p(x, 2)];
+            let fragments = points
+                .iter()
+                .zip(points.iter().cycle().skip(1))
+                .map(|(start, end)| BezierSplitFragment2::Materialized {
+                    start: BezierParameter2::Exact(Real::zero()),
+                    end: BezierParameter2::Exact(Real::one()),
+                    curve: BezierSubcurve2::Quadratic(QuadraticBezier2::from_line_segment(
+                        LineSeg2::try_new(start.clone(), end.clone()).unwrap(),
+                    )),
+                })
+                .collect();
+            CurveRegionBoundaryLoop2::try_new_from_certified_arrangement_chain(
+                fragments,
+                (0..4)
+                    .map(|index| {
+                        let source = 4 * loop_index + index;
+                        CurveRegionFragmentSource2::new(source, source, index)
+                    })
+                    .collect(),
+                &policy,
+            )
+            .unwrap()
+        })
+        .collect();
+    // Two independently specified, disjoint counterclockwise squares.
+    CurveRegion2::new(boundaries)
+        .unwrap()
+        .with_regularized_filled_left_topology(&policy)
+        .unwrap()
+        .with_certified_all_material_loop_roles(2)
+        .unwrap()
