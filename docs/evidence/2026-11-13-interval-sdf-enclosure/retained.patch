+            [zero(), zero(), zero()],
+            -32,
+            &mut graph(),
+            &mut arithmetic()
+        )
+        .is_err()
+    );
+    assert_eq!(
+        p.image(
+            [zero(), DyadicInterval::empty(), zero()],
+            -32,
+            &mut graph(),
+            &mut arithmetic()
+        )
+        .unwrap()
+        .location(),
+        None
+    );
+    let tangent = program(SdfExpr::x().tan());
+    assert!(
+        tangent
+            .image(
+                [d(1, 2, 0), zero(), zero()],
+                -48,
+                &mut graph(),
+                &mut arithmetic()
+            )
+            .is_err()
+    );
+    let root = program(SdfExpr::x().sqrt());
+    assert!(
+        root.image(
+            [d(0, 1, 0), zero(), zero()],
+            -32,
+            &mut graph(),
+            &mut arithmetic()
+        )
+        .is_ok()
+    );
+    assert!(
+        root.taylor_cell(
+            TaylorRequest {
+                center: vec![d(1, 1, -1), zero(), zero()],
+                domain: vec![d(0, 1, 0), zero(), zero()],
+                order: 1,
+                precision: -32
+            },
+            &mut graph(),
+            &mut arithmetic()
+        )
+        .is_err()
+    );
+    for expr in [
+        SdfExpr::x().abs(),
+        SdfExpr::x().union(SdfExpr::y()),
+        SdfExpr::x().intersection(SdfExpr::y()),
+        SdfExpr::sphere(point(0, 0, 0), Real::one()),
+    ] {
+        assert!(matches!(
+            SdfProgram::compile(Arc::new(Sdf::new(expr)), &mut graph()),
+            Err(SdfProgramError::Unsupported(_))
+        ));
+    }
+}
