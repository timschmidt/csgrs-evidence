+#[test]
+fn nonempty_working_form_preserves_endpoint_authority_and_composition() {
+    assert_eq!(
+        NonEmptyRationalInterval::new(r(2, 1), r(1, 1)),
+        Err(IntervalError::ReversedEndpoints)
+    );
+    assert!(RationalInterval::empty().into_nonempty().is_none());
+    assert!(RationalInterval::empty().translate(&r(1, 1)).is_empty());
+    let x = NonEmptyRationalInterval::new(r(-2, 3), r(5, 7)).unwrap();
+    assert_eq!(x.clone().into_interval().into_nonempty().unwrap(), x);
+    let lo = r(-2, 3);
+    let hi = r(5, 7);
+    let view = NonEmptyRationalIntervalRef::new(&lo, &hi).unwrap();
+    assert_eq!(view.bounds(), (&lo, &hi));
+    assert_eq!(view.to_owned(), x);
+    assert_eq!(
+        NonEmptyRationalIntervalRef::new(&hi, &lo),
+        Err(IntervalError::ReversedEndpoints)
+    );
+    let y = NonEmptyRationalInterval::point(r(-3, 5));
+    let product = x.mul(&y);
+    assert_eq!(product.bounds(), (&r(-3, 7), &r(2, 5)));
+    let translated = product.clone().translate(&r(4, 9));
+    assert_eq!(translated.bounds(), (&r(1, 63), &r(38, 45)));
+    assert_eq!(
+        product.into_interval().translate(&r(4, 9)),
+        translated.clone().into_interval()
+    );
+    assert_eq!(translated.into_bounds(), (r(1, 63), r(38, 45)));
+    assert_eq!(
+        core::mem::size_of::<NonEmptyRationalInterval>(),
+        2 * core::mem::size_of::<Rational>()
+    );
+}
+
+#[test]
+fn horner_stream_preserves_enclosure_and_lazy_failure() {
+    let lower = r(-1, 1);
+    let upper = r(2, 1);
+    let point = NonEmptyRationalIntervalRef::new(&lower, &upper).unwrap();
+    let leading = r(1, 1);
+    let zero = r(0, 1);
+    let result = point
+        .evaluate_polynomial(&leading, [Ok::<_, &str>(&zero), Ok(&zero)])
+        .unwrap();
+    // Horner treats its two occurrences of x independently. Keep this wider
+    // enclosure distinct from the correlated square operation's [0,4].
+    assert_eq!(result.bounds(), (&r(-2, 1), &r(4, 1)));
+    assert_eq!(
+        point
+            .evaluate_polynomial(&leading, [] as [Result<&Rational, &str>; 0])
+            .unwrap(),
+        NonEmptyRationalInterval::point(leading.clone())
+    );
+    let calls = core::cell::Cell::new(0);
+    let coefficients = (0..3).map(|i| {
+        calls.set(calls.get() + 1);
+        if i == 1 {
+            Err("unavailable exact coefficient")
+        } else {
+            Ok(&zero)
+        }
+    });
+    assert_eq!(
+        point.evaluate_polynomial(&leading, coefficients),
+        Err("unavailable exact coefficient")
+    );
+    assert_eq!(calls.get(), 2);
+}
