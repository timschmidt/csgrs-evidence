+/// Validated nonempty working form of [`RationalInterval`].
+///
+/// This is the same exact rational family, with nonemptiness retained in the
+/// type through products and translations. It introduces no second product
+/// kernel or unchecked endpoint constructor. Convert to the general carrier
+/// for operations whose result may be empty, such as intersection.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct NonEmptyRationalInterval {
+    bounds: Bounds<Rational>,
+}
+
+/// Borrowed validated nonempty rational bounds.
+///
+/// Borrowing preserves the endpoint lifetime and exact order without cloning
+/// their shared scalar storage. It carries the same invariant as the owned
+/// working form; its constructor still checks order.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct NonEmptyRationalIntervalRef<'a> {
+    bounds: Bounds<&'a Rational>,
+}
+
+impl<'a> NonEmptyRationalIntervalRef<'a> {
+    /// Checks the order of borrowed endpoints exactly once.
+    #[inline]
+    pub fn new(lower: &'a Rational, upper: &'a Rational) -> Result<Self, IntervalError> {
+        Ok(Self {
+            bounds: Bounds::new(lower, upper)?,
+        })
+    }
+
+    /// Exact borrowed endpoint pair.
+    #[inline]
+    pub fn bounds(self) -> (&'a Rational, &'a Rational) {
+        self.bounds.endpoints()
+    }
+
+    /// Retains owned endpoint storage without a new order comparison.
+    #[inline]
+    pub fn to_owned(self) -> NonEmptyRationalInterval {
+        NonEmptyRationalInterval {
+            bounds: self.bounds.cloned(),
+        }
+    }
+
+    /// Exact product hull through the shared sign-specialized kernel.
+    #[inline]
+    pub fn mul(&self, other: Self) -> NonEmptyRationalInterval {
+        let (a, b) = self.bounds();
+        let (c, d) = other.bounds();
+        let (lower, upper) = product_hull(a, b, c, d);
+        NonEmptyRationalInterval {
+            bounds: Bounds::ordered(lower, upper),
+        }
+    }
+
+    /// Encloses Horner evaluation starting at `leading`, consuming subsequent
+    /// coefficients in descending degree order. An empty tail is a constant.
+    ///
+    /// Coefficients may be borrowed or owned. A failed coefficient is returned
+    /// before the next product; no partial interval is published. This permits
+    /// lazy exact-coefficient admission without collecting or reordering scalar
+    /// work. The finite stream and arbitrary-precision rational operations have
+    /// no implicit work budget. Repeated occurrences of the input are enclosed
+    /// independently, so this is generally wider than the exact polynomial image.
+    #[inline]
+    pub fn evaluate_polynomial<T, E>(
+        self,
+        leading: &Rational,
+        coefficients: impl IntoIterator<Item = Result<T, E>>,
+    ) -> Result<NonEmptyRationalInterval, E>
+    where
+        T: AsRef<Rational>,
+    {
+        let (point_lower, point_upper) = self.bounds();
+        let mut lower = leading.clone();
+        let mut upper = leading.clone();
+        for coefficient in coefficients {
+            let coefficient = coefficient?;
+            let coefficient = coefficient.as_ref();
+            (lower, upper) = product_hull(&lower, &upper, point_lower, point_upper);
+            lower = lower + coefficient;
+            upper = upper + coefficient;
+        }
+        Ok(NonEmptyRationalInterval {
+            bounds: Bounds::ordered(lower, upper),
+        })
+    }
+}
+
+impl NonEmptyRationalInterval {
+    /// Checks the order of finite exact endpoints once.
+    #[inline]
+    pub fn new(lower: Rational, upper: Rational) -> Result<Self, IntervalError> {
+        Ok(Self {
+            bounds: Bounds::new(lower, upper)?,
+        })
+    }
+
+    /// A singleton, with nonemptiness known by construction.
+    #[inline]
+    pub fn point(value: Rational) -> Self {
+        Self {
+            bounds: Bounds::point(value),
+        }
+    }
+
+    /// Borrowed exact endpoints.
+    #[inline]
+    pub fn bounds(&self) -> (&Rational, &Rational) {
+        self.bounds.as_refs().endpoints()
+    }
+
+    /// Borrows this already validated working form without comparisons.
+    #[inline]
+    pub fn borrowed(&self) -> NonEmptyRationalIntervalRef<'_> {
+        NonEmptyRationalIntervalRef {
+            bounds: self.bounds.as_refs(),
+        }
+    }
+
+    /// Consumes the working form without cloning either endpoint.
+    #[inline]
+    pub fn into_bounds(self) -> (Rational, Rational) {
+        self.bounds.endpoints()
+    }
+
+    /// Lossless conversion to the general carrier, without comparison.
+    #[inline]
+    pub fn into_interval(self) -> RationalInterval {
+        RationalInterval {
+            bounds: Some(self.bounds),
+        }
+    }
+
+    /// Exact product hull, using the same sign-specialized rational kernel.
+    #[inline]
+    pub fn mul(&self, other: &Self) -> Self {
+        self.borrowed().mul(other.borrowed())
+    }
+
+    /// Exact translation by a rational scalar, preserving nonemptiness.
+    #[inline]
+    pub fn translate(self, offset: &Rational) -> Self {
+        let (a, b) = self.into_bounds();
+        Self {
+            bounds: translated_bounds(a, b, offset),
+        }
+    }
+}
+
+#[inline]
+fn translated_bounds<'a, T: core::ops::Add<&'a Rational, Output = Rational>>(
+    lower: T,
+    upper: T,
+    offset: &'a Rational,
+) -> Bounds<Rational> {
+    Bounds::ordered(lower + offset, upper + offset)
+}
