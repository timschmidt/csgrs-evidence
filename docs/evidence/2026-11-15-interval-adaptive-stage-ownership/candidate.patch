+#[test]
+fn complete_coefficient_association_is_shared_by_restriction() {
+    let high = field::<1>(&[Expr::anonymous_symbol(X)], &[X])
+        .flow_taylor(4, &mut budget())
+        .unwrap();
+    println!(
+        "STAGE_BYTES n0={} n1={} n2={} n64={}",
+        std::mem::size_of::<hyperdynamics::field::taylor_flow::FlowTaylorStage<0>>(),
+        std::mem::size_of::<hyperdynamics::field::taylor_flow::FlowTaylorStage<1>>(),
+        std::mem::size_of::<hyperdynamics::field::taylor_flow::FlowTaylorStage<2>>(),
+        std::mem::size_of::<hyperdynamics::field::taylor_flow::FlowTaylorStage<64>>()
+    );
+    let restricted = high.restrict_order(2, &mut budget()).unwrap();
+    for (original, selected) in high.stages().iter().zip(restricted.stages()).skip(1) {
+        assert!(
+            std::ptr::eq(
+                original.derivatives().unwrap(),
+                selected.derivatives().unwrap()
+            ),
+            "immutable coefficient association was copied instead of shared"
+        );
+    }
+}
