+            ])
+            .unwrap();
+            assert_eq!(f.widest_axis(&mut ()).unwrap(), Some(1));
+            std::hint::black_box(f.widths(&mut ()).unwrap());
+            let f = IntervalVector::new([
+                F32Enclosure::new(f32::from_bits(2), 1.).unwrap(),
+                F32Enclosure::new(f32::from_bits(1), 1.).unwrap(),
