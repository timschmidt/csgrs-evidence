+    let profile = region(&[rectangle(&int(-2), &int(0), &int(-1), &int(1))], &[], false);
+    let start = int(37);
+    let theta = (start.clone() * Real::pi() / int(180)).unwrap();
+    let vertex = Point3::new(
+        int(-2) * theta.clone().cos(),
+        Real::zero(),
