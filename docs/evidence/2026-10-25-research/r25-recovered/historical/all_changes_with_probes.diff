+// TEMPORARY H13 PROBE (not for commit).
+pub(crate) mod h13_probe {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    pub(crate) static SIGN_NS: AtomicU64 = AtomicU64::new(0);
+    pub(crate) static EXPANSION_NS: AtomicU64 = AtomicU64::new(0);
+    pub(crate) static TWO_ROOT_EXPANSION_NS: AtomicU64 = AtomicU64::new(0);
+    static LAST_REPORT_NS: AtomicU64 = AtomicU64::new(0);
+    pub(crate) fn add(counter: &AtomicU64, start: std::time::Instant) {
+        counter.fetch_add(start.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    }
+    pub(crate) fn report() {
+        if std::env::var_os("HYPERSOLVE_PROBE_H13").is_none() {
+            return;
+        }
+        let sign = SIGN_NS.load(Ordering::Relaxed);
+        let expansion = EXPANSION_NS.load(Ordering::Relaxed);
+        let two = TWO_ROOT_EXPANSION_NS.load(Ordering::Relaxed);
+        let total = sign + expansion + two;
+        let last = LAST_REPORT_NS.load(Ordering::Relaxed);
+        if total.saturating_sub(last) < 5_000_000_000 {
+            return;
+        }
+        LAST_REPORT_NS.store(total, Ordering::Relaxed);
+        eprintln!(
+            "H13PROBE cumulative: leaf signs {:.1} s, one-radical magnitude expansion {:.1} s, two-radical norm expansion {:.1} s",
+            sign as f64 * 1e-9,
+            expansion as f64 * 1e-9,
+            two as f64 * 1e-9
+        );
+    }
