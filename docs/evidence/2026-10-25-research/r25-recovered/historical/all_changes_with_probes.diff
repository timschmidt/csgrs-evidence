+// TEMPORARY H14 PROBE (not for commit).
+fn h14_value_size(value: &RecursiveQuadraticValue) -> (usize, u64, u64) {
+    use hypersolve::recursive_quadratic_field::RecursiveQuadraticValueData;
+    match value.data.as_ref() {
+        RecursiveQuadraticValueData::Base { expression, .. } => {
+            let mut terms = 0;
+            let mut max_bits = 0;
+            let mut total_bits = 0;
+            for polynomial in [
+                &expression.rational,
+                &expression.first,
+                &expression.second,
+                &expression.product,
+            ] {
+                for coefficient in polynomial.coefficients() {
+                    let bits = coefficient.exact_rational_ref().map_or(1_000_000, |r| {
+                        r.numerator().bits() + r.denominator().bits()
+                    });
+                    if bits > 1 {
+                        terms += 1;
+                    }
+                    max_bits = max_bits.max(bits);
+                    total_bits += bits;
+                }
+            }
+            (terms, max_bits, total_bits)
+        }
+        RecursiveQuadraticValueData::Extension {
+            retained, radical, ..
+        } => {
+            let a = h14_value_size(retained);
+            let b = h14_value_size(radical);
+            (a.0 + b.0, a.1.max(b.1), a.2 + b.2)
+        }
+    }
+}
+
+fn h14_probe_report(
+    elapsed: std::time::Duration,
+    field: &RecursiveQuadraticField,
+    defining: &[RecursiveQuadraticValue],
+    query: &[RecursiveQuadraticValue],
+    remainder: Option<&[RecursiveQuadraticValue]>,
+) {
+    if elapsed.as_millis() < 200 {
+        return;
+    }
+    let (base, extensions) = field.base_and_extension_path();
+    let sources: Vec<usize> = base
+        .sources
+        .iter()
+        .map(|s| s.polynomial_coefficients.len().saturating_sub(1))
+        .collect();
+    let speeds = (
+        base.first_speed_squared.dimensions().to_vec(),
+        base.second_speed_squared.dimensions().to_vec(),
+    );
+    let sizes = |values: &[RecursiveQuadraticValue]| -> (usize, u64, u64) {
+        values.iter().map(h14_value_size).fold((0, 0, 0), |a, b| {
+            (a.0 + b.0, a.1.max(b.1), a.2 + b.2)
+        })
+    };
+    let rem_zero = remainder.map(|r| r.iter().all(|c| c.is_structurally_zero()));
+    eprintln!(
+        "H14PROBE remainder {:?}: defining deg {} size {:?}; query deg {} size {:?}; sources {:?}; speeds {:?}; extensions {}; remainder size {:?} structurally zero {:?}",
+        elapsed,
+        defining.len() - 1,
+        sizes(defining),
+        query.len() - 1,
+        sizes(query),
+        sources,
+        speeds,
+        extensions.len(),
+        remainder.map(sizes),
+        rem_zero
+    );
+}
