+
+#[test]
+fn binding_shifts_preserve_generation_and_model_fallback() {
+    let mut context = EvaluationContext::default();
+    context.bind(SymbolId(0), Real::from(3));
+    let generation = context.generation();
+    context.shift_binding(SymbolId(0), &Real::one(), &Real::from(2));
+    assert_eq!(context.bindings()[&SymbolId(0)], Real::from(5));
+    assert_eq!(context.generation(), generation + 1);
+    context.shift_binding(SymbolId(1), &Real::from(7), &Real::from(-2));
+    assert_eq!(context.bindings()[&SymbolId(1)], Real::from(5));
+    assert_eq!(context.generation(), generation + 2);
+    assert_eq!(context.bindings().len(), 2);
+}
