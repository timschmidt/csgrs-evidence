diff --git a/crates/hypersolve/src/eval.rs b/crates/hypersolve/src/eval.rs
index 68e0a7241..1e7690584 100644
--- a/crates/hypersolve/src/eval.rs
+++ b/crates/hypersolve/src/eval.rs
@@ -17,6 +17,17 @@ impl EvaluationContext {
         self.generation += 1;
     }
 
+    /// Shift an existing binding, using the model value only when it is absent.
+    /// Finite differences use one map lookup for the read and replacement.
+    pub(crate) fn shift_binding(&mut self, symbol: SymbolId, model_value: &Real, step: &Real) {
+        let value = self
+            .bindings
+            .entry(symbol)
+            .or_insert_with(|| model_value.clone());
+        *value = value.clone() + step.clone();
+        self.generation += 1;
+    }
+
     pub fn generation(&self) -> u64 {
         self.generation
     }
