+#[cfg(feature = "dyadic")]
+#[test]
+fn prepared_support_saves_shared_work_and_failed_queries_retry() {
+    use hyperlattice_interval::IntervalLatticeError;
+    use hyperlattice_interval::hyperinterval::{DyadicBudget, DyadicInterval, IntervalError};
+    let zero = DyadicInterval::point(0.into(), 0).unwrap();
+    let one = DyadicInterval::point(1.into(), 0).unwrap();
+    let matrix = IntervalMatrix::new([core::array::from_fn::<_, 8, _>(|i| {
+        if i == 0 { one.clone() } else { zero.clone() }
+    })])
+    .unwrap();
+    let vector = IntervalVector::new(core::array::from_fn(|_| {
+        DyadicInterval::new(1234567.into(), 7654321.into(), -10).unwrap()
+    }))
+    .unwrap();
+    let mut ordinary = DyadicBudget::new(256, 10_000_000);
+    let expected = matrix.mul_vector(&vector, &mut ordinary).unwrap();
+    let prepared = matrix.prepare();
+    let mut native = DyadicBudget::new(256, 10_000_000);
+    assert_eq!(prepared.mul_vector(&vector, &mut native).unwrap(), expected);
+    let work = 10_000_000 - native.remaining_work();
+    assert!(native.remaining_work() > ordinary.remaining_work());
+    assert_eq!(
+        prepared
+            .mul_vector(&vector, &mut DyadicBudget::new(256, work))
+            .unwrap(),
+        expected
+    );
+    assert_eq!(
+        matrix.mul_vector(&vector, &mut DyadicBudget::new(256, work)),
+        Err(IntervalLatticeError::Scalar(IntervalError::WorkExhausted))
+    );
+    assert_eq!(
+        prepared.mul_vector(&vector, &mut DyadicBudget::new(256, work - 1)),
+        Err(IntervalLatticeError::Scalar(IntervalError::WorkExhausted))
+    );
+    assert_eq!(
+        prepared.mul_vector(&vector, &mut DyadicBudget::new(0, 10_000_000)),
+        Err(IntervalLatticeError::Scalar(IntervalError::SizeExhausted))
+    );
+    assert_eq!(
+        prepared
+            .mul_vector(&vector, &mut DyadicBudget::new(256, work))
+            .unwrap(),
+        expected
+    );
+    assert_eq!(matrix.prepare().zero_entries(), prepared.zero_entries());
+    // A zero-only row is an exact proof, not a failed or partial product.
+    let zeros = IntervalMatrix::new([[zero; 1]]).unwrap();
+    let vector = IntervalVector::new([one]).unwrap();
+    assert_eq!(
+        zeros
+            .prepare()
+            .mul_vector(&vector, &mut DyadicBudget::new(0, 0))
+            .unwrap()
+            .lanes()
+            .unwrap()[0]
+            .signs(),
+        hyperlattice_interval::hyperinterval::SignSet::Zero
+    );
+}
+
+#[cfg(feature = "fixed")]
+#[test]
+fn prepared_nonzero_overflow_and_empty_operands_stay_explicit() {
+    use hyperlattice_interval::IntervalLatticeError;
+    use hyperlattice_interval::hyperinterval::{FixedInterval, IntervalError};
+    type I = FixedInterval<i32, 0>;
+    let matrix =
+        IntervalMatrix::new([[I::point(0).unwrap(), I::point(i32::MAX).unwrap()]]).unwrap();
+    let vector = IntervalVector::new([I::point(i32::MAX).unwrap(), I::point(2).unwrap()]).unwrap();
+    assert_eq!(
+        matrix.prepare().mul_vector(&vector, &mut ()),
+        Err(IntervalLatticeError::Scalar(IntervalError::Overflow))
+    );
+    assert_eq!(
+        matrix.prepare().mul_vector(&vector, &mut ()),
+        matrix.mul_vector(&vector, &mut ())
+    );
+    assert!(
+        matrix
+            .prepare()
+            .mul_vector(&IntervalVector::empty().unwrap(), &mut ())
+            .unwrap()
+            .is_empty()
+    );
+    assert!(
+        matrix
+            .prepare()
+            .mul_matrix(&IntervalMatrix::<I, 2, 3>::empty().unwrap(), &mut ())
+            .unwrap()
+            .is_empty()
+    );
+}
