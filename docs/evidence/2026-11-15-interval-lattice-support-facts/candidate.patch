+fn prepared_products<I: IntervalArithmetic + core::fmt::Debug + PartialEq>(
+    scalar: impl Fn(i32, i32) -> I,
+    mut context: impl FnMut() -> I::Context,
+) {
+    let mut seed = 0x1234_87ab_c992_u64;
+    for case in 0..512 {
+        let mut range = || {
+            seed ^= seed << 13;
+            seed ^= seed >> 7;
+            seed ^= seed << 17;
+            if seed % 3 == 0 {
+                (0, 0)
+            } else {
+                let a = (seed % 7) as i32 - 3;
+                (a, a + ((seed >> 16) % 4) as i32)
+            }
+        };
+        let aa: [[(i32, i32); 3]; 2] = core::array::from_fn(|_| core::array::from_fn(|_| range()));
+        let bb: [[(i32, i32); 2]; 3] = core::array::from_fn(|_| core::array::from_fn(|_| range()));
+        let a = IntervalMatrix::new(aa.map(|row| row.map(|(a, b)| scalar(a, b)))).unwrap();
+        let b = IntervalMatrix::new(bb.map(|row| row.map(|(a, b)| scalar(a, b)))).unwrap();
+        let prepared = a.prepare();
+        assert!(std::ptr::eq(prepared.source(), &a));
+        assert_eq!(
+            prepared.zero_entries(),
+            Some(&aa.map(|row| row.map(|pair| pair == (0, 0))))
+        );
+        let expected = IntervalMatrix::new(core::array::from_fn(|r| {
+            core::array::from_fn(|k| {
+                let col = bb.map(|row| row[k]);
+                let (lo, hi) = dot_bounds(&aa[r], &col);
+                scalar(lo, hi)
+            })
+        }))
+        .unwrap();
+        let actual = prepared.mul_matrix(&b, &mut context()).unwrap();
+        assert_eq!(actual, expected, "case {case}");
+        assert_eq!(actual, a.mul_matrix(&b, &mut context()).unwrap());
+        assert_eq!(
+            prepared.clone().mul_matrix(&b, &mut context()).unwrap(),
+            actual
+        );
+        for column in 0..2 {
+            let v = b.column(column, &mut context()).unwrap();
+            let actual = prepared.mul_vector(&v, &mut context()).unwrap();
+            assert_eq!(actual, expected.column(column, &mut context()).unwrap());
+            assert_eq!(actual, a.mul_vector(&v, &mut context()).unwrap());
+            // Generated output remains an ordinary operand, including after
+            // preparing a separately rebuilt source with the same values.
+            let next =
+                IntervalMatrix::new([[scalar(1, 1), scalar(0, 0)], [scalar(0, 0), scalar(-1, -1)]])
+                    .unwrap();
+            assert_eq!(
+                next.prepare().mul_vector(&actual, &mut context()).unwrap(),
+                next.mul_vector(&actual, &mut context()).unwrap()
+            );
+        }
+    }
+    let unit = IntervalMatrix::<I, 2, 0>::new([[], []]).unwrap();
+    let unit_vector = IntervalVector::<I, 0>::new([]).unwrap();
+    assert_eq!(unit.prepare().zero_entries(), Some(&[[], []]));
+    assert_eq!(
+        unit.prepare()
+            .mul_vector(&unit_vector, &mut context())
+            .unwrap()
+            .lanes(),
+        Some(&[scalar(0, 0), scalar(0, 0)])
+    );
+    let zero_rows = IntervalMatrix::<I, 0, 2>::new([]).unwrap();
+    let vector = IntervalVector::new([scalar(1, 1), scalar(2, 2)]).unwrap();
+    assert_eq!(
+        zero_rows
+            .prepare()
+            .mul_vector(&vector, &mut context())
+            .unwrap()
+            .lanes(),
+        Some(&[])
+    );
+    let empty = IntervalMatrix::<I, 2, 2>::empty().unwrap();
+    assert!(empty.prepare().zero_entries().is_none());
+    assert!(
+        empty
+            .prepare()
+            .mul_vector(&vector, &mut context())
+            .unwrap()
+            .is_empty()
+    );
+    assert!(
+        empty
+            .prepare()
+            .mul_matrix(&empty, &mut context())
+            .unwrap()
+            .is_empty()
+    );
+    assert!(
+        unit.prepare()
+            .mul_vector(&IntervalVector::empty().unwrap(), &mut context())
+            .unwrap()
+            .is_empty()
+    );
+}
