+    // keeps addition's early offset check before comparing symbolic bases.
+    pub(crate) fn rational_affine_difference(
+        &self,
+        other: &Self,
+        zero_only: bool,
+    ) -> Option<Rational> {
+        let left_parts = self.rational_offset_parts(&mut 8);
+        let right_parts = other.rational_offset_parts(&mut 8);
+        let (left, left_scale, left_offset, right, right_scale, right_offset) =
+            match (left_parts, right_parts) {
+                (Some((left, scale, offset)), Some((right, other_scale, other_offset))) => {
+                    (left, scale, offset, right, other_scale, other_offset)
+                }
+                (Some((base, scale, offset)), None) => (
+                    base,
+                    scale,
+                    offset,
+                    other,
+                    Rational::one(),
+                    Rational::zero(),
+                ),
+                (None, Some((base, scale, offset))) => {
+                    (self, Rational::one(), Rational::zero(), base, scale, offset)
+                }
+                (None, None) => return None,
+            };
+        if zero_only && left_offset != right_offset {
+            return None;
+        }
+        let same_term = if left_scale == right_scale {
+            Self::internal_structural_eq(left, right)
+        } else {
+            Self::internal_structural_eq(
+                &left.clone().multiply_rational(left_scale),
+                &right.clone().multiply_rational(right_scale),
+            )
+        };
+        same_term.then(|| left_offset - right_offset)
+    }
