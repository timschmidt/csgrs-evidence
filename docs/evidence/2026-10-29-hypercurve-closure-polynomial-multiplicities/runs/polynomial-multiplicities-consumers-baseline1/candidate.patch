diff --git a/crates/hypersolve/src/bivariate_topology/multiplicity.rs b/crates/hypersolve/src/bivariate_topology/multiplicity.rs
new file mode 100644
index 0000000000..c25c897223
--- /dev/null
+++ b/crates/hypersolve/src/bivariate_topology/multiplicity.rs
@@ -0,0 +1,314 @@
+//! Checked square-free factors for a previously repeated finite-fiber source.
+use super::*;
+use crate::bivariate_arithmetic::{
+    bivariate_multiply, bivariate_outer_product, bivariate_storage_bidegree_sum,
+};
+use crate::bivariate_components::rational_parameter_component_support;
+use crate::curve_resultant::{
+    BivariatePolynomialAxisFactorStatus, BivariatePolynomialComponentStatus,
+    extract_bivariate_polynomial_system_axis_factors,
+    parameter_component_bivariate_polynomial_system,
+};
+use std::sync::Arc;
+
+/// A product of distinct irreducible factors with one defining exponent.
+///
+/// This exponent is not a local contact or intersection multiplicity. Different
+/// branches can belong to the same factor, and singular points need their own
+/// incidence analysis. Factors need not be irreducible individually.
+#[derive(Clone, Debug, PartialEq)]
+pub struct BivariateMultiplicityFactor {
+    equation: Arc<BivariatePolynomial>,
+    exponent: usize,
+}
+
+impl BivariateMultiplicityFactor {
+    /// Exact supporting polynomial for this multiplicity group.
+    pub fn equation(&self) -> &BivariatePolynomial {
+        &self.equation
+    }
+
+    /// Exponent in the original defining polynomial.
+    pub const fn exponent(&self) -> usize {
+        self.exponent
+    }
+}
+
+/// Exact factorization retained when generic repeated fibers need reduction.
+///
+/// The original polynomial equals `scale * product(factor^exponent)`. The
+/// support has one copy of each factor. This checked live value is reconstructed
+/// from the original polynomial on replay; serialized flags are not proof.
+#[derive(Clone, Debug, PartialEq)]
+pub struct BivariateRepeatedFactorization {
+    support: Arc<BivariatePolynomial>,
+    scale: Real,
+    factors: Vec<BivariateMultiplicityFactor>,
+}
+
+impl BivariateRepeatedFactorization {
+    /// Square-free support of the original zero set.
+    pub fn support(&self) -> &BivariatePolynomial {
+        &self.support
+    }
+
+    /// Nonzero rational scalar in the exact reconstruction identity.
+    pub const fn scale(&self) -> &Real {
+        &self.scale
+    }
+
+    /// Coprime square-free factors, grouped by increasing positive exponent.
+    pub fn factors(&self) -> &[BivariateMultiplicityFactor] {
+        &self.factors
+    }
+}
+
+type Result<T> = std::result::Result<T, BivariateTopologyError>;
+
+fn canonical(polynomial: &BivariatePolynomial) -> Result<BivariatePolynomial> {
+    let mut rows = polynomial
+        .coefficients
+        .iter()
+        .map(|row| {
+            let mut row = row
+                .iter()
+                .map(|value| {
+                    value
+                        .exact_rational_normal_form()
+                        .map(Real::new)
+                        .ok_or(BivariateTopologyError::Undecided)
+                })
+                .collect::<Result<Vec<_>>>()?;
+            while row.last().is_some_and(Real::definitely_zero) {
+                row.pop();
+            }
+            Ok(row)
+        })
+        .collect::<Result<Vec<_>>>()?;
+    while rows.last().is_some_and(Vec::is_empty) {
+        rows.pop();
+    }
+    Ok(BivariatePolynomial::new(rows))
+}
+
+fn one() -> BivariatePolynomial {
+    BivariatePolynomial::new(vec![vec![Real::one()]])
+}
+
+fn constant(polynomial: &BivariatePolynomial) -> bool {
+    polynomial.coefficients.len() <= 1
+        && polynomial
+            .coefficients
+            .first()
+            .is_none_or(|row| row.len() <= 1)
+}
+
+fn monic(polynomial: &BivariatePolynomial) -> Result<BivariatePolynomial> {
+    let mut polynomial = canonical(polynomial)?;
+    let Some(leading) = polynomial
+        .coefficients
+        .last()
+        .and_then(|row| row.last())
+        .cloned()
+    else {
+        return Ok(polynomial);
+    };
+    let inverse = (Real::one() / leading).map_err(|_| BivariateTopologyError::Undecided)?;
+    for coefficient in polynomial.coefficients.iter_mut().flatten() {
+        *coefficient *= &inverse;
+    }
+    canonical(&polynomial)
+}
+
+fn quotient(
+    first: &BivariatePolynomial,
+    second: &BivariatePolynomial,
+) -> Result<BivariatePolynomial> {
+    crate::divide_bivariate_polynomial_exact(first, second)
+        .ok_or(BivariateTopologyError::Undecided)
+        .and_then(|result| canonical(&result))
+}
+
+fn product(
+    first: &BivariatePolynomial,
+    second: &BivariatePolynomial,
+) -> Result<BivariatePolynomial> {
+    canonical(&bivariate_multiply(first, second))
+}
+
+fn gcd(
+    first: &BivariatePolynomial,
+    second: &BivariatePolynomial,
+    config: BivariateTopologyConfig,
+) -> Result<BivariatePolynomial> {
+    work_budget::consume(WorkKind::AlgebraicPromotion, 1)
+        .map_err(|_| BivariateTopologyError::BudgetExhausted)?;
+    let mut pair = [monic(first)?, monic(second)?];
+    if pair[0].coefficients.is_empty() {
+        return Ok(pair[1].clone());
+    }
+    if pair[1].coefficients.is_empty() {
+        return Ok(pair[0].clone());
+    }
+    if constant(&pair[0]) || constant(&pair[1]) {
+        return Ok(one());
+    }
+    for (dividend, divisor) in [(0, 1), (1, 0)] {
+        if crate::divide_bivariate_polynomial_exact(&pair[dividend], &pair[divisor]).is_some() {
+            return Ok(pair[divisor].clone());
+        }
+    }
+    let mut common = one();
+    let bounded = CurveIntersectionResultantConfig {
+        max_resultant_degree: config.max_projection_degree,
+        ..Default::default()
+    };
+    loop {
+        let axes = extract_bivariate_polynomial_system_axis_factors(&pair[0], &pair[1]);
+        match axes.status {
+            BivariatePolynomialAxisFactorStatus::Primitive => {}
+            BivariatePolynomialAxisFactorStatus::Reduced => {
+                let factor = bivariate_outer_product(
+                    &axes.first_parameter_factor,
+                    &axes.second_parameter_factor,
+                );
+                // Recheck the reported factor by exact division. Its entire
+                // zero set stays in the accumulated gcd, including axis fibers.
+                pair = [quotient(&pair[0], &factor)?, quotient(&pair[1], &factor)?];
+                common = product(&common, &factor)?;
+            }
+            BivariatePolynomialAxisFactorStatus::BudgetExhausted => {
+                return Err(BivariateTopologyError::BudgetExhausted);
+            }
+            _ => return Err(BivariateTopologyError::Undecided),
+        }
+        if pair
+            .iter()
+            .any(|p| p.coefficients.iter().all(|row| row.len() <= 1))
+        {
+            // Any common factor of a first-axis polynomial was covered by the
+            // exact axis-content gcd. No generic lifted factor can remain.
+            return monic(&common);
+        }
+        let resultant = resultant_bivariate_polynomial_system(&pair[0], &pair[1], FIRST, bounded);
+        match resultant.status {
+            CurveIntersectionResultantStatus::Constructed => {}
+            CurveIntersectionResultantStatus::BudgetExhausted => {
+                return Err(BivariateTopologyError::BudgetExhausted);
+            }
+            CurveIntersectionResultantStatus::DegreeBoundExceeded => {
+                return Err(BivariateTopologyError::DegreeLimit);
+            }
+            _ => return Err(BivariateTopologyError::Undecided),
+        }
+        if !is_zero(&resultant.resultant_coefficients) {
+            // A nonzero resultant proves generic coprimality. Common axis
+            // factors were already retained above, so the full gcd is known.
+            return monic(&common);
+        }
+        let report =
+            parameter_component_bivariate_polynomial_system(&pair[0], &pair[1], FIRST, bounded);
+        let component = match report.status {
+            BivariatePolynomialComponentStatus::Rational => rational_parameter_component_support(
+                FIRST,
+                &report.numerator_coefficients,
+                &report.denominator_coefficients,
+            ),
+            BivariatePolynomialComponentStatus::Implicit => report.implicit_component,
+            BivariatePolynomialComponentStatus::BudgetExhausted => {
+                return Err(BivariateTopologyError::BudgetExhausted);
+            }
+            BivariatePolynomialComponentStatus::DegreeBoundExceeded => {
+                return Err(BivariateTopologyError::DegreeLimit);
+            }
+            _ => return Err(BivariateTopologyError::Undecided),
+        }
+        .ok_or(BivariateTopologyError::Undecided)?;
+        let next = [
+            quotient(&pair[0], &component)?,
+            quotient(&pair[1], &component)?,
+        ];
+        if next
+            .iter()
+            .map(bivariate_storage_bidegree_sum)
+            .sum::<usize>()
+            >= pair
+                .iter()
+                .map(bivariate_storage_bidegree_sum)
+                .sum::<usize>()
+        {
+            return Err(BivariateTopologyError::Undecided);
+        }
+        common = product(&common, &component)?;
+        pair = next;
+    }
+}
+
+pub(super) fn factor(
+    original: &BivariatePolynomial,
+    config: BivariateTopologyConfig,
+) -> Result<BivariateRepeatedFactorization> {
+    let canonical_original = canonical(original)?;
+    let scale = canonical_original
+        .coefficients
+        .last()
+        .and_then(|row| row.last())
+        .cloned()
+        .ok_or(BivariateTopologyError::ZeroPolynomial)?;
+    let normalized = monic(original)?;
+    let dx = bivariate_parameter_derivative(&normalized, FIRST);
+    let dy = bivariate_parameter_derivative(&normalized, CurveResultantParameter::Second);
+    let mut repeated = gcd(&gcd(&normalized, &dy, config)?, &dx, config)?;
+    let mut remaining = quotient(&normalized, &repeated)?;
+    let mut exponent = 1_usize;
+    let mut factors = Vec::new();
+    while !constant(&remaining) {
+        let common = gcd(&remaining, &repeated, config)?;
+        let factor = quotient(&remaining, &common)?;
+        if !constant(&factor) {
+            factors.push(BivariateMultiplicityFactor {
+                equation: Arc::new(factor),
+                exponent,
+            });
+        }
+        let next_repeated = quotient(&repeated, &common)?;
+        if bivariate_storage_bidegree_sum(&common) + bivariate_storage_bidegree_sum(&next_repeated)
+            >= bivariate_storage_bidegree_sum(&remaining)
+                + bivariate_storage_bidegree_sum(&repeated)
+        {
+            return Err(BivariateTopologyError::Undecided);
+        }
+        remaining = common;
+        repeated = next_repeated;
+        exponent = exponent
+            .checked_add(1)
+            .ok_or(BivariateTopologyError::DegreeLimit)?;
+    }
+    if !constant(&repeated) || factors.is_empty() {
+        return Err(BivariateTopologyError::Undecided);
+    }
+    let mut rebuilt = BivariatePolynomial::new(vec![vec![scale.clone()]]);
+    let mut support = one();
+    for factor in &factors {
+        support = product(&support, factor.equation())?;
+        for _ in 0..factor.exponent {
+            rebuilt = product(&rebuilt, factor.equation())?;
+        }
+    }
+    if canonical(&rebuilt)? != canonical_original
+        || bivariate_storage_bidegree_sum(&support)
+            >= bivariate_storage_bidegree_sum(&canonical_original)
+    {
+        return Err(BivariateTopologyError::Undecided);
+    }
+    let support = if factors.len() == 1 {
+        Arc::clone(&factors[0].equation)
+    } else {
+        Arc::new(support)
+    };
+    Ok(BivariateRepeatedFactorization {
+        support,
+        scale,
+        factors,
+    })
+}
diff --git a/crates/hypersolve/tests/bivariate_multiplicities.rs b/crates/hypersolve/tests/bivariate_multiplicities.rs
new file mode 100644
index 0000000000..016894e9e7
--- /dev/null
+++ b/crates/hypersolve/tests/bivariate_multiplicities.rs
@@ -0,0 +1,276 @@
+//! Repeated defining factors keep their original authority and reduced geometry.
+use hyperlimit::PredicatePolicy;
+use hyperreal::Real;
+use hypersolve::bivariate_arithmetic::{bivariate_multiply, bivariate_specialize_first};
+use hypersolve::bivariate_topology::{
+    BivariateCurveDomain, BivariateCurveTopology, BivariateTopologyConfig,
+    decompose_bivariate_curve,
+};
+use hypersolve::{BivariatePolynomial, UnivariateSturmSequence};
+
+fn polynomial(rows: &[&[i32]]) -> BivariatePolynomial {
+    BivariatePolynomial::new(
+        rows.iter()
+            .map(|row| row.iter().copied().map(Real::from).collect())
+            .collect(),
+    )
+}
+fn power(source: &BivariatePolynomial, exponent: usize) -> BivariatePolynomial {
+    (0..exponent).fold(polynomial(&[&[1]]), |value, _| {
+        bivariate_multiply(&value, source)
+    })
+}
+fn rectangle() -> BivariateCurveDomain {
+    BivariateCurveDomain {
+        first: [(-2).into(), 2.into()],
+        second: [(-2).into(), 2.into()],
+    }
+}
+fn config() -> BivariateTopologyConfig {
+    BivariateTopologyConfig {
+        max_axis_degree: 12,
+        max_projection_degree: 256,
+        ..Default::default()
+    }
+}
+fn build(source: &BivariatePolynomial) -> BivariateCurveTopology {
+    decompose_bivariate_curve(source, &rectangle(), config()).unwrap()
+}
+fn layout(topology: &BivariateCurveTopology) -> (Vec<usize>, Vec<Vec<(usize, usize)>>) {
+    (
+        topology
+            .events()
+            .iter()
+            .map(|event| event.roots().len())
+            .collect(),
+        topology
+            .slabs()
+            .iter()
+            .map(|slab| {
+                slab.arcs()
+                    .iter()
+                    .map(|arc| (arc.left_root(), arc.right_root()))
+                    .collect()
+            })
+            .collect(),
+    )
+}
+
+fn verify_fibers(topology: &BivariateCurveTopology, support: &BivariatePolynomial) {
+    // Independent univariate counts on the known reduced support validate
+    // each reported selector and the complete closed fiber. Original repeated
+    // coefficients and the graph incidence are checked separately.
+    for x in [-2, -1, 0, 1, 2].map(Real::from) {
+        let row = bivariate_specialize_first(support, &x);
+        let sequence = UnivariateSturmSequence::new(&row, PredicatePolicy::STRICT).unwrap();
+        let fiber = topology.rational_fiber(&x, config().fiber).unwrap();
+        let expected = sequence
+            .count_distinct_roots(&Real::from(-2), &Real::from(2), PredicatePolicy::STRICT)
+            .unwrap()
+            + usize::from(Real::eval_poly(&row, &Real::from(-2)).definitely_zero());
+        assert_eq!(fiber.roots().len(), expected);
+        for root in fiber.roots() {
+            if let Some(value) = &root.exact_root {
+                assert!(Real::eval_poly(&row, value).definitely_zero());
+            } else {
+                let count = sequence
+                    .count_distinct_roots(&root.lower, &root.upper, PredicatePolicy::STRICT)
+                    .unwrap()
+                    + usize::from(Real::eval_poly(&row, &root.lower).definitely_zero());
+                assert_eq!(count, 1);
+            }
+        }
+    }
+}
+
+fn assert_polynomial_eq(first: &BivariatePolynomial, second: &BivariatePolynomial) {
+    for i in 0..first.coefficients.len().max(second.coefficients.len()) {
+        let a = first.coefficients.get(i).map_or(&[][..], Vec::as_slice);
+        let b = second.coefficients.get(i).map_or(&[][..], Vec::as_slice);
+        for j in 0..a.len().max(b.len()) {
+            let a = a.get(j).cloned().unwrap_or_else(Real::zero);
+            let b = b.get(j).cloned().unwrap_or_else(Real::zero);
+            assert!((a - b).definitely_zero());
+        }
+    }
+}
+
+fn verify_factors(topology: &BivariateCurveTopology, expected: &[(&BivariatePolynomial, usize)]) {
+    let evidence = topology.repeated_factorization().unwrap();
+    assert_eq!(evidence.factors().len(), expected.len());
+    let mut rebuilt = BivariatePolynomial::new(vec![vec![evidence.scale().clone()]]);
+    let mut support = polynomial(&[&[1]]);
+    for (factor, &(known, exponent)) in evidence.factors().iter().zip(expected) {
+        assert_eq!(factor.exponent(), exponent);
+        // Normalize the independent expected factor in the same lexicographic
+        // order, without invoking the factor-discovery or gcd implementation.
+        let leading = known
+            .coefficients
+            .iter()
+            .rev()
+            .find_map(|r| r.iter().rev().find(|c| !c.definitely_zero()))
+            .unwrap();
+        let normalized = BivariatePolynomial::new(
+            known
+                .coefficients
+                .iter()
+                .map(|row| row.iter().map(|c| (c / leading).unwrap()).collect())
+                .collect(),
+        );
+        assert_polynomial_eq(factor.equation(), &normalized);
+        support = bivariate_multiply(&support, factor.equation());
+        rebuilt = bivariate_multiply(&rebuilt, &power(factor.equation(), exponent));
+    }
+    assert_polynomial_eq(&rebuilt, topology.equation());
+    assert_polynomial_eq(&support, topology.geometric_equation());
+    assert_eq!(topology.geometric_equation(), evidence.support());
+}
+
+fn check_powers(support: BivariatePolynomial) {
+    let control = build(&support);
+    verify_fibers(&control, &support);
+    assert!(control.repeated_factorization().is_none());
+    for exponent in [2, 3] {
+        for scale in [1, -3] {
+            let mut original = power(&support, exponent);
+            for coefficient in original.coefficients.iter_mut().flatten() {
+                *coefficient *= Real::from(scale);
+            }
+            let topology = build(&original);
+            assert_eq!(topology.equation(), &original);
+            verify_factors(&topology, &[(&support, exponent)]);
+            assert_eq!(topology.domain(), &rectangle());
+            assert_eq!(layout(&topology), layout(&control));
+            verify_fibers(&topology, &support);
+        }
+    }
+}
+
+#[test]
+fn repeated_circle_keeps_both_selected_branches() {
+    let circle = polynomial(&[&[-1, 0, 1], &[], &[1]]);
+    let control = build(&circle);
+    assert_eq!(layout(&control).0, vec![0, 1, 1, 0]);
+    assert_eq!(
+        control
+            .slabs()
+            .iter()
+            .map(|s| s.arcs().len())
+            .collect::<Vec<_>>(),
+        vec![0, 2, 0]
+    );
+    check_powers(circle);
+}
+
+#[test]
+fn repeated_parabola_keeps_its_two_sided_critical_fiber() {
+    check_powers(polynomial(&[&[0, 0, 1], &[-1]]));
+}
+
+#[test]
+fn repeated_node_keeps_all_four_incident_half_branches() {
+    let node = polynomial(&[&[0, 0, 1], &[], &[-1]]);
+    let control = build(&node);
+    assert_eq!(layout(&control).0, vec![2, 1, 2]);
+    assert_eq!(
+        control
+            .slabs()
+            .iter()
+            .map(|s| s.arcs().len())
+            .collect::<Vec<_>>(),
+        vec![2, 2]
+    );
+    check_powers(node);
+}
+
+#[test]
+fn repeated_cusp_keeps_its_selected_one_sided_branches() {
+    check_powers(polynomial(&[&[0, 0, 1], &[], &[], &[-1]]));
+}
+
+#[test]
+fn repeated_isolated_point_is_not_an_empty_curve() {
+    let isolated = polynomial(&[&[0, 0, 1], &[], &[1]]);
+    let control = build(&isolated);
+    assert!(!control.is_empty());
+    assert_eq!(layout(&control).0, vec![0, 1, 0]);
+    assert!(control.slabs().iter().all(|slab| slab.arcs().is_empty()));
+    check_powers(isolated);
+}
+
+#[test]
+fn different_factor_multiplicities_keep_the_original_crossings() {
+    let circle = polynomial(&[&[-1, 0, 1], &[], &[1]]);
+    let line = polynomial(&[&[0, 1]]);
+    let support = bivariate_multiply(&circle, &line);
+    let control = build(&support);
+    assert_eq!(layout(&control).0, vec![1, 1, 1, 1]);
+    assert_eq!(
+        control
+            .slabs()
+            .iter()
+            .map(|s| s.arcs().len())
+            .collect::<Vec<_>>(),
+        vec![1, 3, 1]
+    );
+    let original = bivariate_multiply(&power(&circle, 2), &power(&line, 3));
+    let topology = build(&original);
+    assert_eq!(topology.equation(), &original);
+    assert_eq!(layout(&topology), layout(&control));
+    verify_fibers(&topology, &support);
+    verify_factors(&topology, &[(&circle, 2), (&line, 3)]);
+}
+
+#[test]
+fn rootless_axis_factors_keep_their_defining_powers() {
+    let circle = polynomial(&[&[-1, 0, 1], &[], &[1]]);
+    for axis in [polynomial(&[&[1], &[], &[1]]), polynomial(&[&[-3], &[1]])] {
+        let original = bivariate_multiply(&power(&axis, 2), &power(&circle, 3));
+        let support = bivariate_multiply(&axis, &circle);
+        let topology = build(&original);
+        assert_eq!(topology.equation(), &original);
+        verify_factors(&topology, &[(&axis, 2), (&circle, 3)]);
+        assert_eq!(layout(&topology), layout(&build(&support)));
+        verify_fibers(&topology, &support);
+    }
+}
+
+#[test]
+fn repeated_components_preserve_degree_budget_and_retry() {
+    use hypersolve::bivariate_topology::BivariateTopologyError;
+    use hypersolve::work_budget::{WorkBudget, with_budget};
+    let original = power(&polynomial(&[&[-1, 0, 1], &[], &[1]]), 3);
+    for limits in [
+        BivariateTopologyConfig {
+            max_axis_degree: 5,
+            ..config()
+        },
+        BivariateTopologyConfig {
+            max_projection_degree: 2,
+            ..config()
+        },
+    ] {
+        assert_eq!(
+            decompose_bivariate_curve(&original, &rectangle(), limits),
+            Err(BivariateTopologyError::DegreeLimit)
+        );
+    }
+    let denied = with_budget(WorkBudget::ZERO, || {
+        assert_eq!(
+            decompose_bivariate_curve(&original, &rectangle(), config()),
+            Err(BivariateTopologyError::BudgetExhausted)
+        );
+    });
+    assert!(denied.result.is_err());
+    let retry = with_budget(
+        WorkBudget {
+            promotions: 100_000,
+            refinements: 1_000_000,
+        },
+        || build(&original),
+    );
+    let restored = retry.result.unwrap();
+    assert_eq!(restored.equation(), &original);
+    assert_eq!(layout(&restored), layout(&build(&original)));
+    assert!(retry.usage.promotions > 1);
+}
