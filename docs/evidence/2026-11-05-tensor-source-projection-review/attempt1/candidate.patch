diff --git a/crates/hyperbrep/src/geometry/tensor_image.rs b/crates/hyperbrep/src/geometry/tensor_image.rs
index b70e74c8df..ee3cf61e2c 100644
--- a/crates/hyperbrep/src/geometry/tensor_image.rs
+++ b/crates/hyperbrep/src/geometry/tensor_image.rs
@@ -168,6 +168,32 @@ impl Curve3 {
 }
 
 impl TensorCurve3 {
+    /// Projects the retained UV definition without replacing its selected
+    /// coefficient field with independently materialized scalar coordinates.
+    pub(super) fn materialize_plane_projection(
+        &self,
+        origin: &Point3,
+        u: &Vector3,
+        v: &Vector3,
+    ) -> GeometryResult<MaterializedSurfacePcurve> {
+        let SurfaceGeometry::RationalBezier(tensor) = &self.surface.data.geometry else {
+            return Err(GeometryError::UnsupportedPcurveContour);
+        };
+        let plane = PlaneSurface {
+            origin: origin.clone(),
+            u: u.clone(),
+            v: v.clone(),
+        };
+        let (_, projection) = super::plane_tensor::pullback(&plane, tensor)?;
+        let curve = self.source.rational_image(&projection)?;
+        let scale = (Real::one() / &self.source_scale).map_err(GeometryError::Numeric)?;
+        let offset = -&self.source_offset * &scale;
+        Ok(MaterializedSurfacePcurve {
+            curve,
+            correspondence: SurfacePcurveCorrespondence::Affine { scale, offset },
+        })
+    }
+
     pub(super) fn parameter(&self, s: &Real) -> Real {
         &self.source_offset + &self.source_scale * s
     }
