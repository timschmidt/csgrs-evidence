+    // of its defining fiber (1/2,a) gives (a,1/2) on y=x^5+x.
+    let source = curves(polynomial(&[&[0, 1, 0, 0, 0, 1], &[-1]]));
+    let selected = source.curves()[0].point_at(&q(1, 2).into()).unwrap();
+    let swap = hypercurve::Similarity2::try_from_real_affine(
