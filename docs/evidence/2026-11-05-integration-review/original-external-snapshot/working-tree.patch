+fn mapped_selected_line_components_never_become_empty_successes() {
+    let equation = BivariatePolynomial::new(vec![vec![
+        (-1).into(),
+        1.into(),
+        0.into(),
+        0.into(),
+        0.into(),
+        1.into(),
