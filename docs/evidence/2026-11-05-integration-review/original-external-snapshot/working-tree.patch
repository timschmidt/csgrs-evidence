+                Point2::from_values(0, 0),
+                Point2::from_values(0, 2),
+            ],
+            vec![Real::one(); 3],
+        )
+        .unwrap(),
+    );
+    vertical_contact(&branch, &line);
+    vertical_contact(&branch.reversed().unwrap(), &line.reversed().unwrap());
