+        self.data
+            .first
+            .validate_policy(policy)
+            .map_err(field::FieldError::Context)?;
+        self.data
+            .second
+            .validate_policy(policy)
+            .map_err(field::FieldError::Context)?;
+        if hypersolve::work_budget::exhaustion().is_some() {
+            return Err(field::FieldError::Uncertain(
+                UncertaintyReason::BudgetExhausted,
+            ));
+        }
