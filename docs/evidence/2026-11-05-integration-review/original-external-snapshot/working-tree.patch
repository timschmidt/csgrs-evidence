+    let image = set.curves()[0].rational_image(&map).unwrap();
+    // X=x/(3+x), Y=x^2/(3+x), so Y(1-X)=3X^2.
+    assert!(
+        image
+            .polynomial_branch()
+            .unwrap()
+            .certifies_polynomial_zero(&polynomial(&[&[0, 1], &[0, -1], &[-3]]))
