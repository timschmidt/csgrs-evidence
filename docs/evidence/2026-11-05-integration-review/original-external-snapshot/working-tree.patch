+            .unwrap();
+        for reference in [selector, definitions.len(), 0] {
+            let mut forged = raw.clone();
+            forged["selection"]["parameters"][selector]["PointOnChord"]["chord"] =
+                serde_json::json!(reference);
+            let forged = serde_json::to_string(&forged).unwrap();
+            assert!(
