+        Arc::as_ptr(&self.0).cast()
+    }
+}
+
+impl std::ops::Deref for ParallelFidelityConstruction2 {
+    type Target = ParallelFidelityConstructionData2;
+
+    fn deref(&self) -> &Self::Target {
