+            face_id,
+            endpoint,
+            point,
+            intersection,
+            operand,
+        )?;
+        match location {
+            FaceSplitEndpointLocation::Vertex(vertex) => Ok((self.clone(), wire, vertex, None)),
+            FaceSplitEndpointLocation::Edge {
+                edge,
+                parameter,
+                pcurve_split,
+            } => {
