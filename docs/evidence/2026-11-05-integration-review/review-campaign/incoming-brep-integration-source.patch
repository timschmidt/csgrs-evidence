+fn full_circle(center: Point3, x: Vector3, y: Vector3, radius: i64) -> Curve3 {
+    Curve3::circle_arc(
+        center,
+        x,
+        y,
+        radius.into(),
+        Real::zero(),
+        Real::from(2) * Real::pi(),
+    )
