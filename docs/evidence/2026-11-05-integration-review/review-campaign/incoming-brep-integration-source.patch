+/// Arcs of the unit circle in z = 0, in the global frame unless stated:
+/// [0, π] and [π/2, 3π/2] share [π/2, π]; [0, π/2] and [π/2, π] touch at
+/// (0, 1, 0); [0, π/3] and [π/2, π] miss; with the frame rotated by a quarter
+/// turn, its [0, π/2] is the global [π/2, π]; with the y axis flipped, its
+/// [π/2, π] is the global lower quarter [π, 3π/2], touching [0, π] at (-1, 0, 0).
+#[test]
+fn arcs_of_one_circle_return_exact_coincident_ranges() {
+    let x = Vector3::x;
+    let y = Vector3::y;
+    let pi = Real::pi;
+    let half = |r: Real| (r / Real::from(2)).unwrap();
+    let upper = unit_arc(x(), y(), Real::zero(), pi());
+    assert_overlap(
+        upper
+            .intersect_curve(&unit_arc(x(), y(), half(pi()), Real::from(3) * half(pi())))
+            .unwrap(),
+        [half(pi()), pi()],
+        [half(pi()), pi()],
+    );
+    let touching = points(
+        &unit_arc(x(), y(), Real::zero(), half(pi())),
+        &unit_arc(x(), y(), half(pi()), pi()),
+    );
+    assert_eq!(touching.len(), 1);
+    assert!(touching[0].point.coincides_with(&pi_point(0, 1)).unwrap());
+    assert!(matches!(
+        unit_arc(x(), y(), Real::zero(), (pi() / Real::from(3)).unwrap())
+            .intersect_curve(&unit_arc(x(), y(), half(pi()), pi()))
+            .unwrap(),
+        CurveCurveIntersection::None
+    ));
+    let rotated = unit_arc(y(), -x(), Real::zero(), half(pi()));
+    assert_overlap(
+        upper.intersect_curve(&rotated).unwrap(),
+        [half(pi()), pi()],
+        [Real::zero(), half(pi())],
+    );
+    let flipped = unit_arc(x(), -y(), half(pi()), pi());
+    let found = points(&upper, &flipped);
+    assert_eq!(found.len(), 1);
+    assert!(equal(&found[0].first, pi()));
+    assert!(equal(&found[0].second, pi()));
+    assert!(found[0].point.coincides_with(&pi_point(-1, 0)).unwrap());
+    let full = unit_arc(x(), y(), Real::zero(), Real::from(2) * pi());
+    assert_overlap(
+        full.intersect_curve(&unit_arc(x(), y(), half(pi()), pi()))
+            .unwrap(),
+        [half(pi()), pi()],
+        [half(pi()), pi()],
+    );
+}
+
+fn pi_point(x: i64, y: i64) -> GeometricPoint3 {
+    pi(x, y, 0).into()
+}
+
+/// The radius-5 circle in z = 0 and the parabola y = x^2/3 + 1 (controls
+/// (-3,4,0), (0,-2,0), (3,4,0)): substituting gives u^2 + 15u - 216 = 0 for
+/// u = x^2, so they meet only at (±3, 4, 0), the parabola's ends. The
+/// quadratic (2,4,-1), (4,4,0), (2,4,1) pierces z = 0 at (3, 4, 0).
+#[test]
+fn circles_meet_rational_curves_in_and_across_their_plane() {
+    let circle = full_circle(Point3::origin(), Vector3::x(), Vector3::y(), 5);
+    let parabola = Curve3::rational_bezier(
+        vec![pi(-3, 4, 0), pi(0, -2, 0), pi(3, 4, 0)],
+        vec![Real::one(); 3],
+    )
+    .unwrap();
+    let found = points(&circle, &parabola);
+    assert_eq!(found.len(), 2);
+    let ends = found.iter().map(|p| p.second.clone()).collect::<Vec<_>>();
+    assert!(ends.iter().any(|s| equal(s, Real::zero())));
+    assert!(ends.iter().any(|s| equal(s, Real::one())));
+    let swapped = points(&parabola, &circle);
+    assert_eq!(swapped.len(), 2);
+    let piercing = Curve3::rational_bezier(
+        vec![pi(2, 4, -1), pi(4, 4, 0), pi(2, 4, 1)],
+        vec![Real::one(); 3],
+    )
+    .unwrap();
+    let found = points(&circle, &piercing);
+    assert_eq!(found.len(), 1);
+    assert!(equal(&found[0].second, q(1, 2)));
+    assert!(found[0].point.coincides_with(&pi(3, 4, 0).into()).unwrap());
+    // A cubic crossing z = 0 at the selected s = cbrt(1/2) has no scalar
+    // contact point for the arc's angle: a typed refusal, not a guess.
+    let cubic = Curve3::rational_bezier(
+        vec![pi(3, 4, -1), pi(3, 4, -1), pi(3, 4, -1), pi(3, 4, 1)],
+        vec![Real::one(); 4],
+    )
+    .unwrap();
+    assert!(matches!(
+        circle.intersect_curve(&cubic),
+        Err(GeometryError::UnsupportedIntersection)
+    ));
+}
+
+fn whole_ellipse(center: Point3, x: Vector3, y: Vector3, rx: Real, ry: Real) -> Curve3 {
+    Curve3::ellipse_arc(
+        center,
+        x,
+        y,
+        rx,
+        ry,
+        Real::zero(),
+        Real::pi() * Real::from(2),
+    )
+    .unwrap()
+}
+
+/// Concentric aligned conics through (±3, ±4): x^2/(39/5)^2 + y^2/(13/3)^2
+/// = 1 (since 5/13 and 12/13 are a Pythagorean pair), x^2/(51/8)^2 +
+/// y^2/(68/15)^2 = 1 (8/17, 15/17), and the radius-5 circle. Each pair's
+/// equations are linear in (x^2, y^2) with the unique solution (9, 16), so
+/// every pair meets exactly at the four points (±3, ±4, 0).
+#[test]
+fn conic_pairs_meet_at_exact_points() {
+    let first = whole_ellipse(
+        Point3::origin(),
+        Vector3::x(),
+        Vector3::y(),
+        q(39, 5),
+        q(13, 3),
+    );
+    let second = whole_ellipse(
+        Point3::origin(),
+        Vector3::x(),
+        Vector3::y(),
+        q(51, 8),
+        q(68, 15),
+    );
+    let circle = full_circle(Point3::origin(), Vector3::x(), Vector3::y(), 5);
+    let expected = [pi(3, 4, 0), pi(-3, 4, 0), pi(-3, -4, 0), pi(3, -4, 0)];
+    for (a, b) in [
+        (&first, &second),
+        (&second, &first),
+        (&circle, &first),
+        (&first, &circle),
+    ] {
+        let found = points(a, b);
+        assert_eq!(found.len(), 4);
+        for point in &expected {
+            assert!(
+                found
+                    .iter()
+                    .any(|contact| contact.point.coincides_with(&point.clone().into()).unwrap())
+            );
+        }
+        // Both parameters evaluate to the reported point.
+        for contact in &found {
+            assert!(
+                a.point_at(&contact.first)
+                    .unwrap()
+                    .coincides_with(&contact.point)
+                    .unwrap()
+            );
+            assert!(
+                b.point_at(&contact.second)
+                    .unwrap()
+                    .coincides_with(&contact.point)
+                    .unwrap()
+            );
+        }
+    }
+    // A quarter arc keeps only (3, 4, 0).
+    let quarter = Curve3::ellipse_arc(
+        Point3::origin(),
+        Vector3::x(),
+        Vector3::y(),
+        q(39, 5),
+        q(13, 3),
+        Real::zero(),
+        (Real::pi() / Real::from(2)).unwrap(),
+    )
+    .unwrap();
+    let found = points(&quarter, &second);
+    assert_eq!(found.len(), 1);
+    assert!(found[0].point.coincides_with(&pi(3, 4, 0).into()).unwrap());
+    // The ellipse in the plane x = 3 (radii 4 along y, 2 along z) crosses the
+    // circle's plane at (3, ±4, 0), both on the circle. It starts at
+    // (3, 4, 0), so that closed-arc seam is visited at θ = 0 and θ = 2π.
+    let upright = whole_ellipse(pi(3, 0, 0), Vector3::y(), Vector3::z(), 4.into(), 2.into());
+    let found = points(&upright, &circle);
+    assert_eq!(found.len(), 3);
+    assert!(equal(&found[0].first, Real::zero()));
+    assert!(equal(&found[2].first, Real::pi() * Real::from(2)));
+    assert!(found[0].point.coincides_with(&pi(3, 4, 0).into()).unwrap());
+    assert!(found[2].point.coincides_with(&pi(3, 4, 0).into()).unwrap());
+    for point in [pi(3, 4, 0), pi(3, -4, 0)] {
+        assert!(
+            found
+                .iter()
+                .any(|contact| contact.point.coincides_with(&point.clone().into()).unwrap())
+        );
+    }
+    assert_eq!(points(&circle, &upright).len(), 3);
+}
+
+/// The circle x^2 + y^2 = 4 and the ellipse x^2/9 + y^2 = 1 meet where
+/// 8x^2/9 = 3: at (±√(27/8), ±√(5/8)). On a quarter span of either conic
+/// the contact parameters solve a biquadratic (for the circle span,
+/// -5t^4 + 118t^2 - 5 = 0), so each selected contact is certified as an
+/// exact nested-radical parameter before the arc angle is located.
+#[test]
+fn conic_pairs_meet_at_quartic_root_contacts() {
+    let circle = full_circle(Point3::origin(), Vector3::x(), Vector3::y(), 2);
+    let ellipse = whole_ellipse(
+        Point3::origin(),
+        Vector3::x(),
+        Vector3::y(),
+        3.into(),
+        1.into(),
+    );
+    let x = (Real::from(27) / Real::from(8)).unwrap().sqrt().unwrap();
+    let y = (Real::from(5) / Real::from(8)).unwrap().sqrt().unwrap();
+    let expected = [
+        Point3::new(x.clone(), y.clone(), 0.into()),
+        Point3::new(-x.clone(), y.clone(), 0.into()),
+        Point3::new(-x.clone(), -y.clone(), 0.into()),
+        Point3::new(x, -y, 0.into()),
+    ];
+    for (a, b) in [(&circle, &ellipse), (&ellipse, &circle)] {
+        let found = points(a, b);
+        assert_eq!(found.len(), 4);
+        for point in &expected {
+            assert!(
+                found
+                    .iter()
+                    .any(|contact| contact.point.coincides_with(&point.clone().into()).unwrap())
+            );
+        }
+        for contact in &found {
+            assert!(
+                a.point_at(&contact.first)
+                    .unwrap()
+                    .coincides_with(&contact.point)
+                    .unwrap()
+            );
+            assert!(
+                b.point_at(&contact.second)
+                    .unwrap()
+                    .coincides_with(&contact.point)
+                    .unwrap()
+            );
+        }
+    }
+}
+
+/// The quadratic with controls (1, 0), (1/2, 1), (-5/2, 3/4) is
+/// a(s) = 1 - s - 5s^2/2, b(s) = 2s - 5s^2/4, so a^2 + b^2 - 1 =
+/// s((125/16)s^3 - 2): it meets the unit circle at its start (1, 0), the
+/// circle's seam, and at the pure cube root s = cbrt(32/125), which is
+/// certified exactly. The circle and
+/// y = x^2 + x meet at x^3 + x^2 + x = 1, whose root has only an undecided
+/// Cardano form, so that incidence stays typed rather than failing otherwise.
+#[test]
+fn circles_meet_rational_curves_at_cube_root_contacts() {
+    let circle = full_circle(Point3::origin(), Vector3::x(), Vector3::y(), 1);
+    let quadratic = Curve3::rational_bezier(
+        vec![
+            pi(1, 0, 0),
+            Point3::new(q(1, 2), 1.into(), 0.into()),
+            Point3::new(q(-5, 2), q(3, 4), 0.into()),
+        ],
+        vec![Real::one(); 3],
+    )
+    .unwrap();
+    // The circle's evaluation at an atan2 of cube-root coordinates is exact
+    // but its comparison with the point is undecided, so the contact is
+    // checked through its defining relation instead.
+    let CurveCurveIntersection::Points(found) = circle.intersect_curve(&quadratic).unwrap() else {
+        panic!("isolated contacts required");
+    };
+    // The start (1, 0, 0) is the full circle's seam, visited at 0 and 2π.
+    assert_eq!(found.len(), 3);
+    assert_eq!(
+        found
+            .iter()
+            .filter(|contact| equal(&contact.second, Real::zero()))
+            .count(),
+        2
+    );
+    let interior = found
+        .iter()
+        .find(|contact| !equal(&contact.second, Real::zero()))
+        .unwrap();
+    let s = interior
+        .second
+        .try_real()
+        .expect("certified scalar parameter")
+        .clone();
+    assert!(equal(
+        &Parameter::from_real(&s * &s * &s),
+        (Real::from(32) / Real::from(125)).unwrap()
+    ));
+    assert!(
+        quadratic
+            .point_at(&interior.second)
+            .unwrap()
+            .coincides_with(&interior.point)
+            .unwrap()
+    );
+    let parabola = Curve3::rational_bezier(
+        vec![pi(-1, 0, 0), pi(0, -1, 0), pi(1, 2, 0)],
+        vec![Real::one(); 3],
+    )
+    .unwrap();
+    assert!(matches!(
+        circle.intersect_curve(&parabola),
+        Err(GeometryError::UnsupportedIntersection)
+    ));
+}
