+    let map = hypercurve::RationalMap2::new(
+        [
+            BivariatePolynomial::new(vec![vec![0.into()], vec![0.into()], vec![1.into()]]),
+            equation,
+        ],
+        BivariatePolynomial::new(vec![vec![1.into()]]),
