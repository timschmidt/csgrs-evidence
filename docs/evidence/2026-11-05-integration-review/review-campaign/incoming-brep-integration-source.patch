+fn nonlinear_map_chains_keep_sections_after_restriction_reversal_and_reflection() {
+    let poly = |rows: Vec<Vec<i32>>| {
+        BivariatePolynomial::new(
+            rows.into_iter()
+                .map(|row| row.into_iter().map(Real::from).collect())
+                .collect(),
+        )
