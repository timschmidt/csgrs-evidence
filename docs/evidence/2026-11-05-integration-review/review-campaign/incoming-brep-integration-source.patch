+                            .clone(),
+                        parameter.clone(),
+                        Some(parameter),
+                        uv.clone(),
+                        point.clone(),
+                    ));
+                }
+            }
+        }
+        self.locate_retained_contact_endpoint(face_id, endpoint, wires, &contacts)
+    }
