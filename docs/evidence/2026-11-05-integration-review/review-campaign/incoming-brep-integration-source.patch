+        hypercurve::Curve2::from(
+            hypercurve::RationalBezier2::try_new(
+                vec![
+                    hypercurve::Point2::from_values(0, 0),
+                    hypercurve::Point2::from_values(2, 0),
+                    hypercurve::Point2::from_values(4, 16),
