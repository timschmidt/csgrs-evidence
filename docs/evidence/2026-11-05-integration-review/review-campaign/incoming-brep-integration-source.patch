@@ -0,0 +1,417 @@
+//! Native cylinder sections by nonparallel cylinders, off-axis spheres and
+//! off-axis ring tori, through an exact rational atlas of the cylinder.
+//!
+//! Topology is checked independently of the implementation: piece endpoints
+//! are chained by exact coincidence, every junction must join exactly two
+//! piece ends, and the closed loops are counted.
+
+use hyperbrep::*;
+use std::cmp::Ordering;
+
+fn q(n: i64, d: i64) -> Real {
+    (Real::from(n) / Real::from(d)).unwrap()
+}
+
+fn root(n: i64) -> Real {
+    Real::from(n).sqrt().unwrap()
+}
+
+fn p(x: Real, y: Real, z: Real) -> Point3 {
+    Point3::new(x, y, z)
+}
+
+fn pi(x: i64, y: i64, z: i64) -> Point3 {
+    Point3::new(x.into(), y.into(), z.into())
+}
+
+/// x^2 + y^2 = r^2 about the z axis.
+fn z_cylinder(radius: Real) -> Surface {
+    Surface::cylinder(
+        Point3::origin(),
+        Vector3::x(),
+        Vector3::y(),
+        Vector3::z(),
+        radius,
+    )
+    .unwrap()
+}
+
+/// y^2 + z^2 = r^2 about the x axis.
+fn x_cylinder(radius: Real) -> Surface {
+    Surface::cylinder(
+        Point3::origin(),
+        Vector3::y(),
+        Vector3::z(),
+        Vector3::x(),
+        radius,
+    )
+    .unwrap()
+}
+
+fn pieces(result: SurfaceSurfaceIntersection) -> Vec<SurfaceIntersectionCurve> {
+    match result {
+        SurfaceSurfaceIntersection::Curves(curves) => curves,
+        SurfaceSurfaceIntersection::Curve(curve) => vec![*curve],
+        other => panic!("curve pieces required, found {other:?}"),
+    }
+}
+
+fn endpoints(piece: &SurfaceIntersectionCurve) -> [GeometricPoint3; 2] {
+    let curve = piece.curve();
+    [
+        curve.point_at(curve.domain().start()).unwrap(),
+        curve.point_at(curve.domain().end()).unwrap(),
+    ]
+}
+
+/// Exact seam points of the atlas of a cylinder about an origin with frame
+/// (`x`, `y`) and radius `r`, as `origin + r(c x + s y)` without the height.
+struct Seams {
+    origin: Point3,
+    x: Vector3,
+    y: Vector3,
+    radius: Real,
+    /// Axis whose sign separates the loops; on every seam line each sign-half
+    /// of the fixture's intersection crosses exactly once (argued per test).
+    sign_axis: Vector3,
+}
+
+impl Seams {
+    /// The seam index of a point whose two in-plane coordinates match a seam.
+    /// Only exact linear forms against represented seam values are used.
+    fn index(&self, point: &GeometricPoint3) -> Option<usize> {
+        seams().iter().position(|(c, s)| {
+            let at = self.origin.clone()
+                + self.x.clone() * (&self.radius * c)
+                + self.y.clone() * (&self.radius * s);
+            [&self.x, &self.y].into_iter().all(|direction| {
+                point
+                    .compare_linear_form(direction, &direction.dot(&Vector3::from(at.clone())))
+                    .unwrap()
+                    == Ordering::Equal
+            })
+        })
+    }
+}
+
+/// Number of closed loops formed by the pieces; panics on a junction that
+/// does not join exactly two piece ends.
+///
+/// Seam ends are identified by (seam, sign) alone: each bucket must hold
+/// exactly two ends, justified by the fixture's uniqueness argument, so no
+/// costly equality proof between independently selected points of adjacent
+/// patches is needed. Interior event ends are matched by exact coincidence
+/// only with ends of the same patch and sign.
+fn loops(pieces: &[SurfaceIntersectionCurve], seams: &Seams) -> usize {
+    type Key = (Option<usize>, Ordering, Option<Point3>);
+    let mut nodes = Vec::<(Key, GeometricPoint3, usize)>::new();
+    let mut node = |piece: &SurfaceIntersectionCurve, point: GeometricPoint3| -> usize {
+        let seam = seams.index(&point);
+        let sign = point
+            .compare_linear_form(&seams.sign_axis, &Real::zero())
+            .unwrap();
+        let patch = seam.is_none().then(|| {
+            piece
+                .curve()
+                .tensor_geometry()
+                .unwrap()
+                .surface
+                .point_at(&hypercurve::Point2::from_values(0, 0).into())
+                .unwrap()
+                .try_coordinates()
+                .unwrap()
+                .clone()
+        });
+        let same_patch = |a: &Option<Point3>, b: &Option<Point3>| match (a, b) {
+            (None, None) => true,
+            (Some(p), Some(q)) => GeometricPoint3::from(p.clone())
+                .coincides_with(&q.clone().into())
+                .unwrap(),
+            _ => false,
+        };
+        let found = nodes.iter().position(|(key, existing, _)| {
+            key.0 == seam
+                && key.1 == sign
+                && same_patch(&key.2, &patch)
+                && (seam.is_some() || existing.coincides_with(&point).unwrap())
+        });
+        match found {
+            Some(index) => {
+                nodes[index].2 += 1;
+                index
+            }
+            None => {
+                nodes.push(((seam, sign, patch), point, 1));
+                nodes.len() - 1
+            }
+        }
+    };
+    let edges = pieces
+        .iter()
+        .map(|piece| {
+            let [a, b] = endpoints(piece);
+            (node(piece, a), node(piece, b))
+        })
+        .collect::<Vec<_>>();
+    let count = nodes.len();
+    assert!(
+        nodes.iter().all(|(_, _, ends)| *ends == 2),
+        "open or branched junction"
+    );
+    let mut parent = (0..count).collect::<Vec<_>>();
+    fn find(parent: &mut [usize], mut i: usize) -> usize {
+        while parent[i] != i {
+            parent[i] = parent[parent[i]];
+            i = parent[i];
+        }
+        i
+    }
+    for &(a, b) in &edges {
+        let (ra, rb) = (find(&mut parent, a), find(&mut parent, b));
+        parent[ra] = rb;
+    }
+    (0..count).filter(|&i| find(&mut parent, i) == i).count()
+}
+
+/// Unit cylinder about z, loops separated by the sign of z.
+fn unit_seams() -> Seams {
+    Seams {
+        origin: Point3::origin(),
+        x: Vector3::x(),
+        y: Vector3::y(),
+        radius: Real::one(),
+        sign_axis: Vector3::z(),
+    }
+}
+
+/// Whether some piece ends at the expected point, which has represented x and y;
+/// z is compared only for endpoints with those exact x and y.
+fn has_endpoint(pieces: &[SurfaceIntersectionCurve], expected: &Point3) -> bool {
+    pieces.iter().any(|piece| {
+        endpoints(piece).iter().any(|point| {
+            point
+                .compare_linear_form(&Vector3::x(), &expected.x)
+                .unwrap()
+                == Ordering::Equal
+                && point
+                    .compare_linear_form(&Vector3::y(), &expected.y)
+                    .unwrap()
+                    == Ordering::Equal
+                && point
+                    .compare_linear_form(&Vector3::z(), &expected.z)
+                    .unwrap()
+                    == Ordering::Equal
+        })
+    })
+}
+
+/// Unit-circle atlas seam points at half-angle tangents 0, ±5/12, ±3/4,
+/// ±4/3, ±12/5 and infinity.
+fn seams() -> Vec<(Real, Real)> {
+    let mut points = vec![(q(1, 1), q(0, 1)), (q(-1, 1), q(0, 1))];
+    for (x, y) in [(119_i64, 120_i64), (7, 24), (-7, 24), (-119, 120)] {
+        let d = if x.abs() == 119 { 169 } else { 25 };
+        points.push((q(x, d), q(y, d)));
+        points.push((q(x, d), q(-y, d)));
+    }
+    points
+}
+
+/// The plan's decisive pair x^2 + y^2 = 1, y^2 + z^2 = 2: two disjoint smooth
+/// nonplanar loops, z = ±sqrt(2 - y^2), with no rational parameterization.
+#[test]
+fn unequal_perpendicular_cylinders_give_two_exact_loops() {
+    let all = pieces(
+        z_cylinder(1.into())
+            .intersect_surface(&x_cylinder(root(2)))
+            .unwrap(),
+    );
+    for piece in &all {
+        assert_eq!(piece.curve().kind(), Curve3Kind::TensorImage);
+        // The atlas is internal; no operand pcurve is claimed.
+        assert!(piece.first_pcurve().materialize().is_err());
+        assert!(piece.second_pcurve().materialize().is_err());
+    }
+    assert_eq!(loops(&all, &unit_seams()), 2);
+    // Each loop crosses every atlas seam (c, s) at z = ±sqrt(2 - s^2).
+    for (c, s) in seams() {
+        let z = (Real::from(2) - &s * &s).sqrt().unwrap();
+        assert!(has_endpoint(&all, &p(c.clone(), s.clone(), z.clone())));
+        assert!(has_endpoint(&all, &p(c, s, -z)));
+    }
+    // The loops separate by the sign of z.
+    let upper = all
+        .iter()
+        .filter(|piece| {
+            endpoints(piece)[0]
+                .compare_linear_form(&Vector3::z(), &Real::zero())
+                .unwrap()
+                == Ordering::Greater
+        })
+        .cloned()
+        .collect::<Vec<_>>();
+    assert_eq!(loops(&upper, &unit_seams()), 1);
+    assert!(upper.len() < all.len());
+    // Operand exchange charts the other cylinder: the pieces differ but form
+    // the same two loops. On that atlas's seam lines (fixed y, z) the loops
+    // satisfy x = ±sqrt(1 - y^2), one crossing per sign of x.
+    let swapped = pieces(
+        x_cylinder(root(2))
+            .intersect_surface(&z_cylinder(1.into()))
+            .unwrap(),
+    );
+    let swapped_seams = Seams {
+        origin: Point3::origin(),
+        x: Vector3::y(),
+        y: Vector3::z(),
+        radius: root(2),
+        sign_axis: Vector3::x(),
+    };
+    assert_eq!(loops(&swapped, &swapped_seams), 2);
+}
+
+/// Cutting both loops with x = 0 gives exactly the four transverse contacts
+/// (0, ±1, ±1).
+#[test]
+fn plane_cut_of_the_native_loops_has_four_contacts() {
+    let all = pieces(
+        z_cylinder(1.into())
+            .intersect_surface(&x_cylinder(root(2)))
+            .unwrap(),
+    );
+    let plane = Surface::plane(Point3::origin(), Vector3::y(), Vector3::z()).unwrap();
+    let mut found = Vec::<GeometricPoint3>::new();
+    for piece in &all {
+        match plane.intersect_curve(piece.curve()).unwrap() {
+            CurveSurfaceIntersection::None => {}
+            CurveSurfaceIntersection::Points(points) => {
+                for contact in points {
+                    assert_eq!(contact.kind, CurveSurfaceContactKind::Simple);
+                    if !found
+                        .iter()
+                        .any(|f| f.coincides_with(&contact.point).unwrap())
+                    {
+                        found.push(contact.point);
+                    }
+                }
+            }
+            other => panic!("isolated contacts required, found {other:?}"),
+        }
+    }
+    assert_eq!(found.len(), 4);
+    for (y, z) in [(1, 1), (1, -1), (-1, 1), (-1, -1)] {
+        assert!(
+            found
+                .iter()
+                .any(|f| f.coincides_with(&pi(0, y, z).into()).unwrap())
+        );
+    }
+}
+
+/// Equal radii: z^2 = x^2, so every piece lies in z = x or z = -x.
+#[test]
+fn equal_radius_control_reduces_to_planar_conics() {
+    let all = pieces(
+        z_cylinder(1.into())
+            .intersect_surface(&x_cylinder(1.into()))
+            .unwrap(),
+    );
+    assert!(!all.is_empty());
+    let plus = Vector3::new([1.into(), 0.into(), (-1).into()]);
+    let minus = Vector3::new([1.into(), 0.into(), 1.into()]);
+    for piece in &all {
+        for point in endpoints(piece) {
+            let on_plus =
+                point.compare_linear_form(&plus, &Real::zero()).unwrap() == Ordering::Equal;
+            let on_minus =
+                point.compare_linear_form(&minus, &Real::zero()).unwrap() == Ordering::Equal;
+            assert!(on_plus || on_minus);
+        }
+    }
+}
+
+/// The sphere |p - (1,0,0)| = 1 meets the unit cylinder where z^2 = 2x - 1:
+/// one closed loop through the seams with x >= 1/2.
+#[test]
+fn off_axis_sphere_gives_one_loop_through_known_seams() {
+    let sphere = Surface::sphere(
+        pi(1, 0, 0),
+        Vector3::x(),
+        Vector3::y(),
+        Vector3::z(),
+        1.into(),
+    )
+    .unwrap();
+    let all = pieces(sphere.intersect_surface(&z_cylinder(1.into())).unwrap());
+    assert_eq!(loops(&all, &unit_seams()), 1);
+    assert!(has_endpoint(&all, &pi(1, 0, 1)));
+    assert!(has_endpoint(&all, &pi(1, 0, -1)));
+    let z = (root(69) / Real::from(13)).unwrap();
+    assert!(has_endpoint(&all, &p(q(119, 169), q(120, 169), z.clone())));
+    assert!(has_endpoint(&all, &p(q(119, 169), q(-120, 169), -z)));
+}
+
+/// A thin cylinder about the y-directed line through (3, 0, 0) pierces the
+/// tube of the R = 3, r = 1 torus twice.
+#[test]
+fn off_axis_torus_gives_two_loops() {
+    let torus = Surface::torus(
+        Point3::origin(),
+        Vector3::x(),
+        Vector3::y(),
+        Vector3::z(),
+        3.into(),
+        1.into(),
+    )
+    .unwrap();
+    let thin = Surface::cylinder(
+        pi(3, 0, 0),
+        Vector3::z(),
+        Vector3::x(),
+        Vector3::y(),
+        q(1, 2),
+    )
+    .unwrap();
+    let all = pieces(thin.intersect_surface(&torus).unwrap());
+    // Seams lie on lines (3 + s/2, y, c/2). There the outer tube radius
+    // 3 + sqrt(1 - z^2) >= 3.87 exceeds |x| <= 3.5 while the inner radius
+    // 3 - sqrt(1 - z^2) <= 2.13 is below x >= 2.5, so each sign of y has
+    // exactly one crossing.
+    let thin_seams = Seams {
+        origin: pi(3, 0, 0),
+        x: Vector3::z(),
+        y: Vector3::x(),
+        radius: q(1, 2),
+        sign_axis: Vector3::y(),
+    };
+    assert_eq!(loops(&all, &thin_seams), 2);
+}
+
+#[test]
+fn distant_carriers_give_complete_empty_results() {
+    let far = Surface::sphere(
+        pi(9, 0, 0),
+        Vector3::x(),
+        Vector3::y(),
+        Vector3::z(),
+        1.into(),
+    )
+    .unwrap();
+    assert!(matches!(
+        far.intersect_surface(&z_cylinder(1.into())).unwrap(),
+        SurfaceSurfaceIntersection::None
+    ));
+    // Skew axes (z, and x through (0, 5, 0)) at distance 5 with radii 1, 2.
+    let skew = Surface::cylinder(
+        pi(0, 5, 0),
+        Vector3::y(),
+        Vector3::z(),
+        Vector3::x(),
+        2.into(),
+    )
+    .unwrap();
+    assert!(matches!(
+        z_cylinder(1.into()).intersect_surface(&skew).unwrap(),
+        SurfaceSurfaceIntersection::None
+    ));
+}
diff --git a/crates/hyperbrep/tests/extrusion_contacts.rs b/crates/hyperbrep/tests/extrusion_contacts.rs
new file mode 100644
index 0000000000..1896263d9b
--- /dev/null
+++ b/crates/hyperbrep/tests/extrusion_contacts.rs
@@ -0,0 +1,315 @@
+//! Complete contacts between rational spatial curves and linear extrusions of
+//! line, rational Bézier and NURBS profiles.
+//!
+//! Expectations come from the defining geometry stated beside each witness.
+
+use hyperbrep::*;
+use std::cmp::Ordering;
+
+fn q(n: i64, d: i64) -> Real {
+    (Real::from(n) / Real::from(d)).unwrap()
+}
+
+fn p(x: Real, y: Real, z: Real) -> Point3 {
+    Point3::new(x, y, z)
+}
+
+fn pi(x: i64, y: i64, z: i64) -> Point3 {
+    Point3::new(x.into(), y.into(), z.into())
+}
+
+fn line(start: Point3, end: Point3) -> Curve3 {
+    Curve3::line(start, end).unwrap()
+}
+
+/// Rational quadratic arc of the circle of radius `r` in z = 0 from angle 0 to
+/// θ with cos(θ/2) = 3/5: P1 = (r, 4r/3), w1 = 3/5, P2 = (-7r/25, 24r/25).
+fn arc(r: i64) -> Curve3 {
+    Curve3::rational_bezier(
+        vec![
+            p(r.into(), 0.into(), 0.into()),
+            p(r.into(), q(4 * r, 3), 0.into()),
+            p(q(-7 * r, 25), q(24 * r, 25), 0.into()),
+        ],
+        vec![Real::one(), q(3, 5), Real::one()],
+    )
+    .unwrap()
+}
+
+/// The arc swept along +z: a finite angular strip of the circular cylinder.
+fn arc_wall(r: i64) -> Surface {
+    Surface::extrusion(arc(r), Vector3::z()).unwrap()
+}
+
+fn contacts(surface: &Surface, curve: &Curve3) -> Vec<CurveSurfacePoint> {
+    match surface.intersect_curve(curve).unwrap() {
+        CurveSurfaceIntersection::Points(points) => {
+            for point in &points {
+                assert!(
+                    point
+                        .point
+                        .coincides_with(&curve.point_at(&point.parameter).unwrap())
+                        .unwrap()
+                );
+            }
+            points
+        }
+        other => panic!("isolated contacts required, found {other:?}"),
+    }
+}
+
+fn assert_parameters(points: &[CurveSurfacePoint], expected: &[(Real, CurveSurfaceContactKind)]) {
+    assert_eq!(points.len(), expected.len());
+    for (point, (parameter, kind)) in points.iter().zip(expected) {
+        assert_eq!(
+            point
+                .parameter
+                .compare(&Parameter::from_real(parameter.clone()))
+                .unwrap(),
+            Ordering::Equal
+        );
+        assert_eq!(point.kind, *kind);
+    }
+}
+
+fn reload(model: &Model) -> Model {
+    let json = model.to_json().unwrap();
+    let cold = RawModel::from_json(&json, &ArchiveLimits::default())
+        .unwrap()
+        .validate()
+        .unwrap();
+    assert_eq!(cold.to_json().unwrap(), json);
+    cold
+}
+
+use CurveSurfaceContactKind::{Repeated, Simple};
+
+/// The line (0,0,-1) + t(6,8,2) reaches radius 5 at t = 1/2, at (3,4,0), whose
+/// angle atan(4/3) lies inside the arc's angular range.
+#[test]
+fn transverse_line_meets_the_swept_arc_once() {
+    let curve = line(pi(0, 0, -1), pi(6, 8, 1));
+    let points = contacts(&arc_wall(5), &curve);
+    assert_parameters(&points, &[(q(1, 2), Simple)]);
+    assert!(points[0].point.coincides_with(&pi(3, 4, 0).into()).unwrap());
+    // Reversal and a translated copy of the line along the extrusion
+    // direction keep the same contact parameter structure.
+    let reversed = contacts(&arc_wall(5), &curve.reversed().unwrap());
+    assert_parameters(&reversed, &[(q(1, 2), Simple)]);
+    let lifted = contacts(&arc_wall(5), &line(pi(0, 0, 9), pi(6, 8, 11)));
+    assert_parameters(&lifted, &[(q(1, 2), Simple)]);
+    assert!(
+        lifted[0]
+            .point
+            .coincides_with(&pi(3, 4, 10).into())
+            .unwrap()
+    );
+}
+
+/// The radius-5 crossing (-4, 3, 1) has angle about 143 degrees, outside the
+/// arc's range of about 106 degrees, so the finite profile excludes it.
+#[test]
+fn crossings_outside_the_profile_range_are_excluded() {
+    assert!(matches!(
+        arc_wall(5)
+            .intersect_curve(&line(pi(0, 0, 0), pi(-8, 6, 2)))
+            .unwrap(),
+        CurveSurfaceIntersection::None
+    ));
+}
+
+/// The line through (3,4,0) with direction (-4,3,0) is tangent to the circle.
+#[test]
+fn tangent_line_is_a_repeated_contact() {
+    let points = contacts(&arc_wall(5), &line(pi(7, 1, 0), pi(-1, 7, 0)));
+    assert_parameters(&points, &[(q(1, 2), Repeated)]);
+}
+
+/// Lines parallel to the extrusion direction lie on it or miss it entirely.
+#[test]
+fn lines_parallel_to_the_direction_are_contained_or_disjoint() {
+    assert!(matches!(
+        arc_wall(5)
+            .intersect_curve(&line(pi(3, 4, -7), pi(3, 4, 9)))
+            .unwrap(),
+        CurveSurfaceIntersection::Contained
+    ));
+    assert!(matches!(
+        arc_wall(5)
+            .intersect_curve(&line(pi(5, 5, 0), pi(5, 5, 1)))
+            .unwrap(),
+        CurveSurfaceIntersection::None
+    ));
+    // A lifted copy of the profile lies on the surface.
+    let lifted = Curve3::rational_bezier(
+        vec![
+            p(5.into(), 0.into(), 2.into()),
+            p(5.into(), q(20, 3), 2.into()),
+            p(q(-7, 5), q(24, 5), 2.into()),
+        ],
+        vec![Real::one(), q(3, 5), Real::one()],
+    )
+    .unwrap();
+    assert!(matches!(
+        arc_wall(5).intersect_curve(&lifted).unwrap(),
+        CurveSurfaceIntersection::Contained
+    ));
+}
+
+/// The strip y = 0, 0 <= x <= 1 swept along z contains x in [0, 1] of the line
+/// x = -1 + 3t at height 5, which is t in [1/3, 2/3].
+#[test]
+fn coplanar_line_overlaps_the_swept_segment_range() {
+    let strip = Surface::extrusion(line(pi(0, 0, 0), pi(1, 0, 0)), Vector3::z()).unwrap();
+    let CurveSurfaceIntersection::Overlap(range) = strip
+        .intersect_curve(&line(pi(-1, 0, 5), pi(2, 0, 5)))
+        .unwrap()
+    else {
+        panic!("one coincident range required");
+    };
+    assert_eq!(
+        range
+            .start()
+            .compare(&Parameter::from_real(q(1, 3)))
+            .unwrap(),
+        Ordering::Equal
+    );
+    assert_eq!(
+        range.end().compare(&Parameter::from_real(q(2, 3))).unwrap(),
+        Ordering::Equal
+    );
+}
+
+/// Cubic with x = 4t - 2, y = 3t(1 - t)/2, z = 3t. It meets the unit cylinder
+/// at t = 1/2 ∓ sqrt(u), u = (8 sqrt(229) - 119)/36. Only the second crossing,
+/// near angle 17 degrees, lies on the unit arc of about 106 degrees; the first,
+/// near 163 degrees, does not.
+#[test]
+fn cubic_contact_is_a_selected_root_that_splits_and_replays() {
+    let curve = Curve3::rational_bezier(
+        vec![
+            p((-2).into(), 0.into(), 0.into()),
+            p(q(-2, 3), q(1, 2), 1.into()),
+            p(q(2, 3), q(1, 2), 2.into()),
+            p(2.into(), 0.into(), 3.into()),
+        ],
+        vec![Real::one(); 4],
+    )
+    .unwrap();
+    let points = contacts(&arc_wall(1), &curve);
+    assert_eq!(points.len(), 1);
+    let s = ((Real::from(8) * Real::from(229).sqrt().unwrap() - Real::from(119)) / Real::from(36))
+        .unwrap()
+        .sqrt()
+        .unwrap();
+    assert_eq!(
+        points[0]
+            .parameter
+            .compare(&Parameter::from_real(q(1, 2) + s))
+            .unwrap(),
+        Ordering::Equal
+    );
+    assert_eq!(points[0].kind, Simple);
+
+    let mut builder = ModelBuilder::new();
+    let start = builder
+        .vertex(curve.point_at(curve.domain().start()).unwrap())
+        .unwrap();
+    let end = builder
+        .vertex(curve.point_at(curve.domain().end()).unwrap())
+        .unwrap();
+    let id = builder.curve(curve.clone()).unwrap();
+    builder
+        .edge(&start, &end, &id, curve.domain().clone())
+        .unwrap();
+    let model = builder.finish().unwrap();
+    let split = model
+        .edges()
+        .next()
+        .unwrap()
+        .split(points[0].parameter.clone())
+        .unwrap();
+    assert!(
+        split
+            .details()
+            .vertex()
+            .point()
+            .coincides_with(&points[0].point)
+            .unwrap()
+    );
+    let cold = reload(split.model());
+    assert_eq!(cold.edges().count(), 2);
+    let replayed = cold.curves().next().unwrap().geometry().clone();
+    let again = contacts(&arc_wall(1), &replayed);
+    assert_eq!(again.len(), 1);
+    assert_eq!(
+        again[0].parameter.compare(&points[0].parameter).unwrap(),
+        Ordering::Equal
+    );
+}
+
+/// Two quadratic spans on the x axis (knots [2,2,2,3,4,4,4], controls at
+/// x = -2, -1, 1, 2) give x = 2u - 6. The strip x = 1 swept along z meets it
+/// at u = 7/2 in the original knot chart.
+#[test]
+fn nurbs_curves_and_profiles_keep_authored_knot_parameters() {
+    let spline = || {
+        Curve3::nurbs(
+            2,
+            vec![pi(-2, 0, 0), pi(-1, 0, 0), pi(1, 0, 0), pi(2, 0, 0)],
+            vec![Real::one(); 4],
+            [2, 2, 2, 3, 4, 4, 4].map(Real::from).to_vec(),
+        )
+        .unwrap()
+    };
+    let wall = Surface::extrusion(line(pi(1, -1, 0), pi(1, 1, 0)), Vector3::z()).unwrap();
+    assert_parameters(&contacts(&wall, &spline()), &[(q(7, 2), Simple)]);
+    // The spline swept along y is the plane z = 0 over -2 <= x <= 2. The z axis
+    // crosses it at x = 0, which is the profile's interior knot u = 3.
+    let sheet = Surface::extrusion(spline(), Vector3::y()).unwrap();
+    assert_parameters(
+        &contacts(&sheet, &line(pi(0, 0, -1), pi(0, 0, 1))),
+        &[(q(1, 2), Simple)],
+    );
+    // A line in that plane is contained over the profile's x range.
+    let CurveSurfaceIntersection::Overlap(range) = sheet
+        .intersect_curve(&line(pi(-4, 3, 0), pi(4, 3, 0)))
+        .unwrap()
+    else {
+        panic!("one coincident range required");
+    };
+    assert_eq!(
+        range
+            .start()
+            .compare(&Parameter::from_real(q(1, 4)))
+            .unwrap(),
+        Ordering::Equal
+    );
+    assert_eq!(
+        range.end().compare(&Parameter::from_real(q(3, 4))).unwrap(),
+        Ordering::Equal
+    );
+}
+
+#[test]
+fn unsupported_families_remain_typed_and_budgets_recover() {
+    let circle = Curve3::circle_arc(
+        Point3::origin(),
+        Vector3::x(),
+        Vector3::y(),
+        Real::one(),
+        Real::zero(),
+        Real::one(),
+    );
+    if let Ok(circle) = circle {
+        assert!(matches!(
+            arc_wall(5).intersect_curve(&circle),
+            Err(GeometryError::UnsupportedIntersection)
+        ));
+    }
+    let curve = line(pi(0, 0, -1), pi(6, 8, 1));
+    let denied =
+        OperationContext::strict(WorkBudget::ZERO).evaluate(|| arc_wall(5).intersect_curve(&curve));
+    assert_eq!(denied.result.unwrap_err().limit, 0);
+    assert_eq!(contacts(&arc_wall(5), &curve).len(), 1);
+}
