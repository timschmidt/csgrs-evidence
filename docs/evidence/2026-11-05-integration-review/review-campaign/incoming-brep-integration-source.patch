diff --git a/crates/hyperbrep/src/geometry/curve_revolution.rs b/crates/hyperbrep/src/geometry/curve_revolution.rs
new file mode 100644
index 0000000000..c6f9eb7209
--- /dev/null
+++ b/crates/hyperbrep/src/geometry/curve_revolution.rs
@@ -0,0 +1,305 @@
+//! Complete contacts between rational spatial curves and full revolutions.
+//!
+//! A point lies on the full revolution of a profile about an axis exactly when
+//! its squared axis distance and axial height equal those of some profile
+//! point. The quotient map `p -> (rho^2, z)` sends a positive-weight rational
+//! span of degree `n` to a positive-weight rational planar span of degree `2n`
+//! in the same parameter: with `D = X - W o`, its homogeneous coordinates are
+//! `(|D|^2 - (a·D)^2, (a·D) W, W^2)`. Hypercurve's complete planar incidence
+//! between the curve image and the profile image therefore returns every
+//! contact and coincident range of the spatial curve, in its own chart.
+
+use super::curve_extrusion::classify_one_sided;
+use super::curve_plane::{assemble, classify_derivative};
+use super::*;
+use hypercurve::{CurveIntersectionPairBlockerKind2, CurveParameterSet2, CurvePointLocations2};
+
+/// One positive-weight rational Bézier span and its map into the curve chart.
+struct Span {
+    controls: Vec<HomogeneousPoint3>,
+    start: Real,
+    length: Real,
+}
+
+impl Span {
+    fn unit(controls: Vec<HomogeneousPoint3>) -> Self {
+        Self {
+            controls,
+            start: Real::zero(),
+            length: Real::one(),
+        }
+    }
+
+    fn global(&self, local: Parameter) -> GeometryResult<Parameter> {
+        local.affine_image(&self.length, &self.start)
+    }
+}
+
+/// Native rational spans of a line, rational Bézier or NURBS curve, or `None`
+/// for families without an exact rational span decomposition here.
+fn spans(curve: &Curve3) -> GeometryResult<Option<Vec<Span>>> {
+    Ok(Some(match &curve.data.geometry {
+        CurveGeometry3::Line(line) => vec![Span::unit(vec![
+            HomogeneousPoint3::from_affine(&line.start, &Real::one()),
+            HomogeneousPoint3::from_affine(&line.end, &Real::one()),
+        ])],
+        CurveGeometry3::RationalBezier(bezier) => {
+            vec![Span::unit(bezier.homogeneous_controls().to_vec())]
+        }
+        CurveGeometry3::Nurbs(nurbs) => {
+            let mut spans = Vec::new();
+            for (segment, domain) in decompose_nurbs_into_bezier_segments(nurbs)? {
+                let CurveGeometry3::RationalBezier(bezier) = &segment.data.geometry else {
+                    unreachable!("NURBS decomposition produces rational Bézier segments");
+                };
+                spans.push(Span {
+                    controls: bezier.homogeneous_controls().to_vec(),
+                    start: domain.start().clone(),
+                    length: domain.end() - domain.start(),
+                });
+            }
+            spans
+        }
+        CurveGeometry3::AffineImage(_)
+        | CurveGeometry3::Rotation(_)
+        | CurveGeometry3::Translation(_)
+        | CurveGeometry3::TensorImage(_)
+        | CurveGeometry3::PlanarImage(_)
+        | CurveGeometry3::CircleArc(_)
+        | CurveGeometry3::EllipseArc(_) => return Ok(None),
+    }))
+}
+
+/// Exact quotient image of one span.
+enum Image {
+    /// The span lies on one latitude circle (or one axis point).
+    Point(CurvePoint2),
+    Curve(Curve2),
+}
+
+fn image(controls: &[HomogeneousPoint3], surface: &RevolutionSurface) -> GeometryResult<Image> {
+    let origin = &surface.axis_origin;
+    let axis = &surface.axis;
+    let weight = controls
+        .iter()
+        .map(|point| point.w.clone())
+        .collect::<Vec<_>>();
+    let displacement = [
+        controls
+            .iter()
+            .map(|point| &point.x - &origin.x * &point.w)
+            .collect::<Vec<_>>(),
+        controls
+            .iter()
+            .map(|point| &point.y - &origin.y * &point.w)
+            .collect::<Vec<_>>(),
+        controls
+            .iter()
+            .map(|point| &point.z - &origin.z * &point.w)
+            .collect::<Vec<_>>(),
+    ];
+    let axial = (0..controls.len())
+        .map(|i| {
+            &axis[0] * &displacement[0][i]
+                + &axis[1] * &displacement[1][i]
+                + &axis[2] * &displacement[2][i]
+        })
+        .collect::<Vec<_>>();
+    let mut radial_squared = bernstein_product(&displacement[0], &displacement[0])?;
+    for coordinate in &displacement[1..] {
+        for (total, term) in radial_squared
+            .iter_mut()
+            .zip(bernstein_product(coordinate, coordinate)?)
+        {
+            *total += term;
+        }
+    }
+    // The axis is a unit vector, so |D|^2 - (a·D)^2 is the squared distance.
+    for (total, term) in radial_squared
+        .iter_mut()
+        .zip(bernstein_product(&axial, &axial)?)
+    {
+        *total -= term;
+    }
+    let height = bernstein_product(&axial, &weight)?;
+    let weight = bernstein_product(&weight, &weight)?;
+    // Positive native weights give positive Bernstein coefficients of W^2.
+    let mut points = Vec::with_capacity(weight.len());
+    for ((x, y), w) in radial_squared.iter().zip(&height).zip(&weight) {
+        points.push(CurvePoint2::new(
+            (x / w).map_err(GeometryError::Numeric)?,
+            (y / w).map_err(GeometryError::Numeric)?,
+        ));
+    }
+    let first = points[0].clone();
+    let mut collapsed = true;
+    for point in &points[1..] {
+        if decided_order(compare_reals(
+            point.x(),
+            first.x(),
+            crate::STRICT_PREDICATES,
+        ))? != Ordering::Equal
+            || decided_order(compare_reals(
+                point.y(),
+                first.y(),
+                crate::STRICT_PREDICATES,
+            ))? != Ordering::Equal
+        {
+            collapsed = false;
+            break;
+        }
+    }
+    Ok(if collapsed {
+        Image::Point(first)
+    } else {
+        Image::Curve(Curve2::from(RationalBezier2::try_new(points, weight)?))
+    })
+}
+
+/// Complete exact contacts of a line, rational Bézier or NURBS curve with the
+/// full revolution of a line, rational Bézier or NURBS profile. Returns `None`
+/// for other curve or profile families.
+pub(super) fn intersect_rational_curve_revolution(
+    curve: &Curve3,
+    surface: &RevolutionSurface,
+) -> Option<GeometryResult<CurveSurfaceIntersection>> {
+    let (curve_spans, profile_spans) = match (spans(curve), spans(&surface.profile)) {
+        (Ok(Some(first)), Ok(Some(second))) => (first, second),
+        (Ok(None), _) | (_, Ok(None)) => return None,
+        (Err(error), _) | (_, Err(error)) => return Some(Err(error)),
+    };
+    Some(intersect_spans(
+        curve,
+        surface,
+        &curve_spans,
+        &profile_spans,
+    ))
+}
+
+fn intersect_spans(
+    curve: &Curve3,
+    surface: &RevolutionSurface,
+    curve_spans: &[Span],
+    profile_spans: &[Span],
+) -> GeometryResult<CurveSurfaceIntersection> {
+    let mut profiles = Vec::with_capacity(profile_spans.len());
+    for span in profile_spans {
+        match image(&span.controls, surface)? {
+            Image::Curve(image) => profiles.push(image),
+            // A latitude-circle profile span sweeps no surface area. The
+            // degenerate carrier is not admitted by this route.
+            Image::Point(_) => return Err(GeometryError::UnsupportedIntersection),
+        }
+    }
+    let domain = curve.domain();
+    let mut points = Vec::new();
+    let mut overlaps = Vec::new();
+    for span in curve_spans {
+        let local_unit = || -> GeometryResult<ParameterRange> {
+            ParameterRange::new(
+                span.global(Parameter::from_real(Real::zero()))?,
+                span.global(Parameter::from_real(Real::one()))?,
+            )
+        };
+        let image = match image(&span.controls, surface)? {
+            Image::Point(point) => {
+                // Every point of the span lies on one latitude circle.
+                let mut on_surface = false;
+                for profile in &profiles {
+                    match profile.point_locations(&point.clone().into())? {
+                        CurvePointLocations2::Locations(locations) if locations.is_empty() => {}
+                        CurvePointLocations2::Locations(_)
+                        | CurvePointLocations2::Components(_) => on_surface = true,
+                        CurvePointLocations2::EntireCurve => {
+                            unreachable!("a noncollapsed profile image is not one point")
+                        }
+                    }
+                }
+                if on_surface {
+                    overlaps.push(local_unit()?);
+                }
+                continue;
+            }
+            Image::Curve(image) => image,
+        };
+        for profile in &profiles {
+            let intersection = image.intersect_curve(profile)?;
+            if let Some(blocker) = intersection.blockers().first() {
+                return Err(match blocker.kind() {
+                    CurveIntersectionPairBlockerKind2::Uncertain(reason) => {
+                        GeometryError::PlanarClassificationUnresolved(*reason)
+                    }
+                    CurveIntersectionPairBlockerKind2::IncompleteReplay
+                    | CurveIntersectionPairBlockerKind2::SharedComponent => {
+                        GeometryError::UnsupportedIntersection
+                    }
+                });
+            }
+            for contact in intersection.contacts() {
+                let local = contact.first().parameter()?;
+                let parameter = span.global(Parameter::from_curve(&local)?)?;
+                if !domain.contains(&parameter)? {
+                    continue;
+                }
+                // Both images are single rational spans; joints of authored
+                // splines appear in both adjacent spans and are merged below,
+                // keeping a repeated classification from either side.
+                let kind = match contact.tangent_cross_sign() {
+                    Some(sign) => classify_derivative(sign),
+                    None if contact.is_certified_transverse() => CurveSurfaceContactKind::Simple,
+                    None => {
+                        classify_one_sided(&image, &local, profile, &contact.second().parameter()?)?
+                    }
+                };
+                points.push(CurveSurfacePoint {
+                    point: curve.point_at(&parameter)?,
+                    parameter,
+                    kind,
+                });
+            }
+            // Hypercurve may promote a span internally; its ranges are local
+            // to the promoted span and are mapped back through the image.
+            let mut append_range =
+                |index, range: &hypercurve::CurveParameterRange2| -> GeometryResult<()> {
+                    let first = span.global(Parameter::from_curve(
+                        &image.parameter_from_span(index, range.start())?,
+                    )?)?;
+                    let second = span.global(Parameter::from_curve(
+                        &image.parameter_from_span(index, range.end())?,
+                    )?)?;
+                    let (start, end) = if first.compare(&second)? == Ordering::Greater {
+                        (second, first)
+                    } else {
+                        (first, second)
+                    };
+                    match start.compare(&end)? {
+                        Ordering::Less => overlaps.push(ParameterRange::new(start, end)?),
+                        Ordering::Equal => points.push(CurveSurfacePoint {
+                            point: curve.point_at(&start)?,
+                            parameter: start,
+                            kind: CurveSurfaceContactKind::Boundary,
+                        }),
+                        Ordering::Greater => {}
+                    }
+                    Ok(())
+                };
+            for overlap in intersection.overlaps() {
+                if !overlap.includes_start() || !overlap.includes_end() {
+                    return Err(GeometryError::UnsupportedIntersection);
+                }
+                append_range(overlap.first_span_index(), overlap.first_range())?;
+            }
+            for component in intersection.parameter_components() {
+                match component.first_parameters() {
+                    CurveParameterSet2::Range(range) => {
+                        append_range(component.first_span_index(), range)?
+                    }
+                    CurveParameterSet2::Single(_) => {
+                        return Err(GeometryError::UnsupportedIntersection);
+                    }
+                }
+            }
+        }
+    }
+    assemble(curve, points, overlaps)
+}
diff --git a/crates/hyperbrep/src/geometry/curve_tensor_image.rs b/crates/hyperbrep/src/geometry/curve_tensor_image.rs
new file mode 100644
index 0000000000..637bb351b8
--- /dev/null
+++ b/crates/hyperbrep/src/geometry/curve_tensor_image.rs
@@ -0,0 +1,245 @@
+//! Complete contacts between retained tensor-image curves and further surfaces.
+//!
+//! A tensor-image curve is `S(c(t))` for a UV source `c` on a positive-weight
+//! tensor `S`. A plane or implicit analytic carrier `F` meets it exactly where
+//! `c` meets the zero set of the pulled-back polynomial `G = W^k F(S/W)` on the
+//! unit square. Hypersolve decomposes that zero set completely; Hypercurve
+//! intersects `c` with every resulting branch and locates isolated points on
+//! `c`. A generated nonrational edge therefore remains intersectable with a
+//! third surface without fitting, sampling or materializing coordinates.
+
+use super::curve_implicit::ImplicitCarrier;
+use super::curve_plane::{assemble, classify_derivative};
+use super::*;
+use hypercurve::{CurveIntersectionPairBlockerKind2, CurveParameterSet2, CurvePointLocations2};
+use hypersolve::BivariatePolynomial;
+
+/// Complete exact contacts of a tensor-image curve with a plane, sphere,
+/// cylinder, cone or ring torus. Returns `None` for other surface families.
+pub(super) fn intersect_tensor_image(
+    curve: &Curve3,
+    image: &TensorCurve3,
+    surface: &Surface,
+) -> Option<GeometryResult<CurveSurfaceIntersection>> {
+    let SurfaceGeometry::RationalBezier(patch) = &image.surface.data.geometry else {
+        unreachable!("tensor images retain rational Bézier tensors");
+    };
+    let cone = match &surface.data.geometry {
+        SurfaceGeometry::Cone(cone) => Some(cone),
+        _ => None,
+    };
+    let equation = match &surface.data.geometry {
+        SurfaceGeometry::Plane(plane) => match plane_tensor::pullback(plane, patch) {
+            Ok((equation, _)) => equation,
+            Err(error) => return Some(Err(error)),
+        },
+        geometry => {
+            let carrier = ImplicitCarrier::from_surface(geometry)?;
+            let [x, y, z, weight] = surface_point::tensor_coefficients(patch);
+            implicit_tensor::pullback(carrier, [&x, &y, &z], &weight)
+        }
+    };
+    Some(intersect(curve, image, &equation, cone))
+}
+
+fn intersect(
+    curve: &Curve3,
+    image: &TensorCurve3,
+    equation: &BivariatePolynomial,
+    cone: Option<&ConeSurface>,
+) -> GeometryResult<CurveSurfaceIntersection> {
+    let mut zero = true;
+    for coefficient in equation.coefficients.iter().flatten() {
+        if decided_order(compare_reals(
+            coefficient,
+            &Real::zero(),
+            crate::STRICT_PREDICATES,
+        ))? != Ordering::Equal
+        {
+            zero = false;
+            break;
+        }
+    }
+    let domain = curve.domain();
+    if zero {
+        // The whole tensor lies on the carrier's equation. Only a cone needs a
+        // nappe decision; certify both endpoints and the whole image instead
+        // of guessing a subrange.
+        if let Some(cone) = cone {
+            let SurfaceGeometry::RationalBezier(patch) = &image.surface.data.geometry else {
+                unreachable!("tensor images retain rational Bézier tensors");
+            };
+            for row in patch.homogeneous_controls() {
+                for point in row {
+                    let axial = &cone.frame.z[0] * (&point.x - &cone.apex.x * &point.w)
+                        + &cone.frame.z[1] * (&point.y - &cone.apex.y * &point.w)
+                        + &cone.frame.z[2] * (&point.z - &cone.apex.z * &point.w);
+                    if decided_order(compare_reals(
+                        &axial,
+                        &Real::zero(),
+                        crate::STRICT_PREDICATES,
+                    ))? == Ordering::Less
+                    {
+                        return Err(GeometryError::UnsupportedIntersection);
+                    }
+                }
+            }
+        }
+        return Ok(CurveSurfaceIntersection::Contained);
+    }
+    let set = implicit_tensor::unit_square_zeros(equation)?;
+    let inverse = (Real::one() / &image.source_scale).map_err(GeometryError::Numeric)?;
+    let offset = -&image.source_offset * &inverse;
+    let spatial = |source: &hypercurve::CurveParameter2| -> GeometryResult<Parameter> {
+        Parameter::from_curve(source)?.affine_image(&inverse, &offset)
+    };
+    let source = &image.source;
+    let mut points = Vec::new();
+    let mut overlaps = Vec::new();
+    let push = |parameter: Parameter,
+                kind: CurveSurfaceContactKind,
+                points: &mut Vec<CurveSurfacePoint>|
+     -> GeometryResult<()> {
+        if !domain.contains(&parameter)? {
+            return Ok(());
+        }
+        let point = curve.point_at(&parameter)?;
+        if let Some(cone) = cone
+            && point.compare_linear_form(
+                &cone.frame.z,
+                &cone.frame.z.dot(&Vector3::from(cone.apex.clone())),
+            )? == Ordering::Less
+        {
+            // A root of the double-cone equation on the opposite nappe.
+            return Ok(());
+        }
+        points.push(CurveSurfacePoint {
+            point,
+            parameter,
+            kind,
+        });
+        Ok(())
+    };
+    for branch in &set.curves {
+        let intersection = source.intersect_curve(branch)?;
+        if let Some(blocker) = intersection.blockers().first() {
+            return Err(match blocker.kind() {
+                CurveIntersectionPairBlockerKind2::Uncertain(reason) => {
+                    GeometryError::PlanarClassificationUnresolved(*reason)
+                }
+                CurveIntersectionPairBlockerKind2::IncompleteReplay
+                | CurveIntersectionPairBlockerKind2::SharedComponent => {
+                    GeometryError::UnsupportedIntersection
+                }
+            });
+        }
+        for contact in intersection.contacts() {
+            let parameter = spatial(&contact.first().parameter()?)?;
+            // The zero set's gradient is normal to each regular branch, so a
+            // UV tangency is a zero derivative of G along the source. Without
+            // a certified sign or transversality, no tangency is claimed.
+            let kind = match contact.tangent_cross_sign() {
+                Some(sign) => classify_derivative(sign),
+                None if contact.is_certified_transverse() => CurveSurfaceContactKind::Simple,
+                None => classify_by_gradients(source, equation, contact.point())?,
+            };
+            push(parameter, kind, &mut points)?;
+        }
+        let mut append_range = |index, range: &hypercurve::CurveParameterRange2| {
+            let first = spatial(&source.parameter_from_span(index, range.start())?)?;
+            let second = spatial(&source.parameter_from_span(index, range.end())?)?;
+            let (start, end) = if first.compare(&second)? == Ordering::Greater {
+                (second, first)
+            } else {
+                (first, second)
+            };
+            match start.compare(&end)? {
+                Ordering::Less => overlaps.push(ParameterRange::new(start, end)?),
+                Ordering::Equal => push(start, CurveSurfaceContactKind::Boundary, &mut points)?,
+                Ordering::Greater => {}
+            }
+            Ok::<(), GeometryError>(())
+        };
+        for overlap in intersection.overlaps() {
+            if !overlap.includes_start() || !overlap.includes_end() {
+                return Err(GeometryError::UnsupportedIntersection);
+            }
+            append_range(overlap.first_span_index(), overlap.first_range())?;
+        }
+        for component in intersection.parameter_components() {
+            match component.first_parameters() {
+                CurveParameterSet2::Range(range) => {
+                    append_range(component.first_span_index(), range)?
+                }
+                CurveParameterSet2::Single(_) => {
+                    return Err(GeometryError::UnsupportedIntersection);
+                }
+            }
+        }
+    }
+    for isolated in &set.points {
+        // G keeps one sign around an isolated real zero, so its derivative
+        // along any curve through that point vanishes.
+        match source.point_locations(isolated)? {
+            CurvePointLocations2::Components(_) => {
+                return Err(GeometryError::UnsupportedIntersection);
+            }
+            CurvePointLocations2::EntireCurve => {
+                unreachable!("a noncollapsed source is not one point")
+            }
+            CurvePointLocations2::Locations(locations) => {
+                for location in locations {
+                    let parameter = spatial(&location.parameter()?)?;
+                    push(parameter, CurveSurfaceContactKind::Repeated, &mut points)?;
+                }
+            }
+        }
+    }
+    assemble(curve, points, overlaps)
+}
+
+/// Exact contact kind at a point `P` where Hypercurve supplies no crossing
+/// certificate, such as a topology event at a branch endpoint.
+///
+/// Near a regular point of the source's defining equation `f = 0`, the source
+/// is a smooth arc with tangent `(-f_v, f_u)`, so `dG/dt` vanishes exactly when
+/// `f_u G_v - f_v G_u = 0`. At a singular point of `f` the arc's tangent is not
+/// determined by `f`, and no classification is claimed.
+fn classify_by_gradients(
+    source: &Curve2,
+    equation: &BivariatePolynomial,
+    point: &hypercurve::CurvePoint2,
+) -> GeometryResult<CurveSurfaceContactKind> {
+    use hypersolve::CurveResultantParameter::{First, Second};
+    use hypersolve::bivariate_arithmetic::{
+        bivariate_multiply, bivariate_parameter_derivative, bivariate_subtract,
+    };
+    let source = source
+        .source_restriction()
+        .map_or(source, |(original, _, _)| original);
+    let Some(branch) = source.polynomial_branch() else {
+        return Err(GeometryError::UnsupportedIntersection);
+    };
+    let defining = branch.topology().geometric_equation();
+    let one = BivariatePolynomial::new(vec![vec![Real::one()]]);
+    let vanishes = |polynomial: &BivariatePolynomial| -> GeometryResult<bool> {
+        Ok(point
+            .rational_form(polynomial.clone(), one.clone())?
+            .compare_to_real(&Real::zero())?
+            == Ordering::Equal)
+    };
+    let fu = bivariate_parameter_derivative(defining, First);
+    let fv = bivariate_parameter_derivative(defining, Second);
+    if vanishes(&fu)? && vanishes(&fv)? {
+        return Err(GeometryError::UnsupportedIntersection);
+    }
+    let jacobian = bivariate_subtract(
+        &bivariate_multiply(&fu, &bivariate_parameter_derivative(equation, Second)),
+        &bivariate_multiply(&fv, &bivariate_parameter_derivative(equation, First)),
+    );
+    Ok(if vanishes(&jacobian)? {
+        CurveSurfaceContactKind::Repeated
+    } else {
+        CurveSurfaceContactKind::Simple
+    })
+}
diff --git a/crates/hyperbrep/src/geometry/cylinder_atlas.rs b/crates/hyperbrep/src/geometry/cylinder_atlas.rs
new file mode 100644
index 0000000000..ce171ab38e
--- /dev/null
+++ b/crates/hyperbrep/src/geometry/cylinder_atlas.rs
@@ -0,0 +1,418 @@
+//! Complete sections of a native cylinder by a bounded or transverse carrier.
+//!
+//! A cylinder meets a sphere, a ring torus, or a cylinder with a nonparallel
+//! axis only inside an exactly bounded height range. That finite portion of
+//! the cylinder is covered by an exact atlas of ten rational quadratic tensor
+//! patches whose arc endpoints have half-angle tangents `0, ±5/12, ±3/4,
+//! ±4/3, ±12/5, ∞`: every endpoint, middle control and weight is rational in
+//! the cylinder's own frame. Each patch is sectioned by the complete
+//! implicit/tensor route, and the exact pieces are published together.
+//!
+//! The atlas is an internal exact chart, not either operand's authored chart.
+//! Pieces therefore carry no operand pcurves, and adjacent pieces meet at
+//! atlas seams that need not be physical vertices.
+
+use super::curve_implicit::ImplicitCarrier;
+use super::*;
+
+/// Half-angle tangents `n/d` of the upper atlas points; `1 + t^2` is a square.
+/// Upper half-angle tangents of the fine cylinder atlas (ten arcs).
+pub(super) const FINE_TANGENTS: &[(i64, i64)] = &[(0, 1), (5, 12), (3, 4), (4, 3), (12, 5)];
+
+/// Upper half-angle tangents of the coarse atlas (four arcs of about 106 and
+/// 74 degrees), used where each patch section is costly.
+pub(super) const COARSE_TANGENTS: &[(i64, i64)] = &[(0, 1), (4, 3)];
+
+/// Intersects `cylinder` with `other`, whose intersection with the cylinder is
+/// bounded. `cylinder_operand` names the cylinder's position in the query.
+pub(super) fn intersect(
+    cylinder: &CylinderSurface,
+    other: ImplicitCarrier<'_>,
+    cylinder_operand: SurfaceIntersectionOperand,
+) -> GeometryResult<SurfaceSurfaceIntersection> {
+    let height = height_bound(cylinder, other)?;
+    section_patches(atlas(cylinder, &height)?, other, cylinder_operand)
+}
+
+/// Sections every exact atlas patch of one operand by `other` and publishes
+/// the complete set of exact pieces and deduplicated isolated points.
+///
+/// The atlas is an internal exact chart, so no operand pcurve is claimed and
+/// pieces may meet at seams that are not physical vertices.
+pub(super) fn section_patches(
+    patches: Vec<Surface>,
+    other: ImplicitCarrier<'_>,
+    atlas_operand: SurfaceIntersectionOperand,
+) -> GeometryResult<SurfaceSurfaceIntersection> {
+    section_patches_with_adjacency(patches, other, atlas_operand, None)
+}
+
+/// How the closed images of two distinct atlas patches meet.
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(super) enum PatchContact {
+    /// Disjoint closed images.
+    Disjoint,
+    /// A shared boundary curve (or unknown): boundary points may coincide.
+    Edge,
+    /// A shared boundary curve on which UV coordinate `0` (u) or `1` (v) is
+    /// a boundary value in both patches.
+    EdgeAlong(usize),
+    /// Only a shared corner: just UV corner points may coincide.
+    Corner,
+}
+
+/// [`section_patches`] with an optional exact contact relation on distinct
+/// patch indices, used to skip spatial comparisons of results that cannot
+/// coincide.
+pub(super) fn section_patches_with_adjacency(
+    patches: Vec<Surface>,
+    other: ImplicitCarrier<'_>,
+    atlas_operand: SurfaceIntersectionOperand,
+    adjacent: Option<&dyn Fn(usize, usize) -> PatchContact>,
+) -> GeometryResult<SurfaceSurfaceIntersection> {
+    // Atlas patches are injective charts whose images meet only along shared
+    // patch boundaries. Results of one patch are already distinct (an
+    // isolated zero lies on no branch), and results of different patches can
+    // coincide only when both lie on their patches' UV boundaries, so exact
+    // spatial comparisons are spent only on such pairs.
+    // Per UV coordinate, whether it may equal a boundary value 0 or 1 (an
+    // undecided comparison counts as possibly equal).
+    let boundary_coordinates = |point: &GeometricPoint3| -> [bool; 2] {
+        let Some((_, uv)) = point.surface_source() else {
+            return [true, true];
+        };
+        [(Real::one(), Real::zero()), (Real::zero(), Real::one())].map(|(a, b)| {
+            let coordinate = uv.affine_form(a, b, Real::zero());
+            [Real::zero(), Real::one()].iter().any(|value| {
+                !matches!(
+                    coordinate.compare_to_real(value),
+                    Ok(Ordering::Less | Ordering::Greater)
+                )
+            })
+        })
+    };
+    let may_coincide = |first: (&GeometricPoint3, usize),
+                        second: (&GeometricPoint3, usize)|
+     -> GeometryResult<bool> {
+        if first.1 == second.1 {
+            return Ok(false);
+        }
+        let contact = adjacent.map_or(PatchContact::Edge, |adjacent| adjacent(first.1, second.1));
+        let (a, b) = (
+            boundary_coordinates(first.0),
+            boundary_coordinates(second.0),
+        );
+        Ok(match contact {
+            PatchContact::Disjoint => false,
+            PatchContact::Edge => (a[0] || a[1]) && (b[0] || b[1]),
+            PatchContact::EdgeAlong(index) => a[index] && b[index],
+            PatchContact::Corner => a[0] && a[1] && b[0] && b[1],
+        })
+    };
+    let mut points = Vec::<(GeometricPoint3, usize)>::new();
+    let mut curves = Vec::new();
+    let mut curve_patches = Vec::<usize>::new();
+    let other_bounds = carrier_bounds(other);
+    for (patch_index, patch) in patches.into_iter().enumerate() {
+        // A positive-weight patch lies in its control hull; an exactly
+        // disjoint box cannot meet a bounded carrier.
+        if let (Some(other_bounds), SurfaceBounds::Bounded(patch_bounds)) =
+            (&other_bounds, patch.bounds()?)
+            && boxes_disjoint(&patch_bounds, other_bounds)?
+        {
+            continue;
+        }
+        // Each patch is an injective chart: an arc of less than one turn
+        // (injective in angle) times an injective height or meridian chart.
+        let section = implicit_tensor::intersect_with(
+            other,
+            &patch,
+            atlas_operand,
+            implicit_tensor::Injectivity::ByConstruction,
+        )?;
+        let (patch_points, patch_curves) = match section {
+            SurfaceSurfaceIntersection::None => (Vec::new(), Vec::new()),
+            SurfaceSurfaceIntersection::Point(point) => (vec![*point], Vec::new()),
+            SurfaceSurfaceIntersection::Points(points) => (points, Vec::new()),
+            SurfaceSurfaceIntersection::Curve(curve) => (Vec::new(), vec![*curve]),
+            SurfaceSurfaceIntersection::Curves(curves) => (Vec::new(), curves),
+            SurfaceSurfaceIntersection::Components(components) => (
+                components.points().to_vec(),
+                components.surface_curves().to_vec(),
+            ),
+            // The admitted carriers cannot contain an atlas patch of the operand.
+            _ => return Err(GeometryError::UnsupportedIntersection),
+        };
+        'point: for point in patch_points {
+            // A point on an atlas seam is reported by both adjacent patches.
+            for (existing, existing_patch) in &points {
+                if may_coincide((existing, *existing_patch), (&point, patch_index))?
+                    && existing.coincides_with(&point)?
+                {
+                    continue 'point;
+                }
+            }
+            points.push((point, patch_index));
+        }
+        for section in patch_curves {
+            let curve = section.curve().clone();
+            let domain = curve.domain().clone();
+            let mut piece = SurfaceIntersectionCurve::new(
+                curve,
+                SurfaceIntersectionPcurve::unsupported(domain.clone()),
+                SurfaceIntersectionPcurve::unsupported(domain),
+            );
+            piece.image_certificates = [false, false];
+            piece.polynomial_contact_exponent = section.polynomial_contact_exponent;
+            curves.push(piece);
+            curve_patches.push(patch_index);
+        }
+    }
+    // Isolated contacts lying on a published piece are part of that piece.
+    let mut isolated = Vec::with_capacity(points.len());
+    'isolated: for (point, point_patch) in points {
+        for (piece, piece_patch) in curves.iter().zip(&curve_patches) {
+            let curve = piece.curve();
+            for parameter in [curve.domain().start(), curve.domain().end()] {
+                let end = curve.point_at(parameter)?;
+                if may_coincide((&end, *piece_patch), (&point, point_patch))?
+                    && end.coincides_with(&point)?
+                {
+                    continue 'isolated;
+                }
+            }
+        }
+        isolated.push(point);
+    }
+    Ok(match (isolated.len(), curves.len()) {
+        (0, 0) => SurfaceSurfaceIntersection::None,
+        (1, 0) => SurfaceSurfaceIntersection::Point(Box::new(isolated.pop().expect("one point"))),
+        (_, 0) => SurfaceSurfaceIntersection::Points(isolated),
+        (0, 1) => SurfaceSurfaceIntersection::Curve(Box::new(curves.pop().expect("one curve"))),
+        (0, _) => SurfaceSurfaceIntersection::Curves(curves),
+        _ => SurfaceSurfaceIntersection::Components(Box::new(SurfaceIntersectionComponents::new(
+            isolated,
+            Vec::new(),
+            curves,
+        ))),
+    })
+}
+
+/// A rational `H` with every intersection point strictly inside the cylinder
+/// heights `(-H, H)`, found by exact doubling against a certified bound.
+fn height_bound(cylinder: &CylinderSurface, other: ImplicitCarrier<'_>) -> GeometryResult<Real> {
+    let axis = &cylinder.frame.z;
+    let absolute = |value: Real| -> GeometryResult<Real> {
+        Ok(
+            if decided_order(compare_reals(
+                &value,
+                &Real::zero(),
+                crate::STRICT_PREDICATES,
+            ))? == Ordering::Less
+            {
+                -value
+            } else {
+                value
+            },
+        )
+    };
+    // Bound `B` and positive scale `s` with |h| * s <= B for every common point.
+    let (bound, scale_squared) = match other {
+        ImplicitCarrier::Sphere(sphere) => (
+            absolute(axis.dot(&(&sphere.center - &cylinder.origin)))? + &sphere.radius,
+            Real::one(),
+        ),
+        ImplicitCarrier::Torus(torus) => (
+            absolute(axis.dot(&(&torus.center - &cylinder.origin)))?
+                + &torus.major_radius
+                + &torus.minor_radius,
+            Real::one(),
+        ),
+        ImplicitCarrier::Cylinder(second) => {
+            // Distance to the second axis is at least |h| |a1 x a2| minus the
+            // origin offset and first radius; it equals the second radius.
+            let offset = &second.origin - &cylinder.origin;
+            let mut bound = &cylinder.radius + &second.radius;
+            for i in 0..3 {
+                bound += absolute(offset[i].clone())?;
+            }
+            (bound, axis.cross(&second.frame.z).norm_squared())
+        }
+        ImplicitCarrier::Cone(_) => return Err(GeometryError::UnsupportedIntersection),
+    };
+    if decided_order(compare_reals(
+        &scale_squared,
+        &Real::zero(),
+        crate::STRICT_PREDICATES,
+    ))? != Ordering::Greater
+    {
+        return Err(GeometryError::UnsupportedIntersection);
+    }
+    let bound_squared = &bound * &bound;
+    let mut height = Real::one();
+    for _ in 0..128 {
+        if decided_order(compare_reals(
+            &(&height * &height * &scale_squared),
+            &bound_squared,
+            crate::STRICT_PREDICATES,
+        ))? == Ordering::Greater
+        {
+            return Ok(height);
+        }
+        height *= Real::from(2);
+    }
+    Err(GeometryError::UnsupportedIntersection)
+}
+
+/// One exact rational quadratic arc of the unit circle: end points, the
+/// tangent intersection and the middle weight cos(half angle), all rational.
+pub(super) struct UnitArc {
+    pub(super) start: (Real, Real),
+    pub(super) middle: (Real, Real),
+    pub(super) end: (Real, Real),
+    pub(super) weight: Real,
+}
+
+/// Atlas arcs of the unit circle, counterclockwise from (1, 0), whose seams
+/// have the given upper half-angle tangents (each with `1 + t^2` a square),
+/// their mirror images, and infinity.
+pub(super) fn unit_arcs(tangents: &[(i64, i64)]) -> GeometryResult<Vec<UnitArc>> {
+    let mut circle = Vec::with_capacity(2 * tangents.len());
+    for &(numerator, denominator) in tangents {
+        let t =
+            (Real::from(numerator) / Real::from(denominator)).map_err(GeometryError::Numeric)?;
+        let scale = Real::one() + &t * &t;
+        circle.push((
+            ((Real::one() - &t * &t) / scale.clone()).map_err(GeometryError::Numeric)?,
+            ((Real::from(2) * t) / scale).map_err(GeometryError::Numeric)?,
+        ));
+    }
+    circle.push((-Real::one(), Real::zero()));
+    let lower = circle[1..circle.len() - 1]
+        .iter()
+        .rev()
+        .map(|(x, y)| (x.clone(), -y.clone()))
+        .collect::<Vec<_>>();
+    circle.extend(lower);
+    let mut arcs = Vec::with_capacity(circle.len());
+    for index in 0..circle.len() {
+        let (px, py) = circle[index].clone();
+        let (qx, qy) = circle[(index + 1) % circle.len()].clone();
+        // The tangents at unit points p and q meet at (p + q)/(1 + p·q); the
+        // middle weight is cos(half angle) = sqrt((1 + p·q)/2), rational here.
+        let sum = Real::one() + &px * &qx + &py * &qy;
+        let middle = (
+            ((&px + &qx) / sum.clone()).map_err(GeometryError::Numeric)?,
+            ((&py + &qy) / sum.clone()).map_err(GeometryError::Numeric)?,
+        );
+        let weight = ((sum / Real::from(2)).map_err(GeometryError::Numeric)?)
+            .sqrt()
+            .map_err(GeometryError::Numeric)?;
+        arcs.push(UnitArc {
+            start: (px, py),
+            middle,
+            end: (qx, qy),
+            weight,
+        });
+    }
+    Ok(arcs)
+}
+
+/// Exact rational quadratic patches covering the cylinder for |h| <= H.
+fn atlas(cylinder: &CylinderSurface, height: &Real) -> GeometryResult<Vec<Surface>> {
+    let frame = &cylinder.frame;
+    let lift = |x: &Real, y: &Real, h: &Real| {
+        cylinder.origin.clone()
+            + frame.x.clone() * (&cylinder.radius * x)
+            + frame.y.clone() * (&cylinder.radius * y)
+            + frame.z.clone() * h
+    };
+    let arcs = unit_arcs(FINE_TANGENTS)?;
+    let mut patches = Vec::with_capacity(arcs.len());
+    for arc in &arcs {
+        let low = -height.clone();
+        let row = |(x, y): &(Real, Real)| vec![lift(x, y, &low), lift(x, y, height)];
+        patches.push(Surface::rational_bezier(
+            vec![row(&arc.start), row(&arc.middle), row(&arc.end)],
+            vec![
+                vec![Real::one(), Real::one()],
+                vec![arc.weight.clone(), arc.weight.clone()],
+                vec![Real::one(), Real::one()],
+            ],
+        )?);
+    }
+    Ok(patches)
+}
+
+/// Whether a supported special route owns the pair: parallel cylinder axes, or
+/// a sphere or torus centred on the cylinder axis (torus axis parallel too).
+pub(super) fn special_route_applies(
+    cylinder: &CylinderSurface,
+    other: ImplicitCarrier<'_>,
+) -> GeometryResult<bool> {
+    let zero = |value: &Real| -> GeometryResult<bool> {
+        Ok(decided_order(compare_reals(
+            value,
+            &Real::zero(),
+            crate::STRICT_PREDICATES,
+        ))? == Ordering::Equal)
+    };
+    let axis = &cylinder.frame.z;
+    let off_axis = |center: &Point3| -> GeometryResult<bool> {
+        let offset = center - &cylinder.origin;
+        let radial = &offset - &(axis.clone() * axis.dot(&offset));
+        Ok(!zero(&radial.norm_squared())?)
+    };
+    Ok(match other {
+        ImplicitCarrier::Cylinder(second) => zero(&axis.cross(&second.frame.z).norm_squared())?,
+        ImplicitCarrier::Sphere(sphere) => !off_axis(&sphere.center)?,
+        ImplicitCarrier::Torus(torus) => {
+            zero(&axis.cross(&torus.frame.z).norm_squared())? && !off_axis(&torus.center)?
+        }
+        ImplicitCarrier::Cone(_) => true,
+    })
+}
+
+/// An exact box containing a bounded carrier, or `None` when unbounded.
+fn carrier_bounds(carrier: ImplicitCarrier<'_>) -> Option<Aabb> {
+    let cube = |center: &Point3, half: Real| {
+        Aabb::new(
+            Point3::new(&center.x - &half, &center.y - &half, &center.z - &half),
+            Point3::new(&center.x + &half, &center.y + &half, &center.z + &half),
+        )
+    };
+    match carrier {
+        ImplicitCarrier::Sphere(sphere) => Some(cube(&sphere.center, sphere.radius.clone())),
+        ImplicitCarrier::Torus(torus) => Some(cube(
+            &torus.center,
+            &torus.major_radius + &torus.minor_radius,
+        )),
+        ImplicitCarrier::Cylinder(_) | ImplicitCarrier::Cone(_) => None,
+    }
+}
+
+/// Whether two exact boxes are strictly separated along some axis.
+fn boxes_disjoint(first: &Aabb, second: &Aabb) -> GeometryResult<bool> {
+    let less = |a: &Real, b: &Real| -> GeometryResult<bool> {
+        Ok(decided_order(compare_reals(a, b, crate::STRICT_PREDICATES))? == Ordering::Less)
+    };
+    for (a, b) in [
+        (
+            (&first.mins.x, &first.maxs.x),
+            (&second.mins.x, &second.maxs.x),
+        ),
+        (
+            (&first.mins.y, &first.maxs.y),
+            (&second.mins.y, &second.maxs.y),
+        ),
+        (
+            (&first.mins.z, &first.maxs.z),
+            (&second.mins.z, &second.maxs.z),
+        ),
+    ] {
+        if less(a.1, b.0)? || less(b.1, a.0)? {
+            return Ok(true);
+        }
+    }
+    Ok(false)
+}
diff --git a/crates/hyperbrep/src/geometry/implicit_tensor.rs b/crates/hyperbrep/src/geometry/implicit_tensor.rs
new file mode 100644
index 0000000000..1bcc961301
--- /dev/null
+++ b/crates/hyperbrep/src/geometry/implicit_tensor.rs
@@ -0,0 +1,699 @@
+//! Complete sections of rational Bézier tensors by implicit analytic carriers.
+//!
+//! The homogenized sphere, cylinder, cone or ring-torus equation pulled back
+//! through a positive-weight tensor is one bivariate polynomial on the unit
+//! square. Hypersolve decomposes its complete real zero set there; every
+//! branch keeps its selected UV source and lifts through the original tensor
+//! as a retained [`Curve3::tensor_image`]. No branch is fitted, sampled or
+//! converted to a fixed-degree rational curve.
+
+use super::curve_implicit::ImplicitCarrier;
+use super::*;
+use hypercurve::{PolynomialCurveSet2, RationalMap2};
+use hypersolve::bivariate_arithmetic::{
+    bivariate_add, bivariate_multiply, bivariate_scale, bivariate_subtract,
+};
+use hypersolve::bivariate_topology::{
+    BivariateCurveDomain, BivariateTopologyConfig, decompose_bivariate_curve,
+};
+use hypersolve::{AlgebraicFiberRootIsolationConfig, BivariatePolynomial};
+
+/// Intersects an implicit carrier with a rational Bézier tensor.
+///
+/// The tensor is `tensor_operand` of the original query. Its pcurves are the
+/// retained UV branches; the analytic carrier's angular pcurves are not
+/// algebraic in general and are published as unavailable rather than fitted.
+pub(super) fn intersect(
+    carrier: ImplicitCarrier<'_>,
+    tensor: &Surface,
+    tensor_operand: SurfaceIntersectionOperand,
+) -> GeometryResult<SurfaceSurfaceIntersection> {
+    intersect_with(carrier, tensor, tensor_operand, Injectivity::Certify)
+}
+
+/// How a tensor's injectivity on the unit square is established.
+#[derive(Clone, Copy)]
+pub(super) enum Injectivity {
+    /// Require an injective coordinate-plane projection certificate.
+    Certify,
+    /// The caller constructed the tensor as an injective exact chart, such as
+    /// an atlas patch of a cylinder or ring torus with arcs under one turn.
+    ByConstruction,
+}
+
+pub(super) fn intersect_with(
+    carrier: ImplicitCarrier<'_>,
+    tensor: &Surface,
+    tensor_operand: SurfaceIntersectionOperand,
+    injectivity: Injectivity,
+) -> GeometryResult<SurfaceSurfaceIntersection> {
+    let SurfaceGeometry::RationalBezier(patch) = &tensor.data.geometry else {
+        return Err(GeometryError::UnsupportedIntersection);
+    };
+    if let ImplicitCarrier::Cone(cone) = carrier {
+        // Positive weights keep the patch in its control hull. A hull on the
+        // closed upper side of the apex plane meets only the native nappe of
+        // the double-cone equation, and a hull strictly below it misses the
+        // nappe entirely. Other patches need a nappe selection.
+        let mut signs = [false; 3];
+        for row in patch.homogeneous_controls() {
+            for point in row {
+                let axial = &cone.frame.z[0] * (&point.x - &cone.apex.x * &point.w)
+                    + &cone.frame.z[1] * (&point.y - &cone.apex.y * &point.w)
+                    + &cone.frame.z[2] * (&point.z - &cone.apex.z * &point.w);
+                signs[match decided_order(compare_reals(
+                    &axial,
+                    &Real::zero(),
+                    crate::STRICT_PREDICATES,
+                ))? {
+                    Ordering::Less => 0,
+                    Ordering::Equal => 1,
+                    Ordering::Greater => 2,
+                }] = true;
+            }
+        }
+        if signs == [true, false, false] {
+            return Ok(SurfaceSurfaceIntersection::None);
+        }
+        if signs[0] {
+            return Err(GeometryError::UnsupportedIntersection);
+        }
+    }
+    let [x, y, z, weight] = surface_point::tensor_coefficients(patch);
+    let equation = pullback(carrier, [&x, &y, &z], &weight);
+    let mut zero = true;
+    for coefficient in equation.coefficients.iter().flatten() {
+        if decided_order(compare_reals(
+            coefficient,
+            &Real::zero(),
+            crate::STRICT_PREDICATES,
+        ))? != Ordering::Equal
+        {
+            zero = false;
+            break;
+        }
+    }
+    if zero {
+        return Ok(SurfaceSurfaceIntersection::ContainedSurface(tensor_operand));
+    }
+    let set = unit_square_zeros(&equation)?;
+    if set.curves.is_empty() && set.points.is_empty() {
+        return Ok(SurfaceSurfaceIntersection::None);
+    }
+    // Distinct UV components are distinct spatial components only when the
+    // tensor is injective on the square. An injective coordinate-plane
+    // projection is a sufficient whole-rectangle certificate; without one,
+    // no incomplete or overlapping trace is published as complete.
+    if matches!(injectivity, Injectivity::Certify) {
+        certify_injective_tensor([&x, &y, &z], &weight)?;
+    }
+    tensor_image_sections(tensor, &set, tensor_operand)
+}
+
+/// Publishes a complete unit-square zero set of an injective tensor as
+/// tensor-image sections. The tensor's pcurves are the retained UV branches;
+/// the other operand's pcurves are published as unavailable, not fitted.
+pub(super) fn tensor_image_sections(
+    tensor: &Surface,
+    set: &UnitSquareZeros,
+    tensor_operand: SurfaceIntersectionOperand,
+) -> GeometryResult<SurfaceSurfaceIntersection> {
+    let mut curves = Vec::with_capacity(set.curves.len());
+    for uv in &set.curves {
+        // The spatial chart equals the source chart, matching the retained
+        // pcurve's identity correspondence.
+        let curve = Curve3::from_tensor_image(TensorCurve3 {
+            surface: tensor.clone(),
+            source: uv.clone(),
+            source_scale: Real::one(),
+            source_offset: Real::zero(),
+        })?;
+        let retained = SurfaceIntersectionPcurve::retained_curve(uv.clone())?;
+        let unavailable = SurfaceIntersectionPcurve::unsupported(curve.domain().clone());
+        let mut section = match tensor_operand {
+            SurfaceIntersectionOperand::First => {
+                SurfaceIntersectionCurve::new(curve, retained, unavailable)
+            }
+            SurfaceIntersectionOperand::Second => {
+                SurfaceIntersectionCurve::new(curve, unavailable, retained)
+            }
+        };
+        section.image_certificates = match tensor_operand {
+            SurfaceIntersectionOperand::First => [true, false],
+            SurfaceIntersectionOperand::Second => [false, true],
+        };
+        // A reflected branch keeps its original selected graph and exponent.
+        section.polynomial_contact_exponent = uv
+            .polynomial_branch()
+            .map(|branch| branch.defining_exponent());
+        curves.push(section);
+    }
+    let mut points = set
+        .points
+        .iter()
+        .map(|uv| tensor.point_at(uv))
+        .collect::<GeometryResult<Vec<_>>>()?;
+    Ok(match (points.len(), curves.len()) {
+        (0, 0) => SurfaceSurfaceIntersection::None,
+        (1, 0) => SurfaceSurfaceIntersection::Point(Box::new(points.pop().expect("one point"))),
+        (_, 0) => SurfaceSurfaceIntersection::Points(points),
+        (0, 1) => SurfaceSurfaceIntersection::Curve(Box::new(curves.pop().expect("one curve"))),
+        (0, _) => SurfaceSurfaceIntersection::Curves(curves),
+        _ => SurfaceSurfaceIntersection::Components(Box::new(SurfaceIntersectionComponents::new(
+            points,
+            Vec::new(),
+            curves,
+        ))),
+    })
+}
+
+/// `W^k F(X/W)` for the homogeneous tensor coordinates.
+pub(super) fn pullback(
+    carrier: ImplicitCarrier<'_>,
+    coordinates: [&BivariatePolynomial; 3],
+    weight: &BivariatePolynomial,
+) -> BivariatePolynomial {
+    let origin = carrier.origin();
+    let axis = carrier.axis();
+    let origin = [&origin.x, &origin.y, &origin.z];
+    let displacement: [BivariatePolynomial; 3] = std::array::from_fn(|i| {
+        bivariate_subtract(coordinates[i], &bivariate_scale(weight.clone(), origin[i]))
+    });
+    let square = |p: &BivariatePolynomial| bivariate_multiply(p, p);
+    let squared_norm = bivariate_add(
+        &bivariate_add(&square(&displacement[0]), &square(&displacement[1])),
+        &square(&displacement[2]),
+    );
+    let axial = (0..3).fold(BivariatePolynomial::new(Vec::new()), |sum, i| {
+        bivariate_add(&sum, &bivariate_scale(displacement[i].clone(), &axis[i]))
+    });
+    let weight_squared = square(weight);
+    let radial_squared = || bivariate_subtract(&squared_norm, &square(&axial));
+    match carrier {
+        ImplicitCarrier::Sphere(surface) => bivariate_subtract(
+            &squared_norm,
+            &bivariate_scale(weight_squared, &(&surface.radius * &surface.radius)),
+        ),
+        ImplicitCarrier::Cylinder(surface) => bivariate_subtract(
+            &radial_squared(),
+            &bivariate_scale(weight_squared, &(&surface.radius * &surface.radius)),
+        ),
+        ImplicitCarrier::Cone(surface) => {
+            let sin = surface.semi_angle.clone().sin();
+            let cos = surface.semi_angle.clone().cos();
+            bivariate_subtract(
+                &bivariate_scale(radial_squared(), &(&cos * &cos)),
+                &bivariate_scale(square(&axial), &(&sin * &sin)),
+            )
+        }
+        ImplicitCarrier::Torus(surface) => {
+            let major_squared = &surface.major_radius * &surface.major_radius;
+            let minor_squared = &surface.minor_radius * &surface.minor_radius;
+            let shifted = bivariate_add(
+                &squared_norm,
+                &bivariate_scale(weight_squared.clone(), &(&major_squared - minor_squared)),
+            );
+            bivariate_subtract(
+                &square(&shifted),
+                &bivariate_scale(
+                    bivariate_multiply(&weight_squared, &radial_squared()),
+                    &(Real::from(4) * major_squared),
+                ),
+            )
+        }
+    }
+}
+
+pub(super) fn certify_injective_tensor(
+    coordinates: [&BivariatePolynomial; 3],
+    weight: &BivariatePolynomial,
+) -> GeometryResult<()> {
+    let rectangle = match hypercurve::Aabb2::from_points(&[
+        CurvePoint2::new(Real::zero(), Real::zero()),
+        CurvePoint2::new(Real::one(), Real::one()),
+    ]) {
+        Classification::Decided(value) => value,
+        Classification::Uncertain(_) => return Err(GeometryError::UnsupportedIntersection),
+    };
+    for (first, second) in [(0, 1), (0, 2), (1, 2)] {
+        let map = RationalMap2::new(
+            [coordinates[first].clone(), coordinates[second].clone()],
+            weight.clone(),
+        );
+        if map.certify_injective_on(&rectangle).is_ok() {
+            return Ok(());
+        }
+    }
+    Err(GeometryError::UnsupportedIntersection)
+}
+
+/// The complete real zero set of a bivariate polynomial on the unit square:
+/// selected branches and isolated points in the original UV chart.
+pub(super) struct UnitSquareZeros {
+    pub(super) curves: Vec<Curve2>,
+    pub(super) points: Vec<hypercurve::CurvePoint2>,
+}
+
+/// Decomposes `equation` on the unit square. The topology projects over one
+/// coordinate and reports lines on which it is constant as vertical
+/// components. Such a set is first split exactly into its pure-`u` factor,
+/// pure-`v` factor and primitive remainder: pure-`u` components become exact
+/// chords `u = r`, the other parts decompose natively, branches of different
+/// parts are split at their exact crossings, and isolated points lying on
+/// another part are dropped. When that fails (for example a pure-`u` root
+/// without a scalar view), the set is decomposed with exchanged coordinates
+/// and mapped back through the exact reflection `(u, v) -> (v, u)`, which
+/// retains every selected branch, fiber and source authority. Other
+/// blockers remain typed.
+pub(super) fn unit_square_zeros(equation: &BivariatePolynomial) -> GeometryResult<UnitSquareZeros> {
+    use hypersolve::bivariate_topology::BivariateTopologyError;
+    let vertical = |error: &GeometryError| {
+        matches!(
+            error,
+            GeometryError::PolynomialTopology(BivariateTopologyError::VerticalComponent)
+        )
+    };
+    match native_zeros(equation) {
+        Err(error) if vertical(&error) => match axis_factor_zeros(equation) {
+            Ok(zeros) => Ok(zeros),
+            Err(axis_error) => match swapped_zeros(equation) {
+                Err(error) if vertical(&error) => Err(axis_error),
+                other => other,
+            },
+        },
+        other => other,
+    }
+}
+
+fn decompose_unit_square(equation: &BivariatePolynomial) -> GeometryResult<PolynomialCurveSet2> {
+    let domain = BivariateCurveDomain {
+        first: [Real::zero(), Real::one()],
+        second: [Real::zero(), Real::one()],
+    };
+    let topology = decompose_bivariate_curve(equation, &domain, BivariateTopologyConfig::default())
+        .map_err(GeometryError::PolynomialTopology)?;
+    Ok(PolynomialCurveSet2::from_topology(
+        topology,
+        AlgebraicFiberRootIsolationConfig::default(),
+    )?)
+}
+
+fn native_zeros(equation: &BivariatePolynomial) -> GeometryResult<UnitSquareZeros> {
+    let set = decompose_unit_square(equation)?;
+    Ok(UnitSquareZeros {
+        curves: set.curves().to_vec(),
+        points: set.isolated_points().to_vec(),
+    })
+}
+
+fn swapped_zeros(equation: &BivariatePolynomial) -> GeometryResult<UnitSquareZeros> {
+    use hypersolve::bivariate_arithmetic::bivariate_swap_parameters;
+    let set = decompose_unit_square(&bivariate_swap_parameters(equation))?;
+    let swap = RationalMap2::new(
+        [
+            BivariatePolynomial::new(vec![vec![Real::zero(), Real::one()]]),
+            BivariatePolynomial::new(vec![vec![Real::zero()], vec![Real::one()]]),
+        ],
+        BivariatePolynomial::new(vec![vec![Real::one()]]),
+    );
+    Ok(UnitSquareZeros {
+        curves: set
+            .curves()
+            .iter()
+            .map(|curve| curve.rational_image(&swap))
+            .collect::<Result<_, _>>()?,
+        points: set
+            .isolated_points()
+            .iter()
+            .map(|point| point.rational_image(&swap))
+            .collect::<Result<_, _>>()?,
+    })
+}
+
+/// The zero set of `f(u) g(v) R(u, v)` as the union of the three parts' zero
+/// sets, with branches split at their mutual crossings. The factors come from
+/// Hypersolve's exact axis-content extraction, so the parts share no curve
+/// component and meet only at finitely many points.
+fn axis_factor_zeros(equation: &BivariatePolynomial) -> GeometryResult<UnitSquareZeros> {
+    use super::curve_implicit;
+    use hypersolve::bivariate_topology::BivariateTopologyError;
+    use hypersolve::curve_resultant::{
+        BivariatePolynomialAxisFactorStatus, extract_bivariate_polynomial_system_axis_factors,
+    };
+    let report = extract_bivariate_polynomial_system_axis_factors(equation, equation);
+    if report.status != BivariatePolynomialAxisFactorStatus::Reduced {
+        return Err(GeometryError::PolynomialTopology(
+            BivariateTopologyError::VerticalComponent,
+        ));
+    }
+    let [remainder, _] = report
+        .reduced_equations
+        .expect("a reduced axis-factor report carries its primitive equations");
+    // The pure-u factor's components are the vertical chords u = r over its
+    // roots in [0, 1]. Hypercurve's native line authority intersects chords
+    // with branches of either remaining part in their own chart; a root
+    // without a scalar view has no exact chord yet and stays typed.
+    let mut chords = Vec::new();
+    let mut parts = Vec::new();
+    if report.first_parameter_factor.len() > 1 {
+        for (root, _) in curve_implicit::roots(power_to_bernstein(&report.first_parameter_factor))?
+        {
+            let Some(value) = root.try_real() else {
+                return Err(GeometryError::UnsupportedIntersection);
+            };
+            chords.push(Curve2::from(hypercurve::LineSeg2::try_new(
+                hypercurve::Point2::new(value.clone(), Real::zero()),
+                hypercurve::Point2::new(value.clone(), Real::one()),
+            )?));
+        }
+        parts.push(BivariatePolynomial::new(
+            report
+                .first_parameter_factor
+                .iter()
+                .map(|coefficient| vec![coefficient.clone()])
+                .collect(),
+        ));
+    }
+    if report.second_parameter_factor.len() > 1 {
+        parts.push(BivariatePolynomial::new(vec![
+            report.second_parameter_factor.clone(),
+        ]));
+    }
+    let remainder_is_constant = remainder.coefficients.iter().enumerate().all(|(i, row)| {
+        row.iter()
+            .enumerate()
+            .all(|(j, c)| i + j == 0 || c.definitely_zero())
+    });
+    if !remainder_is_constant {
+        parts.push(remainder);
+    }
+    let mut zeros = Vec::with_capacity(parts.len());
+    for (index, part) in parts.iter().enumerate() {
+        zeros.push(if index == 0 && report.first_parameter_factor.len() > 1 {
+            UnitSquareZeros {
+                curves: std::mem::take(&mut chords),
+                points: Vec::new(),
+            }
+        } else {
+            native_zeros(part)?
+        });
+    }
+    // Exact crossing parameters of each branch with every other part.
+    let mut cuts: Vec<Vec<Vec<Parameter>>> = zeros
+        .iter()
+        .map(|part| vec![Vec::new(); part.curves.len()])
+        .collect();
+    for first in 0..zeros.len() {
+        for second in first + 1..zeros.len() {
+            for (a, curve_a) in zeros[first].curves.iter().enumerate() {
+                for (b, curve_b) in zeros[second].curves.iter().enumerate() {
+                    let crossing = curve_a.intersect_curve(curve_b)?;
+                    if !crossing.blockers().is_empty()
+                        || !crossing.overlaps().is_empty()
+                        || !crossing.parameter_components().is_empty()
+                    {
+                        return Err(GeometryError::UnsupportedIntersection);
+                    }
+                    for contact in crossing.contacts() {
+                        cuts[first][a].push(Parameter::from_curve(&contact.first().parameter()?)?);
+                        cuts[second][b]
+                            .push(Parameter::from_curve(&contact.second().parameter()?)?);
+                    }
+                }
+            }
+        }
+    }
+    let one = BivariatePolynomial::new(vec![vec![Real::one()]]);
+    let mut result = UnitSquareZeros {
+        curves: Vec::new(),
+        points: Vec::new(),
+    };
+    for (index, part) in zeros.into_iter().enumerate() {
+        for (curve, mut parameters) in part.curves.into_iter().zip(cuts[index].drain(..)) {
+            let start = Parameter::from_curve(curve.parameter_domain().start())?;
+            let end = Parameter::from_curve(curve.parameter_domain().end())?;
+            // Strictly interior cuts, ordered and without repeats.
+            let mut interior: Vec<Parameter> = Vec::new();
+            for parameter in parameters.drain(..) {
+                if parameter.compare(&start)? != Ordering::Greater
+                    || parameter.compare(&end)? != Ordering::Less
+                {
+                    continue;
+                }
+                let mut position = interior.len();
+                let mut duplicate = false;
+                for (k, existing) in interior.iter().enumerate() {
+                    match existing.compare(&parameter)? {
+                        Ordering::Equal => {
+                            duplicate = true;
+                            break;
+                        }
+                        Ordering::Greater => {
+                            position = k;
+                            break;
+                        }
+                        Ordering::Less => {}
+                    }
+                }
+                if !duplicate {
+                    interior.insert(position, parameter);
+                }
+            }
+            if interior.is_empty() {
+                result.curves.push(curve);
+                continue;
+            }
+            let mut bounds = vec![start];
+            bounds.extend(interior);
+            bounds.push(end);
+            for window in bounds.windows(2) {
+                result.curves.push(
+                    curve.subcurve(window[0].curve_parameter(), window[1].curve_parameter())?,
+                );
+            }
+        }
+        'point: for point in part.points {
+            for (other, polynomial) in parts.iter().enumerate() {
+                if other != index
+                    && point
+                        .rational_form(polynomial.clone(), one.clone())?
+                        .compare_to_real(&Real::zero())?
+                        == Ordering::Equal
+                {
+                    continue 'point;
+                }
+            }
+            result.points.push(point);
+        }
+    }
+    Ok(result)
+}
+
+/// Bernstein coefficients on `[0, 1]` of a power-basis polynomial:
+/// `b_k = sum_{i <= k} C(k, i) / C(n, i) a_i`.
+fn power_to_bernstein(power: &[Real]) -> Vec<Real> {
+    let degree = power.len() - 1;
+    let binomial = |n: usize, k: usize| -> Real {
+        let mut value = Real::one();
+        for i in 0..k {
+            value = (value * Real::from((n - i) as i64) / Real::from((i + 1) as i64))
+                .expect("nonzero factorial denominators");
+        }
+        value
+    };
+    (0..=degree)
+        .map(|k| {
+            (0..=k).fold(Real::zero(), |total, i| {
+                total
+                    + (binomial(k, i) / binomial(degree, i))
+                        .expect("binomial coefficients are positive")
+                        * &power[i]
+            })
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod axis_factor_tests {
+    use super::*;
+    use hypersolve::bivariate_arithmetic::bivariate_multiply;
+
+    fn q(n: i64, d: i64) -> Real {
+        (Real::from(n) / Real::from(d)).unwrap()
+    }
+
+    fn poly(rows: Vec<Vec<Real>>) -> BivariatePolynomial {
+        BivariatePolynomial::new(rows)
+    }
+
+    /// (2u - 1)(2v - 1) has line components in both directions: the two lines
+    /// are split at their crossing (1/2, 1/2) into four branches.
+    #[test]
+    fn crossing_axis_lines_split_at_their_crossing() {
+        let lines = poly(vec![
+            vec![1.into(), (-2).into()],
+            vec![(-2).into(), 4.into()],
+        ]);
+        let zeros = unit_square_zeros(&lines).unwrap();
+        assert_eq!(zeros.curves.len(), 4);
+        assert!(zeros.points.is_empty());
+        let mut ending_at_centre = 0;
+        for curve in &zeros.curves {
+            let (start, end) = curve.parameter_endpoints();
+            for parameter in [start, end] {
+                let point = curve.point_at(parameter).unwrap();
+                let at_half = |a: i64, b: i64| {
+                    point
+                        .affine_form(a.into(), b.into(), Real::zero())
+                        .compare_to_real(&q(1, 2))
+                        .unwrap()
+                        == Ordering::Equal
+                };
+                if at_half(1, 0) && at_half(0, 1) {
+                    ending_at_centre += 1;
+                }
+            }
+        }
+        assert_eq!(ending_at_centre, 4);
+    }
+
+    /// Adding the circle (u - 1/2)^2 + (v - 1/2)^2 = 1/16: each line is cut
+    /// at the other line and twice by the circle (four pieces each), and the
+    /// circle's two branches (split at u = 1/4, 3/4) are cut once each by
+    /// u = 1/2, so the set has twelve branches.
+    #[test]
+    fn remainder_branches_split_at_axis_lines() {
+        let lines = poly(vec![
+            vec![1.into(), (-2).into()],
+            vec![(-2).into(), 4.into()],
+        ]);
+        let circle = poly(vec![
+            vec![q(7, 16), (-1).into(), 1.into()],
+            vec![(-1).into()],
+            vec![1.into()],
+        ]);
+        let zeros = unit_square_zeros(&bivariate_multiply(&lines, &circle)).unwrap();
+        assert_eq!(zeros.curves.len(), 12);
+        assert!(zeros.points.is_empty());
+    }
+
+    /// (8u^3 - 2)(2v - 1) has one vertical and one horizontal component.
+    /// Native selected vertical charts consume the cubic root directly;
+    /// their shared crossing splits the two components into four arcs.
+    #[test]
+    fn cubic_axis_components_keep_native_crossings_without_scalar_views() {
+        let cubic = poly(vec![
+            vec![(-2).into()],
+            vec![0.into()],
+            vec![0.into()],
+            vec![8.into()],
+        ]);
+        let horizontal = poly(vec![vec![(-1).into(), 2.into()]]);
+        let equation = bivariate_multiply(&cubic, &horizontal);
+        let outcome = hypercurve::evaluate_under(hypercurve::PredicatePolicy::STRICT, || {
+            unit_square_zeros(&equation)
+        });
+        assert_eq!(outcome.certainty(), hypercurve::CurveCertainty::Certified);
+        let zeros = outcome.into_unverified().unwrap();
+        assert_eq!(zeros.curves.len(), 4);
+        assert!(zeros.points.is_empty());
+        let mut factors = [0; 2];
+        let mut boundary = [0; 4];
+        let mut crossing: Option<hypercurve::CurvePoint2> = None;
+        for curve in &zeros.curves {
+            let branch = curve.polynomial_branch().unwrap();
+            assert!(branch.certifies_polynomial_identity(&equation));
+            let vertical = branch.certifies_polynomial_identity(&cubic);
+            let horizontal = branch.certifies_polynomial_identity(&horizontal);
+            assert_ne!(vertical, horizontal);
+            factors[usize::from(horizontal)] += 1;
+            let mut crossing_ends = 0;
+            for point in [curve.start(), curve.end()] {
+                let x = point.affine_form(1.into(), 0.into(), 0.into());
+                let y = point.affine_form(0.into(), 1.into(), 0.into());
+                let sides = [
+                    x.compare_to_real(&0.into()).unwrap().is_eq(),
+                    x.compare_to_real(&1.into()).unwrap().is_eq(),
+                    y.compare_to_real(&0.into()).unwrap().is_eq(),
+                    y.compare_to_real(&1.into()).unwrap().is_eq(),
+                ];
+                if let Some(side) = sides.iter().position(|side| *side) {
+                    assert_eq!(sides.iter().filter(|side| **side).count(), 1);
+                    boundary[side] += 1;
+                } else {
+                    // 8u^3-2 is strictly increasing here, so this isolator
+                    // and v=1/2 identify the unique crossing independently.
+                    assert!(x.compare_to_real(&q(1, 2)).unwrap().is_gt());
+                    assert!(x.compare_to_real(&q(3, 4)).unwrap().is_lt());
+                    assert!(y.compare_to_real(&q(1, 2)).unwrap().is_eq());
+                    assert!(
+                        point
+                            .rational_form(cubic.clone(), poly(vec![vec![1.into()]]))
+                            .unwrap()
+                            .compare_to_real(&Real::zero())
+                            .unwrap()
+                            .is_eq()
+                    );
+                    assert!(point.coordinates().is_none());
+                    if let Some(previous) = &crossing {
+                        assert!(point.coincides_with(previous).unwrap());
+                    } else {
+                        crossing = Some(point.clone());
+                    }
+                    crossing_ends += 1;
+                }
+            }
+            assert_eq!(crossing_ends, 1);
+        }
+        assert_eq!(factors, [2, 2]);
+        assert_eq!(boundary, [1, 1, 1, 1]);
+        assert!(crossing.is_some());
+
+        let probe: Curve2 = hypercurve::LineSeg2::try_new(
+            hypercurve::Point2::new(0.into(), q(1, 4)),
+            hypercurve::Point2::new(1.into(), q(1, 4)),
+        )
+        .unwrap()
+        .into();
+        for reversed in [false, true] {
+            let mut contacts = 0;
+            for curve in &zeros.curves {
+                let curve = if reversed {
+                    curve.reversed().unwrap()
+                } else {
+                    curve.clone()
+                };
+                let result = curve.intersect_curve(&probe).unwrap();
+                assert!(result.is_complete());
+                assert!(result.overlaps().is_empty() && result.parameter_components().is_empty());
+                for contact in result.contacts() {
+                    let point = contact.point();
+                    assert!(
+                        point
+                            .affine_form(0.into(), 1.into(), 0.into())
+                            .compare_to_real(&q(1, 4))
+                            .unwrap()
+                            .is_eq()
+                    );
+                    assert!(
+                        point
+                            .rational_form(cubic.clone(), poly(vec![vec![1.into()]]))
+                            .unwrap()
+                            .compare_to_real(&Real::zero())
+                            .unwrap()
+                            .is_eq()
+                    );
+                    assert!(
+                        curve
+                            .point_at(&contact.first().parameter().unwrap())
+                            .unwrap()
+                            .coincides_with(point)
+                            .unwrap()
+                    );
+                    contacts += 1;
+                }
+            }
+            assert_eq!(contacts, 1);
+        }
+    }
+}
