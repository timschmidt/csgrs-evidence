+#[test]
+fn nonlinear_cap_line_trims_keep_selected_endpoints_and_replay() {
+    const INPUT: &str = "HYPERBREP_SELECTED_CAP_LINE_REPLAY";
+    const PARTITION_INPUT: &str = "HYPERBREP_SELECTED_CAP_PARTITION_REPLAY";
+    fn verify(curves: &[&Curve3]) {
+        assert_eq!(curves.len(), 2);
+        let mut inner_signs = Vec::new();
+        let mut outer_signs = Vec::new();
+        for &curve in curves {
+            let frame = curve.planar_geometry().expect("retained plane line");
+            assert_eq!(frame.source.family(), hypercurve::CurveFamily2::Line);
+            assert!(curve.domain().try_real_endpoints().is_none());
+            let affine = |origin: &Real, u: &Real, v: &Real| {
+                hypersolve::BivariatePolynomial::new(vec![
+                    vec![origin.clone(), v.clone()],
+                    vec![u.clone()],
+                ])
+            };
+            let world_xy = hypercurve::RationalMap2::new(
+                [
+                    affine(&frame.origin.x, &frame.u.0[0], &frame.v.0[0]),
+                    affine(&frame.origin.y, &frame.u.0[1], &frame.v.0[1]),
+                ],
+                hypersolve::BivariatePolynomial::new(vec![vec![Real::one()]]),
+            );
+            let mut signs = Vec::new();
+            let mut outer = 0;
+            for end in [curve.domain().start(), curve.domain().end()] {
+                let point = curve.point_at(end).unwrap();
+                assert_eq!(
+                    point
+                        .compare_linear_form(&Vector3::x(), &Real::zero())
+                        .unwrap(),
+                    std::cmp::Ordering::Equal
+                );
+                assert_eq!(
+                    point.compare_linear_form(&Vector3::z(), &q(1, 2)).unwrap(),
+                    std::cmp::Ordering::Equal
+                );
+                let sign = point
+                    .compare_linear_form(&Vector3::y(), &Real::zero())
+                    .unwrap();
+                signs.push(sign);
+                if [Real::from(-1), Real::one()].iter().any(|y| {
+                    point.compare_linear_form(&Vector3::y(), y).unwrap()
+                        == std::cmp::Ordering::Equal
+                }) {
+                    outer_signs.push(sign);
+                    outer += 1;
+                } else {
+                    inner_signs.push(sign);
+                    let uv = frame
+                        .source
+                        .point_at(
+                            &end.affine_image(frame.source_scale, frame.source_offset)
+                                .unwrap()
+                                .curve_parameter(),
+                        )
+                        .unwrap();
+                    let xy = uv.rational_image(&world_xy).unwrap();
+                    // x=0 selects u=(3-sqrt(5))/2. The inner end has
+                    // y²=4sqrt(5)-17/2, hence 4y⁴+68y²-31=0.
+                    assert_eq!(
+                        xy.rational_form(
+                            hypersolve::BivariatePolynomial::new(vec![vec![
+                                (-31).into(),
+                                0.into(),
+                                68.into(),
+                                0.into(),
+                                4.into()
+                            ]]),
+                            hypersolve::BivariatePolynomial::new(vec![vec![Real::one()]]),
+                        )
+                        .unwrap()
+                        .compare_to_real(&Real::zero())
+                        .unwrap(),
+                        std::cmp::Ordering::Equal
+                    );
+                }
+            }
+            assert_eq!(outer, 1);
+            assert_eq!(signs[0], signs[1]);
+            let level = if signs[0] == std::cmp::Ordering::Less {
+                q(-3, 4)
+            } else {
+                q(3, 4)
+            };
+            let expected = Point3::new(0.into(), level.clone(), q(1, 2));
+            let cutter = Surface::plane(
+                Point3::new(0.into(), level, 0.into()),
+                Vector3::x(),
+                Vector3::z(),
+            )
+            .unwrap();
+            let CurveSurfaceIntersection::Points(points) = cutter.intersect_curve(curve).unwrap()
+            else {
+                panic!("one transverse point");
+            };
+            assert_eq!(points.len(), 1);
+            assert!(
+                curve
+                    .point_at(&points[0].parameter)
+                    .unwrap()
+                    .coincides_with(&expected.into())
+                    .unwrap()
+            );
+            let a = curve
+                .restrict_source(
+                    ParameterRange::new(
+                        curve.domain().start().clone(),
+                        points[0].parameter.clone(),
+                    )
+                    .unwrap(),
+                )
+                .unwrap();
+            let b = curve
+                .restrict_source(
+                    ParameterRange::new(points[0].parameter.clone(), curve.domain().end().clone())
+                        .unwrap(),
+                )
+                .unwrap();
+            assert!(
+                a.point_at(a.domain().end())
+                    .unwrap()
+                    .coincides_with(&b.point_at(b.domain().start()).unwrap())
+                    .unwrap()
+            );
+        }
+        inner_signs.sort();
+        outer_signs.sort();
+        assert_eq!(
+            inner_signs,
+            vec![std::cmp::Ordering::Less, std::cmp::Ordering::Greater]
+        );
+        assert_eq!(outer_signs, inner_signs);
+    }
+    fn verify_partition(model: &Model) {
+        use hypercurve::{CurvePath2, CurveRegion2, FillRule, RegionPointLocation};
+        let faces = model.faces().filter(|face| {
+            matches!(face.surface().geometry().plane_origin(), Some(o) if o.z == q(1, 2))
+        }).collect::<Vec<_>>();
+        assert_eq!(faces.len(), 2);
+        let mut regions = Vec::new();
+        for face in &faces {
+            assert_eq!(face.inner().len(), 0);
+            let path = CurvePath2::try_new(
+                face.outer()
+                    .unwrap()
+                    .edge_uses()
+                    .map(|usage| usage.pcurve().geometry().curve().clone())
+                    .collect(),
+            )
+            .unwrap();
+            regions
+                .push(CurveRegion2::try_from_boundary_paths(&[path], FillRule::NonZero).unwrap());
+        }
+        // On the cap, |y|=3/4 lies outside the removed disk for every x.
+        // The two partitions cover opposite x sides, share x=0 only on the
+        // material intervals, and both exclude the original central hole.
+        let classify = |x: Real, y: Real| {
+            faces
+                .iter()
+                .zip(&regions)
+                .map(|(face, region)| {
+                    let surface = face.surface().geometry();
+                    let o = surface.plane_origin().unwrap();
+                    let (u, v) = surface.plane_directions().unwrap();
+                    let (dx, dy) = (&x - &o.x, &y - &o.y);
+                    let det = &u.0[0] * &v.0[1] - &u.0[1] * &v.0[0];
+                    let uv = Uv::new(
+                        ((&dx * &v.0[1] - &dy * &v.0[0]) / &det).unwrap(),
+                        ((&u.0[0] * &dy - &u.0[1] * &dx) / &det).unwrap(),
+                    );
+                    region.classify_point(&uv.into()).unwrap()
+                })
+                .collect::<Vec<_>>()
+        };
+        let left = classify(q(-3, 4), q(3, 4));
+        let right = classify(q(3, 4), q(3, 4));
+        assert!(matches!(
+            left.as_slice(),
+            [RegionPointLocation::Inside, RegionPointLocation::Outside]
+                | [RegionPointLocation::Outside, RegionPointLocation::Inside]
+        ));
+        assert_eq!(right, left.into_iter().rev().collect::<Vec<_>>());
+        assert_eq!(
+            classify(0.into(), 0.into()),
+            vec![RegionPointLocation::Outside; 2]
+        );
+        for y in [q(-3, 4), q(3, 4)] {
+            assert_eq!(
+                classify(0.into(), y),
+                vec![RegionPointLocation::Boundary; 2]
+            );
+        }
+        let first = faces[0].outer().unwrap().edge_uses().collect::<Vec<_>>();
+        let second = faces[1].outer().unwrap().edge_uses().collect::<Vec<_>>();
+        let shared = first
+            .iter()
+            .filter_map(|a| {
+                second
+                    .iter()
+                    .find(|b| a.edge() == b.edge())
+                    .map(|b| (*a, *b))
+            })
+            .collect::<Vec<_>>();
+        assert_eq!(shared.len(), 2);
+        for (a, b) in &shared {
+            assert_ne!(a.direction(), b.direction());
+        }
+        verify(
+            &shared
+                .iter()
+                .map(|(a, _)| a.edge().curve().geometry())
+                .collect::<Vec<_>>(),
+        );
+    }
+    if let Some(path) = std::env::var_os(PARTITION_INPUT) {
+        let text = std::fs::read_to_string(path).unwrap();
+        let model = RawModel::from_json(&text, &ArchiveLimits::default())
+            .unwrap()
+            .validate()
+            .unwrap();
+        verify_partition(&model);
+        assert_eq!(model.to_json().unwrap(), text);
+        return;
+    }
+    if let Some(path) = std::env::var_os(INPUT) {
+        let text = std::fs::read_to_string(path).unwrap();
+        let model = RawModel::from_json(&text, &ArchiveLimits::default())
+            .unwrap()
+            .validate()
+            .unwrap();
+        let curves = model
+            .curves()
+            .map(|curve| curve.geometry())
+            .collect::<Vec<_>>();
+        verify(&curves);
+        assert_eq!(model.to_json().unwrap(), text);
+        return;
+    }
+    let source = graph_fixture_over(
+        [(-1).into(), q(1, 2), 1.into()],
+        [[2, 0, 2], [0, -2, 0], [2, 0, 2]],
+    );
+    let body = BodySet::from_solid(source.solids().next().unwrap());
+    let slab = builder::cuboid(pi(-2, -2, -2), Point3::new(2.into(), 2.into(), q(1, 2))).unwrap();
+    let capped = boolean::intersection(&body, &slab).unwrap();
+    let half = builder::cuboid(pi(-2, -2, -2), pi(0, 2, 3)).unwrap();
+    let cap = capped
+        .model()
+        .faces()
+        .find(|face| matches!(face.surface().geometry().plane_origin(), Some(o) if o.z == q(1, 2)))
+        .unwrap();
+    let wall = half.model().faces().find(|face| {
+        let surface = face.surface().geometry();
+        matches!((surface.plane_origin(), surface.plane_directions()), (Some(o), Some((u, v))) if o.x == Real::zero() && u.0[0] == Real::zero() && v.0[0] == Real::zero())
+    }).unwrap();
+    let pair = boolean::intersect_faces(cap, wall).unwrap().unwrap();
+    let boolean::FacePairTrim::SurfaceCurveFragments(traces) = pair.details().trim() else {
+        panic!("selected line trim: {:?}", pair.details().trim());
+    };
+    verify(&traces.iter().map(|trace| trace.curve()).collect::<Vec<_>>());
+    for trace in traces {
+        for end in [trace.curve().domain().start(), trace.curve().domain().end()] {
+            let spatial = trace.curve().point_at(end).unwrap();
+            for (surface, pcurve) in [
+                (cap.surface().geometry(), trace.first_pcurve()),
+                (wall.surface().geometry(), trace.second_pcurve()),
+            ] {
+                let uv = pcurve.point_at(end).unwrap();
+                assert!(
+                    surface
+                        .point_at(&uv)
+                        .unwrap()
+                        .coincides_with(&spatial)
+                        .unwrap()
+                );
+            }
+        }
+    }
+    let partition = cap
+        .split_by_surface_curves(traces, SurfaceIntersectionOperand::First)
+        .unwrap();
+    assert_eq!(partition.details().faces().len(), 2);
+    verify_partition(partition.model());
+    let partition_path = std::env::temp_dir().join(format!(
+        "hyperbrep-selected-cap-partition-{}.json",
+        std::process::id()
+    ));
+    std::fs::write(&partition_path, partition.model().to_json().unwrap()).unwrap();
+    let replay = std::process::Command::new(std::env::current_exe().unwrap())
+        .args([
+            "--exact",
+            "nonlinear_cap_line_trims_keep_selected_endpoints_and_replay",
+            "--nocapture",
+        ])
+        .env(PARTITION_INPUT, &partition_path)
+        .output()
+        .unwrap();
+    std::fs::remove_file(partition_path).unwrap();
+    assert!(
+        replay.status.success(),
+        "{}{}",
+        String::from_utf8_lossy(&replay.stdout),
+        String::from_utf8_lossy(&replay.stderr)
+    );
+    let mut builder = ModelBuilder::new();
+    for trace in traces {
+        builder.curve(trace.curve().clone()).unwrap();
+    }
+    let text = builder.finish().unwrap().to_json().unwrap();
+    let path = std::env::temp_dir().join(format!(
+        "hyperbrep-selected-cap-line-{}.json",
+        std::process::id()
+    ));
+    std::fs::write(&path, text).unwrap();
+    let result = std::process::Command::new(std::env::current_exe().unwrap())
+        .args([
+            "--exact",
+            "nonlinear_cap_line_trims_keep_selected_endpoints_and_replay",
+            "--nocapture",
+        ])
+        .env(INPUT, &path)
+        .output()
+        .unwrap();
+    std::fs::remove_file(path).unwrap();
+    assert!(
+        result.status.success(),
+        "{}{}",
+        String::from_utf8_lossy(&result.stdout),
+        String::from_utf8_lossy(&result.stderr)
+    );
+}
+
+#[test]
+fn nonuniform_tensor_sections_retain_both_charts_on_folding_plane_projections() {
+    fn verify(surface: &Surface, plane: &Surface, curve: &Curve3, first: &Curve2, second: &Curve2) {
+        assert_eq!(curve.kind(), Curve3Kind::TensorImage);
+        for t in [Real::zero(), q(1, 2), Real::one()] {
+            let parameter: Parameter = t.clone().into();
+            let spatial = curve.point_at(&parameter).unwrap();
+            let uv = first.point_at(&t.clone().into()).unwrap();
+            let yz = second.point_at(&t.clone().into()).unwrap();
+            assert!(
+                surface
+                    .point_at(&uv)
+                    .unwrap()
+                    .coincides_with(&spatial)
+                    .unwrap()
+            );
+            assert!(
+                plane
+                    .point_at(&yz)
+                    .unwrap()
+                    .coincides_with(&spatial)
+                    .unwrap()
+            );
+            assert_eq!(
+                spatial
+                    .compare_linear_form(&Vector3::x(), &Real::zero())
+                    .unwrap(),
+                std::cmp::Ordering::Equal
+            );
+            // z-y²=c, c²-18c+1=0, with the selected small positive c.
+            let equation = hypersolve::BivariatePolynomial::new(vec![
+                vec![1.into(), (-18).into(), 1.into()],
+                vec![],
+                vec![18.into(), (-2).into()],
+                vec![],
+                vec![1.into()],
+            ]);
+            assert_eq!(
+                yz.rational_form(
+                    equation,
+                    hypersolve::BivariatePolynomial::new(vec![vec![1.into()]])
+                )
+                .unwrap()
+                .compare_to_real(&Real::zero())
+                .unwrap(),
+                std::cmp::Ordering::Equal
+            );
+            if t == q(1, 2) {
+                assert_eq!(
+                    spatial
+                        .compare_linear_form(&Vector3::y(), &Real::zero())
+                        .unwrap(),
+                    std::cmp::Ordering::Equal
+                );
+                assert_eq!(
+                    spatial
+                        .compare_linear_form(&Vector3::z(), &Real::zero())
+                        .unwrap(),
+                    std::cmp::Ordering::Greater
+                );
+                assert_eq!(
+                    spatial
+                        .compare_linear_form(&Vector3::z(), &q(1, 16))
+                        .unwrap(),
+                    std::cmp::Ordering::Less
+                );
+            }
+        }
+        let next = Surface::plane(
+            Point3::new(0.into(), 0.into(), q(1, 2)),
+            Vector3::x(),
+            Vector3::y(),
+        )
+        .unwrap();
+        let CurveSurfaceIntersection::Points(points) = next.intersect_curve(curve).unwrap() else {
+            panic!("two selected contacts");
+        };
+        assert_eq!(points.len(), 2);
+        let mut signs = Vec::new();
+        for point in points {
+            let spatial = curve.point_at(&point.parameter).unwrap();
+            assert_eq!(
+                spatial
+                    .compare_linear_form(&Vector3::x(), &Real::zero())
+                    .unwrap(),
+                std::cmp::Ordering::Equal
+            );
+            assert_eq!(
+                spatial
+                    .compare_linear_form(&Vector3::z(), &q(1, 2))
+                    .unwrap(),
+                std::cmp::Ordering::Equal
+            );
+            signs.push(
+                spatial
+                    .compare_linear_form(&Vector3::y(), &Real::zero())
+                    .unwrap(),
+            );
+        }
+        signs.sort();
+        assert_eq!(
+            signs,
+            vec![std::cmp::Ordering::Less, std::cmp::Ordering::Greater]
+        );
+    }
+    let model = graph_fixture_over(
+        [(-1).into(), q(1, 2), 1.into()],
+        [[2, 0, 2], [0, -2, 0], [2, 0, 2]],
+    );
+    let surface = model
+        .faces()
+        .find(|face| face.surface().geometry().kind() == SurfaceKind::RationalBezier)
+        .unwrap()
+        .surface()
+        .geometry();
+    let plane = Surface::plane(Point3::origin(), Vector3::y(), Vector3::z()).unwrap();
+    let SurfaceSurfaceIntersection::Curve(trace) = surface.intersect_surface(&plane).unwrap()
+    else {
+        panic!("one selected section");
+    };
+    assert_eq!(trace.polynomial_contact_exponent(), Some(1));
+    let first = trace.first_pcurve().materialize().unwrap();
+    let second = trace.second_pcurve().materialize().unwrap();
+    for pcurve in [&first, &second] {
+        let Some((scale, offset)) = pcurve.correspondence().affine_coefficients() else {
+            panic!("source chart");
+        };
+        assert_eq!(scale, &Real::one());
+        assert_eq!(offset, &Real::zero());
+    }
+    verify(
+        surface,
+        &plane,
+        trace.curve(),
+        first.curve(),
+        second.curve(),
+    );
+    let mut builder = ModelBuilder::new();
+    builder.surface(surface.clone()).unwrap();
+    builder.surface(plane).unwrap();
+    builder.curve(trace.curve().clone()).unwrap();
+    builder.pcurve(Pcurve::new(first.curve().clone())).unwrap();
+    builder.pcurve(Pcurve::new(second.curve().clone())).unwrap();
+    let text = builder.finish().unwrap().to_json().unwrap();
+    let replay = RawModel::from_json(&text, &ArchiveLimits::default())
+        .unwrap()
+        .validate()
+        .unwrap();
+    let surfaces = replay.surfaces().map(|s| s.geometry()).collect::<Vec<_>>();
+    let pcurves = replay
+        .pcurves()
+        .map(|p| p.curve().clone())
+        .collect::<Vec<_>>();
+    verify(
+        surfaces[0],
+        surfaces[1],
+        replay.curves().next().unwrap().geometry(),
+        &pcurves[0],
+        &pcurves[1],
+    );
+    assert_eq!(replay.to_json().unwrap(), text);
+}
diff --git a/crates/hyperbrep/tests/tensor_image_contacts.rs b/crates/hyperbrep/tests/tensor_image_contacts.rs
new file mode 100644
index 0000000000..2d2edd7b40
--- /dev/null
+++ b/crates/hyperbrep/tests/tensor_image_contacts.rs
@@ -0,0 +1,421 @@
+//! Contacts between generated tensor-image curves and further surfaces.
+
+use hyperbrep::*;
+use std::cmp::Ordering;
+
+fn q(n: i64, d: i64) -> Real {
+    (Real::from(n) / Real::from(d)).unwrap()
+}
+
+fn root(n: i64) -> Real {
+    Real::from(n).sqrt().unwrap()
+}
+
+fn p(x: Real, y: Real, z: Real) -> Point3 {
+    Point3::new(x, y, z)
+}
+
+fn pi(x: i64, y: i64, z: i64) -> Point3 {
+    Point3::new(x.into(), y.into(), z.into())
+}
+
+/// The arc of `y^2 + z^2 = 2` from (7/5, 1/5) to (1/5, 7/5): the endpoint
+/// directions have cosine 7/25, so the half-angle cosine and middle weight
+/// are 4/5, and the tangents meet at (5/4, 5/4). The arc is swept along
+/// x in [-2, 2]. Control rows follow the arc (parameter v) and columns follow
+/// x = 4u - 2 (parameter u).
+fn cylinder_patch() -> Surface {
+    let arc = [
+        (q(7, 5), q(1, 5), Real::one()),
+        (q(5, 4), q(5, 4), q(4, 5)),
+        (q(1, 5), q(7, 5), Real::one()),
+    ];
+    Surface::rational_bezier(
+        arc.iter()
+            .map(|(y, z, _)| {
+                vec![
+                    p((-2).into(), y.clone(), z.clone()),
+                    p(2.into(), y.clone(), z.clone()),
+                ]
+            })
+            .collect(),
+        arc.iter()
+            .map(|(_, _, w)| vec![w.clone(), w.clone()])
+            .collect(),
+    )
+    .unwrap()
+}
+
+fn unit_cylinder() -> Surface {
+    Surface::cylinder(
+        Point3::origin(),
+        Vector3::x(),
+        Vector3::y(),
+        Vector3::z(),
+        1.into(),
+    )
+    .unwrap()
+}
+
+fn sections(result: SurfaceSurfaceIntersection) -> Vec<SurfaceIntersectionCurve> {
+    match result {
+        SurfaceSurfaceIntersection::Curves(curves) => curves,
+        SurfaceSurfaceIntersection::Curve(curve) => vec![*curve],
+        other => panic!("curve components required, found {other:?}"),
+    }
+}
+
+fn equal(parameter: &Parameter, expected: Real) -> bool {
+    parameter.compare(&Parameter::from_real(expected)).unwrap() == Ordering::Equal
+}
+
+fn reload(model: &Model) -> Model {
+    let json = model.to_json().unwrap();
+    let cold = RawModel::from_json(&json, &ArchiveLimits::default())
+        .unwrap()
+        .validate()
+        .unwrap();
+    assert_eq!(cold.to_json().unwrap(), json);
+    cold
+}
+
+fn edge_model(curve: &Curve3) -> Model {
+    let mut builder = ModelBuilder::new();
+    let start = builder
+        .vertex(curve.point_at(curve.domain().start()).unwrap())
+        .unwrap();
+    let end = builder
+        .vertex(curve.point_at(curve.domain().end()).unwrap())
+        .unwrap();
+    let id = builder.curve(curve.clone()).unwrap();
+    builder
+        .edge(&start, &end, &id, curve.domain().clone())
+        .unwrap();
+    builder.finish().unwrap()
+}
+
+/// Ordered (lower, upper) branches of the perpendicular-cylinder section.
+fn cylinder_branches() -> [SurfaceIntersectionCurve; 2] {
+    let mut branches = sections(
+        unit_cylinder()
+            .intersect_surface(&cylinder_patch())
+            .unwrap(),
+    );
+    assert_eq!(branches.len(), 2);
+    if branches[0]
+        .curve()
+        .domain()
+        .start()
+        .compare(branches[1].curve().domain().start())
+        .unwrap()
+        == Ordering::Greater
+    {
+        branches.swap(0, 1);
+    }
+    let second = branches.pop().unwrap();
+    [branches.pop().unwrap(), second]
+}
+
+fn contacts(surface: &Surface, curve: &Curve3) -> Vec<CurveSurfacePoint> {
+    match surface.intersect_curve(curve).unwrap() {
+        CurveSurfaceIntersection::Points(points) => {
+            for point in &points {
+                assert!(
+                    point
+                        .point
+                        .coincides_with(&curve.point_at(&point.parameter).unwrap())
+                        .unwrap()
+                );
+            }
+            points
+        }
+        other => panic!("isolated contacts required, found {other:?}"),
+    }
+}
+
+fn plane(origin: Point3, u: Vector3, v: Vector3) -> Surface {
+    Surface::plane(origin, u, v).unwrap()
+}
+
+/// The plane y = 3/5 meets the loop where x = ±4/5 and z = sqrt(41)/5, at
+/// s = (x + 2)/4 = 3/10 on the lower branch and 7/10 on the upper branch.
+#[test]
+fn generated_branches_meet_a_transverse_plane_exactly() {
+    let [lower, upper] = cylinder_branches();
+    let cut = plane(p(0.into(), q(3, 5), 0.into()), Vector3::z(), Vector3::x());
+    let z = (root(41) / Real::from(5)).unwrap();
+    for (branch, s, x) in [(&lower, q(3, 10), q(-4, 5)), (&upper, q(7, 10), q(4, 5))] {
+        let points = contacts(&cut, branch.curve());
+        assert_eq!(points.len(), 1);
+        assert!(equal(&points[0].parameter, s));
+        assert_eq!(points[0].kind, CurveSurfaceContactKind::Simple);
+        assert!(
+            points[0]
+                .point
+                .coincides_with(&p(x, q(3, 5), z.clone()).into())
+                .unwrap()
+        );
+    }
+    // The lower branch has a selected endpoint, so reversal negates the
+    // source chart (s -> -s) rather than pivoting on scalar endpoints.
+    let reversed = lower.curve().reversed().unwrap();
+    let points = contacts(&cut, &reversed);
+    assert_eq!(points.len(), 1);
+    assert!(equal(&points[0].parameter, q(-3, 10)));
+    assert!(
+        points[0]
+            .point
+            .coincides_with(&p(q(-4, 5), q(3, 5), z.clone()).into())
+            .unwrap()
+    );
+    // y = 1/10 lies below the patch's y range on the loop: no contact.
+    let low = plane(p(0.into(), q(1, 10), 0.into()), Vector3::z(), Vector3::x());
+    for branch in [&lower, &upper] {
+        assert!(matches!(
+            low.intersect_curve(branch.curve()).unwrap(),
+            CurveSurfaceIntersection::None
+        ));
+    }
+}
+
+/// On the loop z^2 = 1 + x^2, so z = 1 touches it only at the event (0, 1, 1).
+#[test]
+fn tangent_plane_touches_the_branch_event_with_repeated_contacts() {
+    let [lower, upper] = cylinder_branches();
+    let top = plane(pi(0, 0, 1), Vector3::x(), Vector3::y());
+    for branch in [&lower, &upper] {
+        let points = contacts(&top, branch.curve());
+        assert_eq!(points.len(), 1);
+        assert!(equal(&points[0].parameter, q(1, 2)));
+        assert_eq!(points[0].kind, CurveSurfaceContactKind::Repeated);
+        assert!(points[0].point.coincides_with(&pi(0, 1, 1).into()).unwrap());
+    }
+}
+
+/// With x^2 + y^2 = 1, y^2 + z^2 = 2 and x^2 + z^2 = 9/4, the sum gives
+/// x^2 = 5/8, y^2 = 3/8 and z^2 = 13/8: one point on each branch.
+#[test]
+fn third_quadric_meets_each_generated_branch_once() {
+    let [lower, upper] = cylinder_branches();
+    let third = Surface::cylinder(
+        Point3::origin(),
+        Vector3::z(),
+        Vector3::x(),
+        Vector3::y(),
+        q(3, 2),
+    )
+    .unwrap();
+    let x = (root(10) / Real::from(4)).unwrap();
+    let y = (root(6) / Real::from(4)).unwrap();
+    let z = (root(26) / Real::from(4)).unwrap();
+    for (branch, sign) in [(&lower, -1), (&upper, 1)] {
+        let points = contacts(&third, branch.curve());
+        assert_eq!(points.len(), 1);
+        assert_eq!(points[0].kind, CurveSurfaceContactKind::Simple);
+        assert!(points[0].parameter.try_real().is_none());
+        assert!(equal(
+            &points[0].parameter,
+            ((x.clone() * Real::from(sign) + Real::from(2)) / Real::from(4)).unwrap()
+        ));
+        assert!(
+            points[0]
+                .point
+                .coincides_with(&p(x.clone() * Real::from(sign), y.clone(), z.clone()).into())
+                .unwrap()
+        );
+    }
+}
+
+/// The patch lies on its own cylinder, so every branch is contained in it.
+#[test]
+fn source_cylinder_contains_each_generated_branch() {
+    let source = Surface::cylinder(
+        Point3::origin(),
+        Vector3::y(),
+        Vector3::z(),
+        Vector3::x(),
+        root(2),
+    )
+    .unwrap();
+    for branch in cylinder_branches() {
+        assert!(matches!(
+            source.intersect_curve(branch.curve()).unwrap(),
+            CurveSurfaceIntersection::Contained
+        ));
+    }
+}
+
+/// Split the generated edge at a selected third-surface contact, replay it
+/// cold and intersect the replayed edge again.
+#[test]
+fn selected_third_surface_contact_splits_and_replays() {
+    let [lower, _] = cylinder_branches();
+    let third = Surface::cylinder(
+        Point3::origin(),
+        Vector3::z(),
+        Vector3::x(),
+        Vector3::y(),
+        q(3, 2),
+    )
+    .unwrap();
+    let contact = contacts(&third, lower.curve()).remove(0);
+    let split = edge_model(lower.curve())
+        .edges()
+        .next()
+        .unwrap()
+        .split(contact.parameter.clone())
+        .unwrap();
+    assert!(
+        split
+            .details()
+            .vertex()
+            .point()
+            .coincides_with(&contact.point)
+            .unwrap()
+    );
+    let cold = reload(split.model());
+    assert_eq!(cold.edges().count(), 2);
+    let replayed = cold.curves().next().unwrap().geometry().clone();
+    let again = contacts(&third, &replayed);
+    assert_eq!(again.len(), 1);
+    assert_eq!(
+        again[0].parameter.compare(&contact.parameter).unwrap(),
+        Ordering::Equal
+    );
+    let cut = plane(p(0.into(), q(3, 5), 0.into()), Vector3::z(), Vector3::x());
+    assert_eq!(contacts(&cut, &replayed).len(), 1);
+}
+
+/// A plane of constant x pulls back to a line of constant u, which the
+/// topology's projection reports as a vertical component; it is now an exact
+/// chord u = 1/2. The plane x = 0 meets the loop only at (0, 1, 1), where
+/// x^2 + y^2 = 1 and y^2 + z^2 = 2 give y = z = 1, at s = (x + 2)/4 = 1/2:
+/// the shared end of the two branches.
+#[test]
+fn axis_aligned_plane_cut_meets_the_branch_end_exactly() {
+    let [lower, upper] = cylinder_branches();
+    let cut = plane(Point3::origin(), Vector3::y(), Vector3::z());
+    for branch in [&lower, &upper] {
+        let found = contacts(&cut, branch.curve());
+        assert_eq!(found.len(), 1);
+        assert_eq!(
+            found[0]
+                .parameter
+                .compare(&Parameter::from_real(q(1, 2)))
+                .unwrap(),
+            Ordering::Equal
+        );
+        assert!(found[0].point.coincides_with(&pi(0, 1, 1).into()).unwrap());
+    }
+}
+
+/// Branches of the patch's sections by x^2 + y^2 = 1 and by x^2 + z^2 = 9/4
+/// meet exactly where all three cylinders meet: x^2 = 5/8, y^2 = 3/8,
+/// z^2 = 13/8, i.e. (±√10/4, √6/4, √26/4). Generated curves on different
+/// tensors have no admitted shared chart.
+#[test]
+fn generated_curves_on_one_tensor_meet_exactly() {
+    let first = cylinder_branches();
+    let third = Surface::cylinder(
+        Point3::origin(),
+        Vector3::z(),
+        Vector3::x(),
+        Vector3::y(),
+        q(3, 2),
+    )
+    .unwrap();
+    let second = match third.intersect_surface(&cylinder_patch()).unwrap() {
+        SurfaceSurfaceIntersection::Curves(curves) => curves,
+        SurfaceSurfaceIntersection::Curve(curve) => vec![*curve],
+        other => panic!("curve components required, found {other:?}"),
+    };
+    let x = (root(10) / Real::from(4)).unwrap();
+    let y = (root(6) / Real::from(4)).unwrap();
+    let z = (root(26) / Real::from(4)).unwrap();
+    let mut found = Vec::new();
+    for a in &first {
+        for b in &second {
+            match a.curve().intersect_curve(b.curve()).unwrap() {
+                CurveCurveIntersection::None => {}
+                CurveCurveIntersection::Points(points) => {
+                    for point in points {
+                        assert!(
+                            point
+                                .point
+                                .coincides_with(&b.curve().point_at(&point.second).unwrap())
+                                .unwrap()
+                        );
+                        found.push(point.point);
+                    }
+                }
+                other => panic!("isolated incidences required, found {other:?}"),
+            }
+        }
+    }
+    assert_eq!(found.len(), 2);
+    for sign in [-1, 1] {
+        let expected = GeometricPoint3::from(p(x.clone() * Real::from(sign), y.clone(), z.clone()));
+        assert!(
+            found
+                .iter()
+                .any(|point| point.coincides_with(&expected).unwrap())
+        );
+    }
+    // A translated copy lies on a different exact tensor.
+    let moved = edge_model(first[0].curve())
+        .transformed(&Matrix4::affine_translation([
+            Real::zero(),
+            Real::zero(),
+            Real::one(),
+        ]))
+        .unwrap();
+    let moved = moved.curves().next().unwrap().geometry().clone();
+    assert!(matches!(
+        first[0].curve().intersect_curve(&moved),
+        Err(GeometryError::UnsupportedIntersection)
+    ));
+}
+
+/// The bilinear saddle patch z = xy over [-1, 1]^2 (x = 2v - 1, y = 2u - 1)
+/// meets z = 0 along (2u - 1)(2v - 1) = 0: lines in both UV directions. The
+/// generated curve u = t, v = t/2 is x = t - 1, y = 2t - 1, z = (t - 1)(2t - 1),
+/// so it crosses z = 0 at t = 1/2, (-1/2, 0, 0), and ends on it at (0, 1, 0).
+#[test]
+fn tensor_image_meets_a_plane_through_crossing_axis_components() {
+    let corners = [-1, 1];
+    let saddle = Surface::rational_bezier(
+        corners
+            .iter()
+            .map(|&x| corners.iter().map(|&y| pi(x, y, x * y)).collect())
+            .collect(),
+        vec![vec![Real::one(); 2]; 2],
+    )
+    .unwrap();
+    let source = hypercurve::Curve2::from(
+        hypercurve::LineSeg2::try_new(
+            hypercurve::Point2::from_values(0, 0),
+            hypercurve::Point2::new(Real::one(), q(1, 2)),
+        )
+        .unwrap(),
+    );
+    let curve = Curve3::tensor_image(saddle, source).unwrap();
+    let plane = Surface::plane(Point3::origin(), Vector3::x(), Vector3::y()).unwrap();
+    let CurveSurfaceIntersection::Points(points) = plane.intersect_curve(&curve).unwrap() else {
+        panic!("isolated crossings required");
+    };
+    assert_eq!(points.len(), 2);
+    let expected = [
+        (q(1, 2), p(q(-1, 2), 0.into(), 0.into())),
+        (Real::one(), pi(0, 1, 0)),
+    ];
+    for (parameter, point) in expected {
+        assert!(points.iter().any(|contact| {
+            contact
+                .parameter
+                .compare(&Parameter::from_real(parameter.clone()))
+                .unwrap()
+                == Ordering::Equal
+                && contact.point.coincides_with(&point.clone().into()).unwrap()
+        }));
+    }
+}
diff --git a/crates/hyperbrep/tests/tensor_image_selected_locations.rs b/crates/hyperbrep/tests/tensor_image_selected_locations.rs
new file mode 100644
index 0000000000..c6e6a53eb0
--- /dev/null
+++ b/crates/hyperbrep/tests/tensor_image_selected_locations.rs
@@ -0,0 +1,590 @@
+//! Retained tensor images consume independent selected queries and survive edits.
+use hyperbrep::*;
+use hypercurve::{Curve2, LineSeg2, NurbsCurve2, Point2 as Uv};
+use std::cmp::Ordering;
+fn q(n: i64, d: i64) -> Real {
+    (Real::from(n) / Real::from(d)).unwrap()
+}
+fn selector() -> Curve3 {
+    Curve3::rational_bezier(
+        [-5, -7, -9, -11, -13, 145]
+            .map(|n| Point3::new(q(n, 5), 0.into(), 0.into()))
+            .to_vec(),
+        vec![Real::one(); 6],
+    )
+    .unwrap()
+}
+fn alpha() -> Parameter {
+    let CurveParameterLocation::Parameters(mut roots) =
+        selector().parameters_of(Point3::origin()).unwrap()
+    else {
+        panic!("one root")
+    };
+    assert_eq!(roots.len(), 1);
+    let root = roots.remove(0);
+    assert!(root.try_real().is_none());
+    root
+}
+fn native_parabola() -> Curve3 {
+    Curve3::rational_bezier(
+        vec![
+            Point3::new(0.into(), (-1).into(), 1.into()),
+            Point3::new(0.into(), 0.into(), (-1).into()),
+            Point3::new(0.into(), 1.into(), 1.into()),
+        ],
+        vec![Real::one(); 3],
+    )
+    .unwrap()
+}
+fn paraboloid() -> Surface {
+    Surface::rational_bezier(
+        (0..3)
+            .map(|i| {
+                (0..3)
+                    .map(|j| {
+                        let a = [1, -1, 1];
+                        let xs = [-1, 0, 1];
+                        Point3::new(xs[i].into(), xs[j].into(), (a[i] + a[j]).into())
+                    })
+                    .collect()
+            })
+            .collect(),
+        vec![vec![Real::one(); 3]; 3],
+    )
+    .unwrap()
+}
+fn section(patch: &Surface) -> SurfaceIntersectionCurve {
+    let plane = Surface::plane(Point3::origin(), Vector3::y(), Vector3::z()).unwrap();
+    match patch.intersect_surface(&plane).unwrap() {
+        SurfaceSurfaceIntersection::Curve(c) => *c,
+        other => panic!("one complete section: {other:?}"),
+    }
+}
+fn params(curve: &Curve3, point: &GeometricPoint3) -> Vec<Parameter> {
+    match curve.parameters_of(point).unwrap() {
+        CurveParameterLocation::None => Vec::new(),
+        CurveParameterLocation::Parameters(found) => {
+            for t in &found {
+                assert!(curve.point_at(t).unwrap().coincides_with(point).unwrap());
+            }
+            for pair in found.windows(2) {
+                assert_eq!(pair[0].compare(&pair[1]).unwrap(), Ordering::Less);
+            }
+            found
+        }
+        CurveParameterLocation::EntireDomain => panic!("finite locations"),
+    }
+}
+#[track_caller]
+fn reload(model: &Model) -> Model {
+    let json = model.to_json().unwrap();
+    let cold = RawModel::from_json(&json, &ArchiveLimits::default())
+        .unwrap()
+        .validate()
+        .unwrap();
+    assert_eq!(cold.to_json().unwrap(), json);
+    cold
+}
+fn transform() -> Matrix4 {
+    Matrix4::from_row_major([1, 2, 0, 3, 0, -1, 0, 4, 0, 0, 2, 5, 0, 0, 0, 1].map(Real::from))
+}
+#[test]
+fn generated_tensor_section_consumes_independent_selected_query() {
+    let section = section(&paraboloid());
+    assert_eq!(section.curve().kind(), Curve3Kind::TensorImage);
+    let a = alpha();
+    let native = native_parabola();
+    let query = native.point_at(&a).unwrap();
+    assert!(query.try_coordinates().is_none());
+    let roots = params(&native, &query);
+    assert_eq!(roots.len(), 1);
+    assert_eq!(roots[0].compare(&a).unwrap(), Ordering::Equal);
+    assert!(
+        section
+            .curve()
+            .point_at(&a)
+            .unwrap()
+            .coincides_with(&query)
+            .unwrap()
+    );
+    let found = params(section.curve(), &query);
+    assert_eq!(found.len(), 1);
+    assert_eq!(found[0].compare(&a).unwrap(), Ordering::Equal);
+    let reversed = section.curve().reversed().unwrap();
+    let found = params(&reversed, &query);
+    assert_eq!(found.len(), 1);
+    assert_eq!(
+        found[0]
+            .compare(&a.affine_image(&(-1).into(), &1.into()).unwrap())
+            .unwrap(),
+        Ordering::Equal
+    );
+    let excluded = section.curve().subcurve(&0.into(), &q(1, 2)).unwrap();
+    assert!(params(&excluded, &query).is_empty());
+    let kept = section.curve().subcurve(&q(1, 2), &1.into()).unwrap();
+    let found = params(&kept, &query);
+    assert_eq!(found.len(), 1);
+    assert_eq!(
+        found[0]
+            .compare(&a.affine_image(&2.into(), &(-1).into()).unwrap())
+            .unwrap(),
+        Ordering::Equal
+    );
+    let moved = Curve3::affine_image(section.curve().clone(), transform()).unwrap();
+    assert_eq!(
+        params(&moved, &query.transformed(&transform()).unwrap()).len(),
+        1
+    );
+}
+fn paraboloid_face() -> (Model, Surface) {
+    let patch = paraboloid();
+    let mut builder = ModelBuilder::new();
+    let surface = builder.surface(patch.clone()).unwrap();
+    let vertices = [(-1, -1), (-1, 1), (1, 1), (1, -1)].map(|(x, y)| {
+        builder
+            .vertex(Point3::new(x.into(), y.into(), 2.into()).into())
+            .unwrap()
+    });
+    let mut uses = Vec::new();
+    for (axis, constant, a, b, from, to, direction) in [
+        (
+            SurfaceIsoAxis::U,
+            0,
+            0,
+            1,
+            (0, 0),
+            (1, 0),
+            Direction::Forward,
+        ),
+        (
+            SurfaceIsoAxis::V,
+            1,
+            1,
+            2,
+            (1, 0),
+            (1, 1),
+            Direction::Forward,
+        ),
+        (
+            SurfaceIsoAxis::U,
+            1,
+            3,
+            2,
+            (0, 1),
+            (1, 1),
+            Direction::Reversed,
+        ),
+        (
+            SurfaceIsoAxis::V,
+            0,
+            0,
+            3,
+            (0, 0),
+            (0, 1),
+            Direction::Reversed,
+        ),
+    ] {
+        let curve = patch.iso_curve(axis, &Real::from(constant)).unwrap();
+        let domain = curve.domain().clone();
+        let curve = builder.curve(curve).unwrap();
+        let edge = builder
+            .edge(&vertices[a], &vertices[b], &curve, domain)
+            .unwrap();
+        let (from, to, map) = if direction == Direction::Forward {
+            (from, to, ParameterCorrespondence::identity())
+        } else {
+            (
+                to,
+                from,
+                ParameterCorrespondence::affine((-1).into(), 1.into()).unwrap(),
+            )
+        };
+        let pcurve = builder
+            .pcurve(Pcurve::new(Curve2::from(
+                LineSeg2::try_new(Uv::from_values(from.0, from.1), Uv::from_values(to.0, to.1))
+                    .unwrap(),
+            )))
+            .unwrap();
+        uses.push(builder.edge_use(&edge, direction, &pcurve, map).unwrap());
+    }
+    let wire = builder.wire(&uses).unwrap();
+    let face = builder
+        .face(&surface, Orientation::Forward, &wire, &[])
+        .unwrap();
+    builder.shell(&[face]).unwrap();
+    (builder.finish().unwrap(), patch)
+}
+fn continue_replayed_model(model: &Model) {
+    let a = alpha();
+    let query = native_parabola().point_at(&a).unwrap();
+    let edge = model
+        .edges()
+        .find(|edge| {
+            edge.curve().kind() == Curve3Kind::TensorImage
+                && edge
+                    .domain()
+                    .start()
+                    .compare(&Real::zero().into())
+                    .unwrap()
+                    .is_eq()
+                && edge.domain().end().try_real().is_none()
+        })
+        .unwrap();
+    assert_eq!(edge.uses().len(), 2);
+    let found = params(&edge.curve(), &query);
+    assert_eq!(found.len(), 1);
+    assert_eq!(
+        found[0].compare(edge.domain().end()).unwrap(),
+        Ordering::Equal
+    );
+    let edit = edge
+        .split(found[0].affine_image(&q(1, 2), &0.into()).unwrap())
+        .unwrap();
+    eprintln!("cold second selected split");
+    let cold = reload(edit.model());
+    assert_eq!(cold.faces().count(), 2);
+    let moved = model.transformed(&transform()).unwrap();
+    eprintln!("cold affine transformed split");
+    let moved = reload(&moved);
+    let edge = moved
+        .edges()
+        .find(|edge| {
+            edge.curve().kind() == Curve3Kind::TensorImage
+                && edge.domain().end().try_real().is_none()
+        })
+        .unwrap();
+    assert_eq!(
+        params(&edge.curve(), &query.transformed(&transform()).unwrap()).len(),
+        1
+    );
+}
+#[test]
+fn tensor_inverse_splits_both_face_uses_replays_fresh_and_splits_again() {
+    const INPUT: &str = "HYPERBREP_TENSOR_INVERSE_REPLAY";
+    if let Some(path) = std::env::var_os(INPUT) {
+        let json = std::fs::read_to_string(path).unwrap();
+        let model = RawModel::from_json(&json, &ArchiveLimits::default())
+            .unwrap()
+            .validate()
+            .unwrap();
+        assert_eq!(model.to_json().unwrap(), json);
+        continue_replayed_model(&model);
+        return;
+    }
+    let (model, patch) = paraboloid_face();
+    eprintln!("cold source");
+    let model = reload(&model);
+    let cut = section(&patch);
+    let split = model
+        .faces()
+        .next()
+        .unwrap()
+        .split_by_surface_curve(&cut, SurfaceIntersectionOperand::First)
+        .unwrap();
+    assert_eq!(split.model().faces().count(), 2);
+    eprintln!("cold face partition");
+    let partition = reload(split.model());
+    let edge = partition
+        .edges()
+        .find(|edge| edge.curve().kind() == Curve3Kind::TensorImage)
+        .unwrap();
+    assert_eq!(edge.uses().len(), 2);
+    let query = native_parabola().point_at(&alpha()).unwrap();
+    let found = params(&edge.curve(), &query);
+    assert_eq!(found.len(), 1);
+    let edit = edge.split(found[0].clone()).unwrap();
+    eprintln!("cold first selected split");
+    let model = reload(edit.model());
+    continue_replayed_model(&model);
+    let path = std::env::temp_dir().join(format!(
+        "hyperbrep-tensor-inverse-{}.json",
+        std::process::id()
+    ));
+    std::fs::write(&path, model.to_json().unwrap()).unwrap();
+    let child = std::process::Command::new(std::env::current_exe().unwrap())
+        .args([
+            "--exact",
+            "tensor_inverse_splits_both_face_uses_replays_fresh_and_splits_again",
+            "--nocapture",
+        ])
+        .env(INPUT, &path)
+        .output()
+        .unwrap();
+    std::fs::remove_file(path).unwrap();
+    assert!(
+        child.status.success(),
+        "{}{}",
+        String::from_utf8_lossy(&child.stdout),
+        String::from_utf8_lossy(&child.stderr)
+    );
+}
+#[test]
+fn native_tensor_sources_keep_all_visits_spline_charts_and_third_coordinate_checks() {
+    let a = alpha();
+    let source =
+        Curve2::from(LineSeg2::try_new(Uv::from_values(0, 0), Uv::from_values(1, 0)).unwrap());
+    let patch = Surface::rational_bezier(
+        (0..2)
+            .map(|v| {
+                (0..=3)
+                    .map(|i| {
+                        Point3::new(
+                            if i < 2 {
+                                0.into()
+                            } else {
+                                q((i * (i - 1)) as i64, 6)
+                            } + Real::from(v),
+                            if i == 3 { 1.into() } else { 0.into() },
+                            q(i as i64, 3),
+                        )
+                    })
+                    .collect()
+            })
+            .collect(),
+        vec![vec![Real::one(); 4]; 2],
+    )
+    .unwrap();
+    let curve = Curve3::tensor_image(patch, source.clone()).unwrap();
+    let native = Curve3::rational_bezier(
+        vec![
+            Point3::origin(),
+            Point3::new(0.into(), 0.into(), q(1, 3)),
+            Point3::new(q(1, 3), 0.into(), q(2, 3)),
+            Point3::new(1.into(), 1.into(), 1.into()),
+        ],
+        vec![Real::one(); 4],
+    )
+    .unwrap();
+    let query = native.point_at(&a).unwrap();
+    assert_eq!(params(&curve, &query).len(), 1);
+    let shift = Matrix4::from_row_major([
+        Real::one(),
+        0.into(),
+        0.into(),
+        0.into(),
+        0.into(),
+        Real::one(),
+        0.into(),
+        0.into(),
+        0.into(),
+        0.into(),
+        Real::one(),
+        q(1, 1_i64 << 60),
+        0.into(),
+        0.into(),
+        0.into(),
+        Real::one(),
+    ]);
+    assert!(params(&curve, &query.transformed(&shift).unwrap()).is_empty());
+    let patch = Surface::rational_bezier(
+        (0..2)
+            .map(|v| {
+                [1, -1, 1]
+                    .map(|x| Point3::new(x.into(), 0.into(), v.into()))
+                    .to_vec()
+            })
+            .collect(),
+        vec![vec![Real::one(); 3]; 2],
+    )
+    .unwrap();
+    let query = Curve3::rational_bezier(
+        vec![
+            Point3::origin(),
+            Point3::origin(),
+            Point3::new(1.into(), 0.into(), 0.into()),
+        ],
+        vec![Real::one(); 3],
+    )
+    .unwrap()
+    .point_at(&a)
+    .unwrap();
+    let spline = Curve2::from(
+        NurbsCurve2::try_new(
+            1,
+            vec![
+                Uv::from_values(0, 0),
+                Uv::new(q(1, 2), 0.into()),
+                Uv::from_values(1, 0),
+            ],
+            vec![Real::one(); 3],
+            vec![(-2).into(), (-2).into(), 1.into(), 4.into(), 4.into()],
+        )
+        .unwrap(),
+    );
+    for source in [source, spline] {
+        let curve = Curve3::tensor_image(patch.clone(), source).unwrap();
+        let found = params(&curve, &query);
+        assert_eq!(found.len(), 2);
+        for (t, scale) in found.iter().zip([-1, 1]) {
+            let expected = a.affine_image(&q(scale, 2), &q(1, 2)).unwrap();
+            assert_eq!(t.compare(&expected).unwrap(), Ordering::Equal);
+        }
+        let zero = selector().point_at(&a).unwrap();
+        let seam = params(&curve, &zero);
+        assert_eq!(seam.len(), 1);
