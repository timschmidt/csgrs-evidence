+    // s = cbrt(1/2), again at (1, 1, 0); the planar source is matched through
+    // its intersection with the cubic's plane projection at that same s.
+    let cubic = Curve3::rational_bezier(
+        vec![pi(1, 0, -1), pi(1, 0, -1), pi(1, 0, -1), pi(1, 2, 1)],
