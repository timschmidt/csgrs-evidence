new file mode 100644
index 0000000000..d55c27edcc
--- /dev/null
+++ b/crates/hypersolve/src/selected_polynomial_field/definition.rs
@@ -0,0 +1,138 @@
+//! Shared definitions of selected fields and values, without live proof caches.
+
+mod encode;
+mod replay;
+
+use super::{SelectedPolynomialError, SelectedPolynomialValue};
+use crate::radical_expression::TwoSquareRootExpression;
+use crate::{DenseTensorPolynomial, SymbolId};
+use hyperreal::Real;
+
+/// A selected native root's original data, with no trusted validation flags.
+/// Positive-width native intervals own `(lower, upper]`; an exact point witness
+/// retains the native root admission contract even in a wider interval.
+#[derive(Clone, Debug)]
+pub struct SelectedPolynomialRootDefinition {
+    pub constraint_index: usize,
+    pub symbol: SymbolId,
+    pub interval_index: usize,
+    pub polynomial: Vec<Real>,
+    pub lower: Real,
+    pub upper: Real,
+    pub exact_root: Option<Real>,
+}
+
+/// One definition record. Every index references an earlier record of the
+/// required type. Native base expressions retain both positive square roots;
+/// polynomial values retain rational functions in their selected generator.
+#[derive(Clone, Debug)]
+pub enum SelectedPolynomialDefinitionNode {
+    NativeBase {
+        sources: Vec<SelectedPolynomialRootDefinition>,
+        first_speed_squared: DenseTensorPolynomial,
+        second_speed_squared: DenseTensorPolynomial,
+    },
+    NativeExtension {
+        parent: usize,
+        radicand: usize,
+    },
+    NativeBaseValue {
+        field: usize,
+        expression: TwoSquareRootExpression<DenseTensorPolynomial>,
+    },
+    NativeExtensionValue {
+        field: usize,
+        retained: usize,
+        radical: usize,
+    },
+    NativeField {
+        native: usize,
+    },
+    PolynomialField {
+        parent: usize,
+        coefficients: Vec<usize>,
+        lower: Real,
+        upper: Real,
+    },
+    NativeValue {
+        field: usize,
+        numerator: usize,
+        denominator: usize,
+    },
+    PolynomialValue {
+        field: usize,
+        numerator: Vec<usize>,
+        denominator: Vec<usize>,
+    },
+}
+
+/// A finite, shared definition graph, suitable for a format owner to encode.
+///
+/// This is a scalar definition, not a curve's source/incidence provenance.
+/// `Real` payloads must use validated exact scalar interchange at a byte
+/// boundary. No wire format or geometric replay is implied by this type.
+#[derive(Clone, Debug)]
+pub struct SelectedPolynomialDefinition {
+    pub nodes: Vec<SelectedPolynomialDefinitionNode>,
+    /// Output value indices, preserving order and repeated outputs.
+    pub roots: Vec<usize>,
+}
+
+/// The declared graph-record limit was reached. No partial graph is returned.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct SelectedPolynomialNodeLimit {
+    pub limit: usize,
+}
+
+/// Replay failure before any output is published.
+#[derive(Debug)]
+pub enum SelectedPolynomialReplayError<E> {
+    /// A forward, absent, or wrongly typed reference. For roots, `node` equals
+    /// the number of graph records.
+    InvalidReference {
+        node: usize,
+        reference: usize,
+    },
+    InvalidNativeRoot {
+        node: usize,
+        source: usize,
+    },
+    /// A native base square is negative, or an extension square is not positive.
+    InvalidRadicand {
+        node: usize,
+    },
+    /// A value has the wrong native variant, tensor rank, or coefficient field.
+    InvalidCoordinates {
+        node: usize,
+    },
+    NodeLimit(SelectedPolynomialNodeLimit),
+    /// Original selection, arithmetic, denominator, or context error.
+    Field(SelectedPolynomialError<E>),
+}
+
+impl<E> From<SelectedPolynomialError<E>> for SelectedPolynomialReplayError<E> {
+    fn from(error: SelectedPolynomialError<E>) -> Self {
+        Self::Field(error)
+    }
+}
+
+impl<E> From<super::SelectedPolynomialArithmeticError> for SelectedPolynomialReplayError<E> {
+    fn from(error: super::SelectedPolynomialArithmeticError) -> Self {
+        Self::Field(SelectedPolynomialError::Arithmetic(error))
+    }
+}
+
+impl SelectedPolynomialDefinition {
+    /// Exports shared immutable storage with iterative dependency traversal.
+    /// Pointer keys live only during this call and never define value equality.
+    ///
+    /// `node_limit` counts records, not coefficient storage, arithmetic work,
+    /// temporary memory or cancellation. Underlying arithmetic has its own
+    /// resource limitations; this limit is not a total resource bound.
+    pub fn from_values(
+        values: &[SelectedPolynomialValue],
+        node_limit: usize,
+    ) -> Result<Self, SelectedPolynomialNodeLimit> {
+        encode::encode(values, node_limit)
+    }
+}
diff --git a/crates/hypersolve/src/selected_polynomial_field/definition/encode.rs b/crates/hypersolve/src/selected_polynomial_field/definition/encode.rs
new file mode 100644
index 0000000000..4c2814a156
--- /dev/null
+++ b/crates/hypersolve/src/selected_polynomial_field/definition/encode.rs
@@ -0,0 +1,201 @@
+use super::super::{Coordinates, FieldData, SelectedPolynomialField};
+use super::*;
+use crate::recursive_quadratic_field::{
+    RecursiveQuadraticField, RecursiveQuadraticValue, RecursiveQuadraticValueData,
+};
+use std::{collections::HashMap, sync::Arc};
+
+#[derive(Clone)]
+enum Input {
+    Field(SelectedPolynomialField),
+    Value(SelectedPolynomialValue),
+    NativeField(RecursiveQuadraticField),
+    NativeValue(RecursiveQuadraticValue),
+}
+
+type Key = (u8, usize);
+
+impl Input {
+    fn key(&self) -> Key {
+        match self {
+            Self::Field(v) => (0, Arc::as_ptr(&v.0) as usize),
+            Self::Value(v) => (1, Arc::as_ptr(&v.0) as usize),
+            Self::NativeField(RecursiveQuadraticField::Base(v)) => (2, Arc::as_ptr(v) as usize),
+            Self::NativeField(RecursiveQuadraticField::Extension(v)) => {
+                (3, Arc::as_ptr(v) as usize)
+            }
+            Self::NativeValue(v) => (4, Arc::as_ptr(&v.data) as usize),
+        }
+    }
+
+    fn dependencies(&self) -> Vec<Self> {
+        match self {
+            Self::Field(v) => match v.0.as_ref() {
+                FieldData::Recursive(field) => vec![Self::NativeField(field.clone())],
+                FieldData::Extension {
+                    parent, defining, ..
+                } => std::iter::once(Self::Field(parent.clone()))
+                    .chain(defining.iter().cloned().map(Self::Value))
+                    .collect(),
+            },
+            Self::Value(v) => {
+                let mut dependencies = vec![Self::Field(v.field().clone())];
+                match &v.0.coordinates {
+                    Coordinates::Recursive(scalar) => dependencies.extend([
+                        Self::NativeValue(scalar.numerator.clone()),
+                        Self::NativeValue(scalar.denominator.clone()),
+                    ]),
+                    Coordinates::Extension {
+                        numerator,
+                        denominator,
+                    } => dependencies.extend(
+                        numerator
+                            .iter()
+                            .chain(denominator)
+                            .cloned()
+                            .map(Self::Value),
+                    ),
+                }
+                dependencies
+            }
+            Self::NativeField(RecursiveQuadraticField::Base(_)) => Vec::new(),
+            Self::NativeField(RecursiveQuadraticField::Extension(v)) => vec![
+                Self::NativeField(v.parent.clone()),
+                Self::NativeValue(v.radicand.clone()),
+            ],
+            Self::NativeValue(v) => {
+                let mut dependencies = vec![Self::NativeField(v.field())];
+                if let RecursiveQuadraticValueData::Extension {
+                    retained, radical, ..
+                } = v.data.as_ref()
+                {
+                    dependencies.extend([
+                        Self::NativeValue(retained.clone()),
+                        Self::NativeValue(radical.clone()),
+                    ]);
+                }
+                dependencies
+            }
+        }
+    }
+
+    fn node(&self, ids: &HashMap<Key, usize>) -> SelectedPolynomialDefinitionNode {
+        use SelectedPolynomialDefinitionNode as Node;
+        let id = |input: Self| ids[&input.key()];
+        let values =
+            |v: &[SelectedPolynomialValue]| v.iter().cloned().map(|v| id(Self::Value(v))).collect();
+        match self {
+            Self::Field(v) => match v.0.as_ref() {
+                FieldData::Recursive(field) => Node::NativeField {
+                    native: id(Self::NativeField(field.clone())),
+                },
+                FieldData::Extension {
+                    parent,
+                    defining,
+                    interval,
+                    ..
+                } => Node::PolynomialField {
+                    parent: id(Self::Field(parent.clone())),
+                    coefficients: values(defining),
+                    lower: interval.lower.clone(),
+                    upper: interval.upper.clone(),
+                },
+            },
+            Self::Value(v) => {
+                let field = id(Self::Field(v.field().clone()));
+                match &v.0.coordinates {
+                    Coordinates::Recursive(scalar) => Node::NativeValue {
+                        field,
+                        numerator: id(Self::NativeValue(scalar.numerator.clone())),
+                        denominator: id(Self::NativeValue(scalar.denominator.clone())),
+                    },
+                    Coordinates::Extension {
+                        numerator,
+                        denominator,
+                    } => Node::PolynomialValue {
+                        field,
+                        numerator: values(numerator),
+                        denominator: values(denominator),
+                    },
+                }
+            }
+            Self::NativeField(RecursiveQuadraticField::Base(v)) => Node::NativeBase {
+                sources: v
+                    .sources
+                    .iter()
+                    .map(|root| SelectedPolynomialRootDefinition {
+                        constraint_index: root.constraint_index,
+                        symbol: root.symbol,
+                        interval_index: root.interval_index,
+                        polynomial: root.polynomial_coefficients.clone(),
+                        lower: root.interval.lower.clone(),
+                        upper: root.interval.upper.clone(),
+                        exact_root: root.interval.exact_root.clone(),
+                    })
+                    .collect(),
+                first_speed_squared: v.first_speed_squared.clone(),
+                second_speed_squared: v.second_speed_squared.clone(),
+            },
+            Self::NativeField(RecursiveQuadraticField::Extension(v)) => Node::NativeExtension {
+                parent: id(Self::NativeField(v.parent.clone())),
+                radicand: id(Self::NativeValue(v.radicand.clone())),
+            },
+            Self::NativeValue(v) => {
+                let field = id(Self::NativeField(v.field()));
+                match v.data.as_ref() {
+                    RecursiveQuadraticValueData::Base { expression, .. } => Node::NativeBaseValue {
+                        field,
+                        expression: expression.clone(),
+                    },
+                    RecursiveQuadraticValueData::Extension {
+                        retained, radical, ..
+                    } => Node::NativeExtensionValue {
+                        field,
+                        retained: id(Self::NativeValue(retained.clone())),
+                        radical: id(Self::NativeValue(radical.clone())),
+                    },
+                }
+            }
+        }
+    }
+}
+
+pub(super) fn encode(
+    values: &[SelectedPolynomialValue],
+    limit: usize,
+) -> Result<SelectedPolynomialDefinition, SelectedPolynomialNodeLimit> {
+    let mut ids = HashMap::new();
+    let mut nodes = Vec::new();
+    let mut stack: Vec<_> = values
+        .iter()
+        .rev()
+        .cloned()
+        .map(|v| (Input::Value(v), false))
+        .collect();
+    while let Some((input, ready)) = stack.pop() {
+        let key = input.key();
+        if ids.contains_key(&key) {
+            continue;
+        }
+        if ready {
+            if nodes.len() == limit {
+                return Err(SelectedPolynomialNodeLimit { limit });
+            }
+            let node = input.node(&ids);
+            ids.insert(key, nodes.len());
+            nodes.push(node);
+        } else {
+            let dependencies = input.dependencies();
+            stack.push((input, true));
+            stack.extend(dependencies.into_iter().rev().map(|v| (v, false)));
+        }
+    }
+    Ok(SelectedPolynomialDefinition {
+        nodes,
+        roots: values
+            .iter()
+            .cloned()
+            .map(|v| ids[&Input::Value(v).key()])
+            .collect(),
+    })
+}
diff --git a/crates/hypersolve/src/selected_polynomial_field/definition/replay.rs b/crates/hypersolve/src/selected_polynomial_field/definition/replay.rs
new file mode 100644
index 0000000000..efc7185bfa
--- /dev/null
+++ b/crates/hypersolve/src/selected_polynomial_field/definition/replay.rs
@@ -0,0 +1,327 @@
+use super::super::{FieldData, SelectedPolynomialField, unavailable};
+use super::*;
+use crate::classification::{Classification, UncertaintyReason};
+use crate::recursive_quadratic_field::{RecursiveQuadraticField, RecursiveQuadraticValue};
+use crate::{
+    AlgebraicField, AlgebraicFieldError, AlgebraicRootRepresentation,
+    AlgebraicRootValidationReport, AlgebraicRootValidationStatus, IsolatedRootInterval,
+    SelectedAlgebraContext,
+};
+use hyperreal::RealSign;
+
+type Error<E> = SelectedPolynomialReplayError<E>;
+type Result<T, E> = std::result::Result<T, Error<E>>;
+
+fn exact<T, E>(result: Classification<T>) -> Result<T, E> {
+    match result {
+        Classification::Decided(value) => Ok(value),
+        Classification::Uncertain(reason) => Err(SelectedPolynomialError::Uncertain(reason).into()),
+    }
+}
+
+fn promotion<E>() -> Result<(), E> {
+    crate::work_budget::consume(crate::work_budget::WorkKind::AlgebraicPromotion, 1)
+        .map_err(|_| SelectedPolynomialError::Uncertain(UncertaintyReason::BudgetExhausted).into())
+}
+
+fn native_sign<C: SelectedAlgebraContext>(
+    value: &RecursiveQuadraticValue,
+    policy: &C,
+) -> Result<RealSign, C::Error> {
+    exact(
+        value
+            .sign(policy)
+            .map_err(SelectedPolynomialError::Context)?,
+    )
+}
+
+enum Admitted {
+    NativeField(RecursiveQuadraticField),
+    NativeValue(RecursiveQuadraticValue),
+    Field(SelectedPolynomialField),
+    Value(SelectedPolynomialValue),
+}
+
+struct Reader<'a>(&'a [Admitted]);
+
+impl Reader<'_> {
+    fn invalid<E>(&self, reference: usize) -> Error<E> {
+        Error::InvalidReference {
+            node: self.0.len(),
+            reference,
+        }
+    }
+
+    fn native_field<E>(&self, reference: usize) -> Result<RecursiveQuadraticField, E> {
+        match self.0.get(reference) {
+            Some(Admitted::NativeField(value)) => Ok(value.clone()),
+            _ => Err(self.invalid(reference)),
+        }
+    }
+
+    fn native_value<E>(&self, reference: usize) -> Result<RecursiveQuadraticValue, E> {
+        match self.0.get(reference) {
+            Some(Admitted::NativeValue(value)) => Ok(value.clone()),
+            _ => Err(self.invalid(reference)),
+        }
+    }
+
+    fn field<E>(&self, reference: usize) -> Result<SelectedPolynomialField, E> {
+        match self.0.get(reference) {
+            Some(Admitted::Field(value)) => Ok(value.clone()),
+            _ => Err(self.invalid(reference)),
+        }
+    }
+
+    fn value<E>(&self, reference: usize) -> Result<SelectedPolynomialValue, E> {
+        match self.0.get(reference) {
+            Some(Admitted::Value(value)) => Ok(value.clone()),
+            _ => Err(self.invalid(reference)),
+        }
+    }
+
+    fn values<E>(&self, references: &[usize]) -> Result<Vec<SelectedPolynomialValue>, E> {
+        references.iter().map(|id| self.value(*id)).collect()
+    }
+
+    fn coordinates<E>(&self, valid: bool) -> Result<(), E> {
+        if valid {
+            Ok(())
+        } else {
+            Err(Error::InvalidCoordinates { node: self.0.len() })
+        }
+    }
+
+    fn admit<C: SelectedAlgebraContext>(
+        &self,
+        definition: &SelectedPolynomialDefinitionNode,
+        policy: &C,
+    ) -> Result<Admitted, C::Error> {
+        use SelectedPolynomialDefinitionNode as Node;
+        let node = self.0.len();
+        Ok(match definition {
+            Node::NativeBase {
+                sources,
+                first_speed_squared,
+                second_speed_squared,
+            } => {
+                self.coordinates(
+                    [first_speed_squared, second_speed_squared]
+                        .iter()
+                        .all(|p| p.dimensions().len() == sources.len()),
+                )?;
+                promotion()?;
+                let sources = sources
+                    .iter()
+                    .enumerate()
+                    .map(|(source, definition)| {
+                        let root = AlgebraicRootRepresentation {
+                            constraint_index: definition.constraint_index,
+                            symbol: definition.symbol,
+                            interval_index: definition.interval_index,
+                            polynomial_coefficients: definition.polynomial.clone(),
+                            interval: IsolatedRootInterval {
+                                lower: definition.lower.clone(),
+                                upper: definition.upper.clone(),
+                                exact_root: definition.exact_root.clone(),
+                                distinct_root_count: 1,
+                            },
+                            // This provisional payload is never published without
+                            // full strict selection replay below. A count of one or
+                            // this flag alone is not a uniqueness proof.
+                            validation: AlgebraicRootValidationReport {
+                                status: AlgebraicRootValidationStatus::Valid,
+                                message: None,
+                            },
+                        };
+                        match AlgebraicField::new(&root) {
+                            Ok(_) => Ok(root),
+                            Err(AlgebraicFieldError::Undecided) => Err(Error::Field(
+                                SelectedPolynomialError::Uncertain(UncertaintyReason::Predicate),
+                            )),
+                            Err(
+                                AlgebraicFieldError::InvalidEvidence
+                                | AlgebraicFieldError::DivisionByZero,
+                            ) => Err(Error::InvalidNativeRoot { node, source }),
+                        }
+                    })
+                    .collect::<Result<Vec<_>, C::Error>>()?;
+                // Prove native speed squares in an already valid unit-radical
+                // base, before constructing any field with the supplied squares.
+                let one = unavailable(DenseTensorPolynomial::try_new(
+                    vec![1; sources.len()],
+                    vec![Real::one()],
+                ))?;
+                let RecursiveQuadraticField::Base(validation) = unavailable(
+                    RecursiveQuadraticField::base(sources.clone(), one.clone(), one),
+                )?
+                else {
+                    unreachable!()
+                };
+                for square in [first_speed_squared, second_speed_squared] {
+                    let expression =
+                        unavailable(TwoSquareRootExpression::from_rational(square.clone()))?;
+                    let value = unavailable(RecursiveQuadraticValue::from_base(
+                        validation.clone(),
+                        expression,
+                    ))?;
+                    if native_sign(&value, policy)? == RealSign::Negative {
+                        return Err(Error::InvalidRadicand { node });
+                    }
+                }
+                Admitted::NativeField(unavailable(RecursiveQuadraticField::base(
+                    sources,
+                    first_speed_squared.clone(),
+                    second_speed_squared.clone(),
+                ))?)
+            }
+            Node::NativeExtension { parent, radicand } => {
+                let parent = self.native_field(*parent)?;
+                let radicand = self.native_value(*radicand)?;
+                self.coordinates(parent.same_field(&radicand.field()))?;
+                promotion()?;
+                if native_sign(&radicand, policy)? != RealSign::Positive {
+                    return Err(Error::InvalidRadicand { node });
+                }
+                Admitted::NativeField(unavailable(parent.extension(radicand))?)
+            }
+            Node::NativeBaseValue { field, expression } => {
+                let RecursiveQuadraticField::Base(field) = self.native_field(*field)? else {
+                    return Err(Error::InvalidCoordinates { node });
+                };
+                self.coordinates(
+                    [
+                        &expression.rational,
+                        &expression.first,
+                        &expression.second,
+                        &expression.product,
+                    ]
+                    .iter()
+                    .all(|p| p.dimensions().len() == field.sources.len()),
+                )?;
+                Admitted::NativeValue(unavailable(RecursiveQuadraticValue::from_base(
+                    field,
+                    expression.clone(),
+                ))?)
+            }
+            Node::NativeExtensionValue {
+                field,
+                retained,
+                radical,
+            } => {
+                let RecursiveQuadraticField::Extension(field) = self.native_field(*field)? else {
+                    return Err(Error::InvalidCoordinates { node });
+                };
+                let retained = self.native_value(*retained)?;
+                let radical = self.native_value(*radical)?;
+                self.coordinates(
+                    field.parent.same_field(&retained.field())
+                        && field.parent.same_field(&radical.field()),
+                )?;
+                Admitted::NativeValue(unavailable(RecursiveQuadraticValue::from_extension(
+                    field, retained, radical,
+                ))?)
+            }
+            Node::NativeField { native } => Admitted::Field(
+                SelectedPolynomialField::from_recursive(self.native_field(*native)?),
+            ),
+            Node::PolynomialField {
+                parent,
+                coefficients,
+                lower,
+                upper,
+            } => {
+                let parent = self.field(*parent)?;
+                Admitted::Field(parent.select_strict(
+                    self.values(coefficients)?,
+                    lower.clone(),
+                    upper.clone(),
+                    policy,
+                )?)
+            }
+            Node::NativeValue {
+                field,
+                numerator,
+                denominator,
+            } => {
+                let field = self.field(*field)?;
+                let FieldData::Recursive(native) = field.0.as_ref() else {
+                    return Err(Error::InvalidCoordinates { node });
+                };
+                let numerator = self.native_value(*numerator)?;
+                let denominator = self.native_value(*denominator)?;
+                self.coordinates(
+                    native.same_field(&numerator.field())
+                        && native.same_field(&denominator.field()),
+                )?;
+                let numerator = field.import_recursive(&numerator)?;
+                let denominator = field.import_recursive(&denominator)?;
+                Admitted::Value(numerator.multiply(&denominator.reciprocal_strict(policy)?)?)
+            }
+            Node::PolynomialValue {
+                field,
+                numerator,
+                denominator,
+            } => {
+                let field = self.field(*field)?;
+                let Some(parent) = field.parent() else {
+                    return Err(Error::InvalidCoordinates { node });
+                };
+                let numerator = self.values(numerator)?;
+                let denominator = self.values(denominator)?;
+                self.coordinates(
+                    numerator
+                        .iter()
+                        .chain(&denominator)
+                        .all(|v| parent.shares_authority(v.field())),
+                )?;
+                let one = vec![parent.constant(Real::one())?];
+                let numerator = field.extension_value(numerator, one.clone())?;
+                let denominator = field.extension_value(denominator, one)?;
+                Admitted::Value(numerator.multiply(&denominator.reciprocal_strict(policy)?)?)
+            }
+        })
+    }
+}
+
+impl SelectedPolynomialDefinition {
+    /// Re-establishes every selection and denominator, including unused records.
+    /// No root is exposed until all records and root references pass.
+    ///
+    /// The caller's record limit is separate from the shared promotion counter:
+    /// each native base/extension admission uses one promotion, and polynomial
+    /// selection uses its existing promotion charge. Neither bounds internal
+    /// arithmetic work, coefficient size, memory, elapsed time or cancellation.
+    /// Strict passes forbid approximate terminals even in an approximate context.
+    pub fn replay<C: SelectedAlgebraContext>(
+        &self,
+        node_limit: usize,
+        policy: &C,
+    ) -> Result<Classification<Vec<SelectedPolynomialValue>>, C::Error> {
+        if self.nodes.len() > node_limit {
+            return Err(Error::NodeLimit(SelectedPolynomialNodeLimit {
+                limit: node_limit,
+            }));
+        }
+        let result = policy.strict_predicate_pass(|| {
+            let mut admitted = Vec::new();
+            for node in &self.nodes {
+                let value = Reader(&admitted).admit(node, policy)?;
+                admitted.push(value);
+            }
+            Reader(&admitted).values(&self.roots)
+        });
+        if crate::work_budget::exhaustion().is_some() {
+            return Ok(Classification::Uncertain(
+                UncertaintyReason::BudgetExhausted,
+            ));
+        }
+        match result {
+            Ok(values) => Ok(Classification::Decided(values)),
+            Err(Error::Field(SelectedPolynomialError::Uncertain(reason))) => {
+                Ok(Classification::Uncertain(reason))
+            }
+            Err(error) => Err(error),
+        }
+    }
+}
diff --git a/crates/hypersolve/src/selected_polynomial_field/join.rs b/crates/hypersolve/src/selected_polynomial_field/join.rs
new file mode 100644
index 0000000000..afe4237fe0
--- /dev/null
+++ b/crates/hypersolve/src/selected_polynomial_field/join.rs
@@ -0,0 +1,371 @@
+//! Exact common fields and retained generator correspondences.
+
+use std::collections::HashMap;
+
+use super::*;
+use crate::recursive_quadratic_field::{
+    RecursiveQuadraticBaseField, RecursiveQuadraticExtensionEmbedding,
+    RecursiveQuadraticForeignBaseEmbedding, recursive_embed_foreign_field,
+    recursive_quadratic_source_union, recursive_rebase_field_preserving_base,
+    recursive_rebase_value_preserving_base,
+};
+use crate::tensor_support::{dense_reduce_selected_tuple_relations, dense_tensor_embed_axes};
+
+/// A common selected field and validated embeddings of its operand fields.
+///
+/// Original generator relations are replayed over embedded parent values in
+/// their original singleton selectors. A correspondence therefore denotes the
+/// same selected real value, including for reducible or repeated equations.
+/// Ancestor fields retain their authority. Divergent polynomial generators
+/// are appended without projection; algebraically equal selections need not
+/// have the same allocation or polynomial presentation.
+pub struct SelectedPolynomialJoin {
+    field: SelectedPolynomialField,
+    native: Vec<NativeEmbedding>,
+    generators: Vec<GeneratorEmbedding>,
+}
+
+impl std::fmt::Debug for SelectedPolynomialJoin {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("SelectedPolynomialJoin")
+            .field("field", &self.field)
+            .field("native_embeddings", &self.native.len())
+            .field("generator_embeddings", &self.generators.len())
+            .finish()
+    }
+}
+
+struct GeneratorEmbedding {
+    source: SelectedPolynomialField,
+    image: SelectedPolynomialValue,
+}
+
+struct NativeEmbedding {
+    source: RecursiveQuadraticField,
+    target: RecursiveQuadraticField,
+    map: NativeMap,
+}
+
+enum NativeMap {
+    Extensions(Vec<RecursiveQuadraticExtensionEmbedding>),
+    Rebased {
+        source: Arc<RecursiveQuadraticBaseField>,
+        target: Arc<RecursiveQuadraticBaseField>,
+        axes: Vec<usize>,
+        extensions: Vec<RecursiveQuadraticExtensionEmbedding>,
+    },
+    Foreign(RecursiveQuadraticForeignBaseEmbedding),
+}
+
+impl NativeEmbedding {
+    fn value(&self, value: &RecursiveQuadraticValue) -> Option<RecursiveQuadraticValue> {
+        if !recursive_ancestor(&self.source, &value.field()) {
+            return None;
+        }
+        match &self.map {
+            NativeMap::Extensions(extensions) => self.target.embed_value(value, extensions),
+            NativeMap::Rebased {
+                source,
+                target,
+                axes,
+                extensions,
+            } => self.target.lift(&recursive_rebase_value_preserving_base(
+                value, source, target, axes, extensions,
+            )?),
+            NativeMap::Foreign(embedding) => embedding.value(value, &self.target),
+        }
+    }
+}
+
+impl SelectedPolynomialField {
+    /// Constructs a common selected field with exact embeddings of both inputs.
+    ///
+    /// Native recursive fields use their existing source-union and embedding
+    /// authority. Every new polynomial generator replays its original equation
+    /// and selector after transporting its coefficients. This consumes the
+    /// same shared promotion unit as `select`; no total work or memory bound
+    /// follows from that counter. An unavailable proof cannot publish a join.
+    pub fn joined_with<C: SelectedAlgebraContext>(
+        &self,
+        other: &Self,
+        policy: &C,
+    ) -> ExactResult<SelectedPolynomialJoin, C::Error> {
+        finish(policy.strict_predicate_pass(|| {
+            if self.contains_field(other) {
+                return Ok(SelectedPolynomialJoin::retained(self.clone()));
+            }
+            if other.contains_field(self) {
+                return Ok(SelectedPolynomialJoin::retained(other.clone()));
+            }
+            let (first_native, first_path) = self.native_and_path();
+            let (second_native, second_path) = other.native_and_path();
+            let (native, maps) = join_native(first_native, second_native, policy)?;
+            let field = if native.same_field(first_native) {
+                self.clone()
+            } else {
+                Self::from_recursive(native)
+            };
+            let mut joined = SelectedPolynomialJoin {
+                field,
+                native: maps,
+                generators: Vec::new(),
+            };
+            for source in first_path.into_iter().chain(second_path) {
+                joined.append(source, policy)?;
+            }
+            Ok(joined)
+        }))
+    }
+
+    fn contains_field(&self, source: &Self) -> bool {
+        if self.shares_authority(source) {
+            return true;
+        }
+        match (self.0.as_ref(), source.0.as_ref()) {
+            (FieldData::Recursive(target), FieldData::Recursive(source)) => {
+                recursive_ancestor(target, source)
+            }
+            (FieldData::Extension { parent, .. }, _) => parent.contains_field(source),
+            _ => false,
+        }
+    }
+
+    fn native_and_path(&self) -> (&RecursiveQuadraticField, Vec<Self>) {
+        let mut current = self;
+        let mut path = Vec::new();
+        loop {
+            match current.0.as_ref() {
+                FieldData::Recursive(native) => {
+                    path.reverse();
+                    return (native, path);
+                }
+                FieldData::Extension { parent, .. } => {
+                    path.push(current.clone());
+                    current = parent;
+                }
+            }
+        }
+    }
+}
+
+impl SelectedPolynomialJoin {
+    fn retained(field: SelectedPolynomialField) -> Self {
+        Self {
+            field,
+            native: Vec::new(),
+            generators: Vec::new(),
+        }
+    }
+
+    /// The common field, usable as the parent of a further selected extension.
+    pub fn field(&self) -> &SelectedPolynomialField {
+        &self.field
+    }
+
+    /// Transports a value from either input or an ancestor through the retained
+    /// generator correspondences. Original finite-denominator proofs are
+    /// preserved by these exact real-field embeddings; they are not inferred
+    /// from approximate coordinates or a new independent selection.
+    ///
+    /// A call-local memo retains shared input values during traversal. It has
+    /// no cross-call or policy lifetime, and stores no failed decisions.
+    pub fn embed(
+        &self,
+        value: &SelectedPolynomialValue,
+    ) -> ArithmeticResult<SelectedPolynomialValue> {
+        self.embed_inner(value, &mut HashMap::new())
+    }
+
+    fn embed_inner(
+        &self,
+        value: &SelectedPolynomialValue,
+        memo: &mut HashMap<usize, SelectedPolynomialValue>,
+    ) -> ArithmeticResult<SelectedPolynomialValue> {
+        match self.field.lift(value) {
+            Ok(value) => return Ok(value),
+            Err(SelectedPolynomialArithmeticError::IncompatibleField) => {}
+            Err(error) => return Err(error),
+        }
+        // The immutable source graph remains owned throughout this call, so
+        // pointer keys cannot outlive their nodes or be recycled during traversal.
+        let key = Arc::as_ptr(&value.0) as usize;
+        if let Some(mapped) = memo.get(&key) {
+            return Ok(mapped.clone());
+        }
+        let mapped = match &value.0.coordinates {
+            Coordinates::Recursive(scalar) => {
+                let embedding = self
+                    .native
+                    .iter()
+                    .find(|map| recursive_ancestor(&map.source, &scalar.numerator.field()))
+                    .ok_or(SelectedPolynomialArithmeticError::IncompatibleField)?;
+                let numerator = self
+                    .field
+                    .import_recursive(&unavailable(embedding.value(&scalar.numerator))?)?;
+                let denominator = self
+                    .field
+                    .import_recursive(&unavailable(embedding.value(&scalar.denominator))?)?;
+                numerator.multiply(&denominator.positive_reciprocal()?)?
+            }
+            Coordinates::Extension {
+                numerator,
+                denominator,
+            } => {
+                let generator = self
+                    .generators
+                    .iter()
+                    .find(|map| map.source.shares_authority(value.field()))
+                    .ok_or(SelectedPolynomialArithmeticError::IncompatibleField)?;
+                let generator = self.field.lift(&generator.image)?;
+                let numerator = self.evaluate_embedded(numerator, &generator, memo)?;
+                let denominator = self.evaluate_embedded(denominator, &generator, memo)?;
+                numerator.multiply(&denominator.positive_reciprocal()?)?
+            }
+        };
+        memo.insert(key, mapped.clone());
+        Ok(mapped)
+    }
+
+    fn evaluate_embedded(
+        &self,
+        coefficients: &[SelectedPolynomialValue],
+        generator: &SelectedPolynomialValue,
+        memo: &mut HashMap<usize, SelectedPolynomialValue>,
+    ) -> ArithmeticResult<SelectedPolynomialValue> {
+        let mut result = self.field.constant(Real::zero())?;
+        for coefficient in coefficients.iter().rev() {
+            result = result
+                .multiply(generator)?
+                .add(&self.embed_inner(coefficient, memo)?)?;
+        }
+        Ok(result)
+    }
+
+    fn append<C: SelectedAlgebraContext>(
+        &mut self,
+        source: SelectedPolynomialField,
+        policy: &C,
+    ) -> Result<(), SelectedPolynomialError<C::Error>> {
+        if self.field.contains_field(&source)
+            || self
+                .generators
+                .iter()
+                .any(|map| map.source.shares_authority(&source))
+        {
+            return Ok(());
+        }
+        let FieldData::Extension {
+            defining, interval, ..
+        } = source.0.as_ref()
+        else {
+            return Err(SelectedPolynomialArithmeticError::NoPolynomialGenerator.into());
+        };
+        let mut memo = HashMap::new();
+        let coefficients = defining
+            .iter()
+            .map(|coefficient| self.embed_inner(coefficient, &mut memo))
+            .collect::<ArithmeticResult<Vec<_>>>()?;
+        let field = self.field.select_strict(
+            coefficients,
+            interval.lower.clone(),
+            interval.upper.clone(),
+            policy,
+        )?;
+        self.generators.push(GeneratorEmbedding {
+            source,
+            image: field.generator()?,
+        });
+        self.field = field;
+        Ok(())
+    }
+}
+
+impl SelectedPolynomialValue {
+    // Only called after exact embedding has transported an existing strict
+    // positivity proof. The public reciprocal path still performs its sign test.
+    fn positive_reciprocal(&self) -> ArithmeticResult<Self> {
+        match &self.0.coordinates {
+            Coordinates::Recursive(scalar) => self
+                .field()
+                .recursive_value(scalar.denominator.clone(), scalar.numerator.clone()),
+            Coordinates::Extension {
+                numerator,
+                denominator,
+            } => self
+                .field()
+                .extension_value(denominator.clone(), numerator.clone()),
+        }
+    }
+}
+
+fn require_native<T, E>(value: Classification<Option<T>>) -> Result<T, SelectedPolynomialError<E>> {
+    match value {
+        Classification::Decided(value) => Ok(unavailable(value)?),
+        Classification::Uncertain(reason) => Err(SelectedPolynomialError::Uncertain(reason)),
+    }
+}
+
+fn join_native<C: SelectedAlgebraContext>(
+    first: &RecursiveQuadraticField,
+    second: &RecursiveQuadraticField,
+    policy: &C,
+) -> Result<(RecursiveQuadraticField, Vec<NativeEmbedding>), SelectedPolynomialError<C::Error>> {
+    let (first_base, _) = first.base_and_extension_path();
+    let (second_base, _) = second.base_and_extension_path();
+    if Arc::ptr_eq(&first_base, &second_base) {
+        let (joined, extensions) = require_native(
+            first
+                .joined_with(second, policy)
+                .map_err(SelectedPolynomialError::Context)?,
+        )?;
+        let map = NativeEmbedding {
+            source: second.clone(),
+            target: joined.clone(),
+            map: NativeMap::Extensions(extensions),
+        };
+        return Ok((joined, vec![map]));
+    }
+    let (sources, first_axes, second_axes) =
+        recursive_quadratic_source_union(&first_base.sources, &second_base.sources);
+    let embed_speed = |polynomial| {
+        dense_tensor_embed_axes(polynomial, sources.len(), &first_axes)
+            .and_then(|polynomial| dense_reduce_selected_tuple_relations(polynomial, &sources))
+    };
+    let first_speed = unavailable(embed_speed(&first_base.first_speed_squared))?;
+    let second_speed = unavailable(embed_speed(&first_base.second_speed_squared))?;
+    let base = unavailable(RecursiveQuadraticField::base(
+        sources,
+        first_speed,
+        second_speed,
+    ))?;
+    let RecursiveQuadraticField::Base(target_base) = &base else {
+        unreachable!()
+    };
+    let (rebased, source_base, extensions) = unavailable(recursive_rebase_field_preserving_base(
+        first,
+        target_base.clone(),
+        &first_axes,
+    ))?;
+    let (joined, foreign) = require_native(
+        recursive_embed_foreign_field(second, target_base.clone(), second_axes, rebased, policy)
+            .map_err(SelectedPolynomialError::Context)?,
+    )?;
+    let maps = vec![
+        NativeEmbedding {
+            source: first.clone(),
+            target: joined.clone(),
+            map: NativeMap::Rebased {
+                source: source_base,
+                target: target_base.clone(),
+                axes: first_axes,
+                extensions,
+            },
+        },
+        NativeEmbedding {
+            source: second.clone(),
+            target: joined.clone(),
+            map: NativeMap::Foreign(foreign),
+        },
+    ];
+    Ok((joined, maps))
+}
