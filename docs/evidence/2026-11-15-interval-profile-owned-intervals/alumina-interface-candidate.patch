+#[cfg(test)]
+mod retained_owner_contract_tests {
+    use super::*;
+
+    const fn endpoint_access(value: &ExactInterval) -> (&Rational, &Rational, &Rational) {
+        (value.nominal(), value.lower(), value.upper())
+    }
+
+    #[test]
+    fn retained_owner_preserves_debug_size_const_access_and_scaled_values() {
+        #[derive(Debug)]
+        struct ExactIntervalLegacy {
+            nominal: Rational,
+            lower: Rational,
+            upper: Rational,
+        }
+        let interval = ExactInterval {
+            nominal: Rational::fraction(1, 3).unwrap(),
+            interval: NonEmptyRationalInterval::new(Rational::from(-2), Rational::from(3)).unwrap(),
+        };
+        let legacy = ExactIntervalLegacy {
+            nominal: interval.nominal().clone(),
+            lower: interval.lower().clone(),
+            upper: interval.upper().clone(),
+        };
+        assert_eq!(
+            endpoint_access(&interval),
+            (&legacy.nominal, &legacy.lower, &legacy.upper)
+        );
+        assert_eq!(
+            format!("{interval:?}"),
+            format!("{legacy:?}").replacen("ExactIntervalLegacy", "ExactInterval", 1)
+        );
+        assert_eq!(
+            core::mem::size_of::<ExactInterval>(),
+            core::mem::size_of::<ExactIntervalLegacy>()
+        );
+        for d in [1, 2, 17, 1000, u64::MAX] {
+            let result =
+                interval.divided_by_positive_integer(core::num::NonZeroU64::new(d).unwrap());
+            assert_eq!(result.nominal() * Rational::from(d), legacy.nominal);
+            assert_eq!(result.lower() * Rational::from(d), legacy.lower);
+            assert_eq!(result.upper() * Rational::from(d), legacy.upper);
+        }
+    }
+}
