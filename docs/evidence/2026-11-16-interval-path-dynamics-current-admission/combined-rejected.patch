@@ -0,0 +1,34 @@
+//! Lazy source-owned join decisions with their complete retained evidence.
+use crate::{CornerLookaheadJoinClass, DynamicsError};
+use hyperlimit::PredicatePolicy;
+
+/// A source-owned join decision and its original evidence.
+///
+/// The receipt must retain the endpoint/tangent relations, certainty and source
+/// identity on which classification relies. A successful class asserts the
+/// exact corresponding relation; invalid or undecided geometry remains a typed
+/// error. This container is not itself a validator of arbitrary user providers.
+#[derive(Clone, Debug)]
+pub struct ClassifiedJoin<E> {
+    /// Dynamics class or explicit failure from the geometry owner.
+    pub classification: Result<CornerLookaheadJoinClass, DynamicsError>,
+    /// Complete source-owned predicate receipt, including failure evidence.
+    pub receipt: E,
+}
+
+/// Retained span data whose geometry owner can classify an adjacent join.
+///
+/// Classification is requested lazily under the supplied policy. Implementors
+/// must preserve source identities and transport all consumed evidence in the
+/// receipt. Repeated requests must remain valid for the same retained sources;
+/// scheduling does not authorize precomputation, approximation or weaker proof.
+pub trait JoinSpan {
+    /// Geometry-owned receipt transported without replacing it by a class alone.
+    type Receipt: Clone + core::fmt::Debug;
+    /// Classify this span's end against the outgoing span's start.
+    fn classify_join(
+        &self,
+        outgoing: &Self,
+        policy: PredicatePolicy,
+    ) -> ClassifiedJoin<Self::Receipt>;
+}
diff --git a/crates/hyperdynamics/src/lib.rs b/crates/hyperdynamics/src/lib.rs
index af3dd27f1..d84ed3114 100644
--- a/crates/hyperdynamics/src/lib.rs
+++ b/crates/hyperdynamics/src/lib.rs
@@ -11,3 +11,158 @@
 /// Owned dyadic vector fields with validated expression/Jacobian association.
 #[cfg(feature = "field")]
 pub mod field;
+
+mod axis_projection;
+pub use axis_projection::*;
+
+mod feed;
+mod guards;
+mod jerk_schedule;
+mod join;
+mod lookahead;
+mod metric;
+pub use feed::{
+    AccelerationLimitedFeedProfileClass, AccelerationLimitedFeedTimeReport, ConstantFeedTimeReport,
+    CornerLookaheadJoinClass, CornerLookaheadJoinReport, CornerLookaheadLimitReport,
+    JerkLimitedFeedTimeReport, certify_acceleration_limited_feed_time, certify_constant_feed_time,
+    certify_corner_lookahead_limits, certify_symmetric_jerk_limited_feed_time,
+    constant_feed_time_equation, symmetric_jerk_limited_feed_time_equation,
+};
+pub use guards::{
+    check_nonnegative_feed, check_positive_acceleration, check_positive_feed, check_positive_jerk,
+};
+pub use jerk_schedule::*;
+pub use join::{ClassifiedJoin, JoinSpan};
+pub use lookahead::*;
+pub use metric::{MetricPath, MetricSpan, SpanDynamicsClass};
+
+/// A rejected or undecided exact dynamics construction.
+///
+/// These distinctions preserve legacy route failures. They do not imply a new
+/// cumulative work, memory, or cancellation contract.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum DynamicsError {
+    /// At least one route had no retained path segments to measure.
+    EmptyRoute,
+    /// A segment could not provide a certified axis-aligned length.
+    UnsupportedRouteGeometry,
+    /// Feed rate was structurally negative.
+    NegativeFeedRate,
+    /// Feed rate was structurally zero.
+    ZeroFeedRate,
+    /// Acceleration limit was structurally negative.
+    NegativeAcceleration,
+    /// Acceleration limit was structurally zero.
+    ZeroAcceleration,
+    /// Candidate traversal time was structurally negative.
+    NegativeTime,
+    /// Candidate traversal time was structurally zero where positive time is required.
+    ZeroTime,
+    /// Exact comparison could not choose the acceleration-limited profile.
+    UnknownFeedProfile,
+    /// Jerk limit was structurally negative.
+    NegativeJerk,
+    /// Jerk limit was structurally zero.
+    ZeroJerk,
+    /// Exact scalar division failed while deriving feed-profile facts.
+    UnsupportedDivision,
+    /// Corner radius was structurally negative.
+    NegativeCornerRadius,
+    /// Corner radius was structurally zero.
+    ZeroCornerRadius,
+    /// Lookahead schedule vectors do not match the retained route shape.
+    ScheduleShapeMismatch,
+    /// An exact square-root construction failed during lookahead planning.
+    UnsupportedRadical,
+    /// Independent replay rejected the internally generated lookahead proposal.
+    LookaheadProposalUncertified,
+    /// Both boundary feeds were zero for a transition that requires motion.
+    ZeroBoundaryFeeds,
+    /// Independent replay rejected an internally generated jerk proposal.
+    JerkProposalUncertified,
+    /// Exact power-of-two jerk refinement exhausted its caller-owned bound.
+    JerkRefinementBudgetExceeded,
+    /// No affine spans or no dense axis limits were supplied for projection.
+    EmptyAxisProjection,
+    /// An affine projection vector did not match the dense axis-limit count.
+    AxisProjectionShapeMismatch,
+    /// An absolute affine axis derivative was structurally negative.
+    NegativeAxisProjection,
+    /// An affine span had no structurally positive machine-axis derivative.
+    DegenerateAxisProjection,
+    /// Independent replay rejected internally selected affine axis limits.
+    AxisProjectionProposalUncertified,
+    /// The selected predicate policy could not certify a scalar sign.
+    PredicateUnresolved,
+}
+
+impl core::fmt::Display for DynamicsError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        match self {
+            Self::EmptyRoute => {
+                f.write_str("At least one route had no retained path segments to measure")
+            }
+            Self::UnsupportedRouteGeometry => {
+                f.write_str("A segment could not provide a certified axis-aligned length")
+            }
+            Self::NegativeFeedRate => f.write_str("Feed rate was structurally negative"),
+            Self::ZeroFeedRate => f.write_str("Feed rate was structurally zero"),
+            Self::NegativeAcceleration => {
+                f.write_str("Acceleration limit was structurally negative")
+            }
+            Self::ZeroAcceleration => f.write_str("Acceleration limit was structurally zero"),
+            Self::NegativeTime => f.write_str("Candidate traversal time was structurally negative"),
+            Self::ZeroTime => f.write_str(
+                "Candidate traversal time was structurally zero where positive time is required",
+            ),
+            Self::UnknownFeedProfile => {
+                f.write_str("Exact comparison could not choose the acceleration-limited profile")
+            }
+            Self::NegativeJerk => f.write_str("Jerk limit was structurally negative"),
+            Self::ZeroJerk => f.write_str("Jerk limit was structurally zero"),
+            Self::UnsupportedDivision => {
+                f.write_str("Exact scalar division failed while deriving feed-profile facts")
+            }
+            Self::NegativeCornerRadius => f.write_str("Corner radius was structurally negative"),
+            Self::ZeroCornerRadius => f.write_str("Corner radius was structurally zero"),
+            Self::ScheduleShapeMismatch => {
+                f.write_str("Lookahead schedule vectors do not match the retained route shape")
+            }
+            Self::UnsupportedRadical => {
+                f.write_str("An exact square-root construction failed during lookahead planning")
+            }
+            Self::LookaheadProposalUncertified => f.write_str(
+                "Independent replay rejected the internally generated lookahead proposal",
+            ),
+            Self::ZeroBoundaryFeeds => {
+                f.write_str("Both boundary feeds were zero for a transition that requires motion")
+            }
+            Self::JerkProposalUncertified => {
+                f.write_str("Independent replay rejected an internally generated jerk proposal")
+            }
+            Self::JerkRefinementBudgetExceeded => {
+                f.write_str("Exact power-of-two jerk refinement exhausted its caller-owned bound")
+            }
+            Self::EmptyAxisProjection => {
+                f.write_str("No affine spans or no dense axis limits were supplied for projection")
+            }
+            Self::AxisProjectionShapeMismatch => {
+                f.write_str("An affine projection vector did not match the dense axis-limit count")
+            }
+            Self::NegativeAxisProjection => {
+                f.write_str("An absolute affine axis derivative was structurally negative")
+            }
+            Self::DegenerateAxisProjection => {
+                f.write_str("An affine span had no structurally positive machine-axis derivative")
+            }
+            Self::AxisProjectionProposalUncertified => {
+                f.write_str("Independent replay rejected internally selected affine axis limits")
+            }
+            Self::PredicateUnresolved => {
+                f.write_str("The selected predicate policy could not certify a scalar sign")
+            }
+        }
+    }
+}
+
+impl core::error::Error for DynamicsError {}
diff --git a/crates/hyperdynamics/src/lookahead.rs b/crates/hyperdynamics/src/lookahead.rs
new file mode 100644
index 000000000..3d74464e0
--- /dev/null
+++ b/crates/hyperdynamics/src/lookahead.rs
@@ -0,0 +1,861 @@
+//! Exact lookahead feed-schedule replay for retained path chains.
+//!
+//! This module certifies a controller-style lookahead proposal without turning
+//! it into sampled motion. Retained path elements supply exact span lengths,
+//! retained tangent spans supply exact join classes, and `hypersolve` replays
+//! algebraic process constraints against the proposed speeds. That is the
+//! object/predicate boundary advocated by Yap, "Towards Exact Geometric
+//! Computation," *Computational Geometry* 7.1-2 (1997): a numeric proposal is
+//! kept as a candidate until exact predicates certify the relevant decisions.
+//!
+//! The span transition rows use the standard path-parameterization identity
+//! `v_1^2 - v_0^2 = 2*a*L`, applied as two inequalities to bound both
+//! acceleration and deceleration over a retained path length. This is the
+//! same squared-speed formulation underlying Bobrow, Dubowsky, and Gibson,
+//! "Time-Optimal Control of Robotic Manipulators Along Specified Paths"
+//! (1985), specialized here to scalar feed along an already chosen path.
+
+use std::cmp::Ordering;
+
+use hyperlimit::{PredicatePolicy, Sign, classify_real_sign, compare_reals};
+use hyperreal::Real;
+use hypersolve::{
+    CandidateCertificationReport, Constraint, ConstraintKind, Expr, Problem, certify_candidate,
+    context_from_problem,
+};
+
+use crate::feed::{
+    CornerLookaheadJoinClass, CornerLookaheadJoinReport, CornerLookaheadLimitReport,
+};
+use crate::guards::{
+    require_nonnegative_feed, require_positive_acceleration, require_positive_feed,
+    require_positive_jerk,
+};
+use crate::{
+    DynamicsError, JoinSpan, MetricSpan, PlannedMonotonicJerkTransition,
+    plan_monotonic_jerk_transition,
+};
+
+/// Exact local lookahead speed proposal for a retained route.
+///
+/// `corner_feeds` and `corner_radii` are indexed by adjacent-span join, so
+/// both vectors must have `route.len() - 1` entries. At a true corner, zero
+/// radius explicitly denotes an unblended source corner and therefore
+/// certifies only with zero corner feed; a positive radius denotes a retained
+/// geometric blend. Exact G1 joins do not need a corner radius. Entry and exit
+/// feed are attached to the path endpoints. This keeps controller lookahead
+/// state as explicit retained data rather than hiding it in sampled machine
+/// positions.
+#[derive(Clone, Debug, PartialEq)]
+pub struct LookaheadFeedSchedule {
+    /// Exact candidate feed at the route entry.
+    pub entry_feed: Real,
+    /// Exact candidate feed at each adjacent-span join.
+    pub corner_feeds: Vec<Real>,
+    /// Exact retained blend radius, or zero for an unblended exact stop.
+    pub corner_radii: Vec<Real>,
+    /// Exact candidate feed at the route exit.
+    pub exit_feed: Real,
+}
+
+/// Caller-owned feed ceilings and retained blend radii for exact lookahead
+/// planning.
+///
+/// These are limits, not requested speed nodes. The planner may lower any node
+/// during its forward and reverse reachability passes. A caller that requires
+/// a stop sets that node's limit to zero. A positive radius permits a true
+/// corner to receive a positive geometric speed ceiling; it does not by itself
+/// override a zero caller limit.
+#[derive(Clone, Debug, PartialEq)]
+pub struct LookaheadFeedPlanningLimits {
+    /// Maximum permitted feed at the route entry.
+    pub maximum_entry_feed: Real,
+    /// Per-join caller-owned feed ceilings.
+    pub maximum_corner_feeds: Vec<Real>,
+    /// Per-join retained geometric blend radii.
+    pub corner_radii: Vec<Real>,
+    /// Maximum permitted feed at the route exit.
+    pub maximum_exit_feed: Real,
+}
+
+/// Exact two-pass lookahead proposal and its independent replay.
+///
+/// `effective_node_feed_limits` contains the caller, global, and geometric
+/// ceilings after exact tangent classification. `forward_node_feeds` records
+/// the acceleration-reachable forward pass. `schedule` contains the final
+/// reverse-pass result, `caller_limit_certifications` replays every caller
+/// ceiling, and `certification` independently replays every global, corner,
+/// reversal, and span constraint through Hypersolve.
+#[derive(Clone, Debug)]
+pub struct PlannedLookaheadFeedSchedule<E> {
+    /// Effective entry, join, and exit limits in node order.
+    pub effective_node_feed_limits: Vec<Real>,
+    /// Node feeds after the exact forward acceleration pass.
+    pub forward_node_feeds: Vec<Real>,
+    /// Final exact feed schedule after reverse deceleration propagation.
+    pub schedule: LookaheadFeedSchedule,
+    /// Independent Hypersolve replay of every caller-owned node ceiling.
+    pub caller_limit_certifications: Vec<CandidateCertificationReport>,
+    /// Independent exact corner and transition replay.
+    pub certification: LookaheadFeedScheduleReport<E>,
+}
+
+impl<E> PlannedLookaheadFeedSchedule<E> {
+    /// Return whether caller, corner, global, and reachability rows all replayed.
+    #[inline]
+    pub fn all_satisfied(&self) -> bool {
+        self.caller_limit_certifications
+            .iter()
+            .all(CandidateCertificationReport::all_satisfied)
+            && self.certification.all_satisfied()
+    }
+}
+
+/// One exact positive-node component refined as a unit for jerk feasibility.
+///
+/// Components are maximal contiguous runs of structurally positive speed
+/// nodes in the acceleration-only schedule. Exact zero nodes separate them,
+/// so scaling one component cannot create motion through a retained stop.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct JerkFeasibleNodeComponent {
+    /// First positive node index, inclusive.
+    pub first_node_index: u64,
+    /// Last positive node index, inclusive.
+    pub last_node_index: u64,
+    /// Number of exact divisions by two applied uniformly to this component.
+    pub uniform_halvings: u32,
+}
+
+/// Exact lookahead schedule after bounded component-local jerk refinement.
+///
+/// `acceleration_plan` retains the original forward/reverse proposal. The
+/// final `schedule` can only lower its positive nodes by exact powers of two;
+/// exact zero nodes never move. Caller and lookahead reports replay the final
+/// nodes independently, while every span with at least one positive boundary
+/// retains a fully certified two-phase monotonic transition.
+#[derive(Clone, Debug)]
+pub struct PlannedJerkFeasibleLookaheadSchedule<E> {
+    /// Original exact acceleration-only forward/reverse proposal.
+    pub acceleration_plan: PlannedLookaheadFeedSchedule<E>,
+    /// Maximal positive components and their exact refinement counts.
+    pub positive_node_components: Vec<JerkFeasibleNodeComponent>,
+    /// Final exact feed schedule after component-local refinement.
+    pub schedule: LookaheadFeedSchedule,
+    /// Independent Hypersolve replay of every final caller-owned node ceiling.
+    pub caller_limit_certifications: Vec<CandidateCertificationReport>,
+    /// Independent exact corner and acceleration-transition replay of final nodes.
+    pub lookahead_certification: LookaheadFeedScheduleReport<E>,
+    /// Certified monotonic transition for each nonzero span; zero/zero spans are `None`.
+    pub span_transitions: Vec<Option<PlannedMonotonicJerkTransition>>,
+}
+
+impl<E> PlannedJerkFeasibleLookaheadSchedule<E> {
+    /// Return whether both planning layers and every retained replay succeeded.
+    #[inline]
+    pub fn all_satisfied(&self) -> bool {
+        self.acceleration_plan.all_satisfied()
+            && self
+                .caller_limit_certifications
+                .iter()
+                .all(CandidateCertificationReport::all_satisfied)
+            && self.lookahead_certification.all_satisfied()
+            && self
+                .span_transitions
+                .iter()
+                .flatten()
+                .all(PlannedMonotonicJerkTransition::all_satisfied)
+    }
+}
+
+/// Exact acceleration-feasibility replay for one retained path element.
+///
+/// The replay checks feed caps at both endpoints and the symmetric
+/// squared-speed travel bound `|v_1^2 - v_0^2| <= 2*a_max*L`. No time step,
+/// interpolation, or floating velocity sample is introduced.
+#[derive(Clone, Debug)]
+pub struct LookaheadSpanTransitionReport {
+    /// Zero-based path-element index.
+    pub index: u64,
+    /// Exact retained path-element length.
+    pub path_length: Real,
+    /// Exact candidate feed at the element start.
+    pub start_feed: Real,
+    /// Exact candidate feed at the element end.
+    pub end_feed: Real,
+    /// Exact maximum feed-rate cap.
+    pub max_feed_rate: Real,
+    /// Exact maximum acceleration/deceleration magnitude.
+    pub max_acceleration: Real,
+    /// Exact replay report for cap and squared-speed travel rows.
+    pub certification: CandidateCertificationReport,
+}
+
+/// Exact lookahead replay report for local corner and span constraints.
+#[derive(Clone, Debug)]
+pub struct LookaheadFeedScheduleReport<E> {
+    /// Per-join corner speed/radius certifications.
+    pub corners: CornerLookaheadLimitReport<E>,
+    /// Per-span endpoint-speed transition certifications.
+    pub spans: Vec<LookaheadSpanTransitionReport>,
+}
+
+impl<E> LookaheadFeedScheduleReport<E> {
+    /// Return whether every corner and span transition is certified.
+    #[inline]
+    pub fn all_satisfied(&self) -> bool {
+        self.corners.all_satisfied()
+            && self
+                .spans
+                .iter()
+                .all(|span| span.certification.all_satisfied())
+    }
+
+    /// Return the first span with a certified violation or undecided row.
+    #[inline]
+    pub fn first_unsatisfied_span(&self) -> Option<usize> {
+        self.spans
+            .iter()
+            .position(|span| !span.certification.all_satisfied())
+    }
+}
+
+/// Plan and certify an exact forward/reverse lookahead schedule.
+///
+/// The proposer uses the standard squared-speed reachability relation
+/// `v_next^2 <= v_current^2 + 2*a_max*length`. The forward pass propagates
+/// acceleration reachability and the reverse pass propagates deceleration
+/// reachability. At each true corner, the effective node limit also includes
+/// `v^2 <= a_max*radius`; exact G1 joins need no geometric corner reduction,
+/// while a reversal is fixed at zero. Caller-owned node limits can impose
+/// additional stops or process caps.
+///
+/// This function constructs a candidate and then invokes
+/// [`certify_lookahead_feed_schedule`] as an independent replay. No sampled
+/// time step, floating proposal, or firmware behavior participates.
+#[inline]
+pub fn plan_lookahead_feed_schedule<S: MetricSpan, J: JoinSpan>(
+    route: &[S],
+    spans: &[J],
+    limits: &LookaheadFeedPlanningLimits,
+    max_feed_rate: Real,
+    max_acceleration: Real,
+    policy: PredicatePolicy,
+) -> Result<PlannedLookaheadFeedSchedule<J::Receipt>, DynamicsError> {
+    if route.is_empty() || spans.is_empty() {
+        return Err(DynamicsError::EmptyRoute);
+    }
+    if route.len() != spans.len()
+        || limits.maximum_corner_feeds.len() != route.len().saturating_sub(1)
+        || limits.corner_radii.len() != route.len().saturating_sub(1)
+    {
+        return Err(DynamicsError::ScheduleShapeMismatch);
+    }
+
+    require_nonnegative_feed(&limits.maximum_entry_feed, policy)?;
+    require_nonnegative_feed(&limits.maximum_exit_feed, policy)?;
+    for feed in &limits.maximum_corner_feeds {
+        require_nonnegative_feed(feed, policy)?;
+    }
+    for radius in &limits.corner_radii {
+        require_nonnegative_corner_radius(radius, policy)?;
+    }
+    require_positive_feed(&max_feed_rate, policy)?;
+    require_positive_acceleration(&max_acceleration, policy)?;
+
+    let path_lengths = route
+        .iter()
+        .map(|element| element.exact_length(policy))
+        .collect::<Result<Vec<_>, _>>()?;
+    let mut effective_node_feed_limits = Vec::with_capacity(route.len().saturating_add(1));
+    effective_node_feed_limits.push(minimum_real(
+        limits.maximum_entry_feed.clone(),
+        max_feed_rate.clone(),
+        policy,
+    )?);
+    for (index, pair) in spans.windows(2).enumerate() {
+        let class = lookahead_join_class(&pair[0], &pair[1], policy)?;
+        let geometric_limit = match class {
+            CornerLookaheadJoinClass::StraightThrough => max_feed_rate.clone(),
+            CornerLookaheadJoinClass::RadiusLimitedCorner => (max_acceleration.clone()
+                * &limits.corner_radii[index])
+                .sqrt()
+                .map_err(|_| DynamicsError::UnsupportedRadical)?,
+            CornerLookaheadJoinClass::ReversalStop => Real::zero(),
+        };
+        let caller_and_global = minimum_real(
+            limits.maximum_corner_feeds[index].clone(),
+            max_feed_rate.clone(),
+            policy,
+        )?;
+        effective_node_feed_limits.push(minimum_real(caller_and_global, geometric_limit, policy)?);
+    }
+    effective_node_feed_limits.push(minimum_real(
+        limits.maximum_exit_feed.clone(),
+        max_feed_rate.clone(),
+        policy,
+    )?);
+
+    let doubled_acceleration = Real::from(2) * &max_acceleration;
+    let mut forward_node_feeds = effective_node_feed_limits.clone();
+    for edge in 0..route.len() {
+        let reachable = (&forward_node_feeds[edge] * &forward_node_feeds[edge]
+            + &doubled_acceleration * &path_lengths[edge])
+            .sqrt()
+            .map_err(|_| DynamicsError::UnsupportedRadical)?;
+        forward_node_feeds[edge + 1] =
+            minimum_real(forward_node_feeds[edge + 1].clone(), reachable, policy)?;
+    }
+
+    let mut selected_node_feeds = forward_node_feeds.clone();
+    for edge in (0..route.len()).rev() {
+        let reachable = (&selected_node_feeds[edge + 1] * &selected_node_feeds[edge + 1]
+            + &doubled_acceleration * &path_lengths[edge])
+            .sqrt()
+            .map_err(|_| DynamicsError::UnsupportedRadical)?;
+        selected_node_feeds[edge] =
+            minimum_real(selected_node_feeds[edge].clone(), reachable, policy)?;
+    }
+
+    let schedule = LookaheadFeedSchedule {
+        entry_feed: selected_node_feeds[0].clone(),
+        corner_feeds: selected_node_feeds[1..route.len()].to_vec(),
+        corner_radii: limits.corner_radii.clone(),
+        exit_feed: selected_node_feeds[route.len()].clone(),
+    };
+    let caller_limit_certifications = certify_caller_node_limits(&selected_node_feeds, limits);
+    let certification = certify_lookahead_feed_schedule(
+        route,
+        spans,
+        &schedule,
+        max_feed_rate,
+        max_acceleration,
+        policy,
+    )?;
+    if !caller_limit_certifications
+        .iter()
+        .all(CandidateCertificationReport::all_satisfied)
+        || !certification.all_satisfied()
+    {
+        return Err(DynamicsError::LookaheadProposalUncertified);
+    }
+
+    Ok(PlannedLookaheadFeedSchedule {
+        effective_node_feed_limits,
+        forward_node_feeds,
+        schedule,
+        caller_limit_certifications,
+        certification,
+    })
+}
+
+/// Plan exact lookahead nodes and conservatively refine them until every
+/// nonzero-boundary monotonic jerk transition certifies.
+///
+/// The acceleration-only forward/reverse result is partitioned into maximal
+/// contiguous positive-node components separated by exact zero stops. For one
+/// component at a time, the planner tries the exact two-phase monotonic
+/// transition on every adjacent retained span. If any replay fails only because
+/// the proposal exceeds a dynamic limit, every node in that component is
+/// divided by two exactly and the complete component is replayed again.
+/// Relative node feeds inside the component are therefore retained and no zero
+/// node can become positive. The caller bounds the refinement count; exhausting
+/// it fails instead of returning an uncertified schedule.
+///
+/// This is deliberately conservative rather than time-optimal. It couples the
+/// current monotonic transition primitive to lookahead without solving a
+/// floating cubic, sampling a controller trajectory, or treating a sharp
+/// corner as retained blend geometry.
+#[allow(clippy::too_many_arguments)]
+#[inline]
+pub fn plan_jerk_feasible_lookahead_schedule<S: MetricSpan, J: JoinSpan>(
+    route: &[S],
+    spans: &[J],
+    limits: &LookaheadFeedPlanningLimits,
+    max_feed_rate: Real,
+    max_acceleration: Real,
+    max_jerk: Real,
+    maximum_component_halvings: u32,
+    policy: PredicatePolicy,
+) -> Result<PlannedJerkFeasibleLookaheadSchedule<J::Receipt>, DynamicsError> {
+    require_positive_jerk(&max_jerk, policy)?;
+    let acceleration_plan = plan_lookahead_feed_schedule(
+        route,
+        spans,
+        limits,
+        max_feed_rate.clone(),
+        max_acceleration.clone(),
+        policy,
+    )?;
+    let mut selected_node_feeds = schedule_node_feeds(&acceleration_plan.schedule);
+    let component_ranges = positive_node_components(&selected_node_feeds, policy)?;
+    let mut positive_node_components = Vec::with_capacity(component_ranges.len());
+
+    for (first_node, last_node) in component_ranges {
+        let first_span = first_node.saturating_sub(1);
+        let last_span = last_node.min(route.len().saturating_sub(1));
+        let mut uniform_halvings = 0_u32;
+        loop {
+            let mut component_certifies = true;
+            for span_index in first_span..=last_span {
+                match plan_span_monotonic_transition(
+                    &route[span_index],
+                    &selected_node_feeds[span_index],
+                    &selected_node_feeds[span_index + 1],
+                    max_feed_rate.clone(),
+                    max_acceleration.clone(),
+                    max_jerk.clone(),
+                    policy,
+                ) {
+                    Ok(Some(_)) => {}
+                    Ok(None) => {
+                        return Err(DynamicsError::JerkProposalUncertified);
+                    }
+                    Err(DynamicsError::JerkProposalUncertified) => {
+                        component_certifies = false;
+                        break;
+                    }
+                    Err(error) => return Err(error),
+                }
+            }
+            if component_certifies {
+                break;
+            }
+            if uniform_halvings == maximum_component_halvings {
+                return Err(DynamicsError::JerkRefinementBudgetExceeded);
+            }
+            for feed in &mut selected_node_feeds[first_node..=last_node] {
+                *feed = (&*feed / Real::from(2)).map_err(|_| DynamicsError::UnsupportedDivision)?;
+            }
+            uniform_halvings += 1;
+        }
+        positive_node_components.push(JerkFeasibleNodeComponent {
+            first_node_index: first_node as u64,
+            last_node_index: last_node as u64,
+            uniform_halvings,
+        });
+    }
+
+    let schedule = schedule_from_node_feeds(
+        &selected_node_feeds,
+        limits.corner_radii.clone(),
+        route.len(),
+    );
+    let caller_limit_certifications = certify_caller_node_limits(&selected_node_feeds, limits);
+    let lookahead_certification = certify_lookahead_feed_schedule(
+        route,
+        spans,
+        &schedule,
+        max_feed_rate.clone(),
+        max_acceleration.clone(),
+        policy,
+    )?;
+    let span_transitions = route
+        .iter()
+        .enumerate()
+        .map(|(index, element)| {
+            plan_span_monotonic_transition(
+                element,
+                &selected_node_feeds[index],
+                &selected_node_feeds[index + 1],
+                max_feed_rate.clone(),
+                max_acceleration.clone(),
+                max_jerk.clone(),
+                policy,
+            )
+        })
+        .collect::<Result<Vec<_>, _>>()?;
+    if !caller_limit_certifications
+        .iter()
+        .all(CandidateCertificationReport::all_satisfied)
+        || !lookahead_certification.all_satisfied()
+        || !span_transitions
+            .iter()
+            .flatten()
+            .all(PlannedMonotonicJerkTransition::all_satisfied)
+    {
+        return Err(DynamicsError::JerkProposalUncertified);
+    }
+
+    Ok(PlannedJerkFeasibleLookaheadSchedule {
+        acceleration_plan,
+        positive_node_components,
+        schedule,
+        caller_limit_certifications,
+        lookahead_certification,
+        span_transitions,
+    })
+}
+
+/// Certify a local lookahead feed schedule for a retained mixed path.
+///
+/// The route and tangent spans must describe the same path elements. For each
+/// internal join, exact tangent predicates select whether the proposed corner
+/// feed is straight-through, radius-limited, or a required stop. For each path
+/// element, exact length plus endpoint speeds replay the squared-speed
+/// acceleration bound. Erkorkmaz and Altintas, "High speed CNC system design.
+/// Part I" (2001), discuss jerk-limited controller trajectories; this function
+/// deliberately stays one layer lower by certifying the lookahead speed nodes
+/// that such a trajectory generator would later consume.
+#[inline]
+pub fn certify_lookahead_feed_schedule<S: MetricSpan, J: JoinSpan>(
+    route: &[S],
+    spans: &[J],
+    schedule: &LookaheadFeedSchedule,
+    max_feed_rate: Real,
+    max_acceleration: Real,
+    policy: PredicatePolicy,
+) -> Result<LookaheadFeedScheduleReport<J::Receipt>, DynamicsError> {
+    if route.is_empty() || spans.is_empty() {
+        return Err(DynamicsError::EmptyRoute);
+    }
+    if route.len() != spans.len()
+        || schedule.corner_feeds.len() != route.len().saturating_sub(1)
+        || schedule.corner_radii.len() != route.len().saturating_sub(1)
+    {
+        return Err(DynamicsError::ScheduleShapeMismatch);
+    }
+
+    require_nonnegative_feed(&schedule.entry_feed, policy)?;
+    require_nonnegative_feed(&schedule.exit_feed, policy)?;
+    for feed in &schedule.corner_feeds {
+        require_nonnegative_feed(feed, policy)?;
+    }
+    for radius in &schedule.corner_radii {
+        require_nonnegative_corner_radius(radius, policy)?;
+    }
+    require_positive_feed(&max_feed_rate, policy)?;
+    require_positive_acceleration(&max_acceleration, policy)?;
+
+    let corners = certify_local_corner_limits(
+        spans,
+        &schedule.corner_feeds,
+        &schedule.corner_radii,
+        max_feed_rate.clone(),
+        max_acceleration.clone(),
+        policy,
+    )?;
+
+    let mut span_reports = Vec::with_capacity(route.len());
+    for (index, element) in route.iter().enumerate() {
+        let path_length = element.exact_length(policy)?;
+        let start_feed = if index == 0 {
+            schedule.entry_feed.clone()
+        } else {
+            schedule.corner_feeds[index - 1].clone()
+        };
+        let end_feed = schedule
+            .corner_feeds
+            .get(index)
+            .cloned()
+            .unwrap_or_else(|| schedule.exit_feed.clone());
+        let certification = certify_span_transition_candidate(
+            path_length.clone(),
+            start_feed.clone(),
+            end_feed.clone(),
+            max_feed_rate.clone(),
+            max_acceleration.clone(),
+        );
+        span_reports.push(LookaheadSpanTransitionReport {
+            index: index as u64,
+            path_length,
+            start_feed,
+            end_feed,
+            max_feed_rate: max_feed_rate.clone(),
+            max_acceleration: max_acceleration.clone(),
+            certification,
+        });
+    }
+
+    Ok(LookaheadFeedScheduleReport {
+        corners,
+        spans: span_reports,
+    })
+}
+
+#[inline]
+fn certify_local_corner_limits<J: JoinSpan>(
+    spans: &[J],
+    corner_feeds: &[Real],
+    corner_radii: &[Real],
+    max_feed_rate: Real,
+    max_acceleration: Real,
+    policy: PredicatePolicy,
+) -> Result<CornerLookaheadLimitReport<J::Receipt>, DynamicsError> {
+    let mut joins = Vec::with_capacity(spans.len().saturating_sub(1));
+    for (index, pair) in spans.windows(2).enumerate() {
+        let classified = pair[0].classify_join(&pair[1], policy);
+        let class = classified.classification?;
+        let tangent_join = classified.receipt;
+        let certification = certify_corner_candidate(
+            class,
+            corner_feeds[index].clone(),
+            max_feed_rate.clone(),
+            max_acceleration.clone(),
+            corner_radii[index].clone(),
+        );
+        joins.push(CornerLookaheadJoinReport {
+            index: index as u64,
+            tangent_join,
+            class,
+            candidate_corner_feed: corner_feeds[index].clone(),
+            max_feed_rate: max_feed_rate.clone(),
+            max_acceleration: max_acceleration.clone(),
+            corner_radius: corner_radii[index].clone(),
+            certification,
+        });
+    }
+    Ok(CornerLookaheadLimitReport { joins })
+}
+
+#[inline]
+fn certify_corner_candidate(
+    class: CornerLookaheadJoinClass,
+    candidate_corner_feed: Real,
+    max_feed_rate: Real,
+    max_acceleration: Real,
+    corner_radius: Real,
+) -> CandidateCertificationReport {
+    let mut problem = Problem::default();
+    let feed = problem.add_variable("corner_feed", candidate_corner_feed);
+    problem.add_constraint(feed_cap_constraint(
+        "lookahead local corner feed cap",
+        max_feed_rate,
+        feed,
+        "corner_feed",
+    ));
+    match class {
+        CornerLookaheadJoinClass::StraightThrough => {}
+        CornerLookaheadJoinClass::RadiusLimitedCorner => {
+            let feed_expr = Expr::symbol(feed.into(), "corner_feed");
+            problem.add_constraint(Constraint {
+                name: "lookahead local corner centripetal limit".to_string(),
+                kind: ConstraintKind::GreaterOrEqual,
+                residual: Expr::real(max_acceleration * corner_radius)
+                    - feed_expr.clone() * feed_expr,
+                weight: Real::one(),
+                active: true,
+            });
+        }
+        CornerLookaheadJoinClass::ReversalStop => {
+            problem.add_constraint(Constraint::equality(
+                "lookahead local reversal stop",
+                Expr::symbol(feed.into(), "corner_feed"),
+            ));
+        }
+    }
+    certify_problem(problem)
+}
+
+#[inline]
+fn certify_span_transition_candidate(
+    path_length: Real,
+    start_feed: Real,
+    end_feed: Real,
+    max_feed_rate: Real,
+    max_acceleration: Real,
+) -> CandidateCertificationReport {
+    let mut problem = Problem::default();
+    let start = problem.add_variable("start_feed", start_feed);
+    let end = problem.add_variable("end_feed", end_feed);
+    problem.add_constraint(feed_cap_constraint(
+        "lookahead span start feed cap",
+        max_feed_rate.clone(),
+        start,
+        "start_feed",
+    ));
+    problem.add_constraint(feed_cap_constraint(
+        "lookahead span end feed cap",
+        max_feed_rate,
+        end,
+        "end_feed",
+    ));
+
+    let start_expr = Expr::symbol(start.into(), "start_feed");
+    let end_expr = Expr::symbol(end.into(), "end_feed");
+    let travel_budget = Expr::real(Real::from(2) * max_acceleration * path_length);
+    let start_sq = start_expr.clone() * start_expr;
+    let end_sq = end_expr.clone() * end_expr;
+    problem.add_constraint(Constraint {
+        name: "lookahead span acceleration distance".to_string(),
+        kind: ConstraintKind::GreaterOrEqual,
+        residual: travel_budget.clone() - (end_sq.clone() - start_sq.clone()),
+        weight: Real::one(),
+        active: true,
+    });
+    problem.add_constraint(Constraint {
+        name: "lookahead span deceleration distance".to_string(),
+        kind: ConstraintKind::GreaterOrEqual,
+        residual: travel_budget - (start_sq - end_sq),
+        weight: Real::one(),
+        active: true,
+    });
+    certify_problem(problem)
+}
+
+#[inline]
+fn schedule_node_feeds(schedule: &LookaheadFeedSchedule) -> Vec<Real> {
+    std::iter::once(schedule.entry_feed.clone())
+        .chain(schedule.corner_feeds.iter().cloned())
+        .chain(std::iter::once(schedule.exit_feed.clone()))
+        .collect()
+}
+
+#[inline]
+fn schedule_from_node_feeds(
+    node_feeds: &[Real],
+    corner_radii: Vec<Real>,
+    route_len: usize,
+) -> LookaheadFeedSchedule {
+    LookaheadFeedSchedule {
+        entry_feed: node_feeds[0].clone(),
+        corner_feeds: node_feeds[1..route_len].to_vec(),
+        corner_radii,
+        exit_feed: node_feeds[route_len].clone(),
+    }
+}
+
+#[inline]
+fn positive_node_components(
+    node_feeds: &[Real],
+    policy: PredicatePolicy,
+) -> Result<Vec<(usize, usize)>, DynamicsError> {
+    let mut components = Vec::new();
+    let mut node_index = 0;
+    while node_index < node_feeds.len() {
+        if !feed_is_positive(&node_feeds[node_index], policy)? {
+            node_index += 1;
+            continue;
+        }
+        let first_node = node_index;
+        while node_index + 1 < node_feeds.len()
+            && feed_is_positive(&node_feeds[node_index + 1], policy)?
+        {
+            node_index += 1;
+        }
+        components.push((first_node, node_index));
+        node_index += 1;
+    }
+    Ok(components)
+}
+
+#[allow(clippy::too_many_arguments)]
+#[inline]
+fn plan_span_monotonic_transition<S: MetricSpan>(
+    element: &S,
+    start_feed: &Real,
+    end_feed: &Real,
+    max_feed_rate: Real,
+    max_acceleration: Real,
+    max_jerk: Real,
+    policy: PredicatePolicy,
+) -> Result<Option<PlannedMonotonicJerkTransition>, DynamicsError> {
+    if !feed_is_positive(start_feed, policy)? && !feed_is_positive(end_feed, policy)? {
+        return Ok(None);
+    }
+    plan_monotonic_jerk_transition(
+        element,
+        start_feed.clone(),
+        end_feed.clone(),
+        max_feed_rate,
+        max_acceleration,
+        max_jerk,
+        policy,
+    )
+    .map(Some)
+}
+
+#[inline]
+fn feed_is_positive(value: &Real, policy: PredicatePolicy) -> Result<bool, DynamicsError> {
+    match classify_real_sign(value, policy).value() {
+        Some(Sign::Negative) => Err(DynamicsError::NegativeFeedRate),
+        Some(Sign::Zero) => Ok(false),
+        Some(Sign::Positive) => Ok(true),
+        None => Err(DynamicsError::PredicateUnresolved),
+    }
+}
+
+#[inline]
+fn certify_caller_node_limits(
+    selected_node_feeds: &[Real],
+    limits: &LookaheadFeedPlanningLimits,
+) -> Vec<CandidateCertificationReport> {
+    let caller_node_limits = std::iter::once(&limits.maximum_entry_feed)
+        .chain(limits.maximum_corner_feeds.iter())
+        .chain(std::iter::once(&limits.maximum_exit_feed));
+    selected_node_feeds
+        .iter()
+        .cloned()
+        .zip(caller_node_limits.cloned())
+        .map(|(candidate, maximum)| certify_node_limit_candidate(candidate, maximum))
+        .collect()
+}
+
+#[inline]
+fn certify_node_limit_candidate(
+    candidate_feed: Real,
+    maximum_feed: Real,
+) -> CandidateCertificationReport {
+    let mut problem = Problem::default();
+    let feed = problem.add_variable("planned_feed", candidate_feed);
+    problem.add_constraint(feed_cap_constraint(
+        "lookahead caller node feed cap",
+        maximum_feed,
+        feed,
+        "planned_feed",
+    ));
+    certify_problem(problem)
+}
+
+#[inline]
+fn feed_cap_constraint(
+    name: impl Into<String>,
+    max_feed_rate: Real,
+    feed: hypersolve::VariableId,
+    symbol_name: &'static str,
+) -> Constraint {
+    Constraint {
+        name: name.into(),
+        kind: ConstraintKind::GreaterOrEqual,
+        residual: Expr::real(max_feed_rate) - Expr::symbol(feed.into(), symbol_name),
+        weight: Real::one(),
+        active: true,
+    }
+}
+
+#[inline]
+fn certify_problem(problem: Problem) -> CandidateCertificationReport {
+    let analysis = problem.analyze();
+    let context = context_from_problem(&problem);
+    certify_candidate(&analysis, &context)
+}
+
+#[inline]
+fn require_nonnegative_corner_radius(
+    value: &Real,
+    policy: PredicatePolicy,
+) -> Result<(), DynamicsError> {
+    match classify_real_sign(value, policy).value() {
+        Some(Sign::Negative) => Err(DynamicsError::NegativeCornerRadius),
+        Some(Sign::Zero | Sign::Positive) => Ok(()),
+        None => Err(DynamicsError::PredicateUnresolved),
+    }
+}
+
+#[inline]
+fn lookahead_join_class<J: JoinSpan>(
+    incoming: &J,
+    outgoing: &J,
+    policy: PredicatePolicy,
+) -> Result<CornerLookaheadJoinClass, DynamicsError> {
+    let classified = incoming.classify_join(outgoing, policy);
+    classified.classification
+}
+
+#[inline]
+fn minimum_real(left: Real, right: Real, policy: PredicatePolicy) -> Result<Real, DynamicsError> {
+    match compare_reals(&left, &right, policy).value() {
+        Some(Ordering::Less | Ordering::Equal) => Ok(left),
+        Some(Ordering::Greater) => Ok(right),
+        None => Err(DynamicsError::PredicateUnresolved),
+    }
+}
diff --git a/crates/hyperdynamics/src/metric.rs b/crates/hyperdynamics/src/metric.rs
new file mode 100644
index 000000000..b278d784f
--- /dev/null
+++ b/crates/hyperdynamics/src/metric.rs
@@ -0,0 +1,69 @@
+//! Exact metric input independent of a geometry carrier.
+use crate::DynamicsError;
+use hyperlimit::PredicatePolicy;
+use hyperreal::Real;
+
+/// Structural dynamics specialization supplied by the metric owner.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum SpanDynamicsClass {
+    /// The span has constant tangent with respect to path distance.
+    Affine,
+    /// No constant-tangent specialization is asserted.
+    General,
+}
+
+/// A retained source capable of supplying its exact path length.
+///
+/// Implementors must preserve the source's defining geometry and provenance.
+/// The returned length must be exact, stable across calls, and refer to the same
+/// retained span as its dynamics class. An unavailable exact length is an error;
+/// sampling or fitting is not an implementation of this contract. This protocol
+/// supplies metric data, not a certificate of the source geometry's validity.
+/// Consumers request lengths lazily and may query a source again during replay.
+pub trait MetricSpan {
+    /// Obtain the retained source length under the caller's predicate policy.
+    fn exact_length(&self, policy: PredicatePolicy) -> Result<Real, DynamicsError>;
+    /// Identify a structural specialization; this does not certify axis limits.
+    fn dynamics_class(&self) -> SpanDynamicsClass;
+}
+
+/// A retained whole path with a stable empty/nonempty shape and exact length.
+///
+/// Geometry owners may provide borrowed views with stricter admitted domains.
+/// Length acquisition is lazy and must retain the original source, traversal,
+/// failure distinctions and exact scalar meaning. This contract does not verify
+/// arbitrary provider code or establish geometry validity. Empty native slices
+/// have zero length, while scheduling operations reject empty input first.
+pub trait MetricPath {
+    /// Whether this retained path contains no spans, without evaluating lengths.
+    fn is_empty(&self) -> bool;
+    /// Obtain the exact aggregate length under the caller's policy.
+    fn exact_length(&self, policy: PredicatePolicy) -> Result<Real, DynamicsError>;
+}
+
+impl<S: MetricSpan> MetricPath for [S] {
+    fn is_empty(&self) -> bool {
+        <[S]>::is_empty(self)
+    }
+    fn exact_length(&self, policy: PredicatePolicy) -> Result<Real, DynamicsError> {
+        self.iter().try_fold(Real::zero(), |sum, span| {
+            span.exact_length(policy).map(|length| sum + length)
+        })
+    }
+}
+impl<S: MetricSpan, const N: usize> MetricPath for [S; N] {
+    fn is_empty(&self) -> bool {
+        N == 0
+    }
+    fn exact_length(&self, policy: PredicatePolicy) -> Result<Real, DynamicsError> {
+        MetricPath::exact_length(self.as_slice(), policy)
+    }
+}
+impl<S: MetricSpan> MetricPath for Vec<S> {
+    fn is_empty(&self) -> bool {
+        Vec::is_empty(self)
+    }
+    fn exact_length(&self, policy: PredicatePolicy) -> Result<Real, DynamicsError> {
+        MetricPath::exact_length(self.as_slice(), policy)
+    }
+}
diff --git a/crates/hyperdynamics/tests/axis_projection.rs b/crates/hyperdynamics/tests/axis_projection.rs
new file mode 100644
index 000000000..1bef6f246
--- /dev/null
+++ b/crates/hyperdynamics/tests/axis_projection.rs
@@ -0,0 +1,125 @@
+use hyperdynamics::{
+    AffineSpanAxisProjection, AxisMotionLimits, DynamicsError,
+    certify_axis_projected_motion_limits, plan_axis_projected_motion_limits,
+};
+use hyperlimit::PredicatePolicy;
+use hyperreal::{Rational, Real};
+fn q(n: i64, d: i64) -> Real {
+    Real::new(Rational::new(n) / Rational::new(d))
+}
+#[test]
+fn independent_exact_minima_and_replay() {
+    for policy in [PredicatePolicy::STRICT, PredicatePolicy::APPROXIMATE_512] {
+        for a in 1..=7 {
+            for b in 1..=7 {
+                let spans = vec![
+                    AffineSpanAxisProjection {
+                        absolute_axis_derivatives: vec![a.into(), b.into()],
+                    },
+                    AffineSpanAxisProjection {
+                        absolute_axis_derivatives: vec![0.into(), b.into()],
+                    },
+                ];
+                let axes = vec![
+                    AxisMotionLimits {
+                        maximum_velocity: 12.into(),
+                        maximum_acceleration: 18.into(),
+                        maximum_jerk: 30.into(),
+                    },
+                    AxisMotionLimits {
+                        maximum_velocity: 20.into(),
+                        maximum_acceleration: 10.into(),
+                        maximum_jerk: 15.into(),
+                    },
+                ];
+                let plan = plan_axis_projected_motion_limits(&spans, &axes, policy).unwrap();
+                for (actual, bottleneck, (x, y)) in [
+                    (&plan.maximum_path_feed, plan.feed_bottleneck, (12, 20)),
+                    (
+                        &plan.maximum_path_acceleration,
+                        plan.acceleration_bottleneck,
+                        (18, 10),
+                    ),
+                    (&plan.maximum_path_jerk, plan.jerk_bottleneck, (30, 15)),
+                ] {
+                    let first = x * b <= y * a;
+                    assert_eq!(*actual, if first { q(x, a) } else { q(y, b) });
+                    assert_eq!(bottleneck.span_index, 0);
+                    assert_eq!(bottleneck.axis_index, u64::from(!first));
+                }
+                assert!(plan.all_satisfied());
+                assert_eq!(plan.certification.rows.len(), 4);
+                assert_eq!(
+                    plan.certification
+                        .rows
+                        .iter()
+                        .map(|r| (r.span_index, r.axis_index))
+                        .collect::<Vec<_>>(),
+                    vec![(0, 0), (0, 1), (1, 0), (1, 1)]
+                );
+                let unsafe_plan = certify_axis_projected_motion_limits(
+                    &spans,
+                    &axes,
+                    Real::from(100),
+                    Real::from(100),
+                    Real::from(100),
+                    policy,
+                )
+                .unwrap();
+                assert!(!unsafe_plan.all_satisfied());
+                assert!(unsafe_plan.rows[0].certification.has_certified_violation());
+            }
+        }
+    }
+}
+#[test]
+fn typed_invalid_inputs_and_precedence() {
+    let axes = vec![AxisMotionLimits {
+        maximum_velocity: 1.into(),
+        maximum_acceleration: 2.into(),
+        maximum_jerk: 3.into(),
+    }];
+    for policy in [PredicatePolicy::STRICT, PredicatePolicy::APPROXIMATE_512] {
+        assert_eq!(
+            plan_axis_projected_motion_limits(&[], &axes, policy),
+            Err(DynamicsError::EmptyAxisProjection)
+        );
+        for (derivatives, error) in [
+            (vec![], DynamicsError::AxisProjectionShapeMismatch),
+            (vec![0.into()], DynamicsError::DegenerateAxisProjection),
+            (vec![(-1).into()], DynamicsError::NegativeAxisProjection),
+        ] {
+            assert_eq!(
+                plan_axis_projected_motion_limits(
+                    &[AffineSpanAxisProjection {
+                        absolute_axis_derivatives: derivatives
+                    }],
+                    &axes,
+                    policy
+                ),
+                Err(error)
+            );
+        }
+    }
+}
+
+#[test]
+fn unresolved_sign_does_not_become_zero_under_strict_policy() {
+    let value = (Real::pi() * Real::e()).ln().unwrap()
+        - (Real::pi().ln().unwrap() + Real::e().ln().unwrap());
+    let axes = [AxisMotionLimits {
+        maximum_velocity: 1.into(),
+        maximum_acceleration: 2.into(),
+        maximum_jerk: 3.into(),
+    }];
+    assert_eq!(
+        plan_axis_projected_motion_limits(
+            &[AffineSpanAxisProjection {
+                absolute_axis_derivatives: vec![value]
+            }],
+            &axes,
+            PredicatePolicy::STRICT
+        ),
+        Err(DynamicsError::PredicateUnresolved)
+    );
+}
diff --git a/crates/hyperdynamics/tests/feed_join_admission.rs b/crates/hyperdynamics/tests/feed_join_admission.rs
new file mode 100644
index 000000000..a0e286abf
--- /dev/null
+++ b/crates/hyperdynamics/tests/feed_join_admission.rs
@@ -0,0 +1,314 @@
+use hyperdynamics::{
+    AccelerationLimitedFeedProfileClass, ClassifiedJoin, CornerLookaheadJoinClass, DynamicsError,
+    JoinSpan, LookaheadFeedPlanningLimits, MetricSpan, SpanDynamicsClass,
+    certify_acceleration_limited_feed_time, certify_constant_feed_time,
+    certify_symmetric_jerk_limited_feed_time, plan_jerk_feasible_lookahead_schedule,
+    plan_lookahead_feed_schedule,
+};
+use hyperlimit::PredicatePolicy;
+use hyperreal::Real;
+
+struct Span(Real);
+impl MetricSpan for Span {
+    fn exact_length(&self, _: PredicatePolicy) -> Result<Real, DynamicsError> {
+        Ok(self.0.clone())
+    }
+    fn dynamics_class(&self) -> SpanDynamicsClass {
+        SpanDynamicsClass::Affine
+    }
+}
+#[derive(Clone, Debug, PartialEq)]
+struct Receipt {
+    incoming: u32,
+    outgoing: u32,
+}
+struct Join(u32);
+impl JoinSpan for Join {
+    type Receipt = Receipt;
+    fn classify_join(&self, outgoing: &Self, _: PredicatePolicy) -> ClassifiedJoin<Receipt> {
+        ClassifiedJoin {
+            classification: Ok(CornerLookaheadJoinClass::StraightThrough),
+            receipt: Receipt {
+                incoming: self.0,
+                outgoing: outgoing.0,
+            },
+        }
+    }
+}
+
+#[test]
+fn independent_feed_equations_need_no_geometry_dependency() {
+    for policy in [PredicatePolicy::STRICT, PredicatePolicy::APPROXIMATE_512] {
+        let route = [Span(2.into()), Span(2.into())];
+        let constant = certify_constant_feed_time(&route, 2.into(), 2.into(), policy).unwrap();
+        assert_eq!(constant.path_length, Real::from(4));
+        assert!(constant.certification.all_satisfied());
+        let acceleration =
+            certify_acceleration_limited_feed_time(&route, 10.into(), 1.into(), 4.into(), policy)
+                .unwrap();
+        assert_eq!(
+            acceleration.profile,
+            AccelerationLimitedFeedProfileClass::Triangular
+        );
+        assert!(acceleration.certification.all_satisfied());
+        let jerk = certify_symmetric_jerk_limited_feed_time(
+            &route,
+            4.into(),
+            2.into(),
+            2.into(),
+            4.into(),
+            policy,
+        )
+        .unwrap();
+        assert_eq!(jerk.peak_feed_rate, Real::from(2));
+        assert_eq!(jerk.peak_acceleration, Real::from(2));
+        assert!(jerk.certification.all_satisfied());
+    }
+}
+
+#[test]
+fn independent_reachability_halving_and_receipt_transport() {
+    for policy in [PredicatePolicy::STRICT, PredicatePolicy::APPROXIMATE_512] {
+        let route = [Span(2.into()), Span(2.into())];
+        let joins = [Join(17), Join(29)];
+        let limits = LookaheadFeedPlanningLimits {
+            maximum_entry_feed: 0.into(),
+            maximum_corner_feeds: vec![10.into()],
+            corner_radii: vec![0.into()],
+            maximum_exit_feed: 0.into(),
+        };
+        let acceleration =
+            plan_lookahead_feed_schedule(&route, &joins, &limits, 10.into(), 1.into(), policy)
+                .unwrap();
+        assert!(acceleration.all_satisfied());
+        assert_eq!(acceleration.schedule.corner_feeds, vec![Real::from(2)]);
+        assert_eq!(
+            acceleration.certification.corners.joins[0].tangent_join,
+            Receipt {
+                incoming: 17,
+                outgoing: 29
+            }
+        );
+        let jerk = plan_jerk_feasible_lookahead_schedule(
+            &route,
+            &joins,
+            &limits,
+            10.into(),
+            1.into(),
+            10.into(),
+            4,
+            policy,
+        )
+        .unwrap();
+        assert!(jerk.all_satisfied());
+        assert_eq!(jerk.schedule.corner_feeds, vec![Real::from(1)]);
+        assert_eq!(jerk.positive_node_components[0].uniform_halvings, 1);
+        assert_eq!(
+            jerk.lookahead_certification.corners.joins[0].tangent_join,
+            Receipt {
+                incoming: 17,
+                outgoing: 29
+            }
+        );
+    }
+}
+
+use std::{cell::RefCell, rc::Rc};
+type Queries = Rc<RefCell<Vec<(&'static str, PredicatePolicy)>>>;
+struct ObservedSpan {
+    name: &'static str,
+    length: Result<Real, DynamicsError>,
+    queries: Queries,
+}
+impl MetricSpan for ObservedSpan {
+    fn exact_length(&self, policy: PredicatePolicy) -> Result<Real, DynamicsError> {
+        self.queries.borrow_mut().push((self.name, policy));
+        self.length.clone()
+    }
+    fn dynamics_class(&self) -> SpanDynamicsClass {
+        SpanDynamicsClass::General
+    }
+}
+struct ObservedJoin {
+    queries: Queries,
+    invalid: bool,
+}
+impl JoinSpan for ObservedJoin {
+    type Receipt = Receipt;
+    fn classify_join(&self, _: &Self, policy: PredicatePolicy) -> ClassifiedJoin<Receipt> {
+        self.queries.borrow_mut().push(("join", policy));
+        ClassifiedJoin {
+            classification: if self.invalid {
+                Err(DynamicsError::UnsupportedRouteGeometry)
+            } else {
+                Ok(CornerLookaheadJoinClass::StraightThrough)
+            },
+            receipt: Receipt {
+                incoming: 17,
+                outgoing: 29,
+            },
+        }
+    }
+}
+
+#[test]
+fn metric_and_join_queries_preserve_guard_replay_and_failure_order() {
+    use hyperdynamics::{LookaheadFeedSchedule, certify_lookahead_feed_schedule};
+    for policy in [PredicatePolicy::STRICT, PredicatePolicy::APPROXIMATE_512] {
+        let queries: Queries = Rc::default();
+        let mut route = [
+            ObservedSpan {
+                name: "length0",
+                length: Ok(2.into()),
+                queries: queries.clone(),
+            },
+            ObservedSpan {
+                name: "length1",
+                length: Ok(2.into()),
+                queries: queries.clone(),
+            },
+        ];
+        let mut joins = [
+            ObservedJoin {
+                queries: queries.clone(),
+                invalid: false,
+            },
+            ObservedJoin {
+                queries: queries.clone(),
+                invalid: false,
+            },
+        ];
+        let limits = LookaheadFeedPlanningLimits {
+            maximum_entry_feed: 0.into(),
+            maximum_corner_feeds: vec![10.into()],
+            corner_radii: vec![0.into()],
+            maximum_exit_feed: 0.into(),
+        };
+        assert_eq!(
+            certify_constant_feed_time(&route, (-1).into(), 1.into(), policy).unwrap_err(),
+            DynamicsError::NegativeFeedRate
+        );
+        assert!(queries.borrow().is_empty());
+        assert!(
+            plan_lookahead_feed_schedule(&route, &joins, &limits, 10.into(), 1.into(), policy)
+                .unwrap()
+                .all_satisfied()
+        );
+        assert_eq!(
+            *queries.borrow(),
+            ["length0", "length1", "join", "join", "length0", "length1"].map(|name| (name, policy))
+        );
+        queries.borrow_mut().clear();
+        joins[0].invalid = true;
+        assert_eq!(
+            plan_lookahead_feed_schedule(&route, &joins, &limits, 10.into(), 1.into(), policy)
+                .unwrap_err(),
+            DynamicsError::UnsupportedRouteGeometry
+        );
+        assert_eq!(
+            *queries.borrow(),
+            ["length0", "length1", "join"].map(|name| (name, policy))
+        );
+        queries.borrow_mut().clear();
+        let schedule = LookaheadFeedSchedule {
+            entry_feed: 0.into(),
+            corner_feeds: vec![1.into()],
+            corner_radii: vec![0.into()],
+            exit_feed: 0.into(),
+        };
+        assert_eq!(
+            certify_lookahead_feed_schedule(&route, &joins, &schedule, 10.into(), 1.into(), policy)
+                .unwrap_err(),
+            DynamicsError::UnsupportedRouteGeometry
+        );
+        assert_eq!(*queries.borrow(), vec![("join", policy)]);
+        queries.borrow_mut().clear();
+        route[0].length = Err(DynamicsError::UnsupportedRouteGeometry);
+        assert_eq!(
+            certify_constant_feed_time(&route, 1.into(), 4.into(), policy).unwrap_err(),
+            DynamicsError::UnsupportedRouteGeometry
+        );
+        assert_eq!(*queries.borrow(), vec![("length0", policy)]);
+    }
+}
+
+#[test]
+fn empty_shape_and_explicit_component_bound_remain_distinct_failures() {
+    for policy in [PredicatePolicy::STRICT, PredicatePolicy::APPROXIMATE_512] {
+        let empty: [Span; 0] = [];
+        let no_joins: [Join; 0] = [];
+        let empty_limits = LookaheadFeedPlanningLimits {
+            maximum_entry_feed: 0.into(),
+            maximum_corner_feeds: vec![],
+            corner_radii: vec![],
+            maximum_exit_feed: 0.into(),
+        };
+        assert_eq!(
+            plan_lookahead_feed_schedule(
+                &empty,
+                &no_joins,
+                &empty_limits,
+                (-1).into(),
+                1.into(),
+                policy
+            )
+            .unwrap_err(),
+            DynamicsError::EmptyRoute
+        );
+        assert_eq!(
+            plan_jerk_feasible_lookahead_schedule(
+                &empty,
+                &no_joins,
+                &empty_limits,
+                1.into(),
+                1.into(),
+                0.into(),
+                0,
+                policy
+            )
+            .unwrap_err(),
+            DynamicsError::ZeroJerk
+        );
+
+        assert_eq!(
+            certify_constant_feed_time(&empty, (-1).into(), (-1).into(), policy).unwrap_err(),
+            DynamicsError::EmptyRoute
+        );
+        let route = [Span(2.into()), Span(2.into())];
+        let joins = [Join(17), Join(29)];
+        let limits = LookaheadFeedPlanningLimits {
+            maximum_entry_feed: 0.into(),
+            maximum_corner_feeds: vec![10.into()],
+            corner_radii: vec![0.into()],
+            maximum_exit_feed: 0.into(),
+        };
+        assert_eq!(
+            plan_jerk_feasible_lookahead_schedule(
+                &route,
+                &joins,
+                &limits,
+                10.into(),
+                1.into(),
+                10.into(),
+                0,
+                policy
+            )
+            .unwrap_err(),
+            DynamicsError::JerkRefinementBudgetExceeded
+        );
+        assert!(
+            plan_jerk_feasible_lookahead_schedule(
+                &route,
+                &joins,
+                &limits,
+                10.into(),
+                1.into(),
+                10.into(),
+                1,
+                policy
+            )
+            .unwrap()
+            .all_satisfied()
+        );
+    }
+}
diff --git a/crates/hyperdynamics/tests/metric_admission.rs b/crates/hyperdynamics/tests/metric_admission.rs
new file mode 100644
index 000000000..a4b7d2684
--- /dev/null
+++ b/crates/hyperdynamics/tests/metric_admission.rs
@@ -0,0 +1,263 @@
+use hyperdynamics::{DynamicsError, MetricSpan, SpanDynamicsClass, plan_monotonic_jerk_transition};
+use hyperlimit::PredicatePolicy;
+use hyperreal::Real;
+struct Span(Real);
+impl MetricSpan for Span {
+    fn exact_length(&self, _: PredicatePolicy) -> Result<Real, DynamicsError> {
+        Ok(self.0.clone())
+    }
+    fn dynamics_class(&self) -> SpanDynamicsClass {
+        SpanDynamicsClass::Affine
+    }
+}
+#[test]
+fn a_metric_source_needs_no_geometry_dependency() {
+    let plan = plan_monotonic_jerk_transition(
+        &Span(6.into()),
+        1.into(),
+        2.into(),
+        10.into(),
+        10.into(),
+        10.into(),
+        PredicatePolicy::STRICT,
+    )
+    .unwrap();
+    assert!(plan.all_satisfied());
+    assert_eq!(plan.phases[0].ramp.traversal_time, Real::from(2));
+}
+
+use hyperdynamics::{
+    JerkRampPhaseProposal, JerkRampSpanProposal, certify_jerk_ramp_feed_schedule,
+    certify_multi_phase_jerk_ramp_feed_schedule,
+};
+use hyperreal::Rational;
+use std::cell::RefCell;
+
+fn q(n: i64, d: i64) -> Real {
+    Real::new(Rational::new(n) / Rational::new(d))
+}
+
+#[test]
+fn exact_two_phase_identities_and_unsafe_candidates() {
+    for policy in [PredicatePolicy::STRICT, PredicatePolicy::APPROXIMATE_512] {
+        for (start, end) in [(1, 2), (2, 1), (0, 3), (3, 0), (2, 2)] {
+            let span = Span(12.into());
+            let plan = plan_monotonic_jerk_transition(
+                &span,
+                start.into(),
+                end.into(),
+                10.into(),
+                10.into(),
+                10.into(),
+                policy,
+            )
+            .unwrap();
+            assert!(plan.all_satisfied());
+            assert_eq!(plan.phases.len(), 2);
+            let [first, second] = plan.phases.as_slice() else {
+                unreachable!()
+            };
+            let time = q(12, start + end);
+            assert_eq!(first.ramp.traversal_time, time);
+            assert_eq!(second.ramp.traversal_time, time);
+            assert_eq!(first.ramp.start_acceleration, Real::zero());
+            assert_eq!(second.ramp.end_acceleration, Real::zero());
+            assert_eq!(
+                first.ramp.end_acceleration,
+                q((end - start) * (start + end), 12)
+            );
+            assert_eq!(second.ramp.start_acceleration, first.ramp.end_acceleration);
+            assert_eq!(first.ramp.end_feed, q(start + end, 2));
+            assert_eq!(second.ramp.start_feed, first.ramp.end_feed);
+            // Independently integrate v(t)=v0+a0*t+j*t^2/2 over each phase.
+            for phase in &plan.phases {
+                let ramp = &phase.ramp;
+                assert_eq!(
+                    Real::from(6) * &phase.path_length,
+                    Real::from(6) * &ramp.start_feed * &time
+                        + (Real::from(2) * &ramp.start_acceleration + &ramp.end_acceleration)
+                            * &time
+                            * &time
+                );
+            }
+            assert_eq!(&first.path_length + &second.path_length, Real::from(12));
+            let mut bad = plan.phases.clone();
+            bad[1].ramp.start_feed += Real::one();
+            let rejected = certify_multi_phase_jerk_ramp_feed_schedule(
+                std::slice::from_ref(&span),
+                &[bad],
+                10.into(),
+                10.into(),
+                10.into(),
+                policy,
+            )
+            .unwrap();
+            assert!(!rejected.all_satisfied());
+            assert!(rejected.elements[0].continuity[0].has_certified_violation());
+            let capped = certify_multi_phase_jerk_ramp_feed_schedule(
+                &[span],
+                &[plan.phases],
+                q(1, 2),
+                10.into(),
+                10.into(),
+                policy,
+            )
+            .unwrap();
+            assert!(!capped.all_satisfied());
+            assert_eq!(capped.first_unsatisfied_element(), Some(0));
+        }
+    }
+}
+
+struct ObservedSpan {
+    length: RefCell<Result<Real, DynamicsError>>,
+    queries: RefCell<Vec<PredicatePolicy>>,
+}
+impl MetricSpan for ObservedSpan {
+    fn exact_length(&self, policy: PredicatePolicy) -> Result<Real, DynamicsError> {
+        self.queries.borrow_mut().push(policy);
+        self.length.borrow().clone()
+    }
+    fn dynamics_class(&self) -> SpanDynamicsClass {
+        SpanDynamicsClass::General
+    }
+}
+
+#[test]
+fn metric_queries_stay_lazy_and_failed_sources_can_retry() {
+    for policy in [PredicatePolicy::STRICT, PredicatePolicy::APPROXIMATE_512] {
+        let source = ObservedSpan {
+            length: RefCell::new(Err(DynamicsError::UnsupportedRouteGeometry)),
+            queries: RefCell::new(vec![]),
+        };
+        let invalid = JerkRampSpanProposal {
+            start_feed: 1.into(),
+            end_feed: 2.into(),
+            start_acceleration: 0.into(),
+            end_acceleration: 1.into(),
+            traversal_time: 0.into(),
+        };
+        let single = |proposal| {
+            certify_jerk_ramp_feed_schedule(
+                std::slice::from_ref(&source),
+                &[proposal],
+                10.into(),
+                10.into(),
+                10.into(),
+                policy,
+            )
+        };
+        assert_eq!(
+            single(invalid.clone()).unwrap_err(),
+            DynamicsError::ZeroTime
+        );
+        assert!(source.queries.borrow().is_empty()); // Single-phase validation precedes the source.
+        let multi = certify_multi_phase_jerk_ramp_feed_schedule(
+            std::slice::from_ref(&source),
+            &[vec![JerkRampPhaseProposal {
+                path_length: 6.into(),
+                ramp: invalid,
+            }]],
+            10.into(),
+            10.into(),
+            10.into(),
+            policy,
+        );
+        assert_eq!(multi.unwrap_err(), DynamicsError::UnsupportedRouteGeometry);
+        assert_eq!(*source.queries.borrow(), vec![policy]); // Multi-phase source precedes phase validation.
+        source.queries.borrow_mut().clear();
+        let plan = |start| {
+            plan_monotonic_jerk_transition(
+                &source,
+                start,
+                2.into(),
+                10.into(),
+                10.into(),
+                10.into(),
+                policy,
+            )
+        };
+        assert_eq!(
+            plan((-1).into()).unwrap_err(),
+            DynamicsError::NegativeFeedRate
+        );
+        assert!(source.queries.borrow().is_empty());
+        assert_eq!(
+            plan(1.into()).unwrap_err(),
+            DynamicsError::UnsupportedRouteGeometry
+        );
+        assert_eq!(source.queries.borrow().len(), 1);
+        *source.length.borrow_mut() = Ok(6.into());
+        source.queries.borrow_mut().clear();
+        assert!(plan(1.into()).unwrap().all_satisfied());
+        assert_eq!(*source.queries.borrow(), vec![policy, policy]); // Construction and independent replay.
+    }
+}
+
+#[test]
+fn public_checks_retain_decision_metadata_on_success_failure_and_unknown() {
+    use hyperdynamics::{
+        check_nonnegative_feed, check_positive_acceleration, check_positive_feed,
+        check_positive_jerk,
+    };
+    use hyperlimit::{PredicateOutcome, Sign, classify_real_sign};
+    let unresolved = (Real::pi() * Real::e()).ln().unwrap()
+        - (Real::pi().ln().unwrap() + Real::e().ln().unwrap());
+    for policy in [PredicatePolicy::STRICT, PredicatePolicy::APPROXIMATE_512] {
+        for value in [
+            (-1).into(),
+            0.into(),
+            1.into(),
+            Real::from(2).sqrt().unwrap(),
+            unresolved.clone(),
+        ] {
+            for (check, negative, zero) in [
+                (
+                    check_nonnegative_feed
+                        as fn(
+                            &Real,
+                            PredicatePolicy,
+                        )
+                            -> PredicateOutcome<Result<(), DynamicsError>>,
+                    DynamicsError::NegativeFeedRate,
+                    Ok(()),
+                ),
+                (
+                    check_positive_feed,
+                    DynamicsError::NegativeFeedRate,
+                    Err(DynamicsError::ZeroFeedRate),
+                ),
+                (
+                    check_positive_acceleration,
+                    DynamicsError::NegativeAcceleration,
+                    Err(DynamicsError::ZeroAcceleration),
+                ),
+                (
+                    check_positive_jerk,
+                    DynamicsError::NegativeJerk,
+                    Err(DynamicsError::ZeroJerk),
+                ),
+            ] {
+                let expected = match classify_real_sign(&value, policy) {
+                    PredicateOutcome::Decided {
+                        value: sign,
+                        certainty,
+                        stage,
+                    } => PredicateOutcome::Decided {
+                        value: match sign {
+                            Sign::Negative => Err(negative),
+                            Sign::Zero => zero,
+                            Sign::Positive => Ok(()),
+                        },
+                        certainty,
+                        stage,
+                    },
+                    PredicateOutcome::Unknown { needed, stage } => {
+                        PredicateOutcome::Unknown { needed, stage }
+                    }
+                };
+                assert_eq!(check(&value, policy), expected);
+            }
+        }
+    }
+}
