+        )
+        .unwrap();
+        let lines = std::slice::from_ref(&line);
+        assert_eq!(
+            super::certify_constant_feed_time(lines, 5.into(), 1.into(), policy).unwrap_err(),
+            RouteCertificationError::UnsupportedRouteGeometry
