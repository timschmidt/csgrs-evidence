+            "{}\n{}",
+            String::from_utf8_lossy(&output.stdout),
+            String::from_utf8_lossy(&output.stderr)
+        );
+        String::from_utf8(output.stdout)
+            .unwrap()
+            .lines()
+            .filter(|l| l.starts_with("ROW|") || l.starts_with("TRACE|"))
+            .map(str::to_owned)
+            .collect::<Vec<_>>()
+    };
+    for policy in ["strict", "approximate"] {
