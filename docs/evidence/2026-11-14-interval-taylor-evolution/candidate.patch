+fn qr_generated_flow_evolves_transports_and_continues() {
+    use hyperreal::Real;
+    let y = SymbolId(21);
+    let f = field::<2>(&[Expr::int(2), Expr::int(1)], &[X, y]);
+    let basis = vec![
