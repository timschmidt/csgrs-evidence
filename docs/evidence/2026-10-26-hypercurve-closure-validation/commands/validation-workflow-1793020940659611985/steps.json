[
  {
    "id": "rust-test-1-3",
    "origin": {
      "workflow": ".github/workflows/rust.yml",
      "job": "test",
      "matrix": {
        "name": "all-features",
        "command": "cargo test --locked --all-features"
      },
      "step": 3,
      "name": "Run test configuration"
    },
    "cwd": ".",
    "command": "cargo test --locked --all-features",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "CARGO_TERM_COLOR": "always",
      "COMMAND": "cargo test --locked --all-features"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  },
  {
    "id": "rust-clippy-0-3",
    "origin": {
      "workflow": ".github/workflows/rust.yml",
      "job": "clippy",
      "matrix": {},
      "step": 3,
      "name": null
    },
    "cwd": ".",
    "command": "cargo clippy --locked --all-targets --all-features -- -D warnings",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "CARGO_TERM_COLOR": "always"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  },
  {
    "id": "rust-examples-0-3",
    "origin": {
      "workflow": ".github/workflows/rust.yml",
      "job": "examples",
      "matrix": {},
      "step": 3,
      "name": "Run every example"
    },
    "cwd": ".",
    "command": "bash scripts/run-examples.sh",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "CARGO_TERM_COLOR": "always"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  },
  {
    "id": "rust-wasm-bindings-0-3",
    "origin": {
      "workflow": ".github/workflows/rust.yml",
      "job": "wasm-bindings",
      "matrix": {},
      "step": 3,
      "name": "Install binding tools"
    },
    "cwd": ".",
    "command": "npm ci --ignore-scripts --no-audit --no-fund --prefix tests/wasm",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "CARGO_TERM_COLOR": "always"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  },
  {
    "id": "rust-wasm-bindings-0-4",
    "origin": {
      "workflow": ".github/workflows/rust.yml",
      "job": "wasm-bindings",
      "matrix": {},
      "step": 4,
      "name": "Exercise generated bindings and declarations"
    },
    "cwd": ".",
    "command": "export PATH=\"${GITHUB_WORKSPACE}/tests/wasm/node_modules/.bin:${PATH}\"\nbash scripts/test-wasm-bindings.sh\n",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "CARGO_TERM_COLOR": "always"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  }
