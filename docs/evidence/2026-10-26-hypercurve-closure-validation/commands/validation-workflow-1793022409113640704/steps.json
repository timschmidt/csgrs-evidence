[
  {
    "id": "rust-clippy-0-3",
    "origin": {
      "workflow": ".github/workflows/rust.yml",
      "job": "clippy",
      "matrix": {},
      "step": 3,
      "name": null
    },
    "cwd": ".",
    "command": "cargo clippy --locked --all-targets --all-features -- -D warnings",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "CARGO_TERM_COLOR": "always"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  },
  {
    "id": "rust-examples-0-3",
    "origin": {
      "workflow": ".github/workflows/rust.yml",
      "job": "examples",
      "matrix": {},
      "step": 3,
      "name": "Run every example"
    },
    "cwd": ".",
    "command": "bash scripts/run-examples.sh",
    "env": {
      "RUSTUP_TOOLCHAIN": "1.99.1",
      "CARGO_TERM_COLOR": "always"
    },
    "target_group": "1.99.1-normal",
    "kind": "workflow",
    "timeout_seconds": 21600
  }
]
