+# Changelog
+
+## 0.1.0 (unreleased)
+
+- Exact metric-span jerk replay and monotonic transitions now live in Hyperdynamics;
+  Hyperpath retains its geometry adapter and deprecated compatibility wrappers.
+
+- Extract exact affine axis-limit selection and replay from Hyperpath.
diff --git a/crates/hyperdynamics/Cargo.toml b/crates/hyperdynamics/Cargo.toml
new file mode 100644
index 000000000..eaff7ec53
--- /dev/null
+++ b/crates/hyperdynamics/Cargo.toml
@@ -0,0 +1,23 @@
+[package]
+name = "hyperdynamics"
+version = "0.1.0"
+edition = "2024"
+rust-version = "1.95.0"
+description = "Exact dynamics and independently replayed motion limits for the Hyper stack"
+license = "MIT OR Apache-2.0"
+repository = "https://github.com/timschmidt/csgrs"
+readme = "README.md"
+include = ["/src/**", "/examples/**", "/README.md", "/CHANGELOG.md", "/LICENSE*"]
+categories = ["mathematics", "science"]
+
+[package.metadata.docs.rs]
+all-features = true
+
+[features]
+default = []
+dispatch-trace = ["hyperlimit/dispatch-trace", "hyperreal/dispatch-trace", "hypersolve/dispatch-trace"]
+
+[dependencies]
+hyperlimit = { version = "0.5.0", path = "../hyperlimit", default-features = false }
+hyperreal = { version = "0.14.0", path = "../hyperreal", default-features = false }
+hypersolve = { version = "0.4.0", path = "../hypersolve", default-features = false }
