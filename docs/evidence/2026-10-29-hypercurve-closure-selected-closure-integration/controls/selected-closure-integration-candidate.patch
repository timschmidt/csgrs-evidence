+fn integration_dependent_fiber() -> CurvePoint2 {
+    let parameter = form(&source(), y()).parameter().unwrap();
+    curves(p(&[&[0, 0, 1], &[-1]])).curves()[1]
+        .point_at(&parameter)
+        .unwrap()
+}
