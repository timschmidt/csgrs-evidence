+                        hyperlattice_interval::IntervalLatticeError::Scalar(
+                            IntervalError::WorkExhausted
+                        )
+                    ))
+            ),
+            "{:?}",
+            failure.error()
+        );
+        assert_eq!(failure.request().initial, req.initial);
+    }
+    let mut exact = EnclosureBudget::new(EnclosurePolicy {
+        graph_work: gw * 2,
