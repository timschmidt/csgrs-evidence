+        let value = self.decode(bits);
+        // All input significands have at most 53 bits, including their sign.
+        let magnitude = value.magnitude as i64;
+        (
+            if value.negative {
+                -magnitude
+            } else {
+                magnitude
+            },
+            value.exponent,
+        )
+    }
