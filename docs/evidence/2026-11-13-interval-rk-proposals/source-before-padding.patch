+#[cfg(any(feature = "float-enclosure", feature = "dyadic"))]
+impl Format {
+    fn fraction(self) -> u32 {
+        self.infinity.trailing_zeros()
+    }
+    fn bias(self) -> i32 {
+        ((self.infinity >> self.fraction()) >> 1) as i32
+    }
+    fn minimum(self) -> i32 {
