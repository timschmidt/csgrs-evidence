+        let field = (bits & self.infinity) >> f;
+        let tail = bits & ((1 << f) - 1);
+        Dyadic {
+            negative: bits & self.sign != 0,
+            magnitude: u128::from(if field == 0 { tail } else { tail | (1 << f) }),
+            exponent: if field == 0 {
