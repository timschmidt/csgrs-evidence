+        small.error(),
+        Rk4Error::Field(FieldError::Scalar(IntervalError::SizeExhausted))
+    ));
+    assert!(small.trace().stages().is_empty());
+    for work in [0, sw / 2, sw - 1] {
+        let failure = prepared
+            .propose(
+                req.clone(),
+                Default::default(),
+                &mut EnclosureBudget::new(EnclosurePolicy {
+                    scalar_work: work,
+                    ..p
