+/// Project native source positions to binary64 and check every encoded triangle.
+/// This is a format-boundary check, not a proof of original-source fidelity or
+/// general preservation of intersections/topology under coordinate projection.
+fn native_positions_f64(part: &StlMeshData) -> Result<Vec<[f64; 3]>, String> {
+    use hyperlattice::Point3;
+    let positions = part
+        .source
+        .positions
+        .iter()
+        .map(|point| {
+            point.to_f64_array_lossy().ok_or_else(|| {
+                format!(
+                    "Part @{} has an unrepresentable binary64 export position",
+                    part.part
+                )
+            })
+        })
+        .collect::<Result<Vec<_>, _>>()?;
+    let projected = csgrs::TriangleMesh::new(
+        positions
+            .iter()
+            .map(|p| {
+                Point3::new(
+                    csgrs::Real::try_from(p[0]).expect("finite projection"),
+                    csgrs::Real::try_from(p[1]).expect("finite projection"),
+                    csgrs::Real::try_from(p[2]).expect("finite projection"),
+                )
+            })
+            .collect(),
+        part.source.triangles.to_vec(),
+    );
+    let valid = projected
+        .has_unique_nondegenerate_triangles(&csgrs::GeometryContext::STRICT.mesh_context())
+        .map_err(|error| format!("Part @{} export validation failed: {error}", part.part))?;
+    if !valid.value {
