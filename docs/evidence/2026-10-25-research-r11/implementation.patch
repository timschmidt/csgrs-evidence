+fn loop_rewrite_fixture() -> CurveRegion2 {
+    let policy = CurveContext::STRICT;
+    let boundaries = [0, 10]
+        .into_iter()
+        .enumerate()
+        .map(|(loop_index, x)| {
+            let points = [p(x, 0), p(x + 2, 0), p(x + 2, 2), p(x, 2)];
+            let fragments = points
+                .iter()
+                .zip(points.iter().cycle().skip(1))
+                .map(|(start, end)| BezierSplitFragment2::Materialized {
+                    start: BezierParameter2::Exact(Real::zero()),
+                    end: BezierParameter2::Exact(Real::one()),
+                    curve: BezierSubcurve2::Quadratic(QuadraticBezier2::from_line_segment(
+                        LineSeg2::try_new(start.clone(), end.clone()).unwrap(),
+                    )),
+                })
+                .collect();
+            CurveRegionBoundaryLoop2::try_new_from_certified_arrangement_chain(
+                fragments,
+                (0..4)
+                    .map(|index| {
+                        let source = 4 * loop_index + index;
+                        CurveRegionFragmentSource2::new(source, source, index)
+                    })
+                    .collect(),
+                &policy,
+            )
+            .unwrap()
+        })
+        .collect();
+    // Two independently specified, disjoint counterclockwise squares.
+    CurveRegion2::new(boundaries)
+        .unwrap()
+        .with_regularized_filled_left_topology(&policy)
+        .unwrap()
+        .with_certified_all_material_loop_roles(2)
+        .unwrap()
+}
+
+#[test]
+fn loop_image_rewrite_rejects_removed_or_reordered_correspondence() {
+    let source = loop_rewrite_fixture();
+    let boundaries = source.boundary_loops();
+    for replacement in [
+        vec![(0, boundaries[0].clone())],
+        vec![(1, boundaries[1].clone()), (0, boundaries[0].clone())],
+        vec![(0, boundaries[0].clone()), (0, boundaries[1].clone())],
+    ] {
+        assert!(matches!(
+            source.with_rewritten_loop_images(replacement.into_iter(), &CurveContext::STRICT),
+            Err(CurveError::Topology(_))
+        ));
+    }
+    assert_eq!(source.loop_role_counts().unwrap(), (2, 0));
+    assert_eq!(source.filled_area().unwrap(), Some(Real::from(8)));
+}
+
+#[test]
+fn loop_image_rewrite_keeps_strict_proofs_under_both_policies() {
+    let source = loop_rewrite_fixture();
+    for policy in [
+        CurveContext::STRICT,
+        CurveContext::APPROXIMATE_512,
+        CurveContext::STRICT,
+    ] {
+        let outcome = resolve_certified_operation(&policy, |attempt| {
+            source.with_rewritten_loop_images(
+                source.boundary_loops().to_vec().into_iter().enumerate(),
+                attempt,
+            )
+        })
+        .unwrap();
+        assert_eq!(outcome.certainty, CurveCertainty::Certified);
+        let rewritten = outcome.value;
+        assert_eq!(
+            rewritten.data.normalized_policy(),
+            Some(CurveContext::STRICT)
+        );
+        assert!(Arc::ptr_eq(
+            source.data.certified_loop_roles.as_ref().unwrap(),
+            rewritten.data.certified_loop_roles.as_ref().unwrap(),
+        ));
+        assert_eq!(rewritten.loop_role_counts().unwrap(), (2, 0));
+        assert_eq!(rewritten.filled_area().unwrap(), Some(Real::from(8)));
+        for (before, after) in source
+            .boundary_loops()
+            .iter()
+            .zip(rewritten.boundary_loops())
+        {
+            assert_eq!(before.arrangement_sources(), after.arrangement_sources());
+            assert_eq!(before.fragments(), after.fragments());
+        }
+    }
+}
+
+#[test]
+fn loop_image_rewrite_cannot_upgrade_source_or_rewrite_dependencies() {
+    let source = loop_rewrite_fixture();
+    let approximate = CurveContext::APPROXIMATE_512;
+    let qualified = resolve_certified_operation(&approximate, |attempt| {
+        // Inject a consumed terminal to isolate the transport's dependency
+        // contract; public Boolean tests exercise actual terminal predicates.
+        attempt.observe_approximate_512();
+        source.with_rewritten_loop_images(
+            source.boundary_loops().to_vec().into_iter().enumerate(),
+            attempt,
+        )
+    })
+    .unwrap();
+    assert_eq!(qualified.certainty, CurveCertainty::Approximate512Consumed);
+    assert!(qualified.value.data.certified_loop_roles.is_none());
+    assert_eq!(qualified.value.data.normalized_policy(), Some(approximate));
+    for _ in 0..2 {
+        let replay = resolve_certified_operation(&approximate, |attempt| {
+            qualified.value.with_rewritten_loop_images(
+                qualified
+                    .value
+                    .boundary_loops()
+                    .to_vec()
+                    .into_iter()
+                    .enumerate(),
+                attempt,
+            )
+        })
+        .unwrap();
+        assert_eq!(replay.certainty, CurveCertainty::Approximate512Consumed);
+        assert!(replay.value.data.certified_loop_roles.is_none());
+        assert_eq!(replay.value.data.normalized_policy(), Some(approximate));
+        assert!(
+            qualified
+                .value
+                .with_rewritten_loop_images(
+                    qualified
+                        .value
+                        .boundary_loops()
+                        .to_vec()
+                        .into_iter()
+                        .enumerate(),
+                    &CurveContext::STRICT,
+                )
+                .is_err()
+        );
+    }
+    let raw = CurveRegion2::new(source.boundary_loops().to_vec()).unwrap();
+    assert!(
+        raw.with_rewritten_loop_images(
+            raw.boundary_loops().to_vec().into_iter().enumerate(),
+            &CurveContext::STRICT,
+        )
+        .is_err()
+    );
+    assert!(
+        source
+            .with_rewritten_loop_images(
+                source.boundary_loops().to_vec().into_iter().enumerate(),
+                &CurveContext::STRICT,
+            )
+            .is_ok()
+    );
+}
