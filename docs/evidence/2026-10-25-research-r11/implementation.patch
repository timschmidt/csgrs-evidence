+    /// Replace each loop by a proved equivalent directed boundary image.
+    ///
+    /// The producer must certify every local rewrite (including forward
+    /// direction, not just collinearity) and preserve cyclic connectivity.
+    /// Source indices make the one-to-one, order-preserving correspondence
+    /// explicit: removing or reordering a loop needs a different proof.
+    /// Only strict source topology and strict rewrites transport cached roles;
+    /// a terminal-dependent rewrite retains the existing uncached result path.
+    pub(crate) fn with_rewritten_loop_images(
+        &self,
+        replacements: impl ExactSizeIterator<Item = (usize, CurveRegionBoundaryLoop2)>,
+        policy: &CurveContext,
+    ) -> CurveResult<Self> {
+        if replacements.len() != self.len() {
+            return Err(CurveError::Topology(
+                "loop-image rewrite must preserve every source loop index".into(),
+            ));
+        }
+        let mut preserves_indices = true;
+        // An enumerated boundary Vec can reuse its allocation while making
+        // the correspondence explicit; no parallel copy of all loops is needed.
+        let boundaries = replacements
+            .enumerate()
+            .map(|(index, (source, boundary))| {
+                preserves_indices &= index == source;
+                boundary
+            })
+            .collect();
+        if !preserves_indices {
+            return Err(CurveError::Topology(
+                "loop-image rewrite must preserve every source loop index".into(),
+            ));
+        }
+        // Replay the source dependency before publishing new normalization.
+        // In particular, a qualified source cannot become strict merely
+        // because the local line merges needed no additional predicates.
+        if !self.has_regularized_filled_left_topology(policy) {
+            return Err(CurveError::Topology(
+                "loop-image rewrite requires admissible normalized source topology".into(),
+            ));
+        }
+        let strict = !policy.is_edge_preview()
+            && policy.retained_object_policy() == policy.strict_counterpart()
+            && self.data.normalized_policy() == Some(policy.strict_counterpart());
+        let mut rewritten = Self::new(boundaries)?.with_regularized_filled_left_topology(policy)?;
+        if strict && let Some(roles) = &self.data.certified_loop_roles {
+            rewritten.data_mut_for_construction().certified_loop_roles = Some(roles.clone());
+            #[cfg(feature = "dispatch-trace")]
+            hyperreal::dispatch_trace::record(
+                "hypercurve",
+                "curve-region-loop-role-transport",
+                "strict-directed-images",
+            );
+        }
+        Ok(rewritten)
+    }
+
