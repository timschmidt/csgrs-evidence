+fn negative_start_time_and_unrepresentable_halving_keep_exact_semantics() {
+    let f = field::<1>(&[Expr::int(1)]);
+    let r = f.integrate(
+        EvolutionRequest {
+            start: scaled(-3, -3, -3),
+            end: scaled(1, 1, -2),
