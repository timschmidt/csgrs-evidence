+    let wire = r#"{"rational":{"sign":1,"numerator":[1],"denominator":[1]},"class":"Pi","computable":{"internal":{"Constant":"E"}}}"#;
+    let mut constructed = false;
+    let result = csgrs::Real::from_json(wire)
+        .map_err(ValidationError::from)
+        .and_then(|side| {
+            constructed = true;
