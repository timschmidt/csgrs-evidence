+            a.compare_coordinate(&b, hypercurve::Axis2::X).unwrap(),
+            Ordering::Equal
+        );
+        assert_eq!(
+            a.compare_coordinate(&b, hypercurve::Axis2::Y).unwrap(),
+            Ordering::Less
+        );
+        assert_eq!(
+            b.compare_coordinate(&a, hypercurve::Axis2::Y).unwrap(),
+            Ordering::Greater
+        );
+        assert!(!a.coincides_with(&b).unwrap());
+    }
+}
