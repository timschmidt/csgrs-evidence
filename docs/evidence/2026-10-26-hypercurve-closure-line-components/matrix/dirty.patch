+/// source abscissas and native parameters are never rebased on the trim.
+fn shared_line_section(
+    branch_curve: &Curve2,
+    line_curve: &Curve2,
+    branch_first: bool,
+    abscissas: [Real; 2],
+    chart: &CurveSpanRange2,
+    policy: &CurveContext,
+) -> ExactCurveResult<CurveIntersectionResult2> {
+    let [x0, x1] = abscissas;
