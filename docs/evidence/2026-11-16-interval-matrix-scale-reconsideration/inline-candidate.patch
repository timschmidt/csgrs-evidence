+#[cfg(feature = "fixed")]
+#[test]
+fn matrix_scale_keeps_rounding_overflow_and_cartesian_correlation_contracts() {
+    use hyperlattice_interval::IntervalLatticeError;
+    use hyperlattice_interval::hyperinterval::{FixedInterval as F, IntervalError};
+    type I = F<i32, 2>;
+    let i = |a, b| I::new(a, b).unwrap();
+    // [-1/4,1/2] * [-3/4,1/2] = [-3/8,1/4], rounded outward on a 1/4 grid.
+    let m = IntervalMatrix::new([[i(-1, 2)]]).unwrap();
+    assert_eq!(
+        m.scale(&i(-3, 2), &mut ()).unwrap().rows(),
+        Some(&[[i(-2, 1)]])
+    );
+    let huge = IntervalMatrix::new([[i(i32::MAX, i32::MAX)]]).unwrap();
+    assert_eq!(
+        huge.scale(&i(8, 8), &mut ()),
+        Err(IntervalLatticeError::Scalar(IntervalError::Overflow))
+    );
+    let ones = IntervalMatrix::new([[i(4, 4), i(4, 4)]]).unwrap();
+    let shared = ones.scale(&i(-4, 4), &mut ()).unwrap();
+    // The output is a Cartesian box. The shared-scalar relation is deliberately
+    // absent; evaluating its coordinate difference must not claim exact zero.
+    let difference = IntervalVector::new([i(4, 4), i(-4, -4)]).unwrap();
+    assert_eq!(
+        shared.mul_vector(&difference, &mut ()).unwrap().lanes(),
+        Some(&[i(-8, 8)])
+    );
+}
