+#[cfg(feature = "dyadic")]
+#[test]
+fn matrix_scale_shares_budget_in_row_order_and_retries() {
+    use hyperlattice_interval::IntervalLatticeError;
+    use hyperlattice_interval::hyperinterval::{DyadicBudget, DyadicInterval as I, IntervalError};
+    let i = |n: i32| I::point(n.into(), 0).unwrap();
+    let input = IntervalMatrix::new([[i(2), i(-3)], [i(5), i(7)]]).unwrap();
+    let scalar = I::new((-3).into(), 2.into(), -1).unwrap();
+    let mut measured = DyadicBudget::new(256, 1_000_000);
+    let expected = input.scale(&scalar, &mut measured).unwrap();
+    let work = 1_000_000 - measured.remaining_work();
+    let mut exact = DyadicBudget::new(256, work);
+    assert_eq!(input.scale(&scalar, &mut exact).unwrap(), expected);
+    assert_eq!(exact.remaining_work(), 0);
+    let mut manual = DyadicBudget::new(256, 1_000_000);
+    for (r, row) in input.rows().unwrap().iter().enumerate() {
+        for (c, value) in row.iter().enumerate() {
+            assert_eq!(
+                value.mul(&scalar, &mut manual).unwrap(),
+                expected.rows().unwrap()[r][c]
+            );
+        }
+    }
+    assert_eq!(manual.remaining_work(), measured.remaining_work());
+    // Check every work cut against the explicit left-to-right sequence. An
+    // exhausted matrix operation must consume exactly the same partial work,
+    // without publishing a partial matrix or poisoning a fresh retry.
+    for limit in 0..=work {
+        let mut actual_budget = DyadicBudget::new(256, limit);
+        let actual = input.scale(&scalar, &mut actual_budget);
+        let mut reference_budget = DyadicBudget::new(256, limit);
+        let reference = input
+            .rows()
+            .unwrap()
+            .iter()
+            .flatten()
+            .try_for_each(|value| value.mul(&scalar, &mut reference_budget).map(|_| ()));
+        assert_eq!(
+            actual.map(|_| ()),
+            reference.map_err(IntervalLatticeError::Scalar)
+        );
+        assert_eq!(
+            actual_budget.remaining_work(),
+            reference_budget.remaining_work()
+        );
+    }
+    assert_eq!(
+        input.scale(&scalar, &mut DyadicBudget::new(256, work - 1)),
+        Err(IntervalLatticeError::Scalar(IntervalError::WorkExhausted))
+    );
+    assert_eq!(
+        input.scale(&scalar, &mut DyadicBudget::new(1, 1_000_000)),
+        Err(IntervalLatticeError::Scalar(IntervalError::SizeExhausted))
+    );
+    assert_eq!(
+        input
+            .scale(&scalar, &mut DyadicBudget::new(256, 1_000_000))
+            .unwrap(),
+        expected
+    );
+    // Empty scalar/domain and zero-dimensional unit products require no arithmetic.
+    assert!(
+        input
+            .scale(&I::empty(), &mut DyadicBudget::new(0, 0))
+            .unwrap()
+            .is_empty()
+    );
+    let empty = IntervalMatrix::<I, 2, 2>::empty().unwrap();
+    assert!(
+        empty
+            .scale(&scalar, &mut DyadicBudget::new(0, 0))
+            .unwrap()
+            .is_empty()
+    );
+    let unit = IntervalMatrix::<I, 2, 0>::new([[], []]).unwrap();
+    assert_eq!(
+        unit.scale(&scalar, &mut DyadicBudget::new(0, 0)).unwrap(),
+        unit
+    );
+}
