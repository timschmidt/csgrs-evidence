+    /// Encloses multiplication by a shared scalar. Correlations between entries
+    /// are forgotten in the Cartesian result. Empty operands remain empty,
+    /// including matrices with zero rows or columns. Uses row-major order and
+    /// one shared backend context.
+    #[inline]
+    pub fn scale(
+        &self,
+        scalar: &I,
+        context: &mut I::Context,
+    ) -> Result<Self, IntervalLatticeError> {
+        let Some(rows) = self.rows() else {
+            return Self::empty();
+        };
+        if scalar.is_empty() {
+            return Self::empty();
+        }
+        Self::new(array_result(|r| {
+            array_result(|c| rows[r][c].mul(scalar, context))
+        })?)
+    }
