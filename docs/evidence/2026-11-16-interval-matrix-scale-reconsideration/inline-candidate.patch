+#[test]
+fn scaled_matrix_fresh_process_replay_remains_an_operand() {
+    const ENV: &str = "CSGRS_MATRIX_SCALE_REPLAY_DIR";
+    if let Some(path) = std::env::var_os(ENV) {
+        let path = std::path::PathBuf::from(path);
+        let matrix: IntervalMatrix<I, 2, 2> =
+            serde_json::from_slice(&std::fs::read(path.join("input.json")).unwrap()).unwrap();
+        let vector = IntervalVector::new([I::point(1).unwrap(), I::point(-1).unwrap()]).unwrap();
+        let image = matrix.mul_vector(&vector, &mut ()).unwrap();
+        std::fs::write(
+            path.join("output.json"),
+            serde_json::to_vec(&image).unwrap(),
+        )
+        .unwrap();
+        return;
+    }
+    let matrix = IntervalMatrix::new([
+        [I::new(-2, 3).unwrap(), I::point(4).unwrap()],
+        [I::point(-1).unwrap(), I::new(2, 5).unwrap()],
+    ])
+    .unwrap()
+    .scale(&I::new(-2, 3).unwrap(), &mut ())
+    .unwrap();
+    // Independent products: [-6,9],[-8,12]; [-3,2],[-10,15].
+    let expected =
+        IntervalVector::new([I::new(-18, 17).unwrap(), I::new(-18, 12).unwrap()]).unwrap();
+    let nonce = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap()
+        .as_nanos();
+    let path = std::env::temp_dir().join(format!("matrix-scale-{}-{nonce}", std::process::id()));
+    std::fs::create_dir(&path).unwrap();
+    std::fs::write(
+        path.join("input.json"),
+        serde_json::to_vec(&matrix).unwrap(),
+    )
+    .unwrap();
+    let output = std::process::Command::new(std::env::current_exe().unwrap())
+        .args([
+            "--exact",
+            "scaled_matrix_fresh_process_replay_remains_an_operand",
+            "--nocapture",
+        ])
+        .env(ENV, &path)
+        .output()
+        .unwrap();
+    assert!(output.status.success(), "{output:?}");
+    let bytes = std::fs::read(path.join("output.json")).unwrap();
+    let actual: IntervalVector<I, 2> = serde_json::from_slice(&bytes).unwrap();
+    assert_eq!(actual, expected);
+    assert_eq!(bytes, serde_json::to_vec(&expected).unwrap());
+    std::fs::remove_dir_all(path).unwrap();
+}
