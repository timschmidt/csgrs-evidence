+    let residual = bivariate_subtract(
+        &bivariate_add(&bivariate_multiply(&x, &x), &bivariate_multiply(&y, &y)),
+        &bivariate_scale(
+            bivariate_multiply(&denominator, &denominator),
+            radius_squared,
+        ),
+    );
