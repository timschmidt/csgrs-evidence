+fn cube_is(value: &SelectedPolynomialValue, expected: i64) {
+    assert_eq!(
+        value
+            .multiply(value)
+            .unwrap()
+            .multiply(value)
+            .unwrap()
+            .subtract(&value.field().constant(real(expected)).unwrap())
+            .unwrap()
+            .sign(&TestContext::strict())
+            .unwrap(),
+        Classification::Decided(hyperreal::RealSign::Zero)
+    );
+}
