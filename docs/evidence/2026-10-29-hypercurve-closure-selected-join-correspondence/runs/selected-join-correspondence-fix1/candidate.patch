+            let mut original = Some(target);
+            while let Some(field) = original {
+                if sources.contains(&(Arc::as_ptr(&field.0) as usize)) {
+                    return Ok(Some(self.lift(&target.generator()?)?));
+                }
+                original = field.generator_origin();
+            }
+            target = parent;
+        }
+        Ok(None)
+    }
