+    let source = loop_rewrite_fixture();
+    let approximate = CurveContext::APPROXIMATE_512;
+    let qualified = resolve_certified_operation(&approximate, |attempt| {
+        // Inject a consumed terminal to isolate the transport's dependency
+        // contract; public Boolean tests exercise actual terminal predicates.
+        attempt.observe_approximate_512();
