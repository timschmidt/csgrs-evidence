+                    {
+                        assert_eq!(
+                            winding,
+                            i32::from(expected),
+                            "overlapping or inward material at N={segments}"
+                        );
+                        winding_checks += 1;
+                    }
+                }
+            }
+        }
+    }
+    assert!(
+        checked > 250 && interior > 0 && winding_checks > 10,
+        "oracle must exercise material and exterior"
