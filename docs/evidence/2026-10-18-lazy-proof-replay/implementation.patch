+#[cfg(all(test, feature = "serde"))]
+mod trig_range_proof_tests {
+    use super::*;
+    use serde_json::{Value, json};
+
+    fn raw_trig(kind: &str, argument: Value) -> Computable {
+        serde_json::from_value(json!({"internal": {kind: argument}})).unwrap()
+    }
