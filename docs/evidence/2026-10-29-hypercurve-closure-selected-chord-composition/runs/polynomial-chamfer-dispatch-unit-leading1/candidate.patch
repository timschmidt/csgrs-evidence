@@ -84,6 +84,40 @@ pub(super) fn positive_scale(
     }
 }
 
+// A single positive field factor keeps every row sign unchanged. Unit leading
+// magnitude then prevents division-free remainder steps from repeatedly raising
+// a large leading coefficient to further powers. The original defining relation
+// remains owned by its field; this only normalizes a temporary predicate row.
+pub(super) fn unit_leading<C: SelectedAlgebraContext>(
+    values: &[SelectedPolynomialValue],
+    policy: &C,
+) -> Result<Option<Vec<SelectedPolynomialValue>>, SelectedPolynomialError<C::Error>> {
+    for leading in values.iter().rev() {
+        if leading.stored_zero() {
+            continue;
+        }
+        let sign = leading.sign_strict(policy)?;
+        if sign == RealSign::Zero {
+            continue;
+        }
+        if leading.stored_one() {
+            return Ok(None);
+        }
+        let inverse = leading.reciprocal_strict(policy)?;
+        let scale = if sign == RealSign::Negative {
+            inverse.scale(&Real::from(-1))?
+        } else {
+            inverse
+        };
+        return values
+            .iter()
+            .map(|value| value.multiply(&scale).map_err(Into::into))
+            .collect::<Result<Vec<_>, _>>()
+            .map(Some);
+    }
+    Ok(None)
+}
