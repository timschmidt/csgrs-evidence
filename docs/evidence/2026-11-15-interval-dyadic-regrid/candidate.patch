+#[test]
+fn identity_regrid_preserves_conservative_reservations_and_retries() {
+    let source = d(-7, 9, -3);
+    // A finer grid reserves 4 source bits plus 17 alignment bits, twice.
+    for (bits, work, expected) in [
+        (20, 42, Err(IntervalError::SizeExhausted)),
+        (21, 41, Err(IntervalError::WorkExhausted)),
+        (21, 42, Ok(source.clone())),
+    ] {
+        let mut budget = DyadicBudget::new(bits, work);
+        let actual = source.regrid(-20, &mut budget);
+        assert_eq!(actual, expected);
+        assert_eq!(
+            budget.remaining_work(),
+            if actual.is_ok() { 0 } else { work }
+        );
+    }
+    let capped = d(4, 12, i32::MAX);
+    let mut budget = DyadicBudget::new(5, 10);
+    assert_eq!(capped.regrid(i32::MAX - 1, &mut budget).unwrap(), capped);
+    assert_eq!(budget.remaining_work(), 0);
+    let mut budget = DyadicBudget::new(0, 2);
+    assert_eq!(
+        d(0, 0, 0).regrid(i32::MIN, &mut budget).unwrap(),
+        d(0, 0, 0)
+    );
+    assert_eq!(budget.remaining_work(), 0);
+    assert!(
+        DyadicInterval::empty()
+            .regrid(i32::MIN, &mut budget)
+            .unwrap()
+            .is_empty()
+    );
+}
