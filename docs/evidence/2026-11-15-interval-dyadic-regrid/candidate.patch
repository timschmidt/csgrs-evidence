+#[cfg(all(feature = "hyperreal", feature = "dispatch-trace"))]
+#[test]
+fn regridding_and_alignment_have_no_scalar_dispatch() {
+    use hyperreal::dispatch_trace;
+    dispatch_trace::reset();
+    dispatch_trace::with_recording(|| {
+        for source in [d(-7, 9, -3), d(0, 0, 0), DyadicInterval::empty()] {
+            for precision in [-64, -3, 0, 8] {
+                let result = source.regrid(precision, &mut budget()).unwrap();
+                assert!(source.subset_of(&result, &mut budget()).unwrap());
+                assert_eq!(source.add(&d(0, 0, 0), &mut budget()).unwrap(), source);
+            }
+        }
+    });
+    let trace = dispatch_trace::take_trace();
+    assert!(trace.dispatch.is_empty());
+    assert_eq!(trace.rational, Default::default());
+}
