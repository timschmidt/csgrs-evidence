+                } else {
+                    crate::sqrt::integer_sqrt_bounds((b as u128) << FRAC).1
+                };
+                Ok(RangeEnclosure {
+                    range: Self::from_wide(lower as i128, upper as i128)?,
+                    domain,
+                })
+            }
