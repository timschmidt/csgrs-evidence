diff --git a/crates/hyperdynamics/tests/native_evolution_trace.rs b/crates/hyperdynamics/tests/native_evolution_trace.rs
new file mode 100644
index 000000000..b8375ce23
--- /dev/null
+++ b/crates/hyperdynamics/tests/native_evolution_trace.rs
@@ -0,0 +1,62 @@
+#![cfg(all(feature = "field", feature = "dispatch-trace"))]
+use hyperdynamics::field::{
+    EnclosureBudget, EnclosurePolicy, ExpressionField, FieldDefinition,
+    evolution::{EvolutionOptions, EvolutionRequest},
+};
+use hyperinterval::DyadicInterval;
+use hyperlattice_interval::BoxN;
+use hyperreal::dispatch_trace;
+use hypersolve::{
+    Expr, SymbolId,
+    expression_program::{ExpressionBudget, ExpressionProgram},
+};
+#[test]
+fn native_evolution_retains_fixed_dispatch_counts() {
+    let [t, x, v] = [SymbolId(100), SymbolId(0), SymbolId(1)];
+    for (case, outputs) in [
+        vec![Expr::int(2), Expr::int(0)],
+        vec![Expr::anonymous_symbol(v), -Expr::anonymous_symbol(x)],
+        vec![Expr::anonymous_symbol(x).powi(2), Expr::int(0)],
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let source = ExpressionProgram::compile(
+            &outputs,
+            &[v, t, x],
+            &mut ExpressionBudget::new(100000, 10000000),
+        )
+        .unwrap();
+        let mut budget = EnclosureBudget::new(EnclosurePolicy::default());
+        let field = ExpressionField::<2>::from_definition(
+            FieldDefinition {
+                source: source.definition().clone(),
+                time: t,
+                state: vec![x, v],
+            },
+            &mut budget,
+        )
+        .unwrap();
+        let request = EvolutionRequest {
+            start: DyadicInterval::point(0.into(), 0).unwrap(),
+            end: DyadicInterval::point(1.into(), -2).unwrap(),
+            initial: BoxN::new([
+                DyadicInterval::point(1.into(), 0).unwrap(),
+                DyadicInterval::point(0.into(), 0).unwrap(),
+            ])
+            .unwrap(),
+        };
+        dispatch_trace::reset();
+        let report = dispatch_trace::with_recording(|| {
+            field.integrate(request, EvolutionOptions::default(), &mut budget)
+        });
+        let trace = dispatch_trace::take_trace();
+        assert!(report.end_enclosure().is_some());
+        assert!(trace.dispatch.is_empty());
+        assert_eq!(
+            trace.rational,
+            dispatch_trace::RationalTraceStats::default()
+        );
+        println!("TRACECASE {case} {trace:?}");
+    }
+}
diff --git a/crates/hyperdynamics/tests/reachability.rs b/crates/hyperdynamics/tests/reachability.rs
new file mode 100644
index 000000000..4d50521ca
--- /dev/null
+++ b/crates/hyperdynamics/tests/reachability.rs
@@ -0,0 +1,618 @@
+#![cfg(feature = "reachability")]
+use hyperdynamics::field::{
+    EnclosureBudget, EnclosurePolicy, ExpressionField, FieldDefinition, FieldError, evolution::*,
+    reachability::*,
+};
+use hyperinterval::{DyadicBudget, DyadicInterval};
+use hyperlattice_interval::BoxN;
+use hypersolve::{
+    Expr, SymbolId,
+    expression_program::{ExpressionBudget, ExpressionError, ExpressionProgram},
+    work_budget::CancellationToken,
+};
+fn d(a: i64, b: i64, e: i32) -> DyadicInterval {
+    DyadicInterval::new(a.into(), b.into(), e).unwrap()
+}
+fn b() -> EnclosureBudget {
+    EnclosureBudget::new(EnclosurePolicy::default())
+}
+fn sb() -> DyadicBudget {
+    DyadicBudget::new(16384, 1_000_000_000_000)
+}
+fn field<const N: usize>(outputs: &[Expr]) -> ExpressionField<N> {
+    let state: Vec<_> = (0..N).map(|i| SymbolId(i as u32)).collect();
+    let time = SymbolId(100);
+    let mut vars = state.clone();
+    vars.push(time);
+    let source =
+        ExpressionProgram::compile(outputs, &vars, &mut ExpressionBudget::new(100000, 10000000))
+            .unwrap();
+    ExpressionField::from_definition(
+        FieldDefinition {
+            source: source.definition().clone(),
+            time,
+            state,
+        },
+        &mut b(),
+    )
+    .unwrap()
+}
+fn request<const N: usize>(
+    initial: BoxN<DyadicInterval, N>,
+    epsilon: DyadicInterval,
+) -> ReachabilityRequest<N> {
+    ReachabilityRequest {
+        evolution: EvolutionRequest {
+            start: d(0, 0, 0),
+            end: d(1, 1, -1),
+            initial,
+        },
+        epsilon,
+    }
+}
+fn check<const N: usize>(r: &ReachabilityReport<N>) {
+    assert!(
+        matches!(r.status(), ReachabilityStatus::Completed),
+        "{:?}",
+        r.status()
+    );
+    assert!(r.end_cover().is_some());
+    for (i, cell) in r.cells().iter().enumerate() {
+        if let Some([left, right]) = cell.children() {
+            assert_eq!(r.cells()[left].parent(), Some(i));
+            assert_eq!(r.cells()[right].parent(), Some(i));
+            assert_eq!(r.cells()[left].depth(), cell.depth() + 1);
+            assert_eq!(r.cells()[right].depth(), cell.depth() + 1);
+            let axis = cell.split_axis().unwrap();
+            let source = cell.initial().lanes().unwrap();
+            let l = r.cells()[left].initial().lanes().unwrap();
+            let u = r.cells()[right].initial().lanes().unwrap();
+            for k in 0..N {
+                if k == axis {
+                    let s = source[k].to_rational(&mut sb()).unwrap();
+                    let a = l[k].to_rational(&mut sb()).unwrap();
+                    let z = u[k].to_rational(&mut sb()).unwrap();
+                    let midpoint = (s.lower().unwrap().clone() + s.upper().unwrap().clone())
+                        / hyperreal::Rational::from(2);
+                    assert_eq!(a.lower(), s.lower());
+                    assert_eq!(z.upper(), s.upper());
+                    assert_eq!(a.upper(), Some(&midpoint));
+                    assert_eq!(z.lower(), Some(&midpoint));
+                } else {
+                    assert_eq!(l[k], source[k]);
+                    assert_eq!(u[k], source[k]);
+                }
+            }
+        }
+    }
+    for a in r.attempts() {
+        assert_eq!(a.evolution().identity(), r.identity());
+        assert_eq!(
+            &a.evolution().request().initial,
+            r.cells()[a.cell()].initial()
+        );
+        assert_eq!(a.evolution().request().start, r.request().evolution.start);
+        assert_eq!(a.evolution().request().end, r.request().evolution.end);
