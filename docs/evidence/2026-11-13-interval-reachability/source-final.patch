+    if let Ok(encoded) = std::env::var(KEY) {
+        let (source, request, policy): (
+            FieldDefinition,
+            ReachabilityRequest<2>,
+            ReachabilityPolicy,
+        ) = serde_json::from_str(&encoded).unwrap();
+        let mut budget = b();
