+                let negated = |sign| match sign {
+                    hyperreal::RealSign::Positive => hyperreal::RealSign::Negative,
+                    hyperreal::RealSign::Negative => hyperreal::RealSign::Positive,
+                    hyperreal::RealSign::Zero => hyperreal::RealSign::Zero,
