+    /// Split in ascending source order, evaluating each shared cut once.
+    /// The caller removes duplicate and endpoint cuts. Each restriction keeps
+    /// the original branch, chart and selected point authority, including maps.
+    pub(super) fn split_at_sorted_parameters(
+        &self,
+        cuts: &[CurveParameter2],
+        policy: &CurveContext,
+    ) -> ExactCurveResult<Vec<(CurveParameterRange2, Curve2)>> {
+        let mut pieces = Vec::with_capacity(cuts.len() + 1);
+        let mut start = self.range.start().clone();
+        let mut start_point = self.endpoints[0].clone();
+        for end in cuts
+            .iter()
+            .cloned()
+            .chain(std::iter::once(self.range.end().clone()))
+        {
+            if decided(start.cmp_by_refinement(&end, policy).map_err(invalid)?)? != Ordering::Less {
+                return Err(invalid(CurveError::InvalidCurveRange));
+            }
+            let end_point = self.point_at(&end, policy)?;
+            let range = CurveParameterRange2::new_validated(start, end.clone());
+            let mut piece = self.clone();
+            piece.range = range.clone();
+            piece.endpoints = [start_point, end_point.clone()];
+            pieces.push((range, Curve2::from_polynomial_branch(piece)));
+            start = end;
+            start_point = end_point;
+        }
+        if self.reversed {
+            pieces.reverse();
+        }
+        Ok(pieces)
+    }
