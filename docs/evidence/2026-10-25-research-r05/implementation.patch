+    #[test]
+    fn polynomial_split_rejects_invalid_cuts_and_recovers_after_exhaustion() {
+        let (_, curve) = quintic_branch();
+        for parameter in [-2, -1, 1, 2] {
+            assert!(matches!(
+                curve.split_at(Real::from(parameter).into()),
+                Err(ExactCurveError::Invalid { .. })
+            ));
+        }
+        let denied =
+            hypersolve::work_budget::with_budget(hypersolve::work_budget::WorkBudget::ZERO, || {
+                curve.split_at(Real::zero().into())
+            });
+        assert!(denied.result.is_err());
+        let (first, second) = curve.split_at(Real::zero().into()).unwrap();
+        assert!(first.end().shares_storage(&second.start()));
+        assert_eq!(
+            curve.parameter_domain().start().scalar(),
+            Some(&(-1).into())
+        );
+        assert_eq!(curve.parameter_domain().end().scalar(), Some(&1.into()));
+    }
