 pub struct ExpressionField<const N: usize> {
     data: Arc<FieldData>,
 }
+// Keep the original constructor's ownership/drop scopes while sharing the
+// validated-source assembly with affine clocks. Predicate and charge order are
+// deliberately unchanged; this is assembly, not another validation authority.
+macro_rules! assemble_field {
+    ($source:ident, $time:expr, $state:expr, $inputs:expr, $budget:ident) => {{
+        let mut bindings = Vec::new();
+        for id in &$source.definition().variables {
+            $budget.graph.charge($inputs)?;
+            bindings.push(if *id == $time {
+                Input::Time
+            } else {
+                Input::State(
+                    ($state)
+                        .iter()
+                        .position(|state| state == id)
+                        .ok_or(FieldError::UnexpectedBinding(*id))?,
+                )
+            });
+        }
+        let jacobian = $source.jacobian(&$state, &mut $budget.graph)?;
+        $budget.graph.charge(2)?;
+        let identity = FieldIdentity(Arc::new(IdentityData {
+            source: $source,
+            time: $time,
+            state: $state,
+        }));
+        let field = Self {
+            data: Arc::new(FieldData {
+                identity,
+                jacobian,
+                inputs: bindings,
+            }),
+        };
+        $budget.graph.charge(0)?;
+        Ok(field)
+    }};
+}
+
