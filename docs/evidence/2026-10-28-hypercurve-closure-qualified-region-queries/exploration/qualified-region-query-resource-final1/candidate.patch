+    for policy in [
+        PredicatePolicy::STRICT,
+        PredicatePolicy::APPROXIMATE_512,
+        PredicatePolicy::STRICT,
+    ] {
+        for distance in [0, 1, -1] {
+            let result = hypercurve::evaluate_under(policy, || {
+                qualified.offset(Real::from(distance), &OffsetCornerStyle2::Round)
+            });
