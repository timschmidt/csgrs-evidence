+        PredicatePolicy::APPROXIMATE_512,
+        PredicatePolicy::STRICT,
+    ] {
+        for matrix in [
+            [1, 0, 0, 1, 0, 0],
+            [1, 0, 0, 1, 3, -2],
+            [-1, 0, 0, 1, 0, 0],
+            [1, 2, 0, 1, 0, 0],
+        ] {
+            let [m00, m01, m10, m11, tx, ty] = matrix.map(Real::from);
+            let result = hypercurve::evaluate_under(policy, || {
+                qualified.transform_affine(&m00, &m01, &m10, &m11, &tx, &ty)
+            });
