+    if policy == PredicatePolicy::STRICT {
+        assert!(
+            matches!(outcome.as_unverified(), Err(hypercurve::ExactCurveError::Blocked(reason)) if reason.reason() == hypercurve::UncertaintyReason::Predicate),
