index 000000000..f11f78704
--- /dev/null
+++ b/crates/hyperinterval/src/rational/nonempty.rs
@@ -0,0 +1,76 @@
+//! Transport of a proved nonempty rational interval through native constructions.
+use super::{Bounds, IntervalError, PositiveRationalInterval, Rational, RationalInterval};
+
+/// A nonempty closed real interval with exact rational endpoints.
+///
+/// This refinement retains nonemptiness across constructors that establish it
+/// algebraically. It shares the general carrier's endpoint authority and does
+/// not add scalar decisions when converted back. Arithmetic retains the general
+/// rational backend's resource exclusions.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct NonEmptyRationalInterval {
+    pub(super) bounds: Bounds<Rational>,
+}
+
+impl NonEmptyRationalInterval {
+    /// Checks endpoint order without changing either exact endpoint.
+    pub fn new(lower: Rational, upper: Rational) -> Result<Self, IntervalError> {
+        Ok(Self {
+            bounds: Bounds::new(lower, upper)?,
+        })
+    }
+
+    /// Exact nonempty set `nominal ± numerator/denominator`.
+    ///
+    /// Unsigned numerator and nonzero denominator establish nonnegative radius.
+    /// No sign or order predicate is repeated on the converted radius/endpoints.
+    pub fn from_nominal_unsigned_uncertainty(
+        nominal: &Rational,
+        numerator: u64,
+        denominator: core::num::NonZeroU64,
+    ) -> Self {
+        let uncertainty = Rational::from((numerator, denominator));
+        Self::centered(nominal, &uncertainty)
+    }
+
+    // Callers establish a nonnegative uncertainty before endpoint arithmetic.
+    pub(super) fn centered(nominal: &Rational, uncertainty: &Rational) -> Self {
+        Self {
+            bounds: Bounds::ordered(nominal - uncertainty, nominal + uncertainty),
+        }
+    }
+
+    /// Borrow the exact ordered endpoints.
+    pub fn bounds(&self) -> (&Rational, &Rational) {
+        self.bounds.as_refs().endpoints()
+    }
+
+    /// Transfer both exact endpoints without cloning or revalidation.
+    pub fn into_bounds(self) -> (Rational, Rational) {
+        self.bounds.endpoints()
+    }
+
+    /// Return the same set in the general carrier, without new decisions.
+    pub fn into_interval(self) -> RationalInterval {
+        RationalInterval {
+            bounds: Some(self.bounds),
+        }
+    }
+
+    /// Refine strict positivity with one exact comparison of the lower bound.
+    ///
+    /// `None` means the lower endpoint is nonpositive. Empty input is impossible
+    /// for this carrier and needs neither an error branch nor a fresh proof.
+    pub fn into_positive(self) -> Option<PositiveRationalInterval> {
+        PositiveRationalInterval::from_bounds(self.bounds)
+    }
+}
+
+impl RationalInterval {
+    /// Preserve the existing ordered endpoints when the set is nonempty.
+    /// `None` denotes exactly the empty set; no scalar predicate is evaluated.
+    pub fn into_nonempty(self) -> Option<NonEmptyRationalInterval> {
+        self.bounds
+            .map(|bounds| NonEmptyRationalInterval { bounds })
+    }
+}
diff --git a/crates/hyperinterval/src/rational/positive.rs b/crates/hyperinterval/src/rational/positive.rs
new file mode 100644
index 000000000..1281f7518
--- /dev/null
+++ b/crates/hyperinterval/src/rational/positive.rs
@@ -0,0 +1,93 @@
+//! Retained nonempty positivity for monotone rational interval arithmetic.
+use super::{Bounds, IntervalError, Rational, RationalInterval};
+
+/// A nonempty exact rational interval whose lower endpoint is strictly positive.
+///
+/// Construction validates this refinement once. Products and quotients preserve
+/// it algebraically and do not repeat sign predicates. This is a specialization;
+/// the general [`RationalInterval`] retains its empty and signed domains.
+/// Arbitrary-precision arithmetic has the same resource exclusions as that type.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct PositiveRationalInterval {
+    bounds: Bounds<Rational>,
+}
+
+impl RationalInterval {
+    /// Refine a nonempty interval to a retained strict-positivity proof.
+    ///
+    /// Empty is [`IntervalError::EmptyDomain`]; a nonpositive lower endpoint is
+    /// [`IntervalError::NonPositiveLowerBound`]. The lower bound is compared to
+    /// exact zero once, preserving this decision separately from sign-bit tests.
+    pub fn into_positive(self) -> Result<PositiveRationalInterval, IntervalError> {
+        let bounds = self.bounds.ok_or(IntervalError::EmptyDomain)?;
+        PositiveRationalInterval::from_bounds(bounds).ok_or(IntervalError::NonPositiveLowerBound)
+    }
+}
+
+impl PositiveRationalInterval {
+    pub(super) fn from_bounds(bounds: Bounds<Rational>) -> Option<Self> {
+        if bounds.as_refs().endpoints().0 <= &Rational::zero() {
+            return None;
+        }
+        Some(Self { bounds })
+    }
+
+    /// Borrow the exact ordered endpoints of this nonempty interval.
+    pub fn bounds(&self) -> (&Rational, &Rational) {
+        self.bounds.as_refs().endpoints()
+    }
+
+    /// Transfer the exact endpoints without cloning or revalidation.
+    pub fn into_bounds(self) -> (Rational, Rational) {
+        self.bounds.endpoints()
+    }
+
+    /// Return the same set in the general interval carrier without revalidation.
+    pub fn into_interval(self) -> RationalInterval {
+        RationalInterval {
+            bounds: Some(self.bounds),
+        }
+    }
+
+    /// Exact product of a finite sequence of positive interval sets.
+    ///
+    /// Zero factors give `[1,1]`; one factor is copied. Otherwise lower products
+    /// run in input order, followed by upper products in input order. No sign
+    /// predicate or extra multiplication by one is performed. Input factors are
+    /// independently ranged; repeated references do not assert correlation.
+    pub fn product(factors: &[&Self]) -> Self {
+        let Some((first, rest)) = factors.split_first() else {
+            return Self {
+                bounds: Bounds::point(Rational::one()),
+            };
+        };
+        let Some((second, tail)) = rest.split_first() else {
+            return (*first).clone();
+        };
+        let lower = tail
+            .iter()
+            .fold(first.bounds().0 * second.bounds().0, |value, factor| {
+                value * factor.bounds().0
+            });
+        let upper = tail
+            .iter()
+            .fold(first.bounds().1 * second.bounds().1, |value, factor| {
+                value * factor.bounds().1
+            });
+        Self {
+            bounds: Bounds::ordered(lower, upper),
+        }
+    }
+
+    /// Exact quotient by a positive interval, retaining the nonempty proof.
+    ///
+    /// The divisor's positive lower endpoint excludes zero. The numerator is
+    /// consumed; lower/upper divisions run in that order with no new predicates.
+    pub fn quotient(self, divisor: &Self) -> Self {
+        let (lower, upper) = self.into_bounds();
+        let (denominator_lower, denominator_upper) = divisor.bounds();
+        Self {
+            bounds: Bounds::ordered(lower / denominator_upper, upper / denominator_lower),
+        }
+    }
+}
