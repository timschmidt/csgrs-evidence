+fn regularized_revolution_adapter<A: ScalarAdapter>() {
+    let source = curve::translated(&curve::rectangle(5, 2).unwrap(), -2, 0).unwrap();
+    let wrapped = ScalarCurve::<A>::from_native(source.clone());
