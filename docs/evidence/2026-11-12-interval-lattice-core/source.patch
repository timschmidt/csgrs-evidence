new file mode 100644
index 000000000..3d926d6c3
--- /dev/null
+++ b/crates/hyperlattice-interval/src/matrix.rs
@@ -0,0 +1,246 @@
+use crate::{IntervalArithmetic, IntervalLatticeError, IntervalVector, array_result};
+
+/// Cartesian set of row-major `R` by `C` matrices, or the canonical empty set.
+/// All entries vary independently. Empty dimensions have a singleton unit
+/// product unless the explicit empty constructor is used.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct IntervalMatrix<I: IntervalArithmetic, const R: usize, const C: usize> {
+    pub(crate) rows: Option<[[I; C]; R]>,
+}
+
+impl<I: IntervalArithmetic, const R: usize, const C: usize> IntervalMatrix<I, R, C> {
+    /// Constructs from row-major scalar intervals; singleton entries lift a point
+    /// matrix. Any empty entry canonicalizes the whole matrix set to empty.
+    pub fn new(rows: [[I; C]; R]) -> Result<Self, IntervalLatticeError> {
+        I::validate_family()?;
+        Ok(Self {
+            rows: if rows.iter().flatten().any(I::is_empty) {
+                None
+            } else {
+                Some(rows)
+            },
+        })
+    }
+
+    /// Constructs the empty set after validating the scalar family.
+    pub fn empty() -> Result<Self, IntervalLatticeError> {
+        I::validate_family()?;
+        Ok(Self { rows: None })
+    }
+
+    /// Whether the matrix set is empty.
+    pub const fn is_empty(&self) -> bool {
+        self.rows.is_none()
+    }
+
+    /// Whether exactly one matrix is represented, including empty dimensions.
+    pub fn is_singleton(&self) -> bool {
+        self.rows
+            .as_ref()
+            .is_some_and(|rows| rows.iter().flatten().all(I::is_singleton))
+    }
+
+    /// Borrowed row-major entries, or `None` for empty. No scalar copies occur.
+    pub const fn rows(&self) -> Option<&[[I; C]; R]> {
+        self.rows.as_ref()
+    }
+
+    /// Transfers owned entries without copying scalar data.
+    pub fn into_rows(self) -> Option<[[I; C]; R]> {
+        self.rows
+    }
+
+    /// Smallest Cartesian matrix box containing both inputs.
+    pub fn hull(
+        &self,
+        other: &Self,
+        context: &mut I::Context,
+    ) -> Result<Self, IntervalLatticeError> {
+        match (&self.rows, &other.rows) {
+            (None, None) => Self::empty(),
+            (Some(rows), None) | (None, Some(rows)) => Self::new(array_result(|r| {
+                array_result(|c| rows[r][c].copy(context))
+            })?),
+            (Some(a), Some(b)) => Self::new(array_result(|r| {
+                array_result(|c| a[r][c].hull(&b[r][c], context))
+            })?),
+        }
+    }
+
+    /// Exact Cartesian intersection, canonicalizing empty entries.
+    pub fn intersection(
+        &self,
+        other: &Self,
+        context: &mut I::Context,
+    ) -> Result<Self, IntervalLatticeError> {
+        self.zip(other, context, I::intersection)
+    }
+
+    /// Set inclusion. The empty set is included in every matrix set.
+    pub fn subset_of(
+        &self,
+        other: &Self,
+        context: &mut I::Context,
+    ) -> Result<bool, IntervalLatticeError> {
+        self.relation(other, context, I::subset_of)
+    }
+
+    /// Inclusion in the other's real interior (unit products are open).
+    pub fn interior_subset_of(
+        &self,
+        other: &Self,
+        context: &mut I::Context,
+    ) -> Result<bool, IntervalLatticeError> {
+        self.relation(other, context, I::interior_subset_of)
+    }
+
+    /// Entrywise sum enclosure.
+    pub fn add(
+        &self,
+        other: &Self,
+        context: &mut I::Context,
+    ) -> Result<Self, IntervalLatticeError> {
+        self.zip(other, context, I::add)
+    }
+
+    /// Entrywise difference enclosure, treating inputs independently.
+    pub fn sub(
+        &self,
+        other: &Self,
+        context: &mut I::Context,
+    ) -> Result<Self, IntervalLatticeError> {
+        self.zip(other, context, I::sub)
+    }
+
+    /// Matrix-vector product enclosure. Singleton coefficients or lanes support
+    /// point-matrix or point-vector products without a separate arithmetic path.
+    /// Rows are evaluated in order, each dot product from column zero upward.
+    pub fn mul_vector(
+        &self,
+        vector: &IntervalVector<I, C>,
+        context: &mut I::Context,
+    ) -> Result<IntervalVector<I, R>, IntervalLatticeError> {
+        match (&self.rows, vector.lanes()) {
+            (Some(a), Some(b)) => {
+                IntervalVector::new(array_result(|r| crate::dot(a[r].iter().zip(b), context))?)
+            }
+            _ => IntervalVector::empty(),
+        }
+    }
+
+    /// Matrix product enclosure. Entries are evaluated in row-major order and
+    /// each dot product in increasing shared index. No budget is reset per row.
+    pub fn mul_matrix<const K: usize>(
+        &self,
+        other: &IntervalMatrix<I, C, K>,
+        context: &mut I::Context,
+    ) -> Result<IntervalMatrix<I, R, K>, IntervalLatticeError> {
+        match (&self.rows, &other.rows) {
+            (Some(a), Some(b)) => IntervalMatrix::new(array_result(|r| {
+                array_result(|k| crate::dot((0..C).map(|c| (&a[r][c], &b[c][k])), context))
+            })?),
+            _ => IntervalMatrix::empty(),
+        }
+    }
+
+    /// Encloses `A*x+b`, with independent matrix, vector and translation sets.
+    /// Correlation between output coordinates is not retained. This does not
+    /// construct the exact correlated affine image of a box.
+    pub fn affine_enclosure(
+        &self,
+        vector: &IntervalVector<I, C>,
+        translation: &IntervalVector<I, R>,
+        context: &mut I::Context,
+    ) -> Result<IntervalVector<I, R>, IntervalLatticeError> {
+        // Empty translation makes the entire source domain empty; do not perform
+        // arithmetic that has no image (and could overflow).
+        if translation.is_empty() {
+            return IntervalVector::empty();
+        }
+        self.mul_vector(vector, context)?.add(translation, context)
+    }
+
+    /// Transposes with backend accounting for owned entry copies.
+    pub fn transpose(
+        &self,
+        context: &mut I::Context,
+    ) -> Result<IntervalMatrix<I, C, R>, IntervalLatticeError> {
+        match &self.rows {
+            Some(rows) => IntervalMatrix::new(array_result(|c| {
+                array_result(|r| rows[r][c].copy(context))
+            })?),
+            None => IntervalMatrix::empty(),
+        }
+    }
+
+    /// Projects a row, copying with backend accounting. Invalid indices are
+    /// rejected even for empty input; projecting an empty set remains empty.
+    pub fn row(
+        &self,
+        index: usize,
+        context: &mut I::Context,
+    ) -> Result<IntervalVector<I, C>, IntervalLatticeError> {
+        if index >= R {
+            return Err(IntervalLatticeError::IndexOutOfBounds {
+                index,
+                dimension: R,
+            });
+        }
+        match &self.rows {
+            Some(rows) => IntervalVector::new(array_result(|c| rows[index][c].copy(context))?),
+            None => IntervalVector::empty(),
+        }
+    }
+
+    /// Projects a column with backend accounting and checked index.
+    pub fn column(
+        &self,
+        index: usize,
+        context: &mut I::Context,
+    ) -> Result<IntervalVector<I, R>, IntervalLatticeError> {
+        if index >= C {
+            return Err(IntervalLatticeError::IndexOutOfBounds {
+                index,
+                dimension: C,
+            });
+        }
+        match &self.rows {
+            Some(rows) => IntervalVector::new(array_result(|r| rows[r][index].copy(context))?),
+            None => IntervalVector::empty(),
+        }
+    }
+
+    fn zip(
+        &self,
+        other: &Self,
+        context: &mut I::Context,
+        mut op: impl FnMut(&I, &I, &mut I::Context) -> Result<I, hyperinterval::IntervalError>,
+    ) -> Result<Self, IntervalLatticeError> {
+        match (&self.rows, &other.rows) {
+            (Some(a), Some(b)) => Self::new(array_result(|r| {
+                array_result(|c| op(&a[r][c], &b[r][c], context))
+            })?),
+            _ => Self::empty(),
+        }
+    }
+
+    fn relation(
+        &self,
+        other: &Self,
+        context: &mut I::Context,
+        mut op: impl FnMut(&I, &I, &mut I::Context) -> Result<bool, hyperinterval::IntervalError>,
+    ) -> Result<bool, IntervalLatticeError> {
+        match (&self.rows, &other.rows) {
+            (None, _) => Ok(true),
+            (Some(_), None) => Ok(false),
+            (Some(a), Some(b)) => {
+                for (a, b) in a.iter().flatten().zip(b.iter().flatten()) {
+                    if !op(a, b, context)? {
+                        return Ok(false);
+                    }
+                }
+                Ok(true)
+            }
+        }
+    }
+}
diff --git a/crates/hyperlattice-interval/src/serde.rs b/crates/hyperlattice-interval/src/serde.rs
new file mode 100644
index 000000000..9bd72f2b3
--- /dev/null
+++ b/crates/hyperlattice-interval/src/serde.rs
@@ -0,0 +1,90 @@
+use crate::{IntervalArithmetic, IntervalMatrix, IntervalVector, array_result};
+use ::serde::{Deserialize, Deserializer, Serialize, Serializer, de, ser::SerializeTuple};
+
+// Serde's built-in arrays do not cover arbitrary const dimensions. This single
+// visitor preserves exact lengths without a Vec or a 32-lane restriction.
+struct Array<T, const N: usize>([T; N]);
+struct ArrayRef<'a, T, const N: usize>(&'a [T; N]);
+
+impl<T: Serialize, const N: usize> Serialize for ArrayRef<'_, T, N> {
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        let mut tuple = serializer.serialize_tuple(N)?;
+        for item in self.0 {
+            tuple.serialize_element(item)?;
+        }
+        tuple.end()
+    }
+}
+
+impl<'de, T: Deserialize<'de>, const N: usize> Deserialize<'de> for Array<T, N> {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct Visitor<T, const N: usize>(core::marker::PhantomData<T>);
+        impl<'de, T: Deserialize<'de>, const N: usize> de::Visitor<'de> for Visitor<T, N> {
+            type Value = Array<T, N>;
+            fn expecting(&self, formatter: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+                write!(formatter, "exactly {N} elements")
+            }
+            fn visit_seq<A: de::SeqAccess<'de>>(
+                self,
+                mut sequence: A,
+            ) -> Result<Self::Value, A::Error> {
+                let values = array_result(|index| {
+                    sequence
+                        .next_element()?
+                        .ok_or_else(|| de::Error::invalid_length(index, &self))
+                })?;
+                if sequence.next_element::<de::IgnoredAny>()?.is_some() {
+                    return Err(de::Error::invalid_length(N.saturating_add(1), &self));
+                }
+                Ok(Array(values))
+            }
+        }
+        deserializer.deserialize_tuple(N, Visitor(core::marker::PhantomData))
+    }
+}
+
+impl<I: IntervalArithmetic + Serialize, const N: usize> Serialize for IntervalVector<I, N> {
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        self.lanes.as_ref().map(ArrayRef).serialize(serializer)
+    }
+}
+
+impl<'de, I: IntervalArithmetic + Deserialize<'de>, const N: usize> Deserialize<'de>
+    for IntervalVector<I, N>
+{
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let values = Option::<Array<I, N>>::deserialize(deserializer)?;
+        match values {
+            None => Self::empty(),
+            Some(values) => Self::new(values.0),
+        }
+        .map_err(de::Error::custom)
+    }
+}
+
+impl<I: IntervalArithmetic + Serialize, const R: usize, const C: usize> Serialize
+    for IntervalMatrix<I, R, C>
+{
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        match &self.rows {
+            None => serializer.serialize_none(),
+            Some(rows) => {
+                let refs: [_; R] = core::array::from_fn(|r| ArrayRef(&rows[r]));
+                serializer.serialize_some(&ArrayRef(&refs))
+            }
+        }
+    }
+}
+
+impl<'de, I: IntervalArithmetic + Deserialize<'de>, const R: usize, const C: usize> Deserialize<'de>
+    for IntervalMatrix<I, R, C>
+{
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let values = Option::<Array<Array<I, C>, R>>::deserialize(deserializer)?;
+        match values {
+            None => Self::empty(),
+            Some(values) => Self::new(values.0.map(|row| row.0)),
+        }
+        .map_err(de::Error::custom)
+    }
+}
diff --git a/crates/hyperlattice-interval/src/vector.rs b/crates/hyperlattice-interval/src/vector.rs
new file mode 100644
index 000000000..314705892
--- /dev/null
+++ b/crates/hyperlattice-interval/src/vector.rs
@@ -0,0 +1,157 @@
+use crate::{IntervalArithmetic, IntervalLatticeError, array_result};
+
+/// A Cartesian product of `N` finite real intervals, or the canonical empty set.
+///
+/// Any empty lane makes the whole product empty. With zero lanes, `new([])` is
+/// the singleton unit product, distinct from `empty()`. Coordinates are private
+/// and immutable; deserialization validates scalar values and canonicalizes.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct IntervalVector<I: IntervalArithmetic, const N: usize> {
+    pub(crate) lanes: Option<[I; N]>,
+}
+
+impl<I: IntervalArithmetic, const N: usize> IntervalVector<I, N> {
+    /// Constructs a product from validated scalar intervals (singletons lift points).
+    /// Type-level constraints are checked even when `N == 0`.
+    pub fn new(lanes: [I; N]) -> Result<Self, IntervalLatticeError> {
+        I::validate_family()?;
+        Ok(Self {
+            lanes: if lanes.iter().any(I::is_empty) {
+                None
+            } else {
+                Some(lanes)
+            },
+        })
+    }
+
+    /// Constructs the empty set after validating the scalar family.
+    pub fn empty() -> Result<Self, IntervalLatticeError> {
+        I::validate_family()?;
+        Ok(Self { lanes: None })
+    }
+
+    /// Whether the represented Cartesian set is empty.
+    pub const fn is_empty(&self) -> bool {
+        self.lanes.is_none()
+    }
+
+    /// Whether the Cartesian set contains exactly one vector (including `()`).
+    pub fn is_singleton(&self) -> bool {
+        self.lanes
+            .as_ref()
+            .is_some_and(|lanes| lanes.iter().all(I::is_singleton))
+    }
+
+    /// Borrowed lanes, or `None` for the canonical empty set.
+    pub const fn lanes(&self) -> Option<&[I; N]> {
+        self.lanes.as_ref()
+    }
+
+    /// Transfers owned lanes without copying scalar data.
+    pub fn into_lanes(self) -> Option<[I; N]> {
+        self.lanes
+    }
+
+    /// Smallest Cartesian box containing both inputs; not their general union.
+    pub fn hull(
+        &self,
+        other: &Self,
+        context: &mut I::Context,
+    ) -> Result<Self, IntervalLatticeError> {
+        match (&self.lanes, &other.lanes) {
+            (None, None) => Self::empty(),
+            (Some(lanes), None) | (None, Some(lanes)) => {
+                Self::new(array_result(|i| lanes[i].copy(context))?)
+            }
+            (Some(a), Some(b)) => Self::new(array_result(|i| a[i].hull(&b[i], context))?),
+        }
+    }
+
+    /// Exact Cartesian intersection, canonicalizing any empty component.
+    pub fn intersection(
+        &self,
+        other: &Self,
+        context: &mut I::Context,
+    ) -> Result<Self, IntervalLatticeError> {
+        self.zip(other, context, I::intersection)
+    }
+
+    /// Whether this set is included in the other set. Empty is always included.
+    pub fn subset_of(
+        &self,
+        other: &Self,
+        context: &mut I::Context,
+    ) -> Result<bool, IntervalLatticeError> {
+        self.relation(other, context, I::subset_of)
+    }
+
+    /// Inclusion in the other's real interior. In dimension zero the unit
+    /// product is open; in positive dimensions every lane needs strict inclusion.
+    pub fn interior_subset_of(
+        &self,
+        other: &Self,
+        context: &mut I::Context,
+    ) -> Result<bool, IntervalLatticeError> {
+        self.relation(other, context, I::interior_subset_of)
+    }
+
+    /// Coordinate sum enclosure. Empty operands have empty images.
+    pub fn add(
+        &self,
+        other: &Self,
+        context: &mut I::Context,
+    ) -> Result<Self, IntervalLatticeError> {
+        self.zip(other, context, I::add)
+    }
+
+    /// Coordinate difference enclosure, treating the two inputs independently.
+    pub fn sub(
+        &self,
+        other: &Self,
+        context: &mut I::Context,
+    ) -> Result<Self, IntervalLatticeError> {
+        self.zip(other, context, I::sub)
+    }
+
+    /// Dot-product enclosure with left-to-right multiplication then addition.
+    /// The same caller budget is used for every scalar operation. The empty
+    /// Cartesian set has empty image; a zero-dimensional unit dot product is zero.
+    pub fn dot(&self, other: &Self, context: &mut I::Context) -> Result<I, IntervalLatticeError> {
+        match (&self.lanes, &other.lanes) {
+            (Some(a), Some(b)) => Ok(crate::dot(a.iter().zip(b), context)?),
+            _ => Ok(I::empty()?),
+        }
+    }
+
+    fn zip(
+        &self,
+        other: &Self,
+        context: &mut I::Context,
+        mut op: impl FnMut(&I, &I, &mut I::Context) -> Result<I, hyperinterval::IntervalError>,
+    ) -> Result<Self, IntervalLatticeError> {
+        match (&self.lanes, &other.lanes) {
+            (Some(a), Some(b)) => Self::new(array_result(|i| op(&a[i], &b[i], context))?),
+            _ => Self::empty(),
+        }
+    }
+
+    fn relation(
+        &self,
+        other: &Self,
+        context: &mut I::Context,
+        mut op: impl FnMut(&I, &I, &mut I::Context) -> Result<bool, hyperinterval::IntervalError>,
+    ) -> Result<bool, IntervalLatticeError> {
+        match (&self.lanes, &other.lanes) {
+            (None, _) => Ok(true),
+            (Some(_), None) => Ok(false),
+            (Some(a), Some(b)) => {
+                for (a, b) in a.iter().zip(b) {
+                    if !op(a, b, context)? {
+                        return Ok(false);
+                    }
+                }
+                Ok(true)
+            }
+        }
+    }
+}
diff --git a/crates/hyperlattice-interval/tests/cartesian.rs b/crates/hyperlattice-interval/tests/cartesian.rs
new file mode 100644
index 000000000..4abc0e1d1
--- /dev/null
+++ b/crates/hyperlattice-interval/tests/cartesian.rs
@@ -0,0 +1,417 @@
+#![cfg(any(
+    feature = "fixed",
+    feature = "rational",
+    feature = "dyadic",
+    feature = "float-enclosure"
+))]
+use hyperlattice_interval::{IntervalArithmetic, IntervalMatrix, IntervalVector};
+
+// Independent endpoint oracle: enumerate every corner of the two independent
+// input boxes using exact i64 arithmetic, without calling any interval kernel.
+fn dot_bounds(a: &[(i32, i32)], b: &[(i32, i32)]) -> (i32, i32) {
+    let mut result = (i64::MAX, i64::MIN);
+    for mask in 0..(1_usize << (2 * a.len())) {
+        let mut sum = 0_i64;
+        for i in 0..a.len() {
+            let x = if mask & (1 << i) == 0 { a[i].0 } else { a[i].1 };
+            let y = if mask & (1 << (a.len() + i)) == 0 {
+                b[i].0
+            } else {
+                b[i].1
+            };
+            sum += i64::from(x) * i64::from(y);
+        }
+        result = (result.0.min(sum), result.1.max(sum));
+    }
+    (result.0.try_into().unwrap(), result.1.try_into().unwrap())
+}
+
+fn exact_products<I: IntervalArithmetic + core::fmt::Debug + PartialEq>(
+    scalar: impl Fn(i32, i32) -> I,
+    mut context: impl FnMut() -> I::Context,
+) {
+    let inner = IntervalVector::new([scalar(-1, 1), scalar(2, 3)]).unwrap();
+    let outer = IntervalVector::new([scalar(-2, 2), scalar(1, 4)]).unwrap();
+    assert!(inner.interior_subset_of(&outer, &mut context()).unwrap());
+    assert!(!outer.subset_of(&inner, &mut context()).unwrap());
+    assert_eq!(inner.intersection(&outer, &mut context()).unwrap(), inner);
+    assert_eq!(inner.hull(&outer, &mut context()).unwrap(), outer);
+    let difference = outer.sub(&inner, &mut context()).unwrap();
+    assert_eq!(difference.lanes(), Some(&[scalar(-3, 3), scalar(-2, 2)]));
+    let m = IntervalMatrix::new([inner.into_lanes().unwrap()]).unwrap();
+    let n = IntervalMatrix::new([outer.into_lanes().unwrap()]).unwrap();
+    assert!(m.subset_of(&n, &mut context()).unwrap());
+    assert!(m.interior_subset_of(&n, &mut context()).unwrap());
+    assert!(!n.subset_of(&m, &mut context()).unwrap());
+    assert_eq!(m.hull(&n, &mut context()).unwrap(), n);
+    assert_eq!(m.intersection(&n, &mut context()).unwrap(), m);
+    assert_eq!(
+        n.sub(&m, &mut context()).unwrap().into_rows(),
+        Some([difference.into_lanes().unwrap()])
+    );
+    let unit = IntervalMatrix::<I, 0, 2>::new([]).unwrap();
+    assert!(unit.interior_subset_of(&unit, &mut context()).unwrap());
+    assert_eq!(unit.into_rows(), Some([]));
+    let ranges = [(-1, -1), (-1, 0), (-1, 1), (0, 0), (0, 1), (1, 1)];
+    // Exhaust every two-lane dot product over this finite endpoint domain.
+    for a0 in ranges {
+        for a1 in ranges {
+            for b0 in ranges {
+                for b1 in ranges {
+                    let a = IntervalVector::new([scalar(a0.0, a0.1), scalar(a1.0, a1.1)]).unwrap();
+                    let b = IntervalVector::new([scalar(b0.0, b0.1), scalar(b1.0, b1.1)]).unwrap();
+                    let expected = dot_bounds(&[a0, a1], &[b0, b1]);
+                    assert_eq!(
+                        a.dot(&b, &mut context()).unwrap(),
+                        scalar(expected.0, expected.1)
+                    );
+                    let left = IntervalMatrix::new([
+                        a.clone().into_lanes().unwrap(),
+                        b.clone().into_lanes().unwrap(),
+                    ])
+                    .unwrap();
+                    let right = IntervalMatrix::new([
+                        [scalar(b0.0, b0.1), scalar(a0.0, a0.1)],
+                        [scalar(b1.0, b1.1), scalar(a1.0, a1.1)],
+                    ])
+                    .unwrap();
+                    let left_bounds = [[a0, a1], [b0, b1]];
+                    let columns = [[b0, b1], [a0, a1]];
+                    let expected_matrix = core::array::from_fn(|r| {
+                        core::array::from_fn(|c| {
+                            let bounds = dot_bounds(&left_bounds[r], &columns[c]);
+                            scalar(bounds.0, bounds.1)
+                        })
+                    });
+                    assert_eq!(
+                        left.mul_matrix(&right, &mut context()).unwrap().rows(),
+                        Some(&expected_matrix)
+                    );
+                    let row = IntervalMatrix::new([a.into_lanes().unwrap()]).unwrap();
+                    let column = IntervalMatrix::new(b.into_lanes().unwrap().map(|x| [x])).unwrap();
+                    let product = row.mul_matrix(&column, &mut context()).unwrap();
+                    assert_eq!(
+                        product.rows().unwrap()[0][0],
+                        scalar(expected.0, expected.1)
+                    );
+                }
+            }
+        }
+    }
+    // Every 2x2 point matrix and every 2D input box on the same endpoint grid.
+    for a in -1..=1 {
+        for b in -1..=1 {
+            for c in -1..=1 {
+                for d in -1..=1 {
+                    let matrix = IntervalMatrix::new([
+                        [scalar(a, a), scalar(b, b)],
+                        [scalar(c, c), scalar(d, d)],
+                    ])
+                    .unwrap();
+                    for x in ranges {
+                        for y in ranges {
+                            let vector =
+                                IntervalVector::new([scalar(x.0, x.1), scalar(y.0, y.1)]).unwrap();
+                            let shift =
+                                IntervalVector::new([scalar(2, 2), scalar(-3, -3)]).unwrap();
+                            let output = matrix
+                                .affine_enclosure(&vector, &shift, &mut context())
+                                .unwrap();
+                            let e0 = dot_bounds(&[(a, a), (b, b)], &[x, y]);
+                            let e1 = dot_bounds(&[(c, c), (d, d)], &[x, y]);
+                            assert_eq!(
+                                output.lanes().unwrap(),
+                                &[scalar(e0.0 + 2, e0.1 + 2), scalar(e1.0 - 3, e1.1 - 3)]
+                            );
+                            let restored = matrix
+                                .transpose(&mut context())
+                                .unwrap()
+                                .transpose(&mut context())
+                                .unwrap();
+                            assert_eq!(restored, matrix);
+                            // Consume generated output in another product, with independently
+                            // computed expectations for its declared Cartesian enclosure.
+                            let next = matrix.mul_vector(&output, &mut context()).unwrap();
+                            let input = [(e0.0 + 2, e0.1 + 2), (e1.0 - 3, e1.1 - 3)];
+                            let n0 = dot_bounds(&[(a, a), (b, b)], &input);
+                            let n1 = dot_bounds(&[(c, c), (d, d)], &input);
+                            assert_eq!(
+                                next.lanes().unwrap(),
+                                &[scalar(n0.0, n0.1), scalar(n1.0, n1.1)]
+                            );
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
