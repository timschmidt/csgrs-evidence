+    env:
+      LATTICE_RUST: ${{ matrix.rust }}
+      LATTICE_FEATURES: ${{ matrix.rust == '1.88.0' && 'fixed,dyadic,float-enclosure,serde' || 'fixed,dyadic,rational,float-enclosure,serde' }}
+    defaults:
