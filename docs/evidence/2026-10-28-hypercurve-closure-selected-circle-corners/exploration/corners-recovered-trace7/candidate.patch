+                            .coincides_with(contact.point())
+                            .unwrap()
+                    );
+                    assert!(
+                        chord
+                            .point_at(&contact.second().parameter().unwrap())
+                            .unwrap()
+                            .coincides_with(contact.point())
+                            .unwrap()
+                    );
+                }
+            }
+        }
+    }
