+        let zero = Real::zero();
+        let order = crate::bezier_offset::point_affine_form_order_to_real(
+            &qualified,
+            &zero,
+            &zero,
+            &zero,
+            &CurveContext::STRICT,
+        )
+        .unwrap();
+        assert!(matches!(
+            order,
+            Classification::Uncertain(UncertaintyReason::Unsupported)
+        ));
+    }
