+        let fragment = carrier.geometry.restrict_certified(
+            CurveParameterRange2::new_validated(pair[0].parameter.clone(), pair[1].parameter.clone()),
+            Some([point(&pair[0])?, point(&pair[1])?]),
+            carrier.reversed,
+            policy,
+        ).map_err(invalid)?;
+        let (start_topology_vertex, end_topology_vertex) = if carrier.reversed {
+            (pair[1].topology_vertex, pair[0].topology_vertex)
+        } else {
+            (pair[0].topology_vertex, pair[1].topology_vertex)
+        };
+        output.push(SplitCarrierFragment { fragment, start_topology_vertex, end_topology_vertex });
+    }
+    if carrier.reversed { output.reverse(); }
