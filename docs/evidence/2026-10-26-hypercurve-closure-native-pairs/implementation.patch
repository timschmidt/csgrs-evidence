+            materialized(line_curve(origin, Point2::new(q(1, 2), Real::zero()))),
+        ],
+        true,
+    );
+    let parameter = BezierParameter2::Algebraic(
+        BezierAlgebraicParameter2::try_isolate(
+            crate::BezierParameterPolynomial::try_new_power_basis(vec![
