+    );
+    // Without a limit, observations are free.
+    assert!(observe_coefficient_bits(u64::MAX).is_ok());
+    assert!(
+        with_budget(WorkBudget::ZERO, || observe_coefficient_bits(u64::MAX))
+            .result
+            .unwrap()
+            .is_ok()
+    );
