+#[cfg(test)]
+mod computable_access_tests {
+    use super::*;
+
+    #[test]
+    fn shared_access_borrows_retained_payload_and_reconstructs_only_missing_payload() {
+        let mut value = Real::pi();
+        let retained = value.computable.as_ref().unwrap();
+        assert!(std::ptr::eq(value.computable_ref(), retained));
+        assert!(value.primitive_approx_cache.cached_computable().is_none());
+
+        value.computable = None;
+        let reconstructed = value.computable_ref();
+        assert!(std::ptr::eq(value.computable_ref(), reconstructed));
+        assert!(value.computable.is_none());
+        assert_eq!(
+            value.certified_sign_until(0).sign(),
+            Some(RealSign::Positive)
+        );
+        assert!(value.computable.is_none());
+    }
+
+    #[test]
+    fn concurrent_lazy_queries_share_one_reconstructed_payload() {
+        let mut value = Real::pi() - Real::from(3);
+        value.computable = None;
+        let barrier = std::sync::Barrier::new(8);
+        std::thread::scope(|scope| {
+            let handles: Vec<_> = (0..8)
+                .map(|_| {
+                    let value = &value;
+                    let barrier = &barrier;
+                    scope.spawn(move || {
+                        barrier.wait();
+                        let payload = value.computable_ref();
+                        assert_eq!(payload.sign_until(-128), Some(RealSign::Positive));
+                        payload as *const Computable as usize
+                    })
+                })
+                .collect();
+            let expected = value.computable_ref() as *const Computable as usize;
+            for handle in handles {
+                assert_eq!(handle.join().unwrap(), expected);
+            }
+        });
+        assert!(value.computable.is_none());
+        let clone = value.clone();
+        assert!(clone.computable.is_none());
+        assert_eq!(
+            clone.computable_ref().immediate_sign(),
+            Some(RealSign::Positive)
+        );
+    }
+}
