+    let mut invalid = definition.clone();
+    invalid.outputs = vec![4, 1];
+    let program = ExpressionProgram::from_definition(invalid, &mut budget()).unwrap();
+    assert!(matches!(
+        program.eval_real(&[], &mut budget()),
+        Err(ExpressionError::Scalar { node: 3, .. })
