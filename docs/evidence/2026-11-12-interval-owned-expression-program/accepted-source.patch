+            // Node-index order would fail at sqrt; demand order must fail at Div.
+            ExpressionNode::Binary {
+                operation: BinaryOperation::Add,
+                left: 3,
+                right: 1,
+            },
+            ExpressionNode::Binary {
+                operation: BinaryOperation::Add,
+                left: 0,
+                right: 0,
