+impl<const N: usize> AdaptiveTaylorField<N> {
+    /// Exact original field and its ordered time/state interpretation.
+    pub fn field(&self) -> &ExpressionField<N> {
+        &self.field
+    }
+    /// Original finite order/step/quality configuration.
