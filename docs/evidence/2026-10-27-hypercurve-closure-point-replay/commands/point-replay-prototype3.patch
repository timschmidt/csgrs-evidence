+    fn selected_parallel_chord_projection_is_stable_after_exact_queries() {
+        use crate::{
+            BezierAlgebraicParameter2, BezierParameterInterval, BezierParameterPolynomial,
+            BezierParameterRange2, CurvePointLocations2,
+        };
