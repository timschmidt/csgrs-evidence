+    let (Some(view), Some((inverse, _))) = (own.affine_view(), other.inverse_affine_view()) else {
+        return Ok(None);
+    };
+    // T_other^-1 after T_own, in the `[a, b, d, e, x, y]` affine convention.
+    let [a1, b1, d1, e1, x1, y1] = &view;
+    let [a2, b2, d2, e2, x2, y2] = &inverse;
+    let composed = [
+        a2 * a1 + b2 * d1,
+        a2 * b1 + b2 * e1,
+        d2 * a1 + e2 * d1,
+        d2 * b1 + e2 * e1,
+        a2 * x1 + b2 * y1 + x2,
+        d2 * x1 + e2 * y1 + y2,
+    ];
