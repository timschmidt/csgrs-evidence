+++ b/crates/hyperbrep/src/topology/tests.rs
@@ -67,0 +68,16 @@
+}
+
+#[test]
+fn face_contours_retry_after_a_work_limited_attempt() {
+    use hypersolve::work_budget::{WorkBudget, WorkKind, consume, with_budget};
+
+    let (model, _) = crate::construction::cuboid(p(0, 0, 0), p(2, 2, 2)).unwrap();
+    let face = model.faces().next().unwrap().0;
+    let mut blocked = None;
+    let attempt = with_budget(WorkBudget::ZERO, || {
+        assert!(consume(WorkKind::RootRefinement, 1).is_err());
+        blocked = Some(model.face_contours(face).map(|contours| contours.len()));
+    });
+    assert!(attempt.result.is_err());
+    assert!(blocked.unwrap().is_err());
+    assert_eq!(model.face_contours(face).unwrap().len(), 1);
