diff --git a/crates/hypercurve/src/polynomial_curve_mapped_chord.rs b/crates/hypercurve/src/polynomial_curve_mapped_chord.rs
new file mode 100644
index 0000000000..b8c54e1872
--- /dev/null
+++ b/crates/hypercurve/src/polynomial_curve_mapped_chord.rs
@@ -0,0 +1,263 @@
+//! Selected line coefficients pull back through retained rational image maps.
+
+use super::selected_chord::{coordinates, form};
+use super::*;
+use crate::{BezierAlgebraicChord2, CurvePointRationalForm2};
+use hypersolve::BivariatePolynomial;
+use hypersolve::bivariate_arithmetic::{
+    bivariate_multiply, bivariate_parameter_derivative as derivative,
+};
+use hypersolve::ordered_field_resultant::{
+    OrderedFieldResultantConfig, OrderedFieldResultantError, resultant_bivariate_ordered_field,
+};
+
+type Form = CurvePointRationalForm2;
+
+struct Coefficients<'a> {
+    origin: &'a CurvePoint2,
+}
+impl hypersolve::OrderedFieldPolynomialContext<Form> for Coefficients<'_> {
+    type Error = ExactCurveError;
+    fn constant(&mut self, value: &Real) -> ExactCurveResult<Form> {
+        form(
+            self.origin,
+            BivariatePolynomial::new(vec![vec![value.clone()]]),
+        )
+    }
+    fn add(&mut self, a: &Form, b: &Form) -> ExactCurveResult<Form> {
+        a.add(b)
+    }
+    fn multiply(&mut self, a: &Form, b: &Form) -> ExactCurveResult<Form> {
+        a.multiply(b)
+    }
+    fn scale(&mut self, value: &Form, scale: &Real) -> ExactCurveResult<Form> {
+        value.scaled(scale)
+    }
+    fn sign(&mut self, value: &Form) -> ExactCurveResult<Ordering> {
+        value.compare_to_real(&Real::zero())
+    }
+    fn sign_if_separated(&mut self, value: &Form) -> ExactCurveResult<Option<Ordering>> {
+        self.sign(value).map(Some)
+    }
+    fn normalize_positive_scale(&mut self, _: &mut [Form]) {}
+}
+
+/// Linear combination of three retained real-coefficient source polynomials.
+/// The coefficients retain the original endpoint fields and pole guards.
+fn combination(
+    polynomials: [&BivariatePolynomial; 3],
+    coefficients: &[Form; 3],
+) -> ExactCurveResult<Vec<Vec<Form>>> {
+    let rows = polynomials
+        .iter()
+        .map(|p| p.coefficients.len())
+        .max()
+        .unwrap_or(0);
+    (0..rows)
+        .map(|i| {
+            let columns = polynomials
+                .iter()
+                .filter_map(|p| p.coefficients.get(i))
+                .map(Vec::len)
+                .max()
+                .unwrap_or(0);
+            (0..columns)
+                .map(|j| {
+                    let term = |index: usize| {
+                        coefficients[index].scaled(
+                            polynomials[index]
+                                .coefficients
+                                .get(i)
+                                .and_then(|row| row.get(j))
+                                .unwrap_or(&Real::zero()),
+                        )
+                    };
+                    term(0)?.add(&term(1)?)?.add(&term(2)?)
+                })
+                .collect()
+        })
+        .collect()
+}
+
+fn evaluate(
+    point: &CurvePoint2,
+    polynomials: [&BivariatePolynomial; 3],
+    coefficients: &[Form; 3],
+) -> ExactCurveResult<Form> {
+    let term = |i: usize| form(point, polynomials[i].clone())?.multiply(&coefficients[i]);
+    term(0)?.add(&term(1)?)?.add(&term(2)?)
+}
+
+impl PolynomialCurveBranch2 {
+    /// Complete isolated contacts with a selected chord, through the original
+    /// source branch. A zero resultant needs component correspondences and
+    /// remains unsupported. The local elimination budget counts coefficient
+    /// calls and matrix entries; it is not a total arithmetic or memory bound.
+    pub(crate) fn mapped_selected_chord_sections(
+        &self,
+        chord: &BezierAlgebraicChord2,
+        policy: &CurveContext,
+    ) -> ExactCurveResult<Vec<PolynomialLineSection2>> {
+        chord.validate_policy(policy).map_err(invalid)?;
+        let [ax, ay] = coordinates(chord.start())?;
+        let [bx, by] = coordinates(chord.end())?;
+        let dx = bx.subtract(&ax)?;
+        let dy = by.subtract(&ay)?;
+        // L(X,Y) = dy*X - dx*Y + dx*ay - dy*ax.
+        let coefficients = [
+            dy.clone(),
+            dx.scaled(&Real::from(-1))?,
+            dx.multiply(&ay)?.subtract(&dy.multiply(&ax)?)?,
+        ];
+        let (nx, wx) = self
+            .coordinate_form(0)
+            .ok_or_else(|| blocked(UncertaintyReason::Unsupported))?;
+        let (ny, wy) = self
+            .coordinate_form(1)
+            .ok_or_else(|| blocked(UncertaintyReason::Unsupported))?;
+        let [x, y, w] = if wx == wy {
+            [nx, ny, wx]
+        } else {
+            [
+                bivariate_multiply(&nx, &wy),
+                bivariate_multiply(&ny, &wx),
+                bivariate_multiply(&wx, &wy),
+            ]
+        };
+        let pulled = combination([&x, &y, &w], &coefficients)?;
+        let original = self
+            .topology()
+            .geometric_equation()
+            .coefficients
+            .iter()
+            .map(|row| {
+                row.iter()
+                    .map(|c| {
+                        form(
+                            chord.start(),
+                            BivariatePolynomial::new(vec![vec![c.clone()]]),
+                        )
+                    })
+                    .collect()
+            })
+            .collect::<ExactCurveResult<Vec<Vec<Form>>>>()?;
+        let report = resultant_bivariate_ordered_field(
+            &original,
+            &pulled,
+            OrderedFieldResultantConfig::default(),
+            &mut Coefficients {
+                origin: chord.start(),
+            },
+        )
+        .map_err(|error| match error {
+            OrderedFieldResultantError::Coefficient(error) => error,
+            OrderedFieldResultantError::OperationLimit { .. }
+            | OrderedFieldResultantError::MatrixLimit { .. }
+            | OrderedFieldResultantError::AllocationFailed
+            | OrderedFieldResultantError::SizeOverflow => {
+                blocked(UncertaintyReason::BudgetExhausted)
+            }
+            OrderedFieldResultantError::Numeric(error) => invalid(error.into()),
+        })?;
+        let roots = PolynomialPoint2::selected_root_candidates(
+            report.coefficients,
+            self.topology().domain().first.clone(),
+            self.source.fiber_config,
+            policy,
+        )?
+        .ok_or_else(|| blocked(UncertaintyReason::Unsupported))?;
+        let source = Curve2::from_polynomial_branch(self.source_branch(policy)?);
+        let fx = derivative(
+            self.topology().geometric_equation(),
+            CurveResultantParameter::First,
+        );
+        let fy = derivative(
+            self.topology().geometric_equation(),
+            CurveResultantParameter::Second,
+        );
+        let gx = [&x, &y, &w].map(|p| derivative(p, CurveResultantParameter::First));
+        let gy = [&x, &y, &w].map(|p| derivative(p, CurveResultantParameter::Second));
+        let mut sections = Vec::new();
+        for root in roots {
+            let mut parameter = coordinates(&root)?[0].parameter()?;
+            let low = decided(
+                parameter
+                    .cmp_by_refinement(self.range.start(), policy)
+                    .map_err(invalid)?,
+            )?;
+            let high = decided(
+                parameter
+                    .cmp_by_refinement(self.range.end(), policy)
+                    .map_err(invalid)?,
+            )?;
+            if low.is_lt() || high.is_gt() {
+                continue;
+            }
+            if low.is_eq() {
+                parameter = self.range.start().clone();
+            }
+            if high.is_eq() {
+                parameter = self.range.end().clone();
+            }
+            let point = source
+                .point_at_with_policy(&parameter, policy)?
+                .into_value();
+            let image = if low.is_eq() {
+                self.endpoints[0].clone()
+            } else if high.is_eq() {
+                self.endpoints[1].clone()
+            } else {
+                self.map_point(point.clone(), policy)?
+            };
+            let [px, py] = coordinates(&image)?;
+            if coefficients[0]
+                .multiply(&px)?
+                .add(&coefficients[1].multiply(&py)?)?
+                .add(&coefficients[2])?
+                .compare_to_real(&Real::zero())?
+                != Ordering::Equal
+            {
+                continue;
+            }
+            // At a validated line contact, G = w*L(image). Its source
+            // derivative has sign sign(w)*sign(T_image x chord_direction).
+            let cross = (|| -> ExactCurveResult<Option<RealSign>> {
+                let denominator = form(&point, fy.clone())?.multiply(&form(&point, w.clone())?)?;
+                let weight = denominator.compare_to_real(&Real::zero())?;
+                if weight == Ordering::Equal {
+                    return Ok(None);
+                }
+                let a = evaluate(&point, [&gx[0], &gx[1], &gx[2]], &coefficients)?
+                    .multiply(&form(&point, fy.clone())?)?;
+                let b = evaluate(&point, [&gy[0], &gy[1], &gy[2]], &coefficients)?
+                    .multiply(&form(&point, fx.clone())?)?;
+                let order = a.subtract(&b)?.compare_to_real(&Real::zero())?;
+                let sign = match order {
+                    Ordering::Less => RealSign::Negative,
+                    Ordering::Equal => RealSign::Zero,
+                    Ordering::Greater => RealSign::Positive,
+                };
+                Ok(Some(if weight == Ordering::Less {
+                    negate(sign)
+                } else {
+                    sign
+                }))
+            })();
+            let cross = match cross {
+                Ok(sign) => sign,
+                Err(ExactCurveError::Blocked(blocker))
+                    if blocker.reason() != UncertaintyReason::BudgetExhausted =>
+                {
+                    None
+                }
+                Err(error) => return Err(error),
+            };
+            sections.push(PolynomialLineSection2 {
+                parameter,
+                point: image,
+                cross,
+            });
+        }
+        Ok(sections)
+    }
+}
diff --git a/crates/hypersolve/src/ordered_field_resultant.rs b/crates/hypersolve/src/ordered_field_resultant.rs
new file mode 100644
index 0000000000..d0b5e9c55a
--- /dev/null
+++ b/crates/hypersolve/src/ordered_field_resultant.rs
@@ -0,0 +1,326 @@
+//! Bivariate elimination over a caller-owned exact ordered coefficient field.
+//!
+//! Coefficients stay in that field. A Sylvester determinant is evaluated by
+//! Faddeev–LeVerrier polynomial arithmetic: only division by nonzero integers
+//! occurs, so no pivot or primitive-element projection is required. Original
+//! coefficient signs determine degrees; intermediate values are never rescaled
+//! projectively. The result is the actual resultant, not only its zero set.
+//!
+//! Limits count coefficient-context calls and matrix entries separately. They
+//! do not bound coefficient arithmetic, expression growth, heap bytes or
+//! cancellation latency inside the caller's field. Platform storage-layout
+//! and allocator limits are additional typed resource stops. Exhaustion publishes no
+//! partial resultant, and a later larger-budget call has no failed cache state.
+
+use crate::OrderedFieldPolynomialContext;
+use hyperreal::{Problem, Real};
+use std::cmp::Ordering;
+
+/// Resource units of one bivariate resultant attempt.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct OrderedFieldResultantConfig {
+    /// Maximum total calls to coefficient arithmetic and sign authority.
+    pub max_coefficient_operations: usize,
+    /// Maximum entries in each square Sylvester/characteristic matrix.
+    pub max_matrix_entries: usize,
+}
+
+impl Default for OrderedFieldResultantConfig {
+    fn default() -> Self {
+        Self {
+            max_coefficient_operations: 1_000_000,
+            max_matrix_entries: 262_144,
+        }
+    }
+}
+
+/// An attempt that did not publish a completed resultant.
+#[derive(Debug)]
+pub enum OrderedFieldResultantError<E> {
+    /// The caller's exact coefficient authority failed or remained undecided.
+    Coefficient(E),
+    /// The declared coefficient-operation allowance was reached.
+    OperationLimit {
+        /// Configured operation allowance.
+        limit: usize,
+    },
+    /// A required matrix exceeds its declared entry allowance.
+    MatrixLimit {
+        /// Required number of entries.
+        required: usize,
+        /// Configured entry allowance.
+        limit: usize,
+    },
+    /// A storage dimension exceeds addressable machine sizes.
+    SizeOverflow,
+    /// Fallible storage reservation failed.
+    AllocationFailed,
+    /// Construction of an exact rational scale failed.
+    Numeric(Problem),
+}
+
+/// A completed polynomial and its measured coefficient-context call count.
+#[derive(Clone, Debug)]
+pub struct OrderedFieldResultant<C> {
+    /// Ascending powers of the retained first variable.
+    pub coefficients: Vec<C>,
+    /// Arithmetic and sign authority calls actually consumed.
+    pub coefficient_operations: usize,
+}
+
+type Result<T, E> = std::result::Result<T, OrderedFieldResultantError<E>>;
+
+fn filled<T: Clone, E>(count: usize, value: T) -> Result<Vec<T>, E> {
+    std::alloc::Layout::array::<T>(count).map_err(|_| OrderedFieldResultantError::SizeOverflow)?;
+    let mut values = Vec::new();
+    values
+        .try_reserve_exact(count)
+        .map_err(|_| OrderedFieldResultantError::AllocationFailed)?;
+    values.resize(count, value);
+    Ok(values)
+}
+
+struct Arithmetic<'a, F> {
+    field: &'a mut F,
+    config: OrderedFieldResultantConfig,
+    calls: usize,
+}
+
+impl<F> Arithmetic<'_, F> {
+    fn tick<E>(&mut self) -> Result<(), E> {
+        if self.calls == self.config.max_coefficient_operations {
+            return Err(OrderedFieldResultantError::OperationLimit { limit: self.calls });
+        }
+        self.calls += 1;
+        Ok(())
+    }
+    fn constant<C>(&mut self, value: &Real) -> Result<C, F::Error>
+    where
+        F: OrderedFieldPolynomialContext<C>,
+    {
+        self.tick()?;
+        self.field
+            .constant(value)
+            .map_err(OrderedFieldResultantError::Coefficient)
+    }
+    fn add<C>(&mut self, a: &C, b: &C) -> Result<C, F::Error>
+    where
+        F: OrderedFieldPolynomialContext<C>,
+    {
+        self.tick()?;
+        self.field
+            .add(a, b)
+            .map_err(OrderedFieldResultantError::Coefficient)
+    }
+    fn multiply<C>(&mut self, a: &C, b: &C) -> Result<C, F::Error>
+    where
+        F: OrderedFieldPolynomialContext<C>,
+    {
+        self.tick()?;
+        self.field
+            .multiply(a, b)
+            .map_err(OrderedFieldResultantError::Coefficient)
+    }
+    fn scale<C>(&mut self, value: &C, scale: &Real) -> Result<C, F::Error>
+    where
+        F: OrderedFieldPolynomialContext<C>,
+    {
+        self.tick()?;
+        self.field
+            .scale(value, scale)
+            .map_err(OrderedFieldResultantError::Coefficient)
+    }
+    fn sign<C>(&mut self, value: &C) -> Result<Ordering, F::Error>
+    where
+        F: OrderedFieldPolynomialContext<C>,
+    {
+        self.tick()?;
+        self.field
+            .sign(value)
+            .map_err(OrderedFieldResultantError::Coefficient)
+    }
+    fn trim<C: Clone>(&mut self, p: &mut Vec<C>) -> Result<(), F::Error>
+    where
+        F: OrderedFieldPolynomialContext<C>,
+    {
+        while let Some(leading) = p.last() {
+            if self.sign(leading)? != Ordering::Equal {
+                break;
+            }
+            p.pop();
+        }
+        Ok(())
+    }
+    fn polynomial_add<C: Clone>(&mut self, a: &[C], b: &[C]) -> Result<Vec<C>, F::Error>
+    where
+        F: OrderedFieldPolynomialContext<C>,
+    {
+        let mut result = Vec::new();
+        result
+            .try_reserve_exact(a.len().max(b.len()))
+            .map_err(|_| OrderedFieldResultantError::AllocationFailed)?;
+        for i in 0..a.len().max(b.len()) {
+            result.push(match (a.get(i), b.get(i)) {
+                (Some(a), Some(b)) => self.add(a, b)?,
+                (Some(a), None) | (None, Some(a)) => a.clone(),
+                (None, None) => unreachable!("index is below the larger polynomial length"),
+            });
+        }
+        self.trim(&mut result)?;
+        Ok(result)
+    }
+    fn polynomial_multiply<C: Clone>(&mut self, a: &[C], b: &[C]) -> Result<Vec<C>, F::Error>
+    where
+        F: OrderedFieldPolynomialContext<C>,
+    {
+        if a.is_empty() || b.is_empty() {
+            return Ok(Vec::new());
+        }
+        let count = a
+            .len()
+            .checked_add(b.len() - 1)
+            .ok_or(OrderedFieldResultantError::SizeOverflow)?;
+        let mut result = filled(count, None)?;
+        for (i, a) in a.iter().enumerate() {
+            for (j, b) in b.iter().enumerate() {
+                let term = self.multiply(a, b)?;
+                result[i + j] = Some(match &result[i + j] {
+                    Some(sum) => self.add(sum, &term)?,
+                    None => term,
+                });
+            }
+        }
+        let mut result = result
+            .into_iter()
+            .map(|value| value.expect("every convolution degree has a contributing pair"))
+            .collect();
+        self.trim(&mut result)?;
+        Ok(result)
+    }
+    fn polynomial_scale<C: Clone>(&mut self, p: &[C], scale: &Real) -> Result<Vec<C>, F::Error>
+    where
+        F: OrderedFieldPolynomialContext<C>,
+    {
+        p.iter().map(|value| self.scale(value, scale)).collect()
+    }
+}
+
+/// Eliminates the second variable from two bivariate polynomials over one
+/// exact coefficient field. Input rows use ascending powers `[x][y]`.
+/// Empty/zero operands return the zero polynomial by convention. Two nonzero
+/// polynomials constant in `y` have resultant one (the empty determinant).
+/// No approximate coefficient test or projective normalization is consumed.
+pub fn resultant_bivariate_ordered_field<C: Clone, F: OrderedFieldPolynomialContext<C>>(
+    first: &[Vec<C>],
+    second: &[Vec<C>],
+    config: OrderedFieldResultantConfig,
+    field: &mut F,
+) -> Result<OrderedFieldResultant<C>, F::Error> {
+    let mut arithmetic = Arithmetic {
+        field,
+        config,
+        calls: 0,
+    };
+    let mut degrees = [None, None];
+    for (index, polynomial) in [first, second].into_iter().enumerate() {
+        for row in polynomial {
+            for (power, coefficient) in row.iter().enumerate() {
+                if arithmetic.sign(coefficient)? != Ordering::Equal {
+                    degrees[index] =
+                        Some(degrees[index].map_or(power, |known: usize| known.max(power)));
+                }
+            }
+        }
+    }
+    let [Some(m), Some(n)] = degrees else {
+        return Ok(OrderedFieldResultant {
+            coefficients: vec![arithmetic.constant(&Real::zero())?],
+            coefficient_operations: arithmetic.calls,
+        });
+    };
+    let dimension = m
+        .checked_add(n)
+        .ok_or(OrderedFieldResultantError::SizeOverflow)?;
+    let entries = dimension
+        .checked_mul(dimension)
+        .ok_or(OrderedFieldResultantError::SizeOverflow)?;
+    if entries > config.max_matrix_entries {
+        return Err(OrderedFieldResultantError::MatrixLimit {
+            required: entries,
+            limit: config.max_matrix_entries,
+        });
+    }
+    let one = arithmetic.constant(&Real::one())?;
+    if dimension == 0 {
+        return Ok(OrderedFieldResultant {
+            coefficients: vec![one],
+            coefficient_operations: arithmetic.calls,
+        });
+    }
+    let mut matrix = filled(entries, Vec::<C>::new())?;
+    let zero = arithmetic.constant(&Real::zero())?;
+    for (offset, count, polynomial, degree) in [(0, n, first, m), (n, m, second, n)] {
+        for row in 0..count {
+            for power in 0..=degree {
+                let mut coefficient = Vec::new();
+                coefficient
+                    .try_reserve_exact(polynomial.len())
+                    .map_err(|_| OrderedFieldResultantError::AllocationFailed)?;
+                for terms in polynomial {
+                    coefficient.push(terms.get(power).unwrap_or(&zero).clone());
+                }
+                arithmetic.trim(&mut coefficient)?;
+                matrix[(offset + row) * dimension + row + degree - power] = coefficient;
+            }
+        }
+    }
+    let mut characteristic = filled(entries, Vec::<C>::new())?;
+    for i in 0..dimension {
+        characteristic[i * dimension + i] = vec![one.clone()];
+    }
+    for step in 1..=dimension {
+        let mut product = filled(entries, Vec::<C>::new())?;
+        for row in 0..dimension {
+            for column in 0..dimension {
+                for inner in 0..dimension {
+                    let term = arithmetic.polynomial_multiply(
+                        &matrix[row * dimension + inner],
+                        &characteristic[inner * dimension + column],
+                    )?;
+                    product[row * dimension + column] =
+                        arithmetic.polynomial_add(&product[row * dimension + column], &term)?;
+                }
+            }
+        }
+        let mut trace = Vec::new();
+        for i in 0..dimension {
+            trace = arithmetic.polynomial_add(&trace, &product[i * dimension + i])?;
+        }
+        let denominator =
+            u64::try_from(step).map_err(|_| OrderedFieldResultantError::SizeOverflow)?;
+        let scale = (Real::from(-1) / Real::from(denominator))
+            .map_err(OrderedFieldResultantError::Numeric)?;
+        let coefficient = arithmetic.polynomial_scale(&trace, &scale)?;
+        if step == dimension {
+            let mut coefficients = if dimension.is_multiple_of(2) {
+                coefficient
+            } else {
+                arithmetic.polynomial_scale(&coefficient, &Real::from(-1))?
+            };
+            arithmetic.trim(&mut coefficients)?;
+            if coefficients.is_empty() {
+                coefficients.push(zero);
+            }
+            return Ok(OrderedFieldResultant {
+                coefficients,
+                coefficient_operations: arithmetic.calls,
+            });
+        }
+        for i in 0..dimension {
+            product[i * dimension + i] =
+                arithmetic.polynomial_add(&product[i * dimension + i], &coefficient)?;
+        }
+        characteristic = product;
+    }
+    unreachable!("a nonempty determinant returns its final characteristic coefficient")
+}
