+        direction: Direction,
+        pcurve: &PcurveKey,
+        correspondence: ParameterCorrespondence,
+        surface: &SurfaceKey,
+    ) -> Result<(), BuildError> {
+        let (edge, pcurve, surface) = (
+            self.resolve(edge)?,
+            self.resolve(pcurve)?,
+            self.resolve(surface)?,
+        );
+        self.inner
+            .validate_edge_image(edge, direction, pcurve, correspondence, surface)
+    }
