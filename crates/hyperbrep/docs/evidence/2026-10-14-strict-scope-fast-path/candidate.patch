diff --git a/crates/hypercurve/src/policy.rs b/crates/hypercurve/src/policy.rs
index 618119f6d..5ba0dcea2 100644
--- a/crates/hypercurve/src/policy.rs
+++ b/crates/hypercurve/src/policy.rs
@@ -155,0 +156,14 @@ pub fn evaluate_under<T>(
+    // No frame needs changing when the caller already has strict authority
+    // and no preview state. This also avoids repeated save/restore work in
+    // nested exact consumers. Check the actual ambient state on every entry;
+    // an intervening provisional or preview scope must still be suspended.
+    if policy == hyperlimit::PredicatePolicy::STRICT
+        && !PROVISIONAL_SCOPE.with(Cell::get)
+        && ACTIVE_PREVIEW_CONTEXT.with(Cell::get).is_none()
+        && ACTIVE_PREVIEW_TOLERANCE.with(Cell::get).is_none()
+    {
+        return Provisional {
+            value: evaluate(),
+            certainty: CurveCertainty::Certified,
+        };
+    }
