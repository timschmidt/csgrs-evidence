+                sorted
+                    .into_iter()
+                    .map(|c| {
+                        let CurveParameterSet2::Single(p) = c.parameters else {
+                            unreachable!()
+                        };
+                        CurveLocation2::new(c.span_index, c.span_range, p)
+                    })
+                    .collect(),
+            ));
+        }
+        Ok(CurvePointLocations2::Components(sorted))
+    }
