+#[test]
+fn near_selected_preimages_remain_distinct_and_partial_constant_spans_stay_explicit() {
+    let source = monomials(2, 2, 2).point_at(&alpha()).unwrap();
+    let epsilon = q(1, 1_i64 << 60);
+    let point = source
+        .rational_image(&hypercurve::RationalMap2::new(
+            [
+                BivariatePolynomial::new(vec![vec![], vec![&epsilon * &epsilon]]),
+                BivariatePolynomial::new(vec![]),
+            ],
+            BivariatePolynomial::new(vec![vec![Real::one()]]),
+        ))
+        .unwrap();
+    let target = Curve2::from(hypercurve::QuadraticBezier2::new(
+        Point2::from_values(1, 0),
+        Point2::from_values(-2, 0),
+        Point2::from_values(4, 0),
+    ));
+    let mut visits = agrees(&target, &point, 2);
+    if visits[0].compare(&visits[1]).unwrap() == Ordering::Greater {
+        visits.swap(0, 1);
+    }
+    let center = CurveParameter2::from(q(1, 3));
+    assert_eq!(visits[0].compare(&center).unwrap(), Ordering::Less);
+    assert_eq!(visits[1].compare(&center).unwrap(), Ordering::Greater);
+    assert_eq!(visits[0].compare(&visits[1]).unwrap(), Ordering::Less);
+    let partial = Curve2::try_nurbs(
+        1,
+        vec![
+            Point2::from_values(0, 0),
+            Point2::from_values(0, 0),
+            Point2::from_values(1, 0),
+        ],
+        vec![Real::one(); 3],
+        [0, 0, 1, 2, 2].into_iter().map(Real::from).collect(),
+    )
+    .unwrap();
+    let zero = point
+        .rational_image(&hypercurve::RationalMap2::new(
+            [
+                BivariatePolynomial::new(vec![]),
+                BivariatePolynomial::new(vec![]),
+            ],
+            BivariatePolynomial::new(vec![vec![Real::one()]]),
+        ))
+        .unwrap();
+    // The original controls and knots give C(t)=0 on [0,1] and
+    // C(t)=(t-1,0) on [1,2]. Its entire preimage is the closed [0,1].
+    assert!(zero.coordinates().is_none());
+    let CurvePointLocations2::Components(parts) = partial.point_locations(&zero).unwrap() else {
+        panic!("one proper constant interval")
+    };
+    assert_eq!(parts.len(), 1);
+    assert_eq!(parts[0].span_index(), 0);
+    assert_eq!(parts[0].endpoint_inclusion(), [true, true]);
+    let hypercurve::CurveParameterSet2::Range(range) = parts[0].parameters().unwrap() else {
+        panic!("interval closure")
+    };
+    assert_eq!(
+        range.start().compare(&Real::zero().into()).unwrap(),
+        Ordering::Equal
+    );
+    assert_eq!(
+        range.end().compare(&Real::one().into()).unwrap(),
+        Ordering::Equal
+    );
+}
diff --git a/crates/hypersolve/src/ordered_field_resultant.rs b/crates/hypersolve/src/ordered_field_resultant.rs
new file mode 100644
index 0000000000..d0b5e9c55a
--- /dev/null
+++ b/crates/hypersolve/src/ordered_field_resultant.rs
@@ -0,0 +1,326 @@
+//! Bivariate elimination over a caller-owned exact ordered coefficient field.
+//!
+//! Coefficients stay in that field. A Sylvester determinant is evaluated by
+//! Faddeev–LeVerrier polynomial arithmetic: only division by nonzero integers
+//! occurs, so no pivot or primitive-element projection is required. Original
+//! coefficient signs determine degrees; intermediate values are never rescaled
+//! projectively. The result is the actual resultant, not only its zero set.
+//!
+//! Limits count coefficient-context calls and matrix entries separately. They
+//! do not bound coefficient arithmetic, expression growth, heap bytes or
+//! cancellation latency inside the caller's field. Platform storage-layout
+//! and allocator limits are additional typed resource stops. Exhaustion publishes no
+//! partial resultant, and a later larger-budget call has no failed cache state.
+
+use crate::OrderedFieldPolynomialContext;
+use hyperreal::{Problem, Real};
+use std::cmp::Ordering;
+
+/// Resource units of one bivariate resultant attempt.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct OrderedFieldResultantConfig {
+    /// Maximum total calls to coefficient arithmetic and sign authority.
+    pub max_coefficient_operations: usize,
+    /// Maximum entries in each square Sylvester/characteristic matrix.
+    pub max_matrix_entries: usize,
+}
+
+impl Default for OrderedFieldResultantConfig {
+    fn default() -> Self {
+        Self {
+            max_coefficient_operations: 1_000_000,
+            max_matrix_entries: 262_144,
+        }
+    }
+}
+
+/// An attempt that did not publish a completed resultant.
+#[derive(Debug)]
+pub enum OrderedFieldResultantError<E> {
+    /// The caller's exact coefficient authority failed or remained undecided.
+    Coefficient(E),
+    /// The declared coefficient-operation allowance was reached.
+    OperationLimit {
+        /// Configured operation allowance.
+        limit: usize,
+    },
+    /// A required matrix exceeds its declared entry allowance.
+    MatrixLimit {
+        /// Required number of entries.
+        required: usize,
+        /// Configured entry allowance.
+        limit: usize,
+    },
+    /// A storage dimension exceeds addressable machine sizes.
+    SizeOverflow,
+    /// Fallible storage reservation failed.
+    AllocationFailed,
+    /// Construction of an exact rational scale failed.
+    Numeric(Problem),
+}
+
+/// A completed polynomial and its measured coefficient-context call count.
+#[derive(Clone, Debug)]
+pub struct OrderedFieldResultant<C> {
+    /// Ascending powers of the retained first variable.
+    pub coefficients: Vec<C>,
+    /// Arithmetic and sign authority calls actually consumed.
+    pub coefficient_operations: usize,
+}
+
+type Result<T, E> = std::result::Result<T, OrderedFieldResultantError<E>>;
+
+fn filled<T: Clone, E>(count: usize, value: T) -> Result<Vec<T>, E> {
+    std::alloc::Layout::array::<T>(count).map_err(|_| OrderedFieldResultantError::SizeOverflow)?;
+    let mut values = Vec::new();
+    values
+        .try_reserve_exact(count)
+        .map_err(|_| OrderedFieldResultantError::AllocationFailed)?;
+    values.resize(count, value);
+    Ok(values)
+}
+
+struct Arithmetic<'a, F> {
+    field: &'a mut F,
+    config: OrderedFieldResultantConfig,
+    calls: usize,
+}
+
+impl<F> Arithmetic<'_, F> {
+    fn tick<E>(&mut self) -> Result<(), E> {
+        if self.calls == self.config.max_coefficient_operations {
+            return Err(OrderedFieldResultantError::OperationLimit { limit: self.calls });
+        }
+        self.calls += 1;
+        Ok(())
+    }
+    fn constant<C>(&mut self, value: &Real) -> Result<C, F::Error>
+    where
+        F: OrderedFieldPolynomialContext<C>,
+    {
+        self.tick()?;
+        self.field
+            .constant(value)
+            .map_err(OrderedFieldResultantError::Coefficient)
+    }
+    fn add<C>(&mut self, a: &C, b: &C) -> Result<C, F::Error>
+    where
+        F: OrderedFieldPolynomialContext<C>,
+    {
+        self.tick()?;
+        self.field
+            .add(a, b)
+            .map_err(OrderedFieldResultantError::Coefficient)
+    }
+    fn multiply<C>(&mut self, a: &C, b: &C) -> Result<C, F::Error>
+    where
+        F: OrderedFieldPolynomialContext<C>,
+    {
+        self.tick()?;
+        self.field
+            .multiply(a, b)
+            .map_err(OrderedFieldResultantError::Coefficient)
+    }
+    fn scale<C>(&mut self, value: &C, scale: &Real) -> Result<C, F::Error>
+    where
+        F: OrderedFieldPolynomialContext<C>,
+    {
+        self.tick()?;
+        self.field
+            .scale(value, scale)
+            .map_err(OrderedFieldResultantError::Coefficient)
+    }
+    fn sign<C>(&mut self, value: &C) -> Result<Ordering, F::Error>
+    where
+        F: OrderedFieldPolynomialContext<C>,
+    {
+        self.tick()?;
+        self.field
+            .sign(value)
+            .map_err(OrderedFieldResultantError::Coefficient)
+    }
+    fn trim<C: Clone>(&mut self, p: &mut Vec<C>) -> Result<(), F::Error>
+    where
+        F: OrderedFieldPolynomialContext<C>,
+    {
+        while let Some(leading) = p.last() {
+            if self.sign(leading)? != Ordering::Equal {
+                break;
+            }
+            p.pop();
+        }
+        Ok(())
+    }
+    fn polynomial_add<C: Clone>(&mut self, a: &[C], b: &[C]) -> Result<Vec<C>, F::Error>
+    where
+        F: OrderedFieldPolynomialContext<C>,
+    {
+        let mut result = Vec::new();
+        result
+            .try_reserve_exact(a.len().max(b.len()))
+            .map_err(|_| OrderedFieldResultantError::AllocationFailed)?;
+        for i in 0..a.len().max(b.len()) {
+            result.push(match (a.get(i), b.get(i)) {
+                (Some(a), Some(b)) => self.add(a, b)?,
+                (Some(a), None) | (None, Some(a)) => a.clone(),
+                (None, None) => unreachable!("index is below the larger polynomial length"),
+            });
+        }
+        self.trim(&mut result)?;
+        Ok(result)
+    }
+    fn polynomial_multiply<C: Clone>(&mut self, a: &[C], b: &[C]) -> Result<Vec<C>, F::Error>
+    where
+        F: OrderedFieldPolynomialContext<C>,
+    {
+        if a.is_empty() || b.is_empty() {
+            return Ok(Vec::new());
+        }
+        let count = a
+            .len()
+            .checked_add(b.len() - 1)
+            .ok_or(OrderedFieldResultantError::SizeOverflow)?;
+        let mut result = filled(count, None)?;
+        for (i, a) in a.iter().enumerate() {
+            for (j, b) in b.iter().enumerate() {
+                let term = self.multiply(a, b)?;
+                result[i + j] = Some(match &result[i + j] {
+                    Some(sum) => self.add(sum, &term)?,
+                    None => term,
+                });
+            }
+        }
+        let mut result = result
+            .into_iter()
+            .map(|value| value.expect("every convolution degree has a contributing pair"))
+            .collect();
+        self.trim(&mut result)?;
+        Ok(result)
+    }
+    fn polynomial_scale<C: Clone>(&mut self, p: &[C], scale: &Real) -> Result<Vec<C>, F::Error>
+    where
+        F: OrderedFieldPolynomialContext<C>,
+    {
+        p.iter().map(|value| self.scale(value, scale)).collect()
+    }
+}
+
+/// Eliminates the second variable from two bivariate polynomials over one
+/// exact coefficient field. Input rows use ascending powers `[x][y]`.
+/// Empty/zero operands return the zero polynomial by convention. Two nonzero
+/// polynomials constant in `y` have resultant one (the empty determinant).
+/// No approximate coefficient test or projective normalization is consumed.
+pub fn resultant_bivariate_ordered_field<C: Clone, F: OrderedFieldPolynomialContext<C>>(
+    first: &[Vec<C>],
+    second: &[Vec<C>],
+    config: OrderedFieldResultantConfig,
+    field: &mut F,
+) -> Result<OrderedFieldResultant<C>, F::Error> {
+    let mut arithmetic = Arithmetic {
+        field,
+        config,
+        calls: 0,
+    };
+    let mut degrees = [None, None];
+    for (index, polynomial) in [first, second].into_iter().enumerate() {
+        for row in polynomial {
+            for (power, coefficient) in row.iter().enumerate() {
+                if arithmetic.sign(coefficient)? != Ordering::Equal {
+                    degrees[index] =
+                        Some(degrees[index].map_or(power, |known: usize| known.max(power)));
+                }
+            }
+        }
+    }
+    let [Some(m), Some(n)] = degrees else {
+        return Ok(OrderedFieldResultant {
+            coefficients: vec![arithmetic.constant(&Real::zero())?],
+            coefficient_operations: arithmetic.calls,
+        });
+    };
+    let dimension = m
+        .checked_add(n)
+        .ok_or(OrderedFieldResultantError::SizeOverflow)?;
+    let entries = dimension
+        .checked_mul(dimension)
+        .ok_or(OrderedFieldResultantError::SizeOverflow)?;
+    if entries > config.max_matrix_entries {
+        return Err(OrderedFieldResultantError::MatrixLimit {
+            required: entries,
+            limit: config.max_matrix_entries,
+        });
+    }
+    let one = arithmetic.constant(&Real::one())?;
+    if dimension == 0 {
+        return Ok(OrderedFieldResultant {
+            coefficients: vec![one],
+            coefficient_operations: arithmetic.calls,
+        });
+    }
+    let mut matrix = filled(entries, Vec::<C>::new())?;
+    let zero = arithmetic.constant(&Real::zero())?;
+    for (offset, count, polynomial, degree) in [(0, n, first, m), (n, m, second, n)] {
+        for row in 0..count {
+            for power in 0..=degree {
+                let mut coefficient = Vec::new();
+                coefficient
+                    .try_reserve_exact(polynomial.len())
+                    .map_err(|_| OrderedFieldResultantError::AllocationFailed)?;
+                for terms in polynomial {
+                    coefficient.push(terms.get(power).unwrap_or(&zero).clone());
+                }
+                arithmetic.trim(&mut coefficient)?;
+                matrix[(offset + row) * dimension + row + degree - power] = coefficient;
+            }
+        }
+    }
+    let mut characteristic = filled(entries, Vec::<C>::new())?;
+    for i in 0..dimension {
+        characteristic[i * dimension + i] = vec![one.clone()];
+    }
+    for step in 1..=dimension {
+        let mut product = filled(entries, Vec::<C>::new())?;
+        for row in 0..dimension {
+            for column in 0..dimension {
+                for inner in 0..dimension {
+                    let term = arithmetic.polynomial_multiply(
+                        &matrix[row * dimension + inner],
+                        &characteristic[inner * dimension + column],
+                    )?;
+                    product[row * dimension + column] =
+                        arithmetic.polynomial_add(&product[row * dimension + column], &term)?;
+                }
+            }
+        }
+        let mut trace = Vec::new();
+        for i in 0..dimension {
+            trace = arithmetic.polynomial_add(&trace, &product[i * dimension + i])?;
+        }
+        let denominator =
+            u64::try_from(step).map_err(|_| OrderedFieldResultantError::SizeOverflow)?;
+        let scale = (Real::from(-1) / Real::from(denominator))
+            .map_err(OrderedFieldResultantError::Numeric)?;
+        let coefficient = arithmetic.polynomial_scale(&trace, &scale)?;
+        if step == dimension {
+            let mut coefficients = if dimension.is_multiple_of(2) {
+                coefficient
+            } else {
+                arithmetic.polynomial_scale(&coefficient, &Real::from(-1))?
+            };
+            arithmetic.trim(&mut coefficients)?;
+            if coefficients.is_empty() {
+                coefficients.push(zero);
+            }
+            return Ok(OrderedFieldResultant {
+                coefficients,
+                coefficient_operations: arithmetic.calls,
+            });
+        }
+        for i in 0..dimension {
+            product[i * dimension + i] =
+                arithmetic.polynomial_add(&product[i * dimension + i], &coefficient)?;
+        }
+        characteristic = product;
+    }
+    unreachable!("a nonempty determinant returns its final characteristic coefficient")
+}
diff --git a/crates/hypersolve/tests/ordered_field_resultants.rs b/crates/hypersolve/tests/ordered_field_resultants.rs
new file mode 100644
index 0000000000..c828cdb0d8
--- /dev/null
+++ b/crates/hypersolve/tests/ordered_field_resultants.rs
@@ -0,0 +1,267 @@
+//! Resultants retain exact selected coefficient fields and typed resource limits.
+
+#[path = "support/recursive_quadratic.rs"]
+#[allow(dead_code)]
+mod support;
+
+use hyperreal::{Real, RealSign};
+use hypersolve::OrderedFieldPolynomialContext;
+use hypersolve::classification::Classification;
+use hypersolve::ordered_field_resultant::{
+    OrderedFieldResultantConfig as Config, OrderedFieldResultantError as Error,
+    resultant_bivariate_ordered_field as resultant,
+};
+use hypersolve::recursive_quadratic_field::RecursiveQuadraticField;
+use hypersolve::selected_polynomial_field::{SelectedPolynomialContext, SelectedPolynomialField};
+use std::cmp::Ordering;
+use support::*;
+
+struct Scalars {
+    fail: bool,
+}
+impl OrderedFieldPolynomialContext<Real> for Scalars {
+    type Error = &'static str;
+    fn constant(&mut self, value: &Real) -> Result<Real, Self::Error> {
+        Ok(value.clone())
+    }
+    fn add(&mut self, a: &Real, b: &Real) -> Result<Real, Self::Error> {
+        Ok(a + b)
+    }
+    fn multiply(&mut self, a: &Real, b: &Real) -> Result<Real, Self::Error> {
+        Ok(a * b)
+    }
+    fn scale(&mut self, value: &Real, scale: &Real) -> Result<Real, Self::Error> {
+        Ok(value * scale)
+    }
+    fn sign(&mut self, value: &Real) -> Result<Ordering, Self::Error> {
+        if self.fail {
+            Err("coefficient authority")
+        } else {
+            value.partial_cmp(&Real::zero()).ok_or("undecided")
+        }
+    }
+    fn sign_if_separated(&mut self, value: &Real) -> Result<Option<Ordering>, Self::Error> {
+        self.sign(value).map(Some)
+    }
+    fn normalize_positive_scale(&mut self, _: &mut [Real]) {
+        panic!("a determinant must retain actual coefficient values")
+    }
+}
+fn p(rows: &[&[i32]]) -> Vec<Vec<Real>> {
+    rows.iter()
+        .map(|r| r.iter().copied().map(Real::from).collect())
+        .collect()
+}
+
+#[test]
+fn exact_resultant_values_degeneracies_and_orientation() {
+    let mut field = Scalars { fail: false };
+    // Res_y(y³-x,y²-1)=(1-x)(-1-x)=x²-1.
+    let f = p(&[&[0, 0, 0, 1], &[-1]]);
+    let g = p(&[&[-1, 0, 1]]);
+    let result = resultant(&f, &g, Config::default(), &mut field).unwrap();
+    assert_eq!(result.coefficients, p(&[&[-1, 0, 1]])[0]);
+    // Leading coefficient factors belong to the determinant too:
+    // Res_y(2y-x,3y-1)=3x-2, without projective normalization.
+    assert_eq!(
+        resultant(
+            &p(&[&[0, 2], &[-1]]),
+            &p(&[&[-1, 3]]),
+            Config::default(),
+            &mut field,
+        )
+        .unwrap()
+        .coefficients,
+        vec![Real::from(-2), Real::from(3)]
+    );
+    // Reversing two odd-degree operands negates the actual determinant.
+    let f = p(&[&[0, 1], &[-1]]);
+    let g = p(&[&[-2, 1]]);
+    assert_eq!(
+        resultant(&f, &g, Config::default(), &mut field)
+            .unwrap()
+            .coefficients,
+        vec![Real::from(-2), Real::one()]
+    );
+    assert_eq!(
+        resultant(&g, &f, Config::default(), &mut field)
+            .unwrap()
+            .coefficients,
+        vec![Real::from(2), Real::from(-1)]
+    );
+    let common = resultant(&f, &f, Config::default(), &mut field).unwrap();
+    assert_eq!(common.coefficients, vec![Real::zero()]);
+    assert_eq!(
+        resultant(&[], &g, Config::default(), &mut field)
+            .unwrap()
+            .coefficients,
+        vec![Real::zero()]
+    );
+    assert_eq!(
+        resultant(&p(&[&[3]]), &p(&[&[2]]), Config::default(), &mut field)
+            .unwrap()
+            .coefficients,
+        vec![Real::one()]
+    );
+    // Degree thirteen is an ordinary input, not a fixed low-degree family.
+    let mut first = vec![vec![Real::zero(); 14], vec![Real::from(-1)]];
+    first[0][13] = Real::one();
+    assert_eq!(
+        resultant(&first, &g, Config::default(), &mut field)
+            .unwrap()
+            .coefficients,
+        vec![Real::from(-8192), Real::one()]
+    );
+    // A constant in y can still be a polynomial in retained x.
+    assert_eq!(
+        resultant(
+            &p(&[&[0], &[1]]),
+            &p(&[&[1, 0, 1]]),
+            Config::default(),
+            &mut field
+        )
+        .unwrap()
+        .coefficients,
+        vec![Real::zero(), Real::zero(), Real::one()]
+    );
+}
+
+#[test]
+fn resource_and_coefficient_failures_never_become_partial_polynomials() {
+    let f = p(&[&[0, 1], &[-1]]);
+    let g = p(&[&[-2, 1]]);
+    let mut field = Scalars { fail: false };
+    assert!(matches!(
+        resultant(
+            &f,
+            &g,
+            Config {
+                max_coefficient_operations: 0,
+                ..Config::default()
+            },
+            &mut field
+        ),
+        Err(Error::OperationLimit { limit: 0 })
+    ));
+    assert!(matches!(
+        resultant(
+            &f,
+            &g,
+            Config {
+                max_matrix_entries: 0,
+                ..Config::default()
+            },
+            &mut field
+        ),
+        Err(Error::MatrixLimit {
+            required: 4,
+            limit: 0
+        })
+    ));
+    field.fail = true;
+    assert!(matches!(
+        resultant(&f, &g, Config::default(), &mut field),
+        Err(Error::Coefficient("coefficient authority"))
+    ));
+    field.fail = false;
+    let result = resultant(&f, &g, Config::default(), &mut field).unwrap();
+    assert_eq!(result.coefficients, vec![Real::from(-2), Real::one()]);
+    assert!(result.coefficient_operations > 0);
+    let exact_budget = Config {
+        max_coefficient_operations: result.coefficient_operations,
+        ..Config::default()
+    };
+    assert!(resultant(&f, &g, exact_budget, &mut field).is_ok());
+    assert!(matches!(
+        resultant(
+            &f,
+            &g,
+            Config {
+                max_coefficient_operations: result.coefficient_operations - 1,
+                ..Config::default()
+            },
+            &mut field
+        ),
+        Err(Error::OperationLimit { .. })
+    ));
+}
+
+#[test]
+fn selected_quintic_coefficients_remain_in_their_original_field() {
+    let base = SelectedPolynomialField::from_recursive(
+        RecursiveQuadraticField::base(
+            Vec::new(),
+            constant_tensor(0, real(1)),
+            constant_tensor(0, real(1)),
+        )
+        .unwrap(),
+    );
+    let policy = TestContext::strict();
+    let values = [-1, 1, 0, 0, 0, 1]
+        .map(|n| base.constant(n.into()).unwrap())
+        .to_vec();
+    let Classification::Decided(field) = base.select(values, 0.into(), 1.into(), &policy).unwrap()
+    else {
+        panic!("one selected quintic root")
+    };
+    let a = field.generator().unwrap();
+    let c = |n| field.constant(Real::from(n)).unwrap();
+    let f = vec![vec![c(0), c(1)], vec![c(0)], vec![c(-1)]];
+    let g = vec![vec![a.scale(&Real::from(-1)).unwrap(), c(1)]];
+    let mut context = SelectedPolynomialContext {
+        field: field.clone(),
+        policy: &policy,
+    };
+    let result = resultant(&f, &g, Config::default(), &mut context).unwrap();
+    assert_eq!(result.coefficients.len(), 3);
+    let zero = |value: &hypersolve::selected_polynomial_field::SelectedPolynomialValue| {
+        assert_eq!(
+            value.sign(&policy).unwrap(),
+            Classification::Decided(RealSign::Zero)
+        )
+    };
+    zero(&result.coefficients[0].add(&a).unwrap());
+    zero(&result.coefficients[1]);
+    zero(&result.coefficients[2].subtract(&c(1)).unwrap());
+}
+
+#[test]
+fn power_resultants_preserve_all_factors_and_their_multiplicities() {
+    let mut field = Scalars { fail: false };
+    for m in 1_usize..=5 {
+        for n in 1_usize..=5 {
+            // Res_y(y^m-x,y^n-1)=(-1)^m(1-x^(n/gcd(m,n)))^gcd(m,n).
+            let (mut a, mut b) = (m, n);
+            while b != 0 {
+                (a, b) = (b, a % b);
+            }
+            let common = a;
+            let stride = n / common;
+            let mut f = vec![vec![Real::zero(); m + 1], vec![Real::from(-1)]];
+            f[0][m] = Real::one();
+            let mut g = vec![vec![Real::zero(); n + 1]];
+            g[0][0] = Real::from(-1);
+            g[0][n] = Real::one();
+            let mut expected = vec![Real::zero(); n + 1];
+            let mut choose = 1_i32;
+            for j in 0..=common {
+                expected[j * stride] = Real::from(if (m + j).is_multiple_of(2) {
+                    choose
+                } else {
+                    -choose
+                });
+                if j < common {
+                    choose =
+                        choose * i32::try_from(common - j).unwrap() / i32::try_from(j + 1).unwrap();
+                }
+            }
+            assert_eq!(
+                resultant(&f, &g, Config::default(), &mut field)
+                    .unwrap()
+                    .coefficients,
+                expected,
+                "degrees {m}, {n}"
+            );
+        }
+    }
+}
