+            .unwrap(),
+        &[(Real::zero().into(), Real::one().into(), [true, false])],
+    );
+    // Intersecting a locus with itself preserves each original puncture.
+    assert_components(
+        source.intersect_point_locations(&result, &result).unwrap(),
