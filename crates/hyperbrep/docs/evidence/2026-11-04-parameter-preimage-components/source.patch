+++ b/crates/hypercurve/src/curve_line_location.rs
@@ -0,0 +1,72 @@
+//! Native line inverse queries retain the selected point's affine field.
+
+use super::*;
+
+pub(super) fn selected_point_locations(
+    curve: &Curve2,
+    point: &CurvePoint2,
+    policy: &CurveContext,
+) -> ExactCurveResult<Option<CurvePointLocations2>> {
+    let source = curve
+        .source_restriction()
+        .map_or(curve, |(source, _, _)| source);
+    let Some(CurveGeometry2::Line(line)) = source.geometry() else {
+        return Ok(None);
+    };
+    let invalid =
+        |cause| ExactCurveError::invalid(CurveOperation2::Intersection, curve.family(), cause);
+    let decided = |result: CurveResult<Classification<std::cmp::Ordering>>| {
+        ExactCurveError::decided(CurveOperation2::Intersection, result.map_err(invalid)?)
+    };
+    let empty = || Some(CurvePointLocations2::Locations(Vec::new()));
+    let (dx, dy) = line.delta();
+    // The original support equation is required before an affine coordinate
+    // becomes an inverse parameter. Coordinate agreement alone is insufficient.
+    if !decided(crate::bezier_offset::point_affine_form_order_to_real(
+        point,
+        &(-&dy),
+        &dx,
+        &(-&dy * line.start().x() + &dx * line.start().y()),
+        policy,
+    ))?
+    .is_eq()
+    {
+        return Ok(empty());
+    }
+    let (a, b, origin) = if crate::classify::is_zero(&dx, policy) == Some(false) {
+        (Real::one(), Real::zero(), line.start().x())
+    } else if crate::classify::is_zero(&dy, policy) == Some(false) {
+        (Real::zero(), Real::one(), line.start().y())
+    } else {
+        return Err(ExactCurveError::blocked(
+            CurveOperation2::Intersection,
+            curve.family(),
+            UncertaintyReason::RealSign,
+        ));
+    };
+    let inverse = (Real::one() / if a == Real::one() { &dx } else { &dy })
+        .map_err(|error| invalid(error.into()))?;
+    let parameter = ExactCurveError::decided(
+        CurveOperation2::Intersection,
+        crate::bezier_offset::point_affine_form_parameter(
+            point,
+            &[a * &inverse, b * &inverse, -origin * &inverse],
+            policy,
+        )
+        .map_err(invalid)?,
+    )?;
+    let parameter =
+        polynomial_curve_section::admit_line_parameter(curve, parameter, point, policy)?;
+    Ok(Some(CurvePointLocations2::Locations(
+        parameter
+            .into_iter()
+            .map(|parameter| {
+                CurveLocation2::new(
+                    0,
+                    CurveSpanRange2::from_affine_chart(&Real::one(), &Real::zero()),
+                    parameter,
+                )
+            })
+            .collect(),
+    )))
+}
diff --git a/crates/hypercurve/src/curve_point_components.rs b/crates/hypercurve/src/curve_point_components.rs
new file mode 100644
index 0000000000..ed2bb5c25b
--- /dev/null
+++ b/crates/hypercurve/src/curve_point_components.rs
@@ -0,0 +1,293 @@
+//! Complete parameter loci and their intersection in the retained source atlas.
+use super::*;
+use std::cmp::Ordering;
+
+fn decided<T>(value: Classification<T>) -> ExactCurveResult<T> {
+    ExactCurveError::decided(CurveOperation2::Intersection, value)
+}
+fn compare(
+    a: &CurveParameter2,
+    b: &CurveParameter2,
+    policy: &CurveContext,
+) -> ExactCurveResult<Ordering> {
+    decided(a.cmp_by_refinement(b, policy).map_err(|cause| {
+        ExactCurveError::invalid_unattributed(CurveOperation2::Intersection, cause)
+    })?)
+}
+impl CurveLocationComponent2 {
+    pub(super) fn new(
+        span_index: usize,
+        span_range: CurveSpanRange2,
+        parameters: CurveParameterSet2,
+        endpoint_inclusion: [bool; 2],
+    ) -> Self {
+        Self {
+            span_index,
+            span_range,
+            parameters,
+            endpoint_inclusion,
+        }
+    }
+    /// Original source span index, including distinct one-sided knot charts.
+    pub const fn span_index(&self) -> usize {
+        self.span_index
+    }
+    /// Original affine chart from local to authored parameters.
+    pub const fn span_range(&self) -> &CurveSpanRange2 {
+        &self.span_range
+    }
+    /// Local component closure, without materializing selected endpoints.
+    /// Apply `endpoint_inclusion` to recover the represented set.
+    pub const fn local_parameters(&self) -> &CurveParameterSet2 {
+        &self.parameters
+    }
+    /// Inclusion at the local range's start and end; singles include their point.
+    pub const fn endpoint_inclusion(&self) -> [bool; 2] {
+        self.endpoint_inclusion
+    }
+    /// The component closure in the authored parameter chart. Range orientation and
+    /// endpoint inclusion correspond to the original local range.
+    pub fn parameters(&self) -> ExactCurveResult<CurveParameterSet2> {
+        let map = |p: &CurveParameter2| {
+            CurveLocation2::new(self.span_index, self.span_range.clone(), p.clone()).parameter()
+        };
+        Ok(match &self.parameters {
+            CurveParameterSet2::Single(p) => CurveParameterSet2::Single(map(p)?),
+            CurveParameterSet2::Range(r) => CurveParameterSet2::Range(
+                CurveParameterRange2::try_new(map(r.start())?, map(r.end())?)?,
+            ),
+        })
+    }
+    fn global_bounds(
+        &self,
+        policy: &CurveContext,
+    ) -> ExactCurveResult<([CurveParameter2; 2], [bool; 2])> {
+        let (a, b) = match &self.parameters {
+            CurveParameterSet2::Single(p) => (p, p),
+            CurveParameterSet2::Range(r) => (r.start(), r.end()),
+        };
+        let map = |p: &CurveParameter2| {
+            decided(
+                CurveLocation2::new(self.span_index, self.span_range.clone(), p.clone())
+                    .parameter_with_policy(policy)
+                    .map_err(|cause| {
+                        ExactCurveError::invalid_unattributed(CurveOperation2::Intersection, cause)
+                    })?,
+            )
+        };
+        let mut bounds = [map(a)?, map(b)?];
+        let mut inclusion = self.endpoint_inclusion;
+        if compare(&bounds[0], &bounds[1], policy)?.is_gt() {
+            bounds.swap(0, 1);
+            inclusion.swap(0, 1);
+        }
+        Ok((bounds, inclusion))
+    }
+    fn local_at(
+        &self,
+        parameter: &CurveParameter2,
+        policy: &CurveContext,
+    ) -> ExactCurveResult<CurveParameter2> {
+        let (a, b) = self.span_range.endpoints();
+        let inverse = (Real::one() / (b - a)).map_err(|cause| {
+            ExactCurveError::invalid_unattributed(
+                CurveOperation2::Intersection,
+                CurveError::from(cause),
+            )
+        })?;
+        decided(
+            parameter
+                .affine_image_unbounded(&inverse, &(-a * &inverse), policy)
+                .map_err(|cause| {
+                    ExactCurveError::invalid_unattributed(CurveOperation2::Intersection, cause)
+                })?,
+        )
+    }
+    fn contains(&self, p: &CurveParameter2, policy: &CurveContext) -> ExactCurveResult<bool> {
+        let ([a, b], [ia, ib]) = self.global_bounds(policy)?;
+        let lower = compare(p, &a, policy)?;
+        let upper = compare(p, &b, policy)?;
+        Ok((lower.is_gt() || (lower.is_eq() && ia)) && (upper.is_lt() || (upper.is_eq() && ib)))
+    }
+    fn from_location(location: CurveLocation2) -> Self {
+        Self::new(
+            location.span_index,
+            location.span_range,
+            CurveParameterSet2::Single(location.local_parameter),
+            [true, true],
+        )
+    }
+}
+impl CurvePointLocations2 {
+    fn components(&self) -> Vec<CurveLocationComponent2> {
+        match self {
+            Self::EntireCurve => {
+                unreachable!("whole-domain intersections use the identity directly")
+            }
+            Self::Locations(locations) => locations
+                .iter()
+                .cloned()
+                .map(CurveLocationComponent2::from_location)
+                .collect(),
+            Self::Components(components) => components.clone(),
+        }
+    }
+}
+impl Curve2 {
+    fn same_component_source(
+        &self,
+        a: &CurveLocationComponent2,
+        b: &CurveLocationComponent2,
+        p: &CurveParameter2,
+        policy: &CurveContext,
+    ) -> ExactCurveResult<bool> {
+        if a.span_index == b.span_index && a.span_range == b.span_range {
+            return Ok(true);
+        }
+        let spans = self.source_spans(policy, CurveOperation2::Intersection)?;
+        let point = |c: &CurveLocationComponent2| -> ExactCurveResult<CurvePoint2> {
+            let span = spans.get(c.span_index).ok_or_else(|| {
+                ExactCurveError::invalid_unattributed(
+                    CurveOperation2::Intersection,
+                    CurveError::InvalidCurveParameter,
+                )
+            })?;
+            Ok(span
+                .curve()
+                .point_at_with_policy(&c.local_at(p, policy)?, policy)?
+                .into_value())
+        };
+        decided(point(a)?.same_point(&point(b)?, policy))
+    }
+    /// Intersects two complete point-preimage results from this same unchanged
+    /// curve and source atlas. Parameter equality alone does not identify
+    /// distinct source germs at a discontinuous knot. Original open endpoints
+    /// and selected parameter evidence survive the intersection.
+    pub fn intersect_point_locations(
+        &self,
+        first: &CurvePointLocations2,
+        second: &CurvePointLocations2,
+    ) -> ExactCurveResult<CurvePointLocations2> {
+        resolve_certified_operation(&crate::policy::principal_context(), |policy| {
+            if matches!(first, CurvePointLocations2::EntireCurve) {
+                return Ok(second.clone());
+            }
+            if matches!(second, CurvePointLocations2::EntireCurve) {
+                return Ok(first.clone());
+            }
+            let mut result = Vec::new();
+            for a in first.components() {
+                let (ab, ai) = a.global_bounds(policy)?;
+                for b in second.components() {
+                    let (bb, bi) = b.global_bounds(policy)?;
+                    let (lo, li) = match compare(&ab[0], &bb[0], policy)? {
+                        Ordering::Less => (bb[0].clone(), bi[0]),
+                        Ordering::Greater => (ab[0].clone(), ai[0]),
+                        Ordering::Equal => (ab[0].clone(), ai[0] && bi[0]),
+                    };
+                    let (hi, hi_included) = match compare(&ab[1], &bb[1], policy)? {
+                        Ordering::Less => (ab[1].clone(), ai[1]),
+                        Ordering::Greater => (bb[1].clone(), bi[1]),
+                        Ordering::Equal => (ab[1].clone(), ai[1] && bi[1]),
+                    };
+                    let set = match compare(&lo, &hi, policy)? {
+                        Ordering::Greater => continue,
+                        Ordering::Equal => {
+                            if !li
+                                || !hi_included
+                                || !self.same_component_source(&a, &b, &lo, policy)?
+                            {
+                                continue;
+                            }
+                            CurveParameterSet2::Single(a.local_at(&lo, policy)?)
+                        }
+                        Ordering::Less => {
+                            // Native source atlas interiors are disjoint. A
+                            // cross-chart common endpoint is handled above.
+                            if a.span_index != b.span_index || a.span_range != b.span_range {
+                                return Err(ExactCurveError::blocked(
+                                    CurveOperation2::Intersection,
+                                    self.family(),
+                                    UncertaintyReason::Unsupported,
+                                ));
+                            }
+                            CurveParameterSet2::Range(CurveParameterRange2::new_validated(
+                                a.local_at(&lo, policy)?,
+                                a.local_at(&hi, policy)?,
+                            ))
+                        }
+                    };
+                    result.push(CurveLocationComponent2::new(
+                        a.span_index,
+                        a.span_range.clone(),
+                        set,
+                        [li, hi_included],
+                    ));
+                }
+            }
+            self.normalize_point_components(result, policy)
+        })
+        .map(CurveOutcome::into_value)
+    }
+    pub(super) fn normalize_point_components(
+        &self,
+        components: Vec<CurveLocationComponent2>,
+        policy: &CurveContext,
+    ) -> ExactCurveResult<CurvePointLocations2> {
+        let mut ranges = Vec::new();
+        let mut points = Vec::new();
+        for component in components {
+            match component.parameters {
+                CurveParameterSet2::Single(_) => points.push(component),
+                CurveParameterSet2::Range(_) => ranges.push(component),
+            }
+        }
+        let mut result: Vec<CurveLocationComponent2> = Vec::new();
+        for point in points {
+            let p = point.global_bounds(policy)?.0[0].clone();
+            let mut duplicate = false;
+            for previous in ranges.iter().chain(&result) {
+                if previous.contains(&p, policy)?
+                    && self.same_component_source(&point, previous, &p, policy)?
+                {
+                    duplicate = true;
+                    break;
+                }
+            }
+            if !duplicate {
+                result.push(point);
+            }
+        }
+        result.extend(ranges);
+        // Exact insertion sorting propagates undecided comparisons. No rounded
+        // endpoint or selected-root payload is used as an ordering key.
+        let mut sorted: Vec<CurveLocationComponent2> = Vec::new();
+        for component in result {
+            let p = component.global_bounds(policy)?.0[0].clone();
+            let mut index = 0;
+            while index < sorted.len()
+                && !compare(&sorted[index].global_bounds(policy)?.0[0], &p, policy)?.is_gt()
+            {
+                index += 1;
+            }
+            sorted.insert(index, component);
+        }
+        if sorted
+            .iter()
+            .all(|c| matches!(c.parameters, CurveParameterSet2::Single(_)))
+        {
+            return Ok(CurvePointLocations2::Locations(
+                sorted
+                    .into_iter()
+                    .map(|c| {
+                        let CurveParameterSet2::Single(p) = c.parameters else {
+                            unreachable!()
+                        };
+                        CurveLocation2::new(c.span_index, c.span_range, p)
+                    })
+                    .collect(),
+            ));
+        }
+        Ok(CurvePointLocations2::Components(sorted))
+    }
+}
diff --git a/crates/hypercurve/src/curve_rational_location.rs b/crates/hypercurve/src/curve_rational_location.rs
new file mode 100644
index 0000000000..e09a70b2d9
--- /dev/null
+++ b/crates/hypercurve/src/curve_rational_location.rs
@@ -0,0 +1,299 @@
+//! Native rational preimages retain the query's selected coefficient field.
+use super::*;
+use crate::bezier_split::CurveParameterDomain2;
+use crate::polynomial_point::PolynomialPoint2;
+use crate::{CurveFamily2, CurveParameterRange2, CurveParameterSet2};
+
+pub(super) type SpanPreimages = Vec<(CurveParameterSet2, [bool; 2])>;
+use hyperreal::RealSign;
+use hypersolve::BivariatePolynomial;
+
+fn decide<T>(value: Classification<T>) -> ExactCurveResult<T> {
+    ExactCurveError::decided(CurveOperation2::Intersection, value)
+}
+
+/// Complete local preimages, with open ends at original denominator zeros.
+/// Roots of one original coordinate equation are complete candidates; the
+/// second equation, original denominator and active range validate each one.
+pub(super) fn parameters(
+    source: &RationalBezier2,
+    range: &CurveParameterRange2,
+    point: &CurvePoint2,
+    family: CurveFamily2,
+    policy: &CurveContext,
+) -> ExactCurveResult<SpanPreimages> {
+    parameters_with_map(source, range, point, family, policy, None)
+}
+
+pub(super) fn mapped_parameters(
+    source: &RationalBezier2,
+    range: &CurveParameterRange2,
+    point: &CurvePoint2,
+    family: CurveFamily2,
+    policy: &CurveContext,
+    map: &crate::RationalMap2,
+) -> ExactCurveResult<SpanPreimages> {
+    parameters_with_map(source, range, point, family, policy, Some(map))
+}
+
+fn parameters_with_map(
+    source: &RationalBezier2,
+    range: &CurveParameterRange2,
+    point: &CurvePoint2,
+    family: CurveFamily2,
+    policy: &CurveContext,
+    map: Option<&crate::RationalMap2>,
+) -> ExactCurveResult<SpanPreimages> {
+    let invalid = |cause| ExactCurveError::invalid(CurveOperation2::Intersection, family, cause);
+    let basis = source.homogeneous_power_basis().map_err(invalid)?;
+    let mapped = map
+        .map(|map| {
+            use hypersolve::bivariate_arithmetic::{
+                bivariate_active_total_degree, bivariate_homogeneous_compose,
+            };
+            // The common degree below is sufficient for every coordinate. A
+            // failed checked composition therefore reaches a platform storage or
+            // allocation limit, rather than a missing geometric algorithm.
+            let polynomials = [
+                &map.numerators()[0],
+                &map.numerators()[1],
+                map.denominator(),
+            ];
+            let degree = polynomials
+                .iter()
+                .map(|p| {
+                    bivariate_active_total_degree(p).ok_or_else(|| {
+                        ExactCurveError::blocked(
+                            CurveOperation2::Intersection,
+                            family,
+                            UncertaintyReason::BudgetExhausted,
+                        )
+                    })
+                })
+                .collect::<ExactCurveResult<Vec<_>>>()?
+                .into_iter()
+                .max()
+                .unwrap_or(0);
+            let univariate = |values: &[Real]| {
+                BivariatePolynomial::new(values.iter().cloned().map(|value| vec![value]).collect())
+            };
+            let [x, y, w] =
+                [&basis.x_numerator, &basis.y_numerator, &basis.weight].map(|v| univariate(v));
+            polynomials
+                .map(|p| {
+                    bivariate_homogeneous_compose(p, &x, &y, &w, degree)
+                        .ok_or_else(|| {
+                            ExactCurveError::blocked(
+                                CurveOperation2::Intersection,
+                                family,
+                                UncertaintyReason::BudgetExhausted,
+                            )
+                        })
+                        .map(|p| {
+                            p.coefficients
+                                .into_iter()
+                                .map(|row| row.into_iter().next().unwrap_or_else(Real::zero))
+                                .collect::<Vec<_>>()
+                        })
+                })
+                .into_iter()
+                .collect::<ExactCurveResult<Vec<_>>>()
+        })
+        .transpose()?;
+    let (coordinates, weight) = match &mapped {
+        Some(values) => (
+            [values[0].as_slice(), values[1].as_slice()],
+            values[2].as_slice(),
+        ),
+        None => (
+            [basis.x_numerator.as_slice(), basis.y_numerator.as_slice()],
+            basis.weight.as_slice(),
+        ),
+    };
+
+    let (_, bounds) = decide(
+        CurveParameterDomain2::new(range, None)
+            .finite_envelope(policy)
+            .map_err(invalid)?,
+    )?;
+    let coefficient_forms = |coordinate: &[Real], axis| {
+        (0..coordinate.len().max(weight.len()))
+            .map(|i| {
+                let c = coordinate.get(i).cloned().unwrap_or_else(Real::zero);
+                let w = -weight.get(i).cloned().unwrap_or_else(Real::zero);
+                let polynomial = if axis == 0 {
+                    BivariatePolynomial::new(vec![vec![c], vec![w]])
+                } else {
+                    BivariatePolynomial::new(vec![vec![c, w]])
+                };
+                point.rational_form(
+                    polynomial,
+                    BivariatePolynomial::new(vec![vec![Real::one()]]),
+                )
+            })
+            .collect::<ExactCurveResult<Vec<_>>>()
+    };
+    let mut candidates = None;
+    for (axis, coordinate) in coordinates.into_iter().enumerate() {
+        if let Some(roots) = PolynomialPoint2::selected_root_candidates(
+            coefficient_forms(coordinate, axis)?,
+            [bounds[0].clone(), bounds[1].clone()],
+            hypersolve::AlgebraicFiberRootIsolationConfig::default(),
+            policy,
+        )? {
+            candidates = Some(roots);
+            break;
+        }
+    }
+    let Some(candidates) = candidates else {
+        // Identically vanishing equations describe the entire defined domain,
+        // including all punctures of the ORIGINAL source and map guards.
+        let mut holes: Vec<CurveParameter2> = Vec::new();
+        for guard in [Some(basis.weight.as_slice()), map.map(|_| weight)]
+            .into_iter()
+            .flatten()
+        {
+            if crate::curve::polynomial_is_zero(guard, policy)? {
+                return if guard == basis.weight.as_slice() {
+                    Err(invalid(CurveError::ZeroRationalPointDenominator))
+                } else {
+                    Ok(Vec::new())
+                };
+            }
+            let coefficients = guard
+                .iter()
+                .map(|c| {
+                    point.rational_form(
+                        BivariatePolynomial::new(vec![vec![c.clone()]]),
+                        BivariatePolynomial::new(vec![vec![Real::one()]]),
+                    )
+                })
+                .collect::<ExactCurveResult<Vec<_>>>()?;
+            let roots = PolynomialPoint2::selected_root_candidates(
+                coefficients,
+                [bounds[0].clone(), bounds[1].clone()],
+                hypersolve::AlgebraicFiberRootIsolationConfig::default(),
+                policy,
+            )?
+            .expect("a nonzero guard has isolated roots");
+            for root in roots {
+                let parameter = decide(
+                    crate::bezier_offset::point_affine_form_parameter(
+                        &root,
+                        &[Real::one(), Real::zero(), Real::zero()],
+                        policy,
+                    )
+                    .map_err(invalid)?,
+                )?;
+                if !decide(
+                    CurveParameterDomain2::new(range, None)
+                        .contains_finite_parameter(&parameter, policy)
+                        .map_err(invalid)?,
+                )? {
+                    continue;
+                }
+                let mut index = 0;
+                while index < holes.len()
+                    && decide(
+                        holes[index]
+                            .cmp_by_refinement(&parameter, policy)
+                            .map_err(invalid)?,
+                    )?
+                    .is_lt()
+                {
+                    index += 1;
+                }
+                if index == holes.len()
+                    || !decide(
+                        holes[index]
+                            .cmp_by_refinement(&parameter, policy)
+                            .map_err(invalid)?,
+                    )?
+                    .is_eq()
+                {
+                    holes.insert(index, parameter);
+                }
+            }
+        }
+        let [start, end] = decide(range.ordered_endpoints(policy).map_err(invalid)?)?;
+        let mut previous = start.clone();
+        let mut included = true;
+        let mut components = Vec::new();
+        for hole in holes {
+            if !decide(previous.cmp_by_refinement(&hole, policy).map_err(invalid)?)?.is_eq() {
+                components.push((
+                    CurveParameterSet2::Range(CurveParameterRange2::new_validated(
+                        previous,
+                        hole.clone(),
+                    )),
+                    [included, false],
+                ));
+            }
+            previous = hole;
+            included = false;
+        }
+        if !decide(previous.cmp_by_refinement(end, policy).map_err(invalid)?)?.is_eq() {
+            components.push((
+                CurveParameterSet2::Range(CurveParameterRange2::new_validated(
+                    previous,
+                    end.clone(),
+                )),
+                [included, true],
+            ));
+        }
+        return Ok(components);
+    };
+    let mut parameters = Vec::new();
+    for root in candidates {
+        let mut parameter = decide(
+            crate::bezier_offset::point_affine_form_parameter(
+                &root,
+                &[Real::one(), Real::zero(), Real::zero()],
+                policy,
+            )
+            .map_err(invalid)?,
+        )?;
+        if !decide(
+            CurveParameterDomain2::new(range, None)
+                .contains_finite_parameter(&parameter, policy)
+                .map_err(invalid)?,
+        )? {
+            continue;
+        }
+        let mut defined = true;
+        for guard in [Some(basis.weight.as_slice()), map.map(|_| weight)]
+            .into_iter()
+            .flatten()
+        {
+            defined &= decide(parameter.polynomial_sign(guard, policy).map_err(invalid)?)?
+                != RealSign::Zero;
+        }
+        if !defined {
+            continue;
+        } // Original source and map poles stay excluded.
+        for endpoint in [range.start(), range.end()] {
+            if decide(
+                parameter
+                    .cmp_by_refinement(endpoint, policy)
+                    .map_err(invalid)?,
+            )?
+            .is_eq()
+            {
+                parameter = endpoint.clone();
+                break;
+            }
+        }
+        let mut evaluated =
+            crate::curve::curve_evaluation::rational_point(source, &parameter, family, policy)?;
+        if let Some(map) = map {
+            evaluated = evaluated.rational_image_with_policy(map, policy)?;
+        }
+        if decide(evaluated.same_point(point, policy))? {
+            parameters.push(parameter);
+        }
+    }
+    Ok(parameters
+        .into_iter()
+        .map(|p| (CurveParameterSet2::Single(p), [true, true]))
+        .collect())
+}
diff --git a/crates/hypercurve/src/curve_rational_map_location.rs b/crates/hypercurve/src/curve_rational_map_location.rs
new file mode 100644
index 0000000000..79c1863554
--- /dev/null
+++ b/crates/hypercurve/src/curve_rational_map_location.rs
@@ -0,0 +1,132 @@
+//! Query retained rational maps without replacing their source geometry.
+use super::*;
+use crate::curve_support::CurveSupport2;
+use crate::{BezierSplitFragment2, RationalMap2};
+
+impl Curve2 {
+    /// All preimages of `point` through `map(self(t))`, in this curve's
+    /// original parameter chart. Original source and map denominator zeros
+    /// remain excluded, including removable poles. No image curve is fitted
+    /// or published. Native rational/spline spans and retained polynomial
+    /// branches share their incidence authority with ordinary point location.
+    /// Continuous preimages covering the complete defined source return
+    /// `EntireCurve` only after a proof that no pole punctures the domain.
+    /// Discontinuous knot sides keep distinct source-chart locations even if
+    /// their mapped point and authored parameter agree; continuous seams merge.
+    /// Proper continuous and mixed preimages retain exact span charts and
+    /// endpoint inclusion in `Components`; original poles remain open ends.
+    pub fn rational_image_point_locations(
+        &self,
+        map: &RationalMap2,
+        point: &CurvePoint2,
+    ) -> ExactCurveResult<CurvePointLocations2> {
+        resolve_certified_operation(&crate::policy::principal_context(), |policy| {
+            self.rational_image_point_locations_raw(map, point, policy)
+        })
+        .map(CurveOutcome::into_value)
+    }
+
+    pub(super) fn identity_point_locations_raw(
+        &self,
+        point: &CurvePoint2,
+        policy: &CurveContext,
+    ) -> ExactCurveResult<CurvePointLocations2> {
+        let identity = crate::RationalMap2::new(
+            [
+                hypersolve::BivariatePolynomial::new(vec![vec![], vec![Real::one()]]),
+                hypersolve::BivariatePolynomial::new(vec![vec![Real::zero(), Real::one()]]),
+            ],
+            hypersolve::BivariatePolynomial::new(vec![vec![Real::one()]]),
+        );
+        self.rational_image_point_locations_raw(&identity, point, policy)
+    }
+
+    pub(super) fn rational_image_point_locations_raw(
+        &self,
+        map: &RationalMap2,
+        point: &CurvePoint2,
+        policy: &CurveContext,
+    ) -> ExactCurveResult<CurvePointLocations2> {
+        let mut zero_denominator = true;
+        for row in &map.denominator().coefficients {
+            if !crate::curve::polynomial_is_zero(row, policy)? {
+                zero_denominator = false;
+                break;
+            }
+        }
+        if zero_denominator {
+            return Err(ExactCurveError::invalid(
+                CurveOperation2::Intersection,
+                self.family(),
+                CurveError::ZeroRationalPointDenominator,
+            ));
+        }
+        if let Some(branch) = self.polynomial_branch() {
+            return Ok(match branch.mapped_point_parameters(point, map, policy)? {
+                None => CurvePointLocations2::EntireCurve,
+                Some(parameters) => CurvePointLocations2::Locations(
+                    parameters
+                        .into_iter()
+                        .map(|p| {
+                            CurveLocation2::new(
+                                0,
+                                CurveSpanRange2::from_affine_chart(&Real::one(), &Real::zero()),
+                                p,
+                            )
+                        })
+                        .collect(),
+                ),
+            });
+        }
+        let blocked = || {
+            ExactCurveError::blocked(
+                CurveOperation2::Intersection,
+                self.family(),
+                UncertaintyReason::Unsupported,
+            )
+        };
+        let spans = self.source_spans(policy, CurveOperation2::Intersection)?;
+        let mut components = Vec::new();
+        let mut entire = 0;
+        for (index, span) in spans.iter().enumerate() {
+            let CurveSupport2::Bezier(source) = CurveSupport2::from_fragment(&span.fragment) else {
+                return Err(blocked());
+            };
+            let source = RationalBezier2::try_from_subcurve(&source).map_err(|cause| {
+                ExactCurveError::invalid(CurveOperation2::Intersection, self.family(), cause)
+            })?;
+            let range = if matches!(span.fragment, BezierSplitFragment2::Materialized { .. }) {
+                CurveParameterRange2::unit()
+            } else {
+                span.fragment.curve_region_parameter_range()
+            };
+            let parameters = curve_rational_location::mapped_parameters(
+                &source,
+                &range,
+                point,
+                self.family(),
+                policy,
+                map,
+            )?;
+            let ordered = ExactCurveError::decided(
+                CurveOperation2::Intersection,
+                range.ordered_endpoints(policy).map_err(|cause| {
+                    ExactCurveError::invalid(CurveOperation2::Intersection, self.family(), cause)
+                })?,
+            )?;
+            if parameters.len() == 1
+                && parameters[0].1 == [true, true]
+                && matches!(&parameters[0].0,CurveParameterSet2::Range(r) if r.start()==ordered[0] && r.end()==ordered[1])
+            {
+                entire += 1;
+            }
+            components.extend(parameters.into_iter().map(|(p, inclusion)| {
+                CurveLocationComponent2::new(index, span.chart(), p, inclusion)
+            }));
+        }
+        if entire == spans.len() {
+            return Ok(CurvePointLocations2::EntireCurve);
+        }
+        self.normalize_point_components(components, policy)
+    }
+}
diff --git a/crates/hypercurve/src/polynomial_curve_mapped_chord.rs b/crates/hypercurve/src/polynomial_curve_mapped_chord.rs
new file mode 100644
index 0000000000..dd89dbc13b
--- /dev/null
+++ b/crates/hypercurve/src/polynomial_curve_mapped_chord.rs
@@ -0,0 +1,316 @@
+//! Selected line coefficients pull back through retained rational image maps.
+
+use super::selected_chord::{coordinates, form};
+use super::*;
+use crate::{BezierAlgebraicChord2, CurvePointRationalForm2};
+use hypersolve::BivariatePolynomial;
+use hypersolve::bivariate_arithmetic::{
+    bivariate_multiply, bivariate_parameter_derivative as derivative,
+};
+use hypersolve::ordered_field_resultant::{
+    OrderedFieldResultantConfig, OrderedFieldResultantError, resultant_bivariate_ordered_field,
+};
+
+type Form = CurvePointRationalForm2;
+
+struct Coefficients<'a> {
+    origin: &'a CurvePoint2,
+}
+impl hypersolve::OrderedFieldPolynomialContext<Form> for Coefficients<'_> {
+    type Error = ExactCurveError;
+    fn constant(&mut self, value: &Real) -> ExactCurveResult<Form> {
+        form(
+            self.origin,
+            BivariatePolynomial::new(vec![vec![value.clone()]]),
+        )
+    }
+    fn add(&mut self, a: &Form, b: &Form) -> ExactCurveResult<Form> {
+        a.add(b)
+    }
+    fn multiply(&mut self, a: &Form, b: &Form) -> ExactCurveResult<Form> {
+        a.multiply(b)
+    }
+    fn scale(&mut self, value: &Form, scale: &Real) -> ExactCurveResult<Form> {
+        value.scaled(scale)
+    }
+    fn sign(&mut self, value: &Form) -> ExactCurveResult<Ordering> {
+        value.compare_to_real(&Real::zero())
+    }
+    fn sign_if_separated(&mut self, value: &Form) -> ExactCurveResult<Option<Ordering>> {
+        self.sign(value).map(Some)
+    }
+    fn normalize_positive_scale(&mut self, _: &mut [Form]) {}
+}
+
+/// Linear combination of three retained real-coefficient source polynomials.
+/// The coefficients retain the original endpoint fields and pole guards.
+fn combination(
+    polynomials: [&BivariatePolynomial; 3],
+    coefficients: &[Form; 3],
+) -> ExactCurveResult<Vec<Vec<Form>>> {
+    let rows = polynomials
+        .iter()
+        .map(|p| p.coefficients.len())
+        .max()
+        .unwrap_or(0);
+    (0..rows)
+        .map(|i| {
+            let columns = polynomials
+                .iter()
+                .filter_map(|p| p.coefficients.get(i))
+                .map(Vec::len)
+                .max()
+                .unwrap_or(0);
+            (0..columns)
+                .map(|j| {
+                    let term = |index: usize| {
+                        coefficients[index].scaled(
+                            polynomials[index]
+                                .coefficients
+                                .get(i)
+                                .and_then(|row| row.get(j))
+                                .unwrap_or(&Real::zero()),
+                        )
+                    };
+                    term(0)?.add(&term(1)?)?.add(&term(2)?)
+                })
+                .collect()
+        })
+        .collect()
+}
+
+fn evaluate(
+    point: &CurvePoint2,
+    polynomials: [&BivariatePolynomial; 3],
+    coefficients: &[Form; 3],
+) -> ExactCurveResult<Form> {
+    let term = |i: usize| form(point, polynomials[i].clone())?.multiply(&coefficients[i]);
+    term(0)?.add(&term(1)?)?.add(&term(2)?)
+}
+
+impl PolynomialCurveBranch2 {
+    /// Complete isolated contacts with a selected chord, through the original
+    /// source branch. A zero resultant needs component correspondences and
+    /// remains unsupported. The local elimination budget counts coefficient
+    /// calls and matrix entries; it is not a total arithmetic or memory bound.
+    pub(crate) fn mapped_selected_chord_sections(
+        &self,
+        chord: &BezierAlgebraicChord2,
+        policy: &CurveContext,
+    ) -> ExactCurveResult<Vec<PolynomialLineSection2>> {
+        chord.validate_policy(policy).map_err(invalid)?;
+        let [ax, ay] = coordinates(chord.start())?;
+        let [bx, by] = coordinates(chord.end())?;
+        let dx = bx.subtract(&ax)?;
+        let dy = by.subtract(&ay)?;
+        // L(X,Y) = dy*X - dx*Y + dx*ay - dy*ax.
+        let coefficients = [
+            dy.clone(),
+            dx.scaled(&Real::from(-1))?,
+            dx.multiply(&ay)?.subtract(&dy.multiply(&ax)?)?,
+        ];
+        self.mapped_selected_line_sections(chord.start(), coefficients, true, policy)
+    }
+
+    /// A selected coordinate level through a foreign point uses the same
+    /// line-pullback authority as generated chord incidence. It does not infer
+    /// an inverse map from the point's construction graph.
+    pub(super) fn mapped_selected_axis_sections(
+        &self,
+        point: &CurvePoint2,
+        axis: usize,
+        map: Option<&crate::RationalMap2>,
+        policy: &CurveContext,
+    ) -> ExactCurveResult<Vec<PolynomialLineSection2>> {
+        let constant = |value| form(point, BivariatePolynomial::new(vec![vec![value]]));
+        let mut coefficients = [
+            constant(Real::zero())?,
+            constant(Real::zero())?,
+            coordinates(point)?[axis].scaled(&Real::from(-1))?,
+        ];
+        coefficients[axis] = constant(Real::one())?;
+        self.mapped_selected_line_sections_with_map(point, coefficients, false, policy, map)
+    }
+
+    fn mapped_selected_line_sections(
+        &self,
+        origin: &CurvePoint2,
+        coefficients: [Form; 3],
+        classify_tangents: bool,
+        policy: &CurveContext,
+    ) -> ExactCurveResult<Vec<PolynomialLineSection2>> {
+        self.mapped_selected_line_sections_with_map(
+            origin,
+            coefficients,
+            classify_tangents,
+            policy,
+            None,
+        )
+    }
+
+    fn mapped_selected_line_sections_with_map(
+        &self,
+        origin: &CurvePoint2,
+        coefficients: [Form; 3],
+        classify_tangents: bool,
+        policy: &CurveContext,
+        map: Option<&crate::RationalMap2>,
+    ) -> ExactCurveResult<Vec<PolynomialLineSection2>> {
+        let (nx, wx) = self
+            .mapped_coordinate_form(0, map)
+            .ok_or_else(|| blocked(UncertaintyReason::Unsupported))?;
+        let (ny, wy) = self
+            .mapped_coordinate_form(1, map)
+            .ok_or_else(|| blocked(UncertaintyReason::Unsupported))?;
+        let [x, y, w] = if wx == wy {
+            [nx, ny, wx]
+        } else {
+            [
+                bivariate_multiply(&nx, &wy),
+                bivariate_multiply(&ny, &wx),
+                bivariate_multiply(&wx, &wy),
+            ]
+        };
+        let pulled = combination([&x, &y, &w], &coefficients)?;
+        let original = self
+            .topology()
+            .geometric_equation()
+            .coefficients
+            .iter()
+            .map(|row| {
+                row.iter()
+                    .map(|c| form(origin, BivariatePolynomial::new(vec![vec![c.clone()]])))
+                    .collect()
+            })
+            .collect::<ExactCurveResult<Vec<Vec<Form>>>>()?;
+        let report = resultant_bivariate_ordered_field(
+            &original,
+            &pulled,
+            OrderedFieldResultantConfig::default(),
+            &mut Coefficients { origin },
+        )
+        .map_err(|error| match error {
+            OrderedFieldResultantError::Coefficient(error) => error,
+            OrderedFieldResultantError::OperationLimit { .. }
+            | OrderedFieldResultantError::MatrixLimit { .. }
+            | OrderedFieldResultantError::AllocationFailed
+            | OrderedFieldResultantError::SizeOverflow => {
+                blocked(UncertaintyReason::BudgetExhausted)
+            }
+            OrderedFieldResultantError::Numeric(error) => invalid(error.into()),
+        })?;
+        let roots = PolynomialPoint2::selected_root_candidates(
+            report.coefficients,
+            self.topology().domain().first.clone(),
+            self.source.fiber_config,
+            policy,
+        )?
+        .ok_or_else(|| blocked(UncertaintyReason::Unsupported))?;
+        let source = Curve2::from_polynomial_branch(self.source_branch(policy)?);
+        let fx = derivative(
+            self.topology().geometric_equation(),
+            CurveResultantParameter::First,
+        );
+        let fy = derivative(
+            self.topology().geometric_equation(),
+            CurveResultantParameter::Second,
+        );
+        let gx = [&x, &y, &w].map(|p| derivative(p, CurveResultantParameter::First));
+        let gy = [&x, &y, &w].map(|p| derivative(p, CurveResultantParameter::Second));
+        let mut sections = Vec::new();
+        for root in roots {
+            let mut parameter = coordinates(&root)?[0].parameter()?;
+            let low = decided(
+                parameter
+                    .cmp_by_refinement(self.range.start(), policy)
+                    .map_err(invalid)?,
+            )?;
+            let high = decided(
+                parameter
+                    .cmp_by_refinement(self.range.end(), policy)
+                    .map_err(invalid)?,
+            )?;
+            if low.is_lt() || high.is_gt() {
+                continue;
+            }
+            if low.is_eq() {
+                parameter = self.range.start().clone();
+            }
+            if high.is_eq() {
+                parameter = self.range.end().clone();
+            }
+            let point = source
+                .point_at_with_policy(&parameter, policy)?
+                .into_value();
+            let mut image = if low.is_eq() {
+                self.endpoints[0].clone()
+            } else if high.is_eq() {
+                self.endpoints[1].clone()
+            } else {
+                self.map_point(point.clone(), policy)?
+            };
+            if let Some(map) = map {
+                // Elimination can propose an original map pole even when a
+                // removable factor cancels. It is not a preimage.
+                if form(&image, map.denominator().clone())?.compare_to_real(&Real::zero())?
+                    == Ordering::Equal
+                {
+                    continue;
+                }
+                image = image.rational_image_with_policy(map, policy)?;
+            }
+            let [px, py] = coordinates(&image)?;
+            if coefficients[0]
+                .multiply(&px)?
+                .add(&coefficients[1].multiply(&py)?)?
+                .add(&coefficients[2])?
+                .compare_to_real(&Real::zero())?
+                != Ordering::Equal
+            {
+                continue;
+            }
+            // At a validated line contact, G = w*L(image). Its source
+            // derivative has sign sign(w)*sign(T_image x chord_direction).
+            let cross = (|| -> ExactCurveResult<Option<RealSign>> {
+                if !classify_tangents {
+                    return Ok(None);
+                }
+                let denominator = form(&point, fy.clone())?.multiply(&form(&point, w.clone())?)?;
+                let weight = denominator.compare_to_real(&Real::zero())?;
+                if weight == Ordering::Equal {
+                    return Ok(None);
+                }
+                let a = evaluate(&point, [&gx[0], &gx[1], &gx[2]], &coefficients)?
+                    .multiply(&form(&point, fy.clone())?)?;
+                let b = evaluate(&point, [&gy[0], &gy[1], &gy[2]], &coefficients)?
+                    .multiply(&form(&point, fx.clone())?)?;
+                let order = a.subtract(&b)?.compare_to_real(&Real::zero())?;
+                let sign = match order {
+                    Ordering::Less => RealSign::Negative,
+                    Ordering::Equal => RealSign::Zero,
+                    Ordering::Greater => RealSign::Positive,
+                };
+                Ok(Some(if weight == Ordering::Less {
+                    negate(sign)
+                } else {
+                    sign
+                }))
+            })();
+            let cross = match cross {
+                Ok(sign) => sign,
+                Err(ExactCurveError::Blocked(blocker))
+                    if blocker.reason() != UncertaintyReason::BudgetExhausted =>
+                {
+                    None
+                }
+                Err(error) => return Err(error),
+            };
+            sections.push(PolynomialLineSection2 {
+                parameter,
+                point: image,
+                cross,
+            });
+        }
+        Ok(sections)
+    }
+}
