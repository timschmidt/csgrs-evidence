+        }
+        Err(hypercurve::ExactCurveError::Blocked(blocker)) => {
+            assert_eq!(blocker.reason(), hypercurve::UncertaintyReason::Unsupported)
+        }
+        other => panic!(
+            "expected the complete preimage set or an explicit implementation blocker: {other:?}"
+        ),
+    }
+}
