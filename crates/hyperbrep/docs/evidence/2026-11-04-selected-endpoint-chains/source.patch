+        for point in points {
+            let spatial = curve.point_at(&point.parameter).unwrap();
+            assert_eq!(
+                spatial
+                    .compare_linear_form(&Vector3::x(), &Real::zero())
+                    .unwrap(),
+                std::cmp::Ordering::Equal
+            );
+            assert_eq!(
+                spatial
+                    .compare_linear_form(&Vector3::z(), &q(1, 2))
+                    .unwrap(),
+                std::cmp::Ordering::Equal
+            );
