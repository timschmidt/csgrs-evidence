+impl BezierAlgebraicChordPairPoint2 {
+    pub(crate) fn uses_selected_field(&self) -> bool {
+        *self.data.selected_field_hint.get_or_init(|| {
+            [&self.data.first, &self.data.second]
+                .into_iter()
+                .flat_map(|line| [line.start(), line.end()])
