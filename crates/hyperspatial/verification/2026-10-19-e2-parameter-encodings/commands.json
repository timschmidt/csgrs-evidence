{
  "caches": {
    "commands": [
      [
        "bash",
        "crates/hyperspatial/scripts/representation-checks.sh"
      ]
    ],
    "environment": {
      "CARGO_BUILD_JOBS": "4",
      "CARGO_TARGET_DIR": "/mnt/development/hyperspatial/encodings-cache-target",
      "TMPDIR": "/mnt/development/hyperspatial/verification-tmp"
    }
  },
  "coverage": {
    "commands": [
      [
        "python3",
        "crates/hyperspatial/scripts/coverage-gates.py"
      ],
      [
        "python3",
        "crates/hyperspatial/scripts/coverage.py"
      ]
    ],
    "environment": {
      "CARGO_BUILD_JOBS": "4",
      "CARGO_PROFILE_TEST_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_TEST_OPT_LEVEL": "1",
      "CARGO_PROFILE_TEST_OVERFLOW_CHECKS": "true",
      "CARGO_TARGET_DIR": "/mnt/development/hyperspatial/thompson-domain-coverage-target",
      "TMPDIR": "/mnt/development/hyperspatial/verification-tmp"
    }
  },
  "docs_wasm": {
    "commands": [
      [
        "cargo",
        "doc",
        "--locked",
        "-p",
        "hyperreal",
        "-p",
        "hyperlattice",
        "-p",
        "hyperlimit",
        "--all-features",
        "--no-deps"
      ],
      [
        "cargo",
        "check",
        "--locked",
        "-p",
        "hyperspatial",
        "--lib",
        "--all-features",
        "--target",
        "wasm32-unknown-unknown"
      ],
      [
        "cargo",
        "clippy",
        "--locked",
        "-p",
        "hyperspatial",
        "--lib",
        "--all-features",
        "--target",
        "wasm32-unknown-unknown",
        "--",
        "-D",
        "warnings"
      ]
    ],
    "environment": {
      "CARGO_BUILD_JOBS": "4",
      "CARGO_TARGET_DIR": "/mnt/development/hyperspatial/thompson-posture-target",
      "RUSTDOCFLAGS": "-D warnings",
      "TMPDIR": "/mnt/development/hyperspatial/verification-tmp"
    }
  },
