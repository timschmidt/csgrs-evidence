{
  "adversarial": {
    "commands": [
      [
        "python3",
        "crates/hyperspatial/scripts/directed.py",
        "--workload",
        "complex_atanh",
        "--output",
        "/mnt/development/hyperspatial/atanh-final-directed"
      ],
      [
        "python3",
        "crates/hyperspatial/scripts/fuzz-smoke.py",
        "--targets",
        "complex_atanh",
        "--atanh-corpus",
        "/mnt/development/hyperspatial/atanh-final-directed/corpus",
        "--output",
        "/mnt/development/hyperspatial/atanh-final-asan"
      ]
    ],
    "environment": {
      "TMPDIR": "/mnt/development/hyperspatial/verification-tmp"
    }
  },
  "caches": {
    "commands": [
      [
        "bash",
        "crates/hyperspatial/scripts/representation-checks.sh"
      ]
    ],
    "environment": {
      "CARGO_TARGET_DIR": "/mnt/development/hyperspatial/atanh-final-cache-target",
      "TMPDIR": "/mnt/development/hyperspatial/verification-tmp"
    }
  },
  "coverage": {
    "commands": [
      [
        "python3",
        "crates/hyperspatial/scripts/coverage-gates.py"
      ],
      [
        "python3",
        "crates/hyperspatial/scripts/coverage.py"
      ]
    ],
    "environment": {
      "CARGO_PROFILE_TEST_DEBUG_ASSERTIONS": "true",
      "CARGO_PROFILE_TEST_OPT_LEVEL": "1",
      "CARGO_PROFILE_TEST_OVERFLOW_CHECKS": "true",
      "CARGO_TARGET_DIR": "/mnt/development/hyperspatial/atanh-final-coverage-target",
      "TMPDIR": "/mnt/development/hyperspatial/verification-tmp"
    }
  },
  "docs_wasm": {
    "commands": [
      [
        "cargo",
        "doc",
        "--locked",
        "-p",
        "hyperreal",
        "-p",
        "hyperlattice",
        "-p",
        "hyperlimit",
        "--all-features",
        "--no-deps"
      ],
      [
        "cargo",
        "check",
        "--locked",
        "-p",
        "hyperspatial",
        "--lib",
        "--all-features",
        "--target",
        "wasm32-unknown-unknown"
      ],
      [
        "cargo",
        "clippy",
        "--locked",
        "-p",
        "hyperspatial",
        "--lib",
        "--all-features",
        "--target",
        "wasm32-unknown-unknown",
        "--",
        "-D",
        "warnings"
      ]
    ],
    "environment": {
      "CARGO_TARGET_DIR": "/mnt/development/hyperspatial/atanh-final-target",
      "RUSTDOCFLAGS": "-D warnings",
      "TMPDIR": "/mnt/development/hyperspatial/verification-tmp"
    }
  },
